{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm build",
  "outputDirectory": "dist",
  "framework": "astro",
  "crons": [
    {
      "path": "/api/cron/daily-tick",
      "schedule": "0 0 * * *"
