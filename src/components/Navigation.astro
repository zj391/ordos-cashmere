---
/**
 * 顶部导航（响应式 + 多语言切换器）
 * 含产品分类下拉菜单
 */
import { LOCALES, LOCALE_NAMES, LOCALE_FLAGS, type Locale } from '@/lib/i18n';
import { localePath } from '@/lib/i18n';
import submenusData from '@/data/nav-submenus.json';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;

// 主导航
// Pura-style: 5 product category tabs each with own submenu
// Plus 5 informational pages (no submenu)
// menuPos: 'left' | 'center' | 'right' - controls mega menu alignment
// 把 URL 直接指向 /products 列表页（不是 /products/[slug] 详情页）
// 子分类链接带 ?cat=hats&byStyle=beanies 等参数，由 products.astro 的 JS 读 URL 应用 filter。
// 历史原因：[category].astro 把 hats 和 accessories 合并到 hats-accessories 单 hub，
// mega menu 子项要独立 filter 所以走总列表页更直接。
const productListHref = localePath(locale, '/products');
const categoryHubHref = {
  hats: `/${locale}/products/hats-accessories/`,
  sweaters: `/${locale}/products/garment-oem/`,
  scarves: `/${locale}/products/scarves/`,
  accessories: `/${locale}/products/accessories-cat/`,
  yarn: `/${locale}/products/yarn/`,
};

const navItems = [
  { href: categoryHubHref.hats, filterHref: `${productListHref}?cat=hats`, labelKey: 'nav.hats', hasSubmenu: 'hats', menuPos: 'left' },
  { href: categoryHubHref.sweaters, filterHref: `${productListHref}?cat=sweaters`, labelKey: 'nav.sweaters', hasSubmenu: 'sweaters', menuPos: 'center' },
  { href: categoryHubHref.scarves, filterHref: `${productListHref}?cat=scarves`, labelKey: 'nav.scarves', hasSubmenu: 'scarves', menuPos: 'center' },
  { href: categoryHubHref.accessories, filterHref: `${productListHref}?cat=accessories`, labelKey: 'nav.accessories', hasSubmenu: 'accessories', menuPos: 'right' },
  { href: categoryHubHref.yarn, filterHref: `${productListHref}?cat=yarn`, labelKey: 'nav.yarn', hasSubmenu: 'yarn', menuPos: 'right' },
  { href: localePath(locale, '/raw-material'), labelKey: 'nav.rawMaterial' },
  { href: localePath(locale, '/blog'), labelKey: 'nav.blog' },
  { href: localePath(locale, '/contact'), labelKey: 'nav.contact' },
];

// 5 个产品分类的 tab 配置 (跟 products.astro 一致)
const productTabs = [
  { key: 'hats', href: categoryHubHref.hats, en: 'Cashmere Hats', cn: '羊绒帽子' },
  { key: 'sweaters', href: categoryHubHref.sweaters, en: 'Sweaters', cn: '羊绒衫' },
  { key: 'scarves', href: categoryHubHref.scarves, en: 'Scarves & Wraps', cn: '围巾披肩' },
  { key: 'accessories', href: categoryHubHref.accessories, en: 'Accessories', cn: '配饰' },
  { key: 'yarn', href: categoryHubHref.yarn, en: 'Yarn & Fiber', cn: '纱线' },
];

// 翻译文本
const labels: Record<string, Record<string, string>> = {
  en: {
    'nav.home': 'Home',
    'nav.hats': 'Hats',
    'nav.sweaters': 'Sweaters',
    'nav.scarves': 'Scarves',
    'nav.accessories': 'Accessories',
    'nav.yarn': 'Yarn', 'nav.products': 'Products', 'nav.rawMaterial': 'Raw Material',
    'nav.yarnFabric': 'Yarn & Fabric', 'nav.garmentOem': 'Garment OEM',
    'nav.ordosOrigin': 'Ordos Origin', 'nav.factory': 'Factory', 'nav.blog': 'Blog',
    'nav.contact': 'Contact', 'nav.menuToggle': 'Menu',
    'nav.viewAll': 'View All →', 'nav.byCategory': 'By Category',
  },
  de: {
    'nav.home': 'Start',
    'nav.hats': 'Hüte',
    'nav.sweaters': 'Pullover',
    'nav.scarves': 'Schals',
    'nav.accessories': 'Accessoires',
    'nav.yarn': 'Garn', 'nav.products': 'Produkte', 'nav.rawMaterial': 'Rohmaterial',
    'nav.yarnFabric': 'Garn & Stoff', 'nav.garmentOem': 'Bekleidung OEM',
    'nav.ordosOrigin': 'Ordos Herkunft', 'nav.factory': 'Fabrik', 'nav.blog': 'Blog',
    'nav.contact': 'Kontakt', 'nav.menuToggle': 'Menü',
    'nav.viewAll': 'Alle anzeigen →', 'nav.byCategory': 'Nach Kategorie',
  },
  fr: {
    'nav.home': 'Accueil',
    'nav.hats': 'Bonnets',
    'nav.sweaters': 'Pulls',
    'nav.scarves': 'Écharpes',
    'nav.accessories': 'Accessoires',
    'nav.yarn': 'Fil', 'nav.products': 'Produits', 'nav.rawMaterial': 'Matière Première',
    'nav.yarnFabric': 'Fil & Tissu', 'nav.garmentOem': 'Vêtement OEM',
    'nav.ordosOrigin': 'Origine Ordos', 'nav.factory': 'Usine', 'nav.blog': 'Blog',
    'nav.contact': 'Contact', 'nav.menuToggle': 'Menu',
    'nav.viewAll': 'Voir tout →', 'nav.byCategory': 'Par catégorie',
  },
  ja: {
    'nav.home': 'ホーム',
    'nav.hats': '帽子',
    'nav.sweaters': 'セーター',
    'nav.scarves': 'スカーフ',
    'nav.accessories': 'アクセサリー',
    'nav.yarn': '糸', 'nav.products': '製品', 'nav.rawMaterial': '原料',
    'nav.yarnFabric': '糸・生地', 'nav.garmentOem': '衣料OEM',
    'nav.ordosOrigin': 'オルドス起源', 'nav.factory': '工場', 'nav.blog': 'ブログ',
    'nav.contact': 'お問い合わせ', 'nav.menuToggle': 'メニュー',
    'nav.viewAll': 'すべて見る →', 'nav.byCategory': 'カテゴリ別',
  },
  kr: {
    'nav.home': '홈',
    'nav.hats': '모자',
    'nav.sweaters': '스웨터',
    'nav.scarves': '스카프',
    'nav.accessories': '액세서리',
    'nav.yarn': '실', 'nav.products': '제품', 'nav.rawMaterial': '원료',
    'nav.yarnFabric': '원사·직물', 'nav.garmentOem': '의류 OEM',
    'nav.ordosOrigin': '오르도스 원산지', 'nav.factory': '공장', 'nav.blog': '블로그',
    'nav.contact': '문의', 'nav.menuToggle': '메뉴',
    'nav.viewAll': '전체 보기 →', 'nav.byCategory': '카테고리별',
  },
  cn: {
    'nav.home': '首页',
    'nav.hats': '帽子',
    'nav.sweaters': '羊绒衫',
    'nav.scarves': '围巾披肩',
    'nav.accessories': '配饰',
    'nav.yarn': '纱线', 'nav.products': '产品', 'nav.rawMaterial': '羊绒原料',
    'nav.yarnFabric': '纱线/面料', 'nav.garmentOem': '成衣代工',
    'nav.ordosOrigin': '鄂尔多斯产地', 'nav.factory': '工厂实力', 'nav.blog': '博客',
    'nav.contact': '联系我们', 'nav.menuToggle': '菜单',
    'nav.viewAll': '查看全部 →', 'nav.byCategory': '按分类',
  },
};

const t = (key: string) => labels[locale]?.[key] || labels.en[key] || key;

// 链接高亮：忽略尾斜杠与查询串的差异
const normPath = (s: string) => s.split('?')[0].replace(/\/+$/, '');
const isActive = (href: string) => normPath(currentPath) === normPath(href);

// submenu helpers
const subLabel = (sub: any) => sub[locale] || sub.en || sub.cn;
const groupLabel = (groupKey: string, group: any) => {
  return group?.label?.[locale] || group?.label?.en || groupKey;
};
---

<header class="snowline-nav sticky top-0 z-40 w-full border-t-2 border-brand-red bg-background/95 backdrop-blur-sm relative">
  <div class="container-narrow flex h-16 lg:h-20 items-center justify-between lg:grid lg:grid-cols-3">
    <!-- 左侧留白 -->
    <div class="hidden lg:block"></div>
    <!-- Logo（桌面端居中） -->
    <a href={localePath(locale, '/')} class="flex items-baseline gap-2.5 group justify-self-center">
      <span class="font-display text-[1.85rem] font-normal tracking-[0.08em] text-primary transition-colors group-hover:text-brand-red">
        DONGXIAO<sup class="text-xs">®</sup>
      </span>
      <span class="hidden md:inline text-[0.65rem] text-muted-foreground tracking-[0.22em] uppercase">
        Cashmere · Ordos
      </span>
    </a>

    <!-- Mega Menu container (rendered once, content swapped by JS based on hovered nav item) -->
    {navItems.filter((i) => i.hasSubmenu).map((item) => (
      <div
        data-mega-panel={item.hasSubmenu}
        class="hidden lg:block absolute left-0 right-0 top-full w-full bg-white border-t border-border shadow-[0_18px_40px_-18px_rgba(28,24,19,0.12)] opacity-0 invisible pointer-events-none transition-all duration-300 ease-out z-50"
      >
        <div class="container-narrow py-12 grid grid-cols-[1fr_320px] gap-14">
          <!-- Left: 4 category groups -->
          <div class="grid grid-cols-4 gap-8">
            {Object.entries((submenusData as any)[item.hasSubmenu] || {})
              .filter(([k]) => k !== 'feature')
              .map(([groupKey, group]: [string, any]) => (
              <div class="space-y-4">
                <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary/80 border-b border-border/80 pb-2.5 mb-4">
                  {groupLabel(groupKey, group)}
                </h3>
                <ul class="space-y-2">
                  {group.items?.map((sub: any) => (
                    <li>
                      <a
                        href={`${item.filterHref || item.href}&${groupKey}=${sub.key}`}
                        rel="nofollow"
                        class="block text-[13px] text-muted-foreground hover:text-primary transition-colors py-1"
                      >
                        {subLabel(sub)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Right: featured card (Pura-style) -->
          {(() => {
            const feature = (submenusData as any)[item.hasSubmenu]?.feature;
            if (!feature) return null;
            return (
              <a href={feature.href?.[locale] || feature.href?.en || '#'} class="group/feature block relative overflow-hidden rounded-none bg-brand-cream">
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={feature.image}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover/feature:scale-105"
                  />
                </div>
                <div class="p-5 space-y-2">
                  <div class="text-[10px] uppercase tracking-[0.15em] text-muted-foreground font-medium">
                    {feature.eyebrow?.[locale] || feature.eyebrow?.en || ''}
                  </div>
                  <div class="font-display text-base text-foreground leading-snug">
                    {feature.title?.[locale] || feature.title?.en || ''}
                  </div>
                  <div class="text-sm text-primary font-medium inline-flex items-center gap-1.5 pt-1">
                    {feature.cta?.[locale] || feature.cta?.en || ''}
                  </div>
                </div>
              </a>
            );
          })()}
        </div>
      </div>
    ))}

    <!-- Right side -->
    <div class="flex items-center justify-end gap-3">
      <!-- Language Switcher -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.14em] text-muted-foreground hover:text-primary transition-colors"
          aria-label="Change language"
        >
          <span>{LOCALE_FLAGS[locale]}</span>
          <span class="uppercase">{locale}</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute right-0 top-full mt-2 w-48 rounded-none border border-border bg-popover shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
          {LOCALES.map((loc) => {
            // Strip the *current* locale prefix (if any) so localePath can
            // safely re-prefix with the target locale. Without this, paths
            // like /cn/products/hats-100 get re-prefixed to /de/cn/... 404 land.
            const stripped = currentPath.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';
            return (
              <a
                href={localePath(loc, stripped)}
                class:list={[
                  'flex items-center gap-2 px-4 py-2 text-sm hover:bg-accent transition-colors',
                  loc === locale ? 'bg-accent font-medium' : '',
                ]}
              >
                <span>{LOCALE_FLAGS[loc]}</span>
                <span>{LOCALE_NAMES[loc]}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Inquiry Cart (B2B RFQ list) -->
      <a
        href={localePath(locale, '/cart')}
        data-cart-link
        aria-label={({ cn: '询价清单', en: 'Inquiry List', de: 'Anfrageliste', fr: 'Liste de demandes', ja: '見積りリスト', kr: '문의 목록' } as Record<string, string>)[locale] || 'Inquiry List'}
        class="relative inline-flex items-center justify-center p-2 text-muted-foreground hover:text-primary transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <span
          data-cart-badge
          class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-primary text-primary-foreground text-[10px] font-bold inline-flex items-center justify-center hidden"
        >0</span>
      </a>

      <!-- CTA: Contact -->
      <a
        href={localePath(locale, '/contact')}
        class="snowline-nav-action hidden sm:inline-flex items-center justify-center border border-primary px-6 py-2.5 text-xs uppercase tracking-[0.18em] text-primary hover:border-brand-red hover:text-brand-red hover:bg-brand-red/[0.04] transition-colors duration-300"
      >
        {locale === 'cn' ? '立即询盘' : 'Request a Quote'}
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        class="lg:hidden p-2"
        aria-label={t('nav.menuToggle')}
        id="mobile-menu-toggle"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Desktop Nav（居中菜单栏） -->
  <div class="hidden lg:block border-t border-border/60">
    <nav class="container-narrow flex items-center justify-center gap-10 py-5 text-xs uppercase tracking-[0.18em]" id="desktop-nav">
      {navItems.map((item) => (
        <div class="relative group/item" data-mega-trigger={item.hasSubmenu || ''}>
          <a
            href={item.href}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 py-1 transition-colors hover:text-primary',
              isActive(item.href) ? 'text-primary is-active' : 'text-muted-foreground',
            ]}
          >
            {t(item.labelKey)}
            {item.hasSubmenu && (
              <svg class="w-3 h-3 transition-transform group-hover/item:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>
        </div>
      ))}
    </nav>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobile-menu" class="lg:hidden hidden border-t border-border bg-background">
    <div class="container-narrow py-4 space-y-1">
      {navItems.map((item) => (
        <div>
          <a
            href={item.href}
            class="block py-3 text-sm uppercase tracking-[0.12em] text-foreground hover:text-primary transition-colors"
          >
            {t(item.labelKey)}
          </a>
          {item.hasSubmenu === 'all' && (
            <div class="pl-4 space-y-1 mt-1 mb-2 border-l-2 border-border ml-2">
              {productTabs.map((tab) => (
                <div class="space-y-1">
                  <a
                    href={tab.href}
                    class="block text-xs font-medium text-muted-foreground hover:text-primary transition-colors py-1"
                  >
                    {locale === 'cn' ? tab.cn : tab.en}
                  </a>
                  {(submenusData as any)[tab.key]?.slice(0, 4).map((sub: any) => (
                    <a
                      href={`${tab.href}?submenu=${sub.key}`}
                      rel="nofollow"
                      class="block text-xs text-muted-foreground/80 hover:text-primary transition-colors py-0.5 pl-3"
                    >
                      · {subLabel(sub)}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  // 移动端菜单
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu.classList.add('hidden'));
  });

  // Pura-style mega menu: show panel matching the hovered nav item.
  // Single shared overlay prevents z-index/overflow pain from per-item positioning.
  (function () {
    const triggers = document.querySelectorAll('[data-mega-trigger]');
    const panels = document.querySelectorAll('[data-mega-panel]');
    if (!triggers.length || !panels.length) return;

    let activeKey = null;
    let hideTimer = null;

    function show(key) {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      if (key === activeKey) return;
      activeKey = key;
      panels.forEach((p) => {
        if (p.getAttribute('data-mega-panel') === key) {
          p.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
          p.classList.add('opacity-100', 'visible', 'pointer-events-auto');
        } else {
          p.classList.add('opacity-0', 'invisible', 'pointer-events-none');
          p.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
        }
      });
    }

    function scheduleHide() {
      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        activeKey = null;
        panels.forEach((p) => {
          p.classList.add('opacity-0', 'invisible', 'pointer-events-none');
          p.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
        });
      }, 120); // small grace period so cursor can move from trigger to panel
    }

    triggers.forEach((t) => {
      const key = t.getAttribute('data-mega-trigger');
      if (!key) return;
      t.addEventListener('mouseenter', () => show(key));
      t.addEventListener('mouseleave', scheduleHide);
    });

    panels.forEach((p) => {
      p.addEventListener('mouseenter', () => {
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      });
      p.addEventListener('mouseleave', scheduleHide);
    });

    // Touch / keyboard: tap-to-toggle for accessibility
    triggers.forEach((t) => {
      const a = t.querySelector('a');
      if (!a) return;
      a.addEventListener('click', (e) => {
        const key = t.getAttribute('data-mega-trigger');
        if (!key) return;
        // If panel for this key is hidden, prevent navigation and show it
        if (activeKey !== key) {
          e.preventDefault();
          show(key);
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeKey) scheduleHide();
    });
  })();

  // Inquiry cart badge — waits for the React island to expose window.dxCart.
  (function () {
    var badge = document.querySelector('[data-cart-badge]');
    if (!badge) return;
    function render() {
      if (!window.dxCart) return;
      var n = window.dxCart.count();
      if (n > 0) {
        badge.textContent = n > 99 ? '99+' : String(n);
        badge.classList.remove('hidden');
        badge.classList.add('inline-flex');
      } else {
        badge.classList.add('hidden');
        badge.classList.remove('inline-flex');
      }
    }
    render();
    window.addEventListener('dx-cart-ready', render);
    window.addEventListener('dx-cart-change', render);
    window.addEventListener('storage', function (e) {
      if (e.key === 'dx-inquiry-cart-v1') render();
    });
  })();

  // 滚动时隐藏/显示顶部导航（下滑隐藏，上滑显示）
  (function () {
    const header = document.querySelector('header.sticky');
    if (!header) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const menu = document.getElementById('mobile-menu');
    let lastY = window.scrollY;
    let ticking = false;
    const THRESHOLD = 80;
    function update() {
      const y = window.scrollY;
      const delta = y - lastY;
      lastY = y;
      const menuOpen = menu && !menu.classList.contains('hidden');
      const megaOpen = document.querySelector('[data-mega-panel].visible') !== null;
      if (y < THRESHOLD) {
        header.classList.remove('header-hidden');
      } else if (delta > 8 && !menuOpen && !megaOpen) {
        header.classList.add('header-hidden');
      } else if (delta < -8) {
        header.classList.remove('header-hidden');
      }
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }, { passive: true });
  })();
</script>

<style>
  /* EU/US B2B navigation: calm, legible, procurement-first. */
  .snowline-nav { border-top:0 !important; border-bottom:1px solid #d9dfda; background:rgba(255,255,253,.96); box-shadow:0 1px 0 rgba(27,39,37,.03); }
  .snowline-nav :global(.font-display) { font-family:"Cormorant Garamond", Georgia, serif; font-weight:600; letter-spacing:.09em; }
  .snowline-nav :global(#desktop-nav) { padding-top:.8rem; padding-bottom:.8rem; letter-spacing:.13em; }
  .snowline-nav :global(.nav-link) { position:relative; font-size:.69rem; }.snowline-nav :global(.nav-link)::after { content:""; position:absolute; left:0; right:0; bottom:-5px; height:1px; background:#254d45; transform:scaleX(0); transform-origin:left; transition:transform .18s ease-out; }.snowline-nav :global(.nav-link:hover)::after, .snowline-nav :global(.nav-link.is-active)::after { transform:scaleX(1); }
