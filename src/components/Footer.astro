---
/**
 * 底部 Footer - 6 国统一结构，本地化内容
 */
import { type Locale, localePath, LOCALES, LOCALE_NAMES, LOCALE_FLAGS } from '@/lib/i18n';
import { SITE_INFO } from '@/lib/seo';
import footerLabels from '@/data/footer-labels.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const fl = (k: string): string => {
  const m = (footerLabels as Record<string, Record<string, string>>)[locale];
  const raw = m?.[k] || (footerLabels as any).en[k] || '';
  return raw.replace('{year}', String(new Date().getFullYear()));
};

const productLinks = [
  { href: '/raw-material', labelKey: 'nav.rawMaterial' },
  { href: '/yarn-fabric', labelKey: 'nav.yarnFabric' },
  { href: '/garment-oem', labelKey: 'nav.garmentOem' },
];
const companyLinks = [
  { href: '/ordos-origin', labelKey: 'nav.ordosOrigin' },
  { href: '/factory', labelKey: 'nav.factory' },
  { href: '/blog', labelKey: 'nav.blog' },
  { href: '/contact', labelKey: 'nav.contact' },
];
const resourceLinks = [
  { href: '/payment-terms', labelKey: 'nav.paymentTerms' },
  { href: '/shipping-logistics', labelKey: 'nav.shippingLogistics' },
  { href: '/download', labelKey: 'nav.download' },
  { href: '/faq', labelKey: 'nav.faq' },
];
---

<footer class="border-t-2 border-brand-red bg-[#F8F5EF]/60 mt-20">
  <div class="container-narrow py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2">
        <div class="font-display text-xl font-medium text-primary mb-3">
          DONGXIAO<sup class="text-xs">®</sup> CASHMERE
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4 max-w-sm">
          {fl('footer.tagline')}
        </p>
        <div class="text-xs text-muted-foreground space-y-1">
          <div>{fl('footer.address')}</div>
          <div class="text-primary font-medium">{fl('footer.certifications')}</div>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h4 class="font-medium text-sm uppercase tracking-wider mb-4">{fl('footer.products')}</h4>
        <ul class="space-y-2 text-sm">
          {productLinks.map((l) => (
            <li>
              <a href={localePath(locale, l.href)} class="text-muted-foreground hover:text-primary transition-colors">
                {fl(l.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-medium text-sm uppercase tracking-wider mb-4">{fl('footer.company')}</h4>
        <ul class="space-y-2 text-sm">
          {companyLinks.map((l) => (
            <li>
              <a href={localePath(locale, l.href)} class="text-muted-foreground hover:text-primary transition-colors">
                {fl(l.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="font-medium text-sm uppercase tracking-wider mb-4">{fl('footer.resources')}</h4>
        <ul class="space-y-2 text-sm">
          {resourceLinks.map((l) => (
            <li>
              <a href={localePath(locale, l.href)} class="text-muted-foreground hover:text-primary transition-colors">
                {fl(l.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-medium text-sm uppercase tracking-wider mb-4">{fl('footer.contact')}</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href={`https://wa.me/${SITE_INFO.whatsapp.replace(/[^\d]/g, '')}`} class="hover:text-primary transition-colors">
              WhatsApp: {SITE_INFO.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE_INFO.email}`} class="hover:text-primary transition-colors">
              {SITE_INFO.email}
            </a>
          </li>
          <li>
            WeChat: {SITE_INFO.wechatId}
          </li>
          <li class="pt-3">
            <div class="flex items-center gap-3">
              <a href={SITE_INFO.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-muted-foreground hover:text-primary transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
              <a href={SITE_INFO.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-muted-foreground hover:text-primary transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/></svg></a>
              <a href={SITE_INFO.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-muted-foreground hover:text-primary transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.09 24 18.1 24 12.07z"/></svg></a>
              <a href={SITE_INFO.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="text-muted-foreground hover:text-primary transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg></a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Languages -->
    <div class="flex flex-wrap gap-3 pb-6 border-b border-border">
      <span class="text-xs uppercase tracking-wider text-muted-foreground">Languages:</span>
      {LOCALES.map((loc) => {
        const strippedPath = Astro.url.pathname.replace(/^\/[a-z]{2,3}/, '') || '/';
        return (
          <a
            href={localePath(loc, strippedPath)}
            class:list={[
              'text-xs flex items-center gap-1 hover:text-primary transition-colors',
              loc === locale ? 'text-primary font-medium' : 'text-muted-foreground',
            ]}
          >
            {LOCALE_FLAGS[loc]} {LOCALE_NAMES[loc]}
          </a>
        );
      })}
    </div>

    <!-- Bottom -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-muted-foreground">
      <div>{fl('footer.copyright')}</div>
      <div class="flex flex-wrap gap-4">
        <a href={localePath(locale, '/privacy-policy')} class="hover:text-primary transition-colors">{fl('footer.privacy')}</a>
        <button type="button" onclick="window.__HERMES_OPEN_COOKIE__?.()" class="hover:text-primary transition-colors cursor-pointer">{fl('footer.cookie')}</button>
        <a href="/sitemap-index.xml" class="hover:text-primary transition-colors">{fl('footer.sitemap')}</a>
      </div>
    </div>
  </div>
</footer>
