  <section class="py-16 md:py-20 bg-background">
    <div class="container-narrow">
      <h2 class="font-display text-3xl font-light mb-8">{t.catalog} — {products.length} {locale === 'cn' ? '条产品记录' : 'product records'}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {products.map((p) => (
          <a
            href={`/${locale}/products/${p.id}/`}
            class="group block border border-border rounded-lg overflow-hidden hover:border-primary transition-colors"
          >
            <div class="aspect-square bg-secondary/30 overflow-hidden">
              <img
                src={resolveCategoryCardImage(p.images[0])}
                alt={p.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                loading="lazy"
              />
            </div>
            <div class="p-3">
              <h3 class="text-xs font-medium leading-snug line-clamp-2 mb-1">{p.name}</h3>
              <p class="text-[10px] text-muted-foreground">{locale === 'cn' ? '项目条件书面确认' : 'Project details confirmed in writing'}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- Compare Categories — 类目页交叉链接 (5 cats × 6 langs = 30 URLs, internal link equity + browse-path to sibling categories) -->
  {crossLinks.length > 0 && (
    <section class="py-14 md:py-20 bg-background border-t border-border">
      <div class="container-narrow">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">
            {locale === 'cn' ? '类目对比' : 'Compare Categories'}
          </span>
        </div>
        <h2 class="font-serif text-3xl md:text-4xl font-light mb-3 leading-tight">
          {locale === 'cn' ? '探索其他羊绒品类' : 'Explore Other Cashmere Categories'}
        </h2>
        <p class="text-sm md:text-base text-muted-foreground mb-10 max-w-2xl">
          {locale === 'cn'
            ? '按产品类型、款式与已列属性比较相邻品类；所选项目的适用条件以书面沟通确认。'
            : 'Compare adjacent categories by product type, style and listed attributes; applicable details are confirmed in writing for the selected project.'}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          {crossLinks.map((cl) => (
            <a href={`/${locale}/products/${cl.slug}/`} class="group block border border-border bg-white p-6 hover:border-brand-gold hover:shadow-lg transition-colors transition-shadow duration-300">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] tracking-[0.2em] uppercase text-brand-camel font-mono">
                  {locale === 'cn' ? '分类目录' : 'CATEGORY CATALOG'}
                </span>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-brand-chocolate group-hover:translate-x-1 transition-colors transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
              <h3 class="font-serif text-xl mb-2 group-hover:text-brand-chocolate transition-colors leading-tight">
                {cl.name[locale] || cl.name.en}
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">{locale === 'cn' ? '查看该品类的产品记录、款式属性和已列规格信息。' : 'Explore the product records, style attributes and listed specifications in this category.'}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}


  <section class="py-16 md:py-20 bg-[#F8F5EF] border-y border-border/60">
    <div class="container-narrow">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-8 bg-brand-red"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '选购指南' : 'Buying Guides'}</span>
      </div>
      </div>
      <h2 class="font-serif text-3xl md:text-4xl font-light mb-8">{locale === 'cn' ? '相关指南' : 'Related Guides'}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {guides.map((g) => (
          <a href={g.href} class="group block border border-border bg-white p-6 hover:border-brand-camel transition-colors">
            <h3 class="font-serif text-xl mb-2 group-hover:text-brand-camel transition-colors">{locale === 'cn' ? g.cn : g.en}</h3>
            <span class="text-sm text-muted-foreground group-hover:text-primary transition-colors inline-flex items-center gap-1">
              {locale === 'cn' ? '阅读指南 →' : 'Read guide →'}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-background">
    <div class="container-narrow">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-8 bg-brand-red"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">
          {procurement.eyebrow}
        </span>
      </div>
      <h2 class="font-serif text-3xl md:text-4xl font-light mb-3">
        {procurement.title}
      </h2>
      <p class="text-sm text-muted-foreground mb-12 max-w-3xl leading-relaxed">
        {procurement.intro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {procurement.steps.map((step, index) => (
          <article class="border border-border bg-white p-6 flex flex-col">
            <span class="text-xs tracking-[0.2em] text-brand-camel font-mono mb-5">0{index + 1}</span>
            <h3 class="font-serif text-xl mb-3">{step.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground mb-6">{step.text}</p>
            <a href={step.href} class="mt-auto text-sm text-brand-chocolate underline underline-offset-4 hover:text-brand-gold transition-colors">{step.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- From the Journal — 类目页 SEO 内链 + 选购洞察 (5 类目 × 6 语言 = 30 个 URL 多内链) -->
  {latestBlogPosts.length > 0 && (
    <section class="py-16 md:py-20 bg-background border-t border-border">
      <div class="container-narrow">
        <div class="flex items-end justify-between mb-10 gap-6 flex-wrap">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="h-[2px] w-10 bg-brand-red"></span>
              <span class="text-xs tracking-[0.3em] text-brand-gold uppercase font-medium">
                {locale === 'cn' ? '选购洞察' : 'From the Journal'}
              </span>
            </div>
            <h2 class="font-serif text-3xl md:text-4xl font-light leading-tight">
              {locale === 'cn'
                ? `${t.h1.replace(/批发$/, '')} — 选购博客`
                : `${category.name} — Buying Insights`}
            </h2>
          </div>
          <a href={`/${locale}/blog/`} class="text-sm text-brand-chocolate border-b border-brand-chocolate hover:border-brand-gold hover:text-brand-gold transition-colors">
            {locale === 'cn' ? '查看全部博客 →' : 'View all articles →'}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestBlogPosts.map((p) => (
            <a href={`/${locale}/blog/${p.slug}/`} class="group block border border-border bg-white overflow-hidden hover:border-brand-gold hover:shadow-lg transition-colors transition-shadow duration-300">
              <div class="aspect-[16/10] bg-gradient-to-br from-brand-cream via-[#F8F5EF] to-[#E8DFD0]"></div>
              <div class="p-6">
                <div class="text-xs text-muted-foreground tracking-wider mb-3 font-mono">{p.date}</div>
                <h3 class="font-serif text-lg mb-3 group-hover:text-brand-chocolate transition-colors leading-tight line-clamp-2">{p.title}</h3>
                <p class="text-muted-foreground leading-relaxed mb-4 text-sm line-clamp-3">{p.excerpt}</p>
                <span class="inline-flex items-center gap-1 text-sm text-brand-chocolate font-medium">
                  {locale === 'cn' ? '阅读文章' : 'Read article'}
                  <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}


  <SEOFaq faqs={t.faqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-[#F5F0E7] border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">{locale === 'cn' ? `为 ${category.name} 准备采购需求` : `Prepare a sourcing brief for ${category.name}`}</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">{locale === 'cn' ? '请提供目标数量、规格方向、目的地和资料需求；适用报价、贸易术语、交付与文件范围将按具体项目书面确认。' : 'Share the target quantity, specification direction, destination and documentation needs; applicable pricing, trade terms, delivery and document scope are confirmed in writing for the project.'}</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">Request a Quote</a>
        <a href={`/${locale}/download/`} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-[#F7F3EC]">Download Catalog</a>
        <a href={`/${locale}/products/`} class="inline-block px-8 py-3 text-brand-ink/70 rounded-none uppercase tracking-[0.15em] hover:text-brand-chocolate">View All Products</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>

<style is:global>
  /* Classification hubs must remain readable even when surrounding themes or
     cached CSS alter brand utility colors. */
  .category-hub-hero {
    background-color: #1C1813 !important;
    color: #F7F3EC !important;
  }
  .category-hub-hero h1,
  .category-hub-hero p,
  .category-hub-hero li,
  .category-hub-hero li span:not(:first-child) {
    color: #F7F3EC !important;
  }
  .category-hub-hero li span:first-child {
    color: #D8B787 !important;
  }
</style>
