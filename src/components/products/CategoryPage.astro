// Build page-specific schema.org ItemList of all products in this category
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.h1,
  description: t.description,
  numberOfItems: products.length,
  itemListElement: products.slice(0, 20).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `${SITE_URL}/${locale}/products/${p.id}`,
  })),
};

// Category-aware journal links distribute internal equity to buying articles
// that match the category, instead of sending every hub to the same newest posts.
const allBlogPosts = await getCollection('blog', ({ id }) => id.startsWith(`${locale}/`));
const categoryBlogKeywords: Record<string, string[]> = {
  hats: ['hat', 'beanie', 'headwear', 'cashmere grade', 'color'],
  scarves: ['scarf', 'wrap', 'shawl', 'cashmere grade', 'color'],
  sweaters: ['sweater', 'knitwear', 'oem', 'private label', 'yarn count'],
  accessories: ['accessor', 'glove', 'sock', 'legging', 'color', 'cashmere grade'],
  yarn: ['yarn', 'fiber', 'micron', 'count', 'dehaired', 'raw cashmere'],
};
const categoryTerms = categoryBlogKeywords[catId] || [];
const relevantBlogPosts = allBlogPosts
  .map((post) => {
    const searchable = [post.id, post.data.title, post.data.excerpt, ...(post.data.tags || []), post.data.sourceTopic || '']
      .join(' ')
      .toLowerCase();
    const score = categoryTerms.reduce((total, term) => total + (searchable.includes(term) ? 1 : 0), 0);
    return { post, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime());
const latestBlogPosts = relevantBlogPosts
  .slice(0, 3)
  .map(({ post: p }) => ({
    slug: p.id.replace(`${locale}/`, '').replace(/\.md$/, ''),
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.publishDate.toISOString().slice(0, 10),
  }));
