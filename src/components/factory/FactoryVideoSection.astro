// 默认 fallback (locale 不匹配时用 EN)
// 注: 用 string 而非 keyof, 因为 6 语言 object 的 keyof 在 index signature 下推断为 string
const T = (key: string): string => {
  const dict = (t as Record<string, Record<string, string>>)[locale];
  return (dict && dict[key]) || t.en[key];
};

const videoSrc = '/videos/factory-floor.mp4';
---

<section class="factory-video-section py-20 md:py-28 bg-brand-cream relative overflow-hidden" aria-labelledby="factory-video-heading">
  <!-- 装饰纤维轨迹: 跟首页 hero 的轨迹设计呼应,保持视觉一致 -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <defs>
        <pattern id="factory-video-fibers" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M0 30 Q15 22, 30 30 T60 30" stroke="#1C1813" stroke-width="0.5" fill="none" />
          <path d="M0 38 Q15 30, 30 38 T60 38" stroke="#1C1813" stroke-width="0.5" fill="none" />
          <path d="M0 22 Q15 14, 30 22 T60 22" stroke="#1C1813" stroke-width="0.5" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#factory-video-fibers)" />
    </svg>
  </div>

  <div class="container-narrow relative z-10">
    <!-- 头部文案 -->
    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-[2px] w-8 bg-brand-cocoa"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-cocoa font-bold">{T('eyebrow')}</span>
        <span class="h-[2px] w-8 bg-brand-cocoa"></span>
      </div>
      <h2 id="factory-video-heading" class="font-serif text-4xl md:text-5xl font-light mb-4 text-balance text-brand-ink leading-tight">
        {T('title')}
      </h2>
      <p class="text-muted-foreground max-w-2xl mx-auto text-base md:text-lg leading-relaxed">
        {T('subtitle')}
      </p>
    </div>

    <!-- 视频框架: 9:16 竖屏镜头在桌面两侧留白;手机全宽 -->
    <!-- 用 aspect-ratio 让高度自适应;max-w 控制桌面最大宽度 -->
    <div class="flex justify-center mb-6">
      <div class="relative w-full max-w-[420px] mx-auto factory-video-frame">
        <div class="relative overflow-hidden bg-brand-ink shadow-[0_24px_64px_-24px_rgba(45,40,36,0.45)] ring-1 ring-brand-cocoa/15">
          <!-- 视频主体 (竖屏 9:16) -->
          <div class="relative w-full" style="aspect-ratio: 9 / 16;">
            <video
              id="factory-walkthrough"
              class="absolute inset-0 w-full h-full object-cover bg-brand-ink"
              controls
              preload="metadata"
              playsinline
              aria-label={T('playLabel')}
            >
              <source src={videoSrc} type="video/mp4" />
            </video>
            <!-- 自定义播放按钮: 浮于视频正中,播放后自动隐藏 -->
            <button
              type="button"
              class="factory-video-play-overlay absolute inset-0 flex items-center justify-center bg-brand-ink/35 text-white transition-opacity duration-500 group-hover:opacity-90 hover:bg-brand-ink/45 focus:outline-none focus:ring-4 focus:ring-brand-cocoa/40"
              aria-label={T('playLabel')}
              data-play-target="factory-walkthrough"
            >
              <span class="relative flex items-center justify-center">
                <span class="absolute inset-0 rounded-full animate-ping bg-white/30"></span>
                <span class="relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/95 backdrop-blur-sm shadow-[0_8px_28px_rgba(0,0,0,0.35)] group-hover:bg-white transition-all">
                  <svg class="w-8 h-8 md:w-10 md:h-10 ml-1 text-brand-cocoa" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>
            </button>
          </div>
        </div>
        <!-- 装饰金线边 (匹配 hero 的品牌铜色) -->
        <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-3/4 h-[2px] bg-gradient-to-r from-transparent via-brand-cocoa/55 to-transparent" aria-hidden="true"></div>
      </div>
    </div>

    <!-- 视频下文字 -->
    <div class="text-center mb-8 max-w-2xl mx-auto">
      <p class="text-xs tracking-[0.18em] uppercase text-muted-foreground font-mono">
        <span aria-hidden="true">●</span>
        <span class="ml-2">{T('duration')}</span>
        <span aria-hidden="true" class="mx-3">·</span>
        <span>{T('caption')}</span>
      </p>
    </div>

    <!-- 双 CTA: 跟工厂页第七节同流向 (Schedule visit + Download catalog) -->
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={T('primaryCtaHref')}
        class="inline-flex items-center gap-2 px-10 py-5 bg-brand-cocoa hover:bg-brand-cocoa-dark text-white text-sm font-semibold uppercase tracking-[0.16em] transition-colors duration-200"
      >
        {T('primaryCta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={T('secondaryCtaHref')}
        class="inline-flex items-center gap-2 border border-brand-cocoa text-brand-cocoa hover:bg-brand-cocoa hover:text-white px-10 py-5 text-sm uppercase tracking-[0.16em] font-semibold transition-colors duration-200"
      >
        {T('secondaryCta')}
      </a>
    </div>
  </div>
</section>

<!-- 微 JS: 播放按钮点击触发 video.play(),播放后隐藏按钮;视频离开视口时暂停 -->
<script>
  (function () {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-play-target]');
    buttons.forEach((btn) => {
      const targetId = btn.getAttribute('data-play-target');
      if (!targetId) return;
      const video = document.getElementById(targetId) as HTMLVideoElement | null;
      if (!video) return;
      btn.addEventListener('click', () => {
        video.play().catch(() => {
          // autoplay may fail (e.g., muted policy); user can use native controls
        });
        btn.style.opacity = '0';
        btn.style.pointerEvents = 'none';
        setTimeout(() => btn.remove(), 600);
      });
    });

    // 离屏时暂停: 避免看不见的视频继续下载
    const videos = document.querySelectorAll<HTMLVideoElement>('video[id="factory-walkthrough"]');
    if (videos.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const v = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              // 用户进入视野时不要自动播放 (避免一进页面就开始)
              // 保持静音自动播放留给浏览器原生 controls
            } else {
              if (!v.paused) v.pause();
            }
          });
        },
        { threshold: 0.25 }
      );
      videos.forEach((v) => io.observe(v));
    }
  })();
</script>

<style>
  .factory-video-frame { container-type: inline-size; }
  /* 当用户开始 hover 时,播放按钮更明显 */
  .factory-video-frame:hover .factory-video-play-overlay { background-color: rgba(28, 24, 19, 0.42); }
  /* prefers-reduced-motion: 取消 ping 动画,避免分散注意力 */
  @media (prefers-reduced-motion: reduce) {
    .factory-video-play-overlay span:first-child { animation: none; }
  }
</style>