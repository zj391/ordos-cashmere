  },
  fr: {
    eyebrow: 'Sur le terrain',
    title: "90 secondes dans notre usine d'Ordos",
    subtitle:
      "Dehairing, filage, tricotage, finition. La même ligne que traverse votre commande en gros.",
    duration: '1 min 30 sec',
    primaryCta: 'Planifier une visite',
    primaryCtaHref: '/fr/contact/?type=visit',
    secondaryCta: 'Télécharger le catalogue',
    secondaryCtaHref: '/fr/download/',
    watchCta: 'Voir la vidéo',
    caption: 'Ordos, Mongolie-Intérieure — Dehairing → Filage → Tricotage → Finition',
