---
/**
 * FactoryVideoSection
 *
 * Click-to-play modal pattern (replaces the previous inline `<video>`).
 *
 * Why modal (not inline):
 *   - The 9:16 portrait footage would render as a tall 420-px column on
 *     a 1440-px desktop viewport, which looked out of place against the
 *     magazine editorial chrome the rest of the site uses
 *   - Desktop B2B buyers are used to a thumbnail + play button that
 *     pops a dialog; the inline player required a deliberate decision to
 *     play and stole vertical real estate from the editorial layout
 *   - The thumbnail card stays a fixed height (250px) so it integrates
 *     with the existing factory page rhythm between section 06 (service
 *     buckets) and section 07 (visit CTA)
 *   - A native `<dialog>` element gives us focus trap + Escape-to-close
 *     for free; no modal library needed
 *
 * Layout (top to bottom):
 *   - Section heading (eyebrow / title / subtitle) — same as before
 *   - Thumbnail card with poster image + circular play button — 16:9
 *     container so the 720x1280 poster letterboxes into a horizontal
 *     frame (less weird than the 9:16 column that was there before)
 *   - Caption (duration + line caption) — same as before
 *   - Pair of CTA buttons (Schedule visit + Download catalog)
 *   - Below them: a "Watch factory video" tertiary button that opens
 *     the modal — this is the user-facing affordance
 *
 * Modal contents:
 *   - Native <dialog> with backdrop
 *   - Video element with the same `controls` + poster
 *   - Close button (X) top-right of the dialog
 *   - Escape key closes; click on backdrop closes
 *   - Closing the dialog pauses the video so the next open starts fresh
 *
 * Accessibility:
 *   - `aria-haspopup="dialog"` on the trigger button
 *   - `aria-label` on the dialog itself (read by screen readers when it
 *     opens) and on the close button
 *   - Focus is moved into the dialog on open and restored to the
 *     trigger button on close (browser-native for <dialog> in modern
 *     browsers; we add a small polyfill for Safari < 15.4)
 */
export interface Props {
  locale: string;
}

const { locale } = Astro.props;

const t: Record<string, Record<string, string>> = {
  en: {
    eyebrow: 'On the floor',
