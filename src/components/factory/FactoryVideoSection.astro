    posterAlt: 'In der Ordos-Kaschmirfabrik — Dehairing-Linie vorn, Strickmaschinen hinten.',
    playLabel: 'Werkstattrundgang abspielen',
  },
  fr: {
    eyebrow: 'Sur le terrain',
    title: "90 secondes dans notre usine d'Ordos",
    subtitle: 'Dehairing, filage, tricotage, finition — la même ligne que traverse votre commande en gros.',
    duration: '1 min 30 sec',
    primaryCta: 'Planifier une visite',
    primaryCtaHref: '/fr/contact/?type=visit',
    secondaryCta: 'Télécharger le catalogue',
    secondaryCtaHref: '/fr/download/',
    caption: 'Ordos, Mongolie-Intérieure — Dehairing → Filage → Tricotage → Finition',
    posterAlt: "À l'intérieur de l'usine de cachemire d'Ordos — ligne de dehairing devant, métiers à tricoter derrière.",
    playLabel: "Lire la visite d'usine",
  },
  ja: {
    eyebrow: '現場より',
    title: '90秒で鄂爾多ス工場を見る',
