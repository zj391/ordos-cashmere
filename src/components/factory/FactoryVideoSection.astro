    watchCta: 'Watch factory video',
    caption: 'Ordos, Inner Mongolia — dehairing → spinning → knitting → finishing',
    posterAlt: 'Inside the Ordos cashmere facility — dehairing line at the front, knitting frames at the back.',
    dialogLabel: 'Factory walkthrough video',
    closeLabel: 'Close video',
  },
  cn: {
    eyebrow: '车间现场',
    title: '90 秒看完鄂尔多斯工厂',
    subtitle: '从分梳、纺纱、针织到整理——你的大货走的也是这条线。',
    duration: '1 分 30 秒',
    primaryCta: '预约参观',
    primaryCtaHref: '/cn/contact/?type=visit',
    secondaryCta: '下载目录',
    secondaryCtaHref: '/cn/download/',
