---
/**
 * FactoryVideoSection
 *
 * 90-second Ordos factory floor walkthrough. Plays inline (not in a modal) so
 * desktop B2B buyers see the workshop before they click a CTA. The two buttons
 * below the video still pivot to the existing /contact?type=visit and
 * /download flows so the section funnels into the same downstream actions.
 *
 * Why inline (not modal):
 *   - 11.7 MB MP4 won't blow up the page when lazy-loaded
 *   - Visitors who reached the factory page want to see the floor; not
 *     hunt for a play icon
 *   - Modal covers the editorial chrome (fibermark SVG, decorative ring)
 *     that we paid real design cost to put there
 *   - Auto-pause when offscreen (IntersectionObserver) is more reliable
 *     than modal close handlers on mobile back gestures
 *   - 576x1024 portrait footage scales down gracefully on a phone
 *     viewport and centers on a desktop viewport without modal chrome
 */
type Props = {
  locale: string;
};

const { locale } = Astro.props;

