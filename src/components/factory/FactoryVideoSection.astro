    caption: '内蒙古鄂尔多斯 — 分梳 → 纺纱 → 针织 → 整理',
    posterAlt: '鄂尔多斯羊绒工厂内部 — 前方是分梳线,后方是针织车间。',
    dialogLabel: '工厂实拍视频',
    closeLabel: '关闭视频',
  },
  de: {
    eyebrow: 'In der Werkstatt',
    title: '90 Sekunden in unserer Ordos-Fabrik',
    subtitle:
      'Dehairing, Spinnen, Stricken, Finishen. Die gleiche Linie, die Ihre Großbestellung durchläuft.',
    duration: '1 Min 30 Sek',
    primaryCta: 'Besuch planen',
    primaryCtaHref: '/de/contact/?type=visit',
    secondaryCta: 'Katalog herunterladen',
    secondaryCtaHref: '/de/download/',
    watchCta: 'Video ansehen',
    caption: 'Ordos, Innere Mongolei — Dehairing → Spinnen → Stricken → Finishen',
    posterAlt: 'In der Ordos-Kaschmirfabrik — Dehairing-Linie vorn, Strickmaschinen hinten.',
    dialogLabel: 'Werkstattrundgang-Video',
