const T = (key: string): string => {
  const dict = (t as Record<string, Record<string, string>>)[locale];
  return (dict && dict[key]) || t.en[key];
};

const videoSrc = '/videos/factory-floor.mp4';
const posterSrc = '/images/factory/factory-floor-poster.webp';
const dialogId = `factory-video-dialog-${Math.random().toString(36).slice(2, 8)}`;
const triggerId = `factory-video-trigger-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="factory-video-section py-20 md:py-28 bg-brand-cream relative overflow-hidden" aria-labelledby="factory-video-heading">
  <!-- 装饰纤维轨迹: 跟首页 hero 的轨迹设计呼应,保持视觉一致 -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <defs>
        <pattern id="factory-video-fibers" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M0 30 Q15 22, 30 30 T60 30" stroke="#1C1813" stroke-width="0.5" fill="none" />
          <path d="M0 38 Q15 30, 30 38 T60 38" stroke="#1C1813" stroke-width="0.5" fill="none" />
          <path d="M0 22 Q15 14, 30 22 T60 22" stroke="#1C1813" stroke-width="0.5" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#factory-video-fibers)" />
    </svg>
  </div>

  <div class="container-narrow relative z-10">
    <!-- 头部文案 -->
    <div class="text-center mb-10 reveal">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-[2px] w-8 bg-brand-cocoa"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-cocoa font-bold">{T('eyebrow')}</span>
        <span class="h-[2px] w-8 bg-brand-cocoa"></span>
      </div>
      <h2 id="factory-video-heading" class="font-serif text-4xl md:text-5xl font-light mb-4 text-balance text-brand-ink leading-tight">
        {T('title')}
      </h2>
      <p class="text-muted-foreground max-w-2xl mx-auto text-base md:text-lg leading-relaxed">
        {T('subtitle')}
      </p>
    </div>

    <!-- 视频缩略卡: 16:9 letterbox + 播放按钮 + decorative 边框 -->
    <div class="flex justify-center mb-6">
      <div class="relative w-full max-w-[640px] mx-auto">
        <button
          type="button"
          id={triggerId}
          data-video-trigger={dialogId}
          aria-haspopup="dialog"
          aria-label={T('watchCta')}
          class="group relative w-full block overflow-hidden bg-brand-ink shadow-[0_24px_64px_-24px_rgba(45,40,36,0.45)] ring-1 ring-brand-cocoa/15 focus:outline-none focus:ring-4 focus:ring-brand-cocoa/40 transition-shadow"
        >
          <!-- 16:9 letterbox: 720x1280 poster 上下黑边 -->
          <div class="relative w-full" style="aspect-ratio: 16 / 9;">
            <img
              src={posterSrc}
              alt={T('posterAlt')}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <!-- 自定义播放按钮: 浮于视频正中 -->
            <span class="absolute inset-0 flex items-center justify-center bg-brand-ink/35 text-white transition-opacity duration-300 group-hover:bg-brand-ink/45" aria-hidden="true">
              <span class="relative flex items-center justify-center">
                <span class="absolute inset-0 rounded-full animate-ping bg-white/30"></span>
                <span class="relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/95 backdrop-blur-sm shadow-[0_8px_28px_rgba(0,0,0,0.35)] group-hover:bg-white transition-all">
                  <svg class="w-8 h-8 md:w-10 md:h-10 ml-1 text-brand-cocoa" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>
            </span>
            <!-- 时长 chip 在右下角 (类似 YouTube 缩略卡) -->
            <span class="absolute bottom-3 right-3 px-2 py-1 bg-brand-ink/85 text-white text-xs font-mono tracking-wide">
              {T('duration')}
            </span>
          </div>
          <!-- 装饰金线边 (匹配 hero 的品牌铜色) -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-3/4 h-[2px] bg-gradient-to-r from-transparent via-brand-cocoa/55 to-transparent" aria-hidden="true"></div>
        </button>
      </div>
    </div>

    <!-- 视频下文字 -->
    <div class="text-center mb-8 max-w-2xl mx-auto">
      <p class="text-xs tracking-[0.18em] uppercase text-muted-foreground font-mono">
        <span aria-hidden="true">●</span>
        <span class="ml-2">{T('duration')}</span>
        <span aria-hidden="true" class="mx-3">·</span>
        <span>{T('caption')}</span>
      </p>
    </div>

    <!-- 主 CTA: Schedule visit + Download catalog (与第 7 节同流向) -->
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={T('primaryCtaHref')}
        class="inline-flex items-center gap-2 px-10 py-5 bg-brand-cocoa hover:bg-brand-cocoa-dark text-white text-sm font-semibold uppercase tracking-[0.16em] transition-colors duration-200"
      >
        {T('primaryCta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={T('secondaryCtaHref')}
        class="inline-flex items-center gap-2 border border-brand-cocoa text-brand-cocoa hover:bg-brand-cocoa hover:text-white px-10 py-5 text-sm uppercase tracking-[0.16em] font-semibold transition-colors duration-200"
      >
        {T('secondaryCta')}
      </a>
    </div>

    <!-- Tertiary 视频按钮: 直接触发 modal, 主 CTA 用户已能注意, 这个给深入用户 -->
    <div class="text-center mt-8">
      <button
        type="button"
        data-video-trigger={dialogId}
        class="inline-flex items-center gap-2 text-brand-cocoa text-sm uppercase tracking-[0.2em] border-b border-brand-cocoa/40 pb-1 hover:border-brand-cocoa hover:text-brand-cocoa-dark transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        {T('watchCta')}
      </button>
    </div>
  </div>

  <!-- 模态: native <dialog> 自动 focus trap + escape key + backdrop click -->
  <dialog
    id={dialogId}
    aria-label={T('dialogLabel')}
    class="factory-video-dialog fixed inset-0 m-auto w-full max-w-[420px] md:max-w-[480px] max-h-[90vh] bg-brand-ink p-0 rounded-none backdrop:bg-brand-ink/85 backdrop:backdrop-blur-sm open:animate-[fadeIn_.25s_ease-out]"
  >
    <div class="relative w-full h-full">
      <!-- 关闭按钮 -->
      <button
        type="button"
        data-video-close
        aria-label={T('closeLabel')}
        class="absolute -top-12 right-0 md:top-3 md:right-3 z-10 w-10 h-10 flex items-center justify-center bg-white/10 hover:bg-white/20 text-white transition-colors rounded-full focus:outline-none focus:ring-4 focus:ring-white/40"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <video
        data-video-player
        controls
        preload="metadata"
        playsinline
        poster={posterSrc}
        class="block w-full max-h-[90vh] bg-black"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>
  </dialog>
</section>

<script>
  (function () {
    const triggers = document.querySelectorAll<HTMLElement>('[data-video-trigger]');
    const dialogs = document.querySelectorAll<HTMLDialogElement>('dialog[data-video-trigger], dialog[id^="factory-video-dialog-"]');
    const closes = document.querySelectorAll<HTMLElement>('[data-video-close]');

    // 触发: open dialog
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const dialogId = trigger.getAttribute('data-video-trigger');
        if (!dialogId) return;
        const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
        if (!dialog || !dialog.showModal) return;
        // 用 showModal() 拿到 backdrop + focus trap
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
        // 自动开始播放
        const video = dialog.querySelector<HTMLVideoElement>('[data-video-player]');
        if (video) {
          video.currentTime = 0;
          video.play().catch(() => {
            // autoplay may be blocked; user can use native controls
          });
        }
      });
    });

    // 关闭: 关 dialog + pause video
    const closeDialog = (dialog: HTMLDialogElement) => {
      const video = dialog.querySelector<HTMLVideoElement>('[data-video-player]');
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    };

    // 关闭按钮
    closes.forEach((closeBtn) => {
      closeBtn.addEventListener('click', () => {
        const dialog = closeBtn.closest('dialog');
        if (dialog) closeDialog(dialog as HTMLDialogElement);
      });
    });

    // backdrop click: 点击 dialog 自身 (非内部) 关闭
    dialogs.forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        // click target 是 dialog 自身 (而非内部 video / button) 时关闭
        if (e.target === dialog) {
          closeDialog(dialog as HTMLDialogElement);
        }
      });
    });

    // Escape key: native <dialog> 默认行为已关闭, 但我们额外确保 pause
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openDialog = document.querySelector<HTMLDialogElement>('dialog[open]');
        if (openDialog) {
          const video = openDialog.querySelector<HTMLVideoElement>('[data-video-player]');
          if (video) {
            video.pause();
            video.currentTime = 0;
          }
        }
      }
    });
  })();
</script>

<style>
  /* native dialog 视觉调整 */
  .factory-video-dialog {
    border: none;
    background: transparent;
  }
  .factory-video-dialog::backdrop {
    background-color: rgba(28, 24, 19, 0.85);
    backdrop-filter: blur(4px);
  }
  /* fade-in 动画 */
  @keyframes factoryVideoFadeIn {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  .factory-video-dialog[open] {
    animation: factoryVideoFadeIn 0.25s ease-out;
  }
  /* prefers-reduced-motion 关闭动画 */
  @media (prefers-reduced-motion: reduce) {
    .factory-video-dialog[open] { animation: none; }
    .animate-ping { animation: none; }
  }
</style>