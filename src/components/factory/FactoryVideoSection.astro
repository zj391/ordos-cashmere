    watchCta: '動画を見る',
    caption: '内モンゴル・鄂爾多ス — 分梳 → 紡績 → ニット → 仕上げ',
    posterAlt: '鄂爾多ス・カシミア工場内部 — 手前は分梳ライン、奥はニット機。',
    dialogLabel: '工場見学動画',
    closeLabel: '動画を閉じる',
  },
  kr: {
    eyebrow: '공장 현장',
    title: '90초만에 보는 어얼도스 공장',
    subtitle:
      '분梳·방적·편직·마감 — 대량 주문이 지나가는 그 동일한 라인을 보여드립니다.',
    duration: '1분 30초',
    primaryCta: '방문 예약',
    primaryCtaHref: '/kr/contact/?type=visit',
    secondaryCta: '카탈로그 다운로드',
    secondaryCtaHref: '/kr/download/',
    watchCta: '영상 보기',
    caption: '내몽골 어얼도스 — 분梳 → 방적 → 편직 → 마감',
    posterAlt: '어얼도스 캐시미어 공장 내부 — 앞쪽은 분梳 라인, 뒤쪽은 편직 기계.',
    dialogLabel: '공장 견학 영상',
    closeLabel: '영상 닫기',
  },
