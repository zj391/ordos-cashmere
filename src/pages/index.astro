---
/**
 * 根路径处理：
 * - 根据浏览器语言自动跳转到对应语种子目录
 * - 或显示语种选择 landing
 */
import { LOCALES } from '@/lib/i18n';

// SSR so Astro.rewrite() can run at request time (rewrite is unavailable on
// prerendered pages). The root URL then renders the visitor's language
// directly with no 308 redirect hop.
export const prerender = false;

const acceptLanguage = Astro.request.headers.get('accept-language') || '';
const langCode = acceptLanguage.split(',')[0]?.split('-')[0]?.toLowerCase() || 'en';

const localeMap: Record<string, string> = {
  en: 'en', de: 'de', fr: 'fr', ja: 'ja', ko: 'kr', zh: 'cn',
};

const targetLocale = localeMap[langCode] || 'en';
// Rewrite instead of redirect: renders the chosen locale's homepage at the
// root URL with no 308 hop (PageSpeed flags the redirect as ~580ms of wasted
// latency on mobile). The root URL keeps serving real content in the user's
// language; /en/ etc. remain the canonical URLs via the page's own links.
return Astro.rewrite(`/${targetLocale}/`);
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>DONGXIAO® Cashmere</title>
  <meta http-equiv="refresh" content="0; url=/{targetLocale}/">
</head>
<body>
  <p>Redirecting to <a href="/{targetLocale}/">/{targetLocale}/</a>...</p>
</body>
</html>
