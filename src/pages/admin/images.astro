---
/**
 * Admin /admin/images/ — image library.
 *
 * Lists files in Supabase Storage bucket `product-images` (public).
 * 2026-09-21 upgrade: now supports deletion via DELETE /api/admin/images?name=<file>.
 * Upload still happens from the product edit page (UI for direct upload
 * coming in a follow-up); this page is the management view.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';

const locale = 'cn';
const L = (en: string, cn: string) => (locale === 'cn' ? cn : en);

const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';
const BUCKET = 'product-images';

type ImageFile = { name: string; id?: string; metadata?: { size?: number; mimetype?: string }; updated_at?: string };
let images: ImageFile[] = [];
let error = '';
let deleteOk = '';
let deleteErr = '';

const url = new URL(Astro.request.url);
if (url.searchParams.get('deleted') === '1') deleteOk = L('Image deleted.', '图片已删除。');
if (url.searchParams.get('delete_error')) deleteErr = decodeURIComponent(url.searchParams.get('delete_error') || '');

const q = (url.searchParams.get('q') || '').trim().toLowerCase();

if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const res = await fetch(`${SUPABASE_URL}/storage/v1/object/list/${BUCKET}`, {
      method: 'POST',
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: 'Bearer ' + SUPABASE_KEY,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ prefix: '', limit: 500, offset: 0, sortBy: { column: 'updated_at', order: 'desc' } }),
    });
    if (res.ok) {
      const all = (await res.json()) as ImageFile[];
      images = q ? all.filter((img) => img.name.toLowerCase().includes(q)) : all;
    } else {
      const t = await res.text();
      error = `Storage ${res.status}: ${t.slice(0, 200)}`;
    }
  } catch (e: any) {
    error = String(e?.message || e);
  }
}

const fmtSize = (n?: number) => {
  if (!n && n !== 0) return '—';
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
};
---
<AdminLayout locale={locale} activeNav="images" title={L('Image Library', '图片管理')} breadcrumb={[L('Images', '图片管理')]}>
  <div class="mb-4 rounded-lg border border-stone-200 bg-white p-4 text-sm text-stone-600">
    {L('Images are stored in the public Supabase Storage bucket `product-images` and uploaded from the product edit page. Use the search to filter; click Delete to permanently remove an image (this affects any product using it).', '图片存储在 Supabase Storage 公共桶 `product-images` 中，可从产品编辑页上传。点击删除会永久移除该图片（会影响引用此图的所有产品）。')}
  </div>

  {deleteOk && (
    <div class="mb-4 rounded-md border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-800">
      ✓ {deleteOk}
    </div>
  )}
  {deleteErr && (
    <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-800">
      ✗ {L('Delete failed:', '删除失败：')} {deleteErr}
    </div>
  )}
  {error && (
    <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-800">
      {L('Could not load images:', '无法加载图片：')} {error}
    </div>
  )}

  {/* Search bar */}
  <form method="get" class="mb-4 flex items-center gap-2 rounded-lg border border-stone-200 bg-white p-3">
    <div class="flex-1">
      <input
        type="text"
        name="q"
        value={q}
        placeholder={L('Search by file name...', '按文件名搜索...')}
        class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
      />
    </div>
    <button type="submit" class="rounded-md bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700">
      {L('Search', '搜索')}
    </button>
    {q && (
      <a href="/admin/images/" class="rounded-md border border-stone-300 px-3 py-2 text-sm text-stone-600 hover:bg-stone-50">
        {L('Reset', '重置')}
      </a>
    )}
    <div class="ml-auto text-xs text-stone-400">
      {images.length} {L('shown', '条')}
    </div>
  </form>

  {!error && images.length === 0 && (
    <div class="rounded-lg border border-stone-200 bg-white p-12 text-center text-stone-400">
      {q
        ? L(`No images match "${q}".`, `没有匹配 "${q}" 的图片。`)
        : L('No images uploaded yet. Upload from a product edit page.', '还没有图片。请从产品编辑页上传。')}
    </div>
  )}

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
    {images.map((img) => {
      const url = `${SUPABASE_URL}/storage/v1/object/public/${BUCKET}/${encodeURIComponent(img.name)}`;
      return (
        <div class="rounded-lg border border-stone-200 bg-white p-3">
          <a href={url} target="_blank" rel="noopener" class="block">
            <img src={url} alt={img.name} loading="lazy" class="aspect-square w-full rounded border border-stone-100 object-cover" />
          </a>
          <div class="mt-2 font-mono text-[10px] text-stone-500 break-all line-clamp-1" title={img.name}>{img.name}</div>
          <div class="mt-1 flex items-center justify-between text-xs text-stone-400">
            <span>{fmtSize(img.metadata?.size)}</span>
            <button
              type="button"
              class="rounded border border-stone-300 px-1.5 py-0.5 text-[10px] text-stone-600 hover:bg-stone-50"
              data-copy={url}
            >
              {L('Copy URL', '复制链接')}
            </button>
          </div>
          <button
            type="button"
            class="mt-2 w-full rounded border border-red-200 bg-red-50 px-2 py-1 text-[11px] font-medium text-red-700 hover:bg-red-100"
            data-delete-name={img.name}
          >
            {L('Delete', '删除')}
          </button>
        </div>
      );
    })}
  </div>

  <script is:inline>
    // Copy URL helper
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-copy');
        if (!url) return;
        navigator.clipboard.writeText(url).then(function () {
          var old = btn.textContent;
          btn.textContent = '✓';
          setTimeout(function () { btn.textContent = old; }, 1200);
        });
      });
    });

    // Delete handler — POSTs to /api/admin/images then redirects with status.
    document.querySelectorAll('[data-delete-name]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var name = btn.getAttribute('data-delete-name');
        if (!name) return;
        var ok = confirm('Delete "' + name + '"? This permanently removes the image from storage. Products using it will be affected.');
        if (!ok) return;
        var orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = '...';
        fetch('/api/admin/images?name=' + encodeURIComponent(name), { method: 'DELETE', credentials: 'same-origin' })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (out) {
            if (out.ok && out.j.ok) {
              window.location.href = '/admin/images/?deleted=1' + (window.location.search || '');
            } else {
              var msg = (out.j && (out.j.text || out.j.error)) || 'unknown error';
              window.location.href = '/admin/images/?delete_error=' + encodeURIComponent(msg);
            }
          })
          .catch(function (e) {
            window.location.href = '/admin/images/?delete_error=' + encodeURIComponent(String(e));
          });
      });
    });
  </script>
</AdminLayout>
