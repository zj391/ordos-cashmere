---
/**
 * Admin dashboard — overview page.
 * Mirrors the screenshot's "仪表盘" layout:
 *   - 4 stat cards (products / news / inquiries / today visitors)
 *   - Recent inquiries table (5 rows)
 *   - Site visit stats (7-day chart placeholder)
 *   - System info card (Vercel + storage + DB)
 *
 * All numbers are best-effort, populated from Supabase counts. If Supabase
 * is unreachable, falls back to "-".
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { LOCALES } from '@/lib/i18n';

const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';

const labels = {
  products: { en: 'Products', cn: '产品总数', de: 'Produkte', fr: 'Produits', ja: '製品総数', kr: '제품 총수' },
  news: { en: 'News', cn: '新闻总数', de: 'Nachrichten', fr: 'Actualités', ja: 'ニュース総数', kr: '뉴스 총수' },
  inquiries: { en: 'Inquiries', cn: '询盘总数', de: 'Anfragen', fr: 'Demandes', ja: '問い合わせ総数', kr: '문의 총수' },
  visitors: { en: "Today's visits", cn: '今日访客', de: 'Heutige Besuche', fr: 'Visites aujourd\'hui', ja: '本日の訪問者', kr: '오늘 방문자' },
  vsLastMonth: { en: 'vs last month', cn: '较上月', de: 'vs. Vormonat', fr: 'vs mois dernier', ja: '前月比', kr: '전월 대비' },
  recent: { en: 'Recent inquiries', cn: '近期询盘', de: 'Letzte Anfragen', fr: 'Demandes récentes', ja: '最近の問い合わせ', kr: '최근 문의' },
  viewAll: { en: 'View all', cn: '全部', de: 'Alle', fr: 'Tout', ja: 'すべて', kr: '전체' },
  traffic: { en: 'Site traffic', cn: '网站访问统计', de: 'Seitenverkehr', fr: 'Trafic du site', ja: 'サイト統計', kr: '사이트 통계' },
  last7days: { en: 'Last 7 days', cn: '近 7 天', de: 'Letzte 7 Tage', fr: '7 derniers jours', ja: '直近7日間', kr: '최근 7일' },
  quickActions: { en: 'Quick actions', cn: '快捷操作', de: 'Schnellzugriff', fr: 'Actions rapides', ja: 'クイック操作', kr: '빠른 작업' },
  sysInfo: { en: 'System info', cn: '系统信息', de: 'Systeminfo', fr: 'Infos système', ja: 'システム情報', kr: '시스템 정보' },
  status: { en: 'Status', cn: '网站状态', de: 'Status', fr: 'Statut', ja: 'ステータス', kr: '상태' },
  running: { en: 'Running normally', cn: '运行正常', de: 'Läuft normal', fr: 'Fonctionne normalement', ja: '正常稼働', kr: '정상 작동' },
  php: { en: 'PHP version', cn: 'PHP版本', de: 'PHP-Version', fr: 'Version PHP', ja: 'PHPバージョン', kr: 'PHP 버전' },
  serverTime: { en: 'Server time', cn: '服务器时间', de: 'Serverzeit', fr: 'Heure serveur', ja: 'サーバー時間', kr: '서버 시간' },
  storage: { en: 'Storage', cn: '存储空间', de: 'Speicher', fr: 'Stockage', ja: 'ストレージ', kr: '저장 공간' },
  addProduct: { en: 'Add product', cn: '发布产品', de: 'Produkt hinzufügen', fr: 'Ajouter produit', ja: '製品追加', kr: '제품 추가' },
  addNews: { en: 'Publish news', cn: '发布新闻', de: 'Nachricht veröffentlichen', fr: 'Publier actualité', ja: 'ニュース公開', kr: '뉴스 게시' },
  addPage: { en: 'Add page', cn: '添加页面', de: 'Seite hinzufügen', fr: 'Ajouter page', ja: 'ページ追加', kr: '페이지 추가' },
  viewInquiries: { en: 'View inquiries', cn: '查看询盘', de: 'Anfragen ansehen', fr: 'Voir demandes', ja: '問い合わせを見る', kr: '문의 보기' },
  unset: { en: 'Unset', cn: '未设置', de: 'Nicht gesetzt', fr: 'Non défini', ja: '未設定', kr: '미설정' },
};

const L = (obj: Record<string, string>) => obj[locale] || obj.en;

const locale = 'cn';

// ====== Fetch counts from Supabase (best-effort) ======
type Stats = { products: number; news: number; inquiries: number; visitors: number; monthDelta: { products: number; news: number; inquiries: number; visitors: number } };
const stats: Stats = { products: 0, news: 0, inquiries: 0, visitors: 0, monthDelta: { products: 0, news: 0, inquiries: 0, visitors: 0 } };
let supabaseErr = '';

async function fetchCount(restPath: string): Promise<number> {
  if (!SUPABASE_URL || !SUPABASE_KEY) return 0;
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${restPath}?select=id&limit=1`, {
    headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
  });
  if (!res.ok) return 0;
  const range = res.headers.get('content-range');
  if (range && range.includes('/')) {
    const total = range.split('/')[1];
    return parseInt(total, 10) || 0;
  }
  const arr = await res.json();
  return Array.isArray(arr) ? arr.length : 0;
}

// 2026-09-23 — Count entities created within a date window (used for
// month-over-month deltas on the dashboard cards).
async function fetchCountSince(restPath: string, sinceIso: string): Promise<number> {
  if (!SUPABASE_URL || !SUPABASE_KEY) return 0;
  const sep = restPath.includes('?') ? '&' : '?';
  const res = await fetch(
    `${SUPABASE_URL}/rest/v1/${restPath}${sep}created_at=gte.${encodeURIComponent(sinceIso)}&select=id&limit=1`,
    { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` } }
  );
  if (!res.ok) return 0;
  const range = res.headers.get('content-range');
  if (range && range.includes('/')) {
    const total = range.split('/')[1];
    return parseInt(total, 10) || 0;
  }
  return 0;
}

if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    [stats.products, stats.news, stats.inquiries] = await Promise.all([
      fetchCount('products?select=id'),
      fetchCount('blog_posts?select=id'),
      fetchCount('inquiries?select=id'),
    ]);
    // Today's visitor_events (page_view only) — used for the dashboard card.
    const todayStart = new Date();
    todayStart.setUTCHours(0, 0, 0, 0);
    stats.visitors = await fetchCountSince(
      'visitor_events?event_name=eq.page_view',
      todayStart.toISOString()
    );

    // Month-over-month deltas (current month vs previous calendar month).
    const lastMonthStart = new Date();
    lastMonthStart.setUTCDate(1);
    lastMonthStart.setUTCHours(0, 0, 0, 0);
    lastMonthStart.setUTCMonth(lastMonthStart.getUTCMonth() - 1);
    const thisMonthStart = new Date();
    thisMonthStart.setUTCDate(1);
    thisMonthStart.setUTCHours(0, 0, 0, 0);
    const futureIso = new Date(Date.now() + 86400000).toISOString();

    const prevDeltas = await Promise.all([
      fetchCountSince('products?created_at=gte.' + lastMonthStart.toISOString(), thisMonthStart.toISOString()),
      fetchCountSince('blog_posts?created_at=gte.' + lastMonthStart.toISOString(), thisMonthStart.toISOString()),
      fetchCountSince('inquiries?created_at=gte.' + lastMonthStart.toISOString(), thisMonthStart.toISOString()),
      fetchCountSince('visitor_events?created_at=gte.' + lastMonthStart.toISOString(), thisMonthStart.toISOString()),
    ]);
    const curDeltas = await Promise.all([
      fetchCountSince('products?created_at=gte.' + thisMonthStart.toISOString(), futureIso),
      fetchCountSince('blog_posts?created_at=gte.' + thisMonthStart.toISOString(), futureIso),
      fetchCountSince('inquiries?created_at=gte.' + thisMonthStart.toISOString(), futureIso),
      fetchCountSince('visitor_events?created_at=gte.' + thisMonthStart.toISOString(), futureIso),
    ]);
    stats.monthDelta.products = curDeltas[0] - prevDeltas[0];
    stats.monthDelta.news = curDeltas[1] - prevDeltas[1];
    stats.monthDelta.inquiries = curDeltas[2] - prevDeltas[2];
    stats.monthDelta.visitors = curDeltas[3] - prevDeltas[3];
  } catch (e: any) {
    supabaseErr = e?.message || String(e);
  }
}

// Recent inquiries (top 5)
const recent: any[] = [];
if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/inquiries?order=created_at.desc&limit=5&select=id,created_at,contact_name,company_name,country,email,phone,inquiry_type,status,created_at&order=created_at.desc`, {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
    });
    if (res.ok) {
      const all: any[] = await res.json();
      recent.push(...all);
    }
  } catch {}
}

// 2026-09-23 — Site traffic chart data sourced from visitor_events (last 7 days).
// Aggregates events by date+ip in JS; falls back to flat zeros if Supabase
// unreachable or no events in the window.
type VisitDay = { date: string; visits: number; uniqueIps: number };
const visitDays: VisitDay[] = [];
const visitTotals = { visits: 0, uniqueIps: 0, prevWeekVisits: 0 };
{
  // Always initialize 7 empty day buckets so the chart shape is stable.
  for (let i = 6; i >= 0; i--) {
    const d = new Date(Date.now() - i * 86400000);
    visitDays.push({ date: d.toISOString().slice(5, 10), visits: 0, uniqueIps: 0 });
  }
}
if (SUPABASE_URL && SUPABASE_KEY) {
  const since7 = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();
  const since14 = new Date(Date.now() - 14 * 24 * 60 * 60 * 1000).toISOString();
  try {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/visitor_events?created_at=gte.${encodeURIComponent(since7)}&select=created_at,ip&limit=10000`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` } }
    );
    if (res.ok) {
      const rows: Array<{ created_at: string; ip: string | null }> = await res.json();
      const ipByDay = new Map<string, Set<string>>();
      for (const row of rows) {
        const key = (row.created_at || '').slice(0, 10);
        const day = visitDays.find((v) => v.date === key.slice(5, 10));
        if (!day) continue;
        day.visits += 1;
        if (row.ip) {
          let s = ipByDay.get(key);
          if (!s) { s = new Set(); ipByDay.set(key, s); }
          s.add(row.ip);
          day.uniqueIps = s.size;
        }
      }
      visitTotals.visits = visitDays.reduce((s, d) => s + d.visits, 0);
      visitTotals.uniqueIps = Math.max(0, ...visitDays.map((d) => d.uniqueIps));
    }
    // Previous-week total for trend indicator.
    const prev = await fetch(
      `${SUPABASE_URL}/rest/v1/visitor_events?created_at=gte.${encodeURIComponent(since14)}&created_at=lt.${encodeURIComponent(since7)}&select=id&limit=1`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` } }
    );
    if (prev.ok) {
      const range = prev.headers.get('content-range');
      if (range && range.includes('/')) {
        visitTotals.prevWeekVisits = parseInt(range.split('/')[1], 10) || 0;
      }
    }
  } catch {
    // ignore — chart stays at zero
  }
}

// Status indicator: show error banner if Supabase fetch failed
const statusOk = !supabaseErr && !!SUPABASE_URL;
const totalInquiries = stats.inquiries;
const serverTime = new Date().toISOString().replace('T', ' ').slice(0, 19);
---
<AdminLayout locale={locale} activeNav="dashboard">
  {supabaseErr && (
    <div class="mb-4 rounded-lg border border-yellow-300 bg-yellow-50 p-3 text-sm text-yellow-900">
      ⚠️ Supabase fetch failed: {supabaseErr}. Check SUPABASE_URL and SUPABASE_SERVICE_KEY env vars.
    </div>
  )}

  <!-- Stats grid (2026-09-23: real month-over-month deltas from Supabase) -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {(() => {
        const cards = [
          { label: L(labels.products), value: stats.products, delta: stats.monthDelta.products, icon: 'M20 7l-8-4-8 4m16 0v10l-8 4m0-10L4 11m16 0l-8 4m0 0L4 21m8-4v10' },
          { label: L(labels.news), value: stats.news, delta: stats.monthDelta.news, icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V9m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2' },
          { label: L(labels.inquiries), value: stats.inquiries, delta: stats.monthDelta.inquiries, icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z' },
          { label: L(labels.visitors), value: stats.visitors, delta: stats.monthDelta.visitors, icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
        ];
        return cards.map((s) => {
          const d = s.delta;
          const arrow = d > 0 ? '↑' : d < 0 ? '↓' : '—';
          const color = d > 0 ? 'text-emerald-600' : d < 0 ? 'text-red-600' : 'text-stone-400';
          const fmt = (n: number) => (n > 0 ? `+${n}` : `${n}`);
          return (
            <div class="rounded-lg border border-stone-200 bg-white p-4">
              <div class="flex items-center justify-between">
                <span class="text-sm text-stone-500">{s.label}</span>
                <svg class="h-5 w-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon} />
                </svg>
              </div>
              <div class="mt-2 font-display text-3xl font-light">{s.value || '—'}</div>
              <div class={`mt-1 text-xs ${color}`}>{arrow} {fmt(d)} · {L(labels.vsLastMonth)}</div>
            </div>
          );
        });
      })()}
    </div>

  <!-- Two-column layout -->
  <div class="mt-6 grid gap-4 md:grid-cols-3">
    <!-- Recent inquiries -->
    <div class="md:col-span-2 rounded-lg border border-stone-200 bg-white p-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="font-display text-lg font-medium">{L(labels.recent)}</h2>
        <a href="/admin/inquiries/" class="text-xs text-primary hover:underline">{L(labels.viewAll)} →</a>
      </div>
      <table class="w-full text-sm">
        <thead class="border-b border-stone-200 text-left text-xs uppercase text-stone-500">
          <tr>
            <th class="py-2">Name</th><th class="py-2">Country</th><th class="py-2">Email</th>
            <th class="py-2">Time</th><th class="py-2">Status</th>
          </tr>
        </thead>
        <tbody>
          {recent.length === 0 ? (
            <tr><td colspan="5" class="py-6 text-center text-stone-400">—</td></tr>
          ) : recent.map((i) => (
            <tr class="border-b border-stone-100 last:border-0">
              <td class="py-2"><a href={`/admin/inquiries/${i.id}`} class="text-primary hover:underline">{i.contact_name || '—'}</a></td>
              <td class="py-2 text-stone-600">{i.country || '—'}</td>
              <td class="py-2 text-stone-600">{i.email || '—'}</td>
              <td class="py-2 text-xs text-stone-500">{new Date(i.created_at).toLocaleString()}</td>
              <td class="py-2">
                <span class:list={[
                  'rounded-full px-2 py-0.5 text-xs',
                  i.status === 'replied' ? 'bg-emerald-100 text-emerald-700' :
                  i.status === 'archived' ? 'bg-stone-100 text-stone-500' :
                  'bg-amber-100 text-amber-700',
                ]}>
                  {i.status || 'new'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- IndexNow Submit (Bing/Yandex/DuckDuckGo) -->
    <section class="rounded-lg border border-stone-200 bg-white p-4 mb-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="font-display text-lg font-medium">IndexNow Submit (Bing/Yandex/DuckDuckGo)</h2>
      </div>
      <p class="text-sm text-stone-500 mb-4">
        IndexNow lets you instantly notify Bing, Yandex, DuckDuckGo, Seznam, and Naver of new or updated URLs.
        Free, no API key. Sitemap-based submission covers all ~3,800 URLs in one shot.
      </p>
      <div class="flex flex-wrap gap-3 mb-4">
        <button
          type="button"
          data-indexnow-full
          class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90"
        >
          Submit full sitemap
        </button>
        <button
          type="button"
          data-indexnow-toggle
          class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50"
        >
          Submit specific URLs
        </button>
      </div>
      <div data-indexnow-urls hidden class="mb-4">
        <label class="block text-sm font-medium mb-2">URLs (one per line, max 10,000)</label>
        <textarea
          data-indexnow-textarea
          rows="6"
          placeholder="https://www.erdosdx.com/en/products/hat-100/&#10;https://www.erdosdx.com/en/blog/my-post/"
          class="w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-mono"
        ></textarea>
        <button
          type="button"
          data-indexnow-submit-urls
          class="mt-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90"
        >
          Submit these URLs
        </button>
      </div>
      <div data-indexnow-result hidden class="mt-4 rounded-md bg-stone-50 p-3">
        <pre data-indexnow-output class="text-xs font-mono whitespace-pre-wrap break-all"></pre>
      </div>
    </section>

    <script is:inline>
      (function () {
        var resultBox = document.querySelector('[data-indexnow-result]');
        var output = document.querySelector('[data-indexnow-output]');
        var fullBtn = document.querySelector('[data-indexnow-full]');
        var toggleBtn = document.querySelector('[data-indexnow-toggle]');
        var urlsBox = document.querySelector('[data-indexnow-urls]');
        var submitUrlsBtn = document.querySelector('[data-indexnow-submit-urls]');
        var textarea = document.querySelector('[data-indexnow-textarea]');
        if (!resultBox || !output || !fullBtn) return;
        async function post(body, isFull) {
          resultBox.hidden = false;
          output.textContent = 'Submitting...';
          try {
            var url = '/api/indexnow-submit' + (isFull ? '?full=1' : '');
            var res = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body || {}),
            });
            var json = await res.json();
            output.textContent = 'HTTP ' + res.status + '\n' + JSON.stringify(json, null, 2);
          } catch (err) {
            output.textContent = 'Error: ' + (err && err.message || String(err));
          }
        }
        fullBtn.addEventListener('click', function () { post({ full: true }, true); });
        toggleBtn.addEventListener('click', function () { urlsBox.hidden = !urlsBox.hidden; });
        submitUrlsBtn.addEventListener('click', function () {
          var urls = (textarea.value || '').split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
          if (urls.length === 0) { output.textContent = 'No URLs provided'; resultBox.hidden = false; return; }
          post({ urls: urls }, false);
        });
      })();
    </script>

    <!-- Site traffic chart (2026-09-23: real visitor_events from Supabase) -->
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-display text-lg font-medium">{L(labels.traffic)}</h2>
            <span class="text-xs text-stone-400">{L(labels.last7days)}</span>
          </div>
          <div class="flex h-40 items-end gap-2">
            {visitDays.map((d) => {
              const maxVisits = Math.max(1, ...visitDays.map((v) => v.visits));
              const h = d.visits === 0
                ? 8
                : Math.max(8, Math.round((d.visits / maxVisits) * 92));
              return (
                <div class="flex flex-1 flex-col items-center gap-1">
                  <div class="relative w-full rounded-t bg-primary/30 transition-colors group hover:bg-primary/50" style={`height:${h}%`}>
                    <div class="absolute bottom-full left-1/2 mb-1 hidden -translate-x-1/2 whitespace-nowrap rounded bg-stone-900 px-2 py-1 text-[10px] text-white group-hover:block">
                      {d.visits} visits · {d.uniqueIps} unique
                    </div>
                  </div>
                  <span class="text-xs text-stone-400">{d.date}</span>
                </div>
              );
            })}
          </div>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-stone-500">
            <span>Visits: <span class="font-medium text-stone-800">{visitTotals.visits.toLocaleString()}</span></span>
            <span>·</span>
            <span>Peak unique IPs: <span class="font-medium text-stone-800">{visitTotals.uniqueIps.toLocaleString()}</span></span>
            {visitTotals.prevWeekVisits > 0 && (
              <>
                <span>·</span>
                <span>vs prev 7d: <span class={`font-medium ${visitTotals.visits >= visitTotals.prevWeekVisits ? 'text-emerald-600' : 'text-red-600'}`}>
                  {visitTotals.visits >= visitTotals.prevWeekVisits ? '↑' : '↓'} {Math.abs(visitTotals.visits - visitTotals.prevWeekVisits).toLocaleString()}
                </span></span>
              </>
            )}
            {visitTotals.visits === 0 && !supabaseErr && (
              <span class="text-stone-400">(no events)</span>
            )}
            {supabaseErr && (
              <span class="text-amber-600">(Supabase unavailable)</span>
            )}
          </div>
        </div>
  </div>

  <!-- Bottom row -->
  <div class="mt-6 grid gap-4 md:grid-cols-3">
    <!-- Quick actions -->
    <div class="md:col-span-2 rounded-lg border border-stone-200 bg-white p-4">
      <h2 class="mb-3 font-display text-lg font-medium">{L(labels.quickActions)}</h2>
      <div class="grid grid-cols-4 gap-3">
        <a href="/admin/products/new" class="flex flex-col items-center gap-2 rounded-md border border-stone-200 p-4 hover:bg-stone-50">
          <svg class="h-7 w-7 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0v10l-8 4m0-10L4 11m16 0l-8 4m0 0L4 21m8-4v10"/></svg>
          <span class="text-xs text-stone-700">{L(labels.addProduct)}</span>
        </a>
        <a href="/admin/news/" class="flex flex-col items-center gap-2 rounded-md border border-stone-200 p-4 hover:bg-stone-50">
          <svg class="h-7 w-7 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V9m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2"/></svg>
          <span class="text-xs text-stone-700">{L(labels.addNews)}</span>
        </a>
        <a href="/admin/pages/" class="flex flex-col items-center gap-2 rounded-md border border-stone-200 p-4 hover:bg-stone-50">
          <svg class="h-7 w-7 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-xs text-stone-700">{L(labels.addPage)}</span>
        </a>
        <a href="/admin/inquiries/" class="flex flex-col items-center gap-2 rounded-md border border-stone-200 p-4 hover:bg-stone-50">
          <svg class="h-7 w-7 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          <span class="text-xs text-stone-700">{L(labels.viewInquiries)}</span>
        </a>
      </div>
    </div>

    <!-- System info -->
    <div class="rounded-lg border border-stone-200 bg-white p-4">
      <h2 class="mb-3 font-display text-lg font-medium">{L(labels.sysInfo)}</h2>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between">
          <dt class="text-stone-500">{L(labels.status)}</dt>
          <dd>
            <span class="inline-flex items-center gap-1 text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              {L(labels.running)}
            </span>
          </dd>
        </div>
        <div class="flex justify-between"><dt class="text-stone-500">Astro / Node</dt><dd class="font-mono text-stone-700">5.18 / 22</dd></div>
        <div class="flex justify-between"><dt class="text-stone-500">{L(labels.serverTime)}</dt><dd class="font-mono text-xs text-stone-700">{serverTime}</dd></div>
        <div class="flex justify-between"><dt class="text-stone-500">Supabase</dt><dd class="font-mono text-xs text-stone-700">{SUPABASE_URL ? '✓' : '✗'}</dd></div>
        <div class="flex justify-between"><dt class="text-stone-500">Resend</dt><dd class="font-mono text-xs text-stone-700">{process.env.RESEND_API_KEY ? '✓' : '✗'}</dd></div>
        <div class="flex justify-between"><dt class="text-stone-500">GA4</dt><dd class="font-mono text-xs text-stone-700">{process.env.PUBLIC_GA4_ID ? '✓' : '✗'}</dd></div>
      </dl>
    </div>
  </div>

  <!-- IndexNow submit -->
  <section class="mt-6 rounded-lg border border-stone-200 bg-white p-4">
    <h2 class="mb-3 font-display text-lg font-medium">IndexNow Submit (Bing / Yandex / DuckDuckGo)</h2>
    <p class="mb-4 text-sm text-stone-600">
      IndexNow lets you instantly notify Bing, Yandex, DuckDuckGo, Seznam, and Naver of new or updated URLs.
      Free, no API key. Sitemap-based submission covers all published pages in one click.
    </p>
    <div class="flex flex-wrap gap-3">
      <button
        type="button"
        data-indexnow-full
        class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary/90"
      >
        Submit full sitemap
      </button>
      <button
        type="button"
        data-indexnow-toggle
        class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-50"
      >
        Submit specific URLs
      </button>
    </div>
    <div data-indexnow-urls hidden class="mt-4">
      <label class="mb-2 block text-sm font-medium text-stone-700">URLs (one per line)</label>
      <textarea
        data-indexnow-textarea
        rows="6"
        placeholder="https://www.erdosdx.com/en/products/hat-100/&#10;https://www.erdosdx.com/en/blog/my-post/"
        class="w-full rounded-md border border-stone-300 bg-white px-3 py-2 font-mono text-xs focus:border-primary focus:outline-none"
      ></textarea>
      <button
        type="button"
        data-indexnow-submit-urls
        class="mt-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary/90"
      >
        Submit these URLs
      </button>
    </div>
    <div data-indexnow-result hidden class="mt-4 rounded-md bg-stone-50 p-3">
      <pre data-indexnow-output class="whitespace-pre-wrap break-all font-mono text-xs text-stone-800"></pre>
    </div>
  </section>

  <script is:inline>
    (function () {
      var resultBox = document.querySelector('[data-indexnow-result]');
      var output = document.querySelector('[data-indexnow-output]');
      var fullBtn = document.querySelector('[data-indexnow-full]');
      var toggleBtn = document.querySelector('[data-indexnow-toggle]');
      var urlsBox = document.querySelector('[data-indexnow-urls]');
      var submitUrlsBtn = document.querySelector('[data-indexnow-submit-urls]');
      var textarea = document.querySelector('[data-indexnow-textarea]');
      if (!resultBox || !output || !fullBtn) return;

      async function post(body, isFull) {
        resultBox.hidden = false;
        output.textContent = 'Submitting...';
        try {
          var url = '/api/indexnow-submit' + (isFull ? '?full=1' : '');
          var res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body || {}),
          });
          var json;
          try { json = await res.json(); } catch (_) { json = { raw: await res.text() }; }
          output.textContent = 'HTTP ' + res.status + '\n' + JSON.stringify(json, null, 2);
        } catch (err) {
          output.textContent = 'Error: ' + (err && err.message ? err.message : String(err));
        }
      }

      fullBtn.addEventListener('click', function () { post({ full: true }, true); });
      toggleBtn.addEventListener('click', function () { urlsBox.hidden = !urlsBox.hidden; });
      submitUrlsBtn.addEventListener('click', function () {
        var urls = (textarea.value || '').split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
        if (urls.length === 0) {
          resultBox.hidden = false;
          output.textContent = 'No URLs provided.';
          return;
        }
        post({ urls: urls }, false);
      });
    })();
  </script>
</AdminLayout>
