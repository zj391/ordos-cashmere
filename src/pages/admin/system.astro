---
/**
 * Admin /admin/system/ 鈥?system information.
 * Shows env var presence, Supabase connectivity, and key table row counts.
 * All checks are best-effort and never throw.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { LOCALES } from '@/lib/i18n';

const locale = 'cn';
const L = (en: string, cn: string) => (locale === 'cn' ? cn : en);

const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';

const envRows = [
  { key: 'SUPABASE_URL / PUBLIC_SUPABASE_URL', set: !!SUPABASE_URL, masked: SUPABASE_URL ? SUPABASE_URL.replace(/^https:\/\//, 'https://***@') : '' },
  { key: 'SUPABASE_SERVICE_KEY', set: !!SUPABASE_KEY, masked: SUPABASE_KEY ? SUPABASE_KEY.slice(0, 6) + '…' + SUPABASE_KEY.slice(-4) : '' },
  { key: 'ADMIN_PASSWORD', set: !!process.env.ADMIN_PASSWORD, masked: process.env.ADMIN_PASSWORD ? '********' : '' },
  { key: 'RESEND_API_KEY', set: !!process.env.RESEND_API_KEY, masked: process.env.RESEND_API_KEY ? '********' : '' },
  { key: 'PUBLIC_GA4_ID', set: !!process.env.PUBLIC_GA4_ID, masked: process.env.PUBLIC_GA4_ID ? '********' : '' },
  // 阶段 6 P1 (2026-09-10): 自动化系统 env 状态
  { key: 'CRON_SECRET', set: !!process.env.CRON_SECRET, masked: process.env.CRON_SECRET ? '********' : '', group: 'automation' },
  { key: 'NOTIFICATION_EMAIL', set: !!process.env.NOTIFICATION_EMAIL, masked: process.env.NOTIFICATION_EMAIL || '', group: 'automation' },
  { key: 'WECHAT_WEBHOOK_URL', set: !!process.env.WECHAT_WEBHOOK_URL, masked: process.env.WECHAT_WEBHOOK_URL ? '*** configured ***' : '', group: 'automation' },
  { key: 'WA_PHONE_NUMBER_ID', set: !!process.env.WA_PHONE_NUMBER_ID, masked: process.env.WA_PHONE_NUMBER_ID ? '*** configured ***' : '', group: 'whatsapp' },
  { key: 'WA_ACCESS_TOKEN', set: !!process.env.WA_ACCESS_TOKEN, masked: process.env.WA_ACCESS_TOKEN ? '********' : '', group: 'whatsapp' },
  { key: 'WA_WEBHOOK_VERIFY_TOKEN', set: !!process.env.WA_WEBHOOK_VERIFY_TOKEN, masked: process.env.WA_WEBHOOK_VERIFY_TOKEN ? '********' : '', group: 'whatsapp' },
  { key: 'WA_APP_SECRET', set: !!process.env.WA_APP_SECRET, masked: process.env.WA_APP_SECRET ? '********' : '', group: 'whatsapp' },
  { key: 'N8N_WEBHOOK_URL', set: !!process.env.N8N_WEBHOOK_URL, masked: process.env.N8N_WEBHOOK_URL ? '*** configured ***' : '', group: 'n8n' },
  { key: 'N8N_WEBHOOK_EVENTS_URL', set: !!process.env.N8N_WEBHOOK_EVENTS_URL, masked: process.env.N8N_WEBHOOK_EVENTS_URL ? '*** configured ***' : '', group: 'n8n' },
  { key: 'LINKEDIN_ACCESS_TOKEN', set: !!process.env.LINKEDIN_ACCESS_TOKEN, masked: process.env.LINKEDIN_ACCESS_TOKEN ? '********' : '', group: 'social' },
  { key: 'LINKEDIN_ORG_URN', set: !!process.env.LINKEDIN_ORG_URN, masked: process.env.LINKEDIN_ORG_URN || '', group: 'social' },
];

// 阶段 6 P1: 自动化系统健康指标
interface HealthProbe {
  name: string;
  value: string;
  status: 'ok' | 'warn' | 'err';
  hint?: string;
}
const healthProbes: HealthProbe[] = [];

if (SUPABASE_URL && SUPABASE_KEY) {
  const sbHeaders = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
  const hours24 = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();
  const days7 = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();

  // daily-tick 是否在 24h 内跑过
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/lead_activities?channel=eq.email&direction=eq.out&order=created_at.desc&limit=1&select=created_at`,
      { headers: sbHeaders },
    );
    if (r.ok) {
      const arr = await r.json();
      const last = arr?.[0]?.created_at;
      if (last) {
        const hoursSince = (Date.now() - new Date(last).getTime()) / 3_600_000;
        healthProbes.push({
          name: 'Nurture cron (daily-tick)',
          value: `上次跑 ${hoursSince < 1 ? Math.round(hoursSince * 60) + ' 分钟前' : hoursSince.toFixed(1) + ' 小时前'}`,
          status: hoursSince < 30 ? 'ok' : hoursSince < 60 ? 'warn' : 'err',
          hint: hoursSince < 30 ? '正常运行 (Vercel Hobby 每天 1 次)' : '超 30 小时未跑 — 检查 Vercel Cron 配置',
        });
      } else {
        healthProbes.push({ name: 'Nurture cron (daily-tick)', value: '从未跑过', status: 'err', hint: '检查 Vercel Cron 配置' });
      }
    }
  } catch { /* ignore */ }

  // WA outbound 7 天内发送过吗
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/wa_send_log?direction=eq.out&created_at=gte.${days7}&limit=1&select=created_at`,
      { headers: sbHeaders },
    );
    if (r.ok) {
      const arr = await r.json();
      if (arr.length > 0) {
        healthProbes.push({
          name: 'WhatsApp outbound (7d)',
          value: `7 天内有发送`,
          status: 'ok',
        });
      } else {
        healthProbes.push({
          name: 'WhatsApp outbound (7d)',
          value: '7 天内无发送',
          status: process.env.WA_PHONE_NUMBER_ID ? 'warn' : 'err',
          hint: !process.env.WA_PHONE_NUMBER_ID ? '未配置 WA_PHONE_NUMBER_ID' : '已配置但未触发 — 检查 A 级 lead 数量',
        });
      }
    }
  } catch { /* ignore */ }

  // Sync logs 最近活动 (LinkedIn/1688/小红书)
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/sync_logs?order=created_at.desc&limit=1&select=created_at,channel,status`,
      { headers: sbHeaders },
    );
    if (r.ok) {
      const arr = await r.json();
      const last = arr?.[0];
      if (last) {
        const hoursSince = (Date.now() - new Date(last.created_at).getTime()) / 3_600_000;
        healthProbes.push({
          name: '社媒同步 (sync runner)',
          value: `${last.channel} 上次 ${hoursSince.toFixed(1)} 小时前 — ${last.status}`,
          status: last.status === 'error' ? 'warn' : 'ok',
          hint: last.status === 'skipped' ? '未配置 API token — 同步跳过是预期行为' : undefined,
        });
      } else {
        healthProbes.push({ name: '社媒同步 (sync runner)', value: '从未跑过', status: 'warn', hint: 'admin UI 触发一次同步' });
      }
    }
  } catch { /* ignore */ }

  // Resend events webhook 是否活跃 (last 7d)
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/lead_activities?channel=eq.email&status=in.(opened,clicked,bounced)&created_at=gte.${days7}&limit=1&select=created_at`,
      { headers: sbHeaders },
    );
    if (r.ok) {
      const arr = await r.json();
      const hasEvents = arr.length > 0;
      // 这是被动的 — 仅在 nurture 邮件发出且客户互动后才有数据
      // 不算错,但提示 zj 配 webhook 后应该有数据
      healthProbes.push({
        name: 'Resend Events webhook (7d)',
        value: hasEvents ? '有 email engagement 数据' : '7 天内无 email engagement (opened/clicked/bounced)',
        status: 'ok',
        hint: !hasEvents ? '在 Resend Dashboard → Webhooks 配 URL: https://www.erdosdx.com/api/resend-events' : undefined,
      });
    }
  } catch { /* ignore */ }
}

// Supabase connectivity + table row counts (best-effort)
type TableStat = { name: string; rows: number; ok: boolean };
const tableStats: TableStat[] = [];
let supabaseStatus = 'unknown';
if (SUPABASE_URL && SUPABASE_KEY) {
  const headers = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
  const tables = ['products', 'categories', 'inquiries', 'leads', 'lead_activities', 'sync_logs', 'wa_send_log', 'blog_posts', 'download_leads'];
  for (const t of tables) {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/${t}?select=id&limit=1`, { headers });
      if (res.ok) {
        const range = res.headers.get('content-range') || '';
        const total = range.split('/')[1];
        const rows = total && total !== '*' ? parseInt(total, 10) : 1;
        tableStats.push({ name: t, rows: isNaN(rows) ? 0 : rows, ok: true });
      } else {
        tableStats.push({ name: t, rows: 0, ok: false });
      }
    } catch {
      tableStats.push({ name: t, rows: 0, ok: false });
    }
  }
  supabaseStatus = tableStats.some((s) => s.ok) ? 'connected' : 'error';
} else {
  supabaseStatus = 'missing_env';
}

const serverTime = new Date().toISOString().replace('T', ' ').slice(0, 19);
const nodeVersion = typeof process !== 'undefined' && process.version ? process.version : '';
const okBadge = '<span class="inline-block rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">SET</span>';
const missingBadge = '<span class="inline-block rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-700">MISSING</span>';
const okTable = '<span class="inline-block rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">OK</span>';
const errTable = '<span class="inline-block rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-700">ERR</span>';
---
<AdminLayout locale={locale} activeNav="system" title={L('System Info', '系统信息')} breadcrumb={[L('System Info', '系统设置')]}>
  <!-- Top status banner -->
  <div class:list={[
    'mb-6 rounded-lg border p-4 text-sm',
    supabaseStatus === 'connected' ? 'border-emerald-300 bg-emerald-50 text-emerald-800' :
    supabaseStatus === 'error' ? 'border-red-300 bg-red-50 text-red-800' :
    'border-amber-300 bg-amber-50 text-amber-800',
  ]}>
    {supabaseStatus === 'connected' && '✓ ' + L('Supabase connected. Data tables are reachable.', 'Supabase 已连接，数据表可访问。')}
    {supabaseStatus === 'error' && '✗ ' + L('Supabase reachable but some tables are missing.', 'Supabase 可达但部分数据表缺失。')}
    {supabaseStatus === 'missing_env' && '⚠ ' + L('Supabase env vars not set. Add SUPABASE_URL + SUPABASE_SERVICE_KEY on Vercel.', '未设置 Supabase 环境变量。请在 Vercel 添加 SUPABASE_URL 和 SUPABASE_SERVICE_KEY。')}
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Environment -->
    <div class="rounded-lg border border-stone-200 bg-white p-5">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Environment variables', '环境变量')}</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          {envRows.filter((r) => !r.group).map((r) => (
            <tr>
              <td class="py-2.5 font-mono text-xs text-stone-600">{r.key}</td>
              <td class="py-2.5 text-right font-mono text-xs text-stone-500">{r.masked || '—'}</td>
              <td class="py-2.5 text-right" set:html={r.set ? okBadge : missingBadge} />
            </tr>
          ))}
        </tbody>
      </table>

      <h4 class="mt-5 mb-3 text-xs font-medium uppercase tracking-wider text-stone-500">Automation</h4>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          {envRows.filter((r) => r.group === 'automation').map((r) => (
            <tr>
              <td class="py-2 font-mono text-xs text-stone-600">{r.key}</td>
              <td class="py-2 text-right font-mono text-xs text-stone-500">{r.masked || '—'}</td>
              <td class="py-2 text-right" set:html={r.set ? okBadge : missingBadge} />
            </tr>
          ))}
        </tbody>
      </table>

      <h4 class="mt-5 mb-3 text-xs font-medium uppercase tracking-wider text-stone-500">WhatsApp</h4>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          {envRows.filter((r) => r.group === 'whatsapp').map((r) => (
            <tr>
              <td class="py-2 font-mono text-xs text-stone-600">{r.key}</td>
              <td class="py-2 text-right font-mono text-xs text-stone-500">{r.masked || '—'}</td>
              <td class="py-2 text-right" set:html={r.set ? okBadge : missingBadge} />
            </tr>
          ))}
        </tbody>
      </table>

      <h4 class="mt-5 mb-3 text-xs font-medium uppercase tracking-wider text-stone-500">n8n</h4>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          {envRows.filter((r) => r.group === 'n8n').map((r) => (
            <tr>
              <td class="py-2 font-mono text-xs text-stone-600">{r.key}</td>
              <td class="py-2 text-right font-mono text-xs text-stone-500">{r.masked || '—'}</td>
              <td class="py-2 text-right" set:html={r.set ? okBadge : missingBadge} />
            </tr>
          ))}
        </tbody>
      </table>

      <h4 class="mt-5 mb-3 text-xs font-medium uppercase tracking-wider text-stone-500">Social</h4>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          {envRows.filter((r) => r.group === 'social').map((r) => (
            <tr>
              <td class="py-2 font-mono text-xs text-stone-600">{r.key}</td>
              <td class="py-2 text-right font-mono text-xs text-stone-500">{r.masked || '—'}</td>
              <td class="py-2 text-right" set:html={r.set ? okBadge : missingBadge} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Runtime -->
    <div class="rounded-lg border border-stone-200 bg-white p-5">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Runtime', '运行环境')}</h3>
      <dl class="space-y-2.5 text-sm">
        <div class="flex justify-between">
          <dt class="text-stone-500">{L('Server time (UTC)', '服务器时间 (UTC)')}</dt>
          <dd class="font-mono text-xs text-stone-700">{serverTime}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">Node.js</dt>
          <dd class="font-mono text-xs text-stone-700">{nodeVersion || '—'}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">{L('Framework', '框架')}</dt>
          <dd class="font-mono text-xs text-stone-700">Astro 5 + Vercel</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">{L('Admin session', '管理员会话')}</dt>
          <dd class="text-stone-700">{L('7-day cookie, HMAC signed', '7 天有效期，HMAC 签名')}</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- 阶段 6 P1 (2026-09-10): 自动化系统健康仪表盘 -->
  <div class="mt-6 rounded-lg border border-stone-200 bg-white p-5">
    <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Automation health', '自动化健康检查')}</h3>
    {healthProbes.length === 0 ? (
      <p class="text-sm text-stone-500">{L('Supabase not configured. Cannot probe automation status.', 'Supabase 未配置，无法检查自动化状态。')}</p>
    ) : (
      <div class="space-y-2">
        {healthProbes.map((p) => (
          <div class="flex items-start justify-between gap-4 rounded-md border border-stone-100 px-4 py-3">
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class:list={[
                  'inline-block h-2.5 w-2.5 rounded-full',
                  p.status === 'ok' ? 'bg-emerald-500' : p.status === 'warn' ? 'bg-amber-500' : 'bg-red-500',
                ]}></span>
                <span class="font-mono text-xs font-medium text-stone-700">{p.name}</span>
              </div>
              {p.hint && <p class="mt-1 text-xs text-stone-500">{p.hint}</p>}
            </div>
            <div class="text-xs text-stone-600">{p.value}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Data tables -->
  <div class="mt-6 rounded-lg border border-stone-200 bg-white p-5">
    <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Supabase tables', 'Supabase 数据表')}</h3>
    <table class="w-full text-sm">
      <thead class="border-b border-stone-200 text-left text-xs uppercase tracking-wider text-stone-500">
        <tr>
          <th class="py-2">{L('Table', '数据表')}</th>
          <th class="py-2 text-right">{L('Rows', '行数')}</th>
          <th class="py-2 text-right">{L('Status', '状态')}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        {tableStats.length === 0 ? (
          <tr><td colspan="3" class="py-8 text-center text-stone-400">{L('Supabase not configured.', 'Supabase 未配置。')}</td></tr>
        ) : tableStats.map((t) => (
          <tr>
            <td class="py-2.5 font-mono text-xs text-stone-700">{t.name}</td>
            <td class="py-2.5 text-right tabular-nums text-stone-700">{t.rows.toLocaleString()}</td>
            <td class="py-2.5 text-right" set:html={t.ok ? okTable : errTable} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
