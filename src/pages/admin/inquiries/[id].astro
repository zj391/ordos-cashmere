---
// Admin inquiry detail
// /admin/inquiries/[id]
// - Show all fields
// - Form to update status, lead_grade, notes
// - Submit POSTs to /api/admin/inquiries/?id=…

export const prerender = false;
import { DEAL_STAGES, QUOTE_STATUSES, SAMPLE_STATUSES, readWorkflow, stripWorkflowSummary } from '../../../lib/deal-workflow';
const { id } = Astro.params;
const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';

let inquiry: any = null;
let lead: any = null;
let error = '';

if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const r1 = await fetch(`${SUPABASE_URL}/rest/v1/inquiries?id=eq.${id}&limit=1`, {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY },
    });
    if (r1.ok) {
      const arr = await r1.json();
      inquiry = arr[0] || null;
    } else {
      error = `Supabase ${r1.status}`;
    }

    // Try to find matching lead (by email)
    if (inquiry?.email) {
      const r2 = await fetch(`${SUPABASE_URL}/rest/v1/leads?email=eq.${encodeURIComponent(inquiry.email)}&limit=1`, {
        headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY },
      });
      if (r2.ok) {
        const arr2 = await r2.json();
        lead = arr2[0] || null;
      }
    }
  } catch (e) {
    error = e.message;
  }
}

function fmtDate(iso: string) {
  if (!iso) return '—';
  return new Date(iso).toISOString().slice(0, 19).replace('T', ' ');
}

function marketForCountry(value: string | null | undefined) {
  const code = String(value || '').toUpperCase();
  if (['CN', 'HK', 'TW'].includes(code)) return '中国 / 大中华';
  if (['US', 'CA', 'MX'].includes(code)) return '北美';
  if (['DE', 'FR', 'IT', 'ES', 'PT', 'NL', 'BE', 'CH', 'AT', 'PL', 'GB'].includes(code)) return '欧洲';
  if (['JP', 'KR', 'SG', 'AU', 'NZ', 'IN', 'VN', 'TH', 'ID', 'PH', 'MY'].includes(code)) return '亚太';
  if (['AE', 'SA', 'TR'].includes(code)) return '中东';
  if (['BR', 'AR'].includes(code)) return '拉丁美洲';
  return '其他市场';
}

function firstResponseSla(inquiry: any) {
  const hours = Math.max(0, (Date.now() - new Date(inquiry.created_at || Date.now()).getTime()) / 3_600_000);
  if (inquiry.status && inquiry.status !== 'new') return '已更新状态';
  if (hours >= 24) return '超过 24 小时待跟进';
  if (hours >= 4) return '4–24 小时待跟进';
  return '4 小时内待跟进';
}
const workflow = readWorkflow(lead?.notes);
const stageLabels: Record<string, string> = { inquiry_review: '询盘评估', quote_drafting: '报价草稿', quote_sent: '报价已发送', sample_requested: '已申请样品', sample_in_progress: '样品制作中', sample_sent: '样品已寄出', negotiation: '商务谈判', won: '已成交', lost: '已流失' };
const quoteLabels: Record<string, string> = { not_started: '未开始', draft: '草稿', sent: '已发送', revised: '已修订', accepted: '已接受', declined: '已拒绝' };
const sampleLabels: Record<string, string> = { not_requested: '未申请', requested: '已申请', in_production: '制作中', sent: '已寄出', approved: '已确认', revision_needed: '需修改' };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inquiry #{id} — DONGXIAO Cashmere Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #fafaf9; color: #1c1917; padding: 1.5rem; }
    .container { max-width: 900px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    h1 { font-size: 1.25rem; font-weight: 600; }
    .actions { display: flex; gap: 0.5rem; }
    a, button { font: inherit; cursor: pointer; padding: 0.5rem 1rem; border-radius: 0.375rem; border: 1px solid #d6d3d1; background: white; color: #1c1917; text-decoration: none; font-size: 0.875rem; }
    a:hover, button:hover { background: #f5f5f4; }
    .primary { background: #1c1917; color: white; border-color: #1c1917; }
    .primary:hover { background: #44403c; }
    .card { background: white; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #e7e5e4; margin-bottom: 1rem; }
    .card h2 { font-size: 1rem; margin-bottom: 1rem; color: #57534e; text-transform: uppercase; letter-spacing: 0.025em; }
    dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; font-size: 0.875rem; }
    dt { color: #78716c; }
    dd { color: #1c1917; word-break: break-word; }
    .message { background: #f5f5f4; padding: 1rem; border-radius: 0.375rem; font-size: 0.875rem; white-space: pre-wrap; }
    label { display: block; font-size: 0.75rem; color: #57534e; text-transform: uppercase; margin-bottom: 0.25rem; font-weight: 600; }
    select, textarea, input[type="text"] { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d6d3d1; border-radius: 0.375rem; font: inherit; font-size: 0.875rem; margin-bottom: 1rem; }
    textarea { resize: vertical; min-height: 100px; }
    .err { background: #fee2e2; color: #991b1b; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1rem; }
    .b { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600; }
    .b-a { background: #d1fae5; color: #065f46; }
    .b-b { background: #fef3c7; color: #92400e; }
    .b-c { background: #dbeafe; color: #1e40af; }
    .b-grey { background: #e7e5e4; color: #57534e; }
    .workflow-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
    .workflow-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin-bottom:1rem; }
    .workflow-summary div { background:#f5f5f4; padding:.75rem; border-radius:.375rem; }
    .workflow-summary small { display:block; color:#78716c; font-size:.7rem; text-transform:uppercase; margin-bottom:.25rem; }
    @media (max-width: 680px) { .workflow-grid,.workflow-summary { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>询盘 #{id}</h1>
      <div class="actions">
        <a href="/admin/inquiries/">← 返回列表</a>
        <a href="/api/admin/auth?action=logout">退出登录</a>
      </div>
    </div>

    {error && <div class="err">Error: {error}</div>}

    {!inquiry ? (
      <div class="card">未找到该询盘。</div>
    ) : (
      <>
        <div class="card">
          <h2>联系信息</h2>
          <dl>
            <dt>姓名</dt><dd>{inquiry.contact_name}</dd>
            <dt>公司</dt><dd>{inquiry.company_name}</dd>
            <dt>邮箱</dt><dd><a href={`mailto:${inquiry.email}`}>{inquiry.email}</a></dd>
            <dt>电话</dt><dd>{inquiry.phone || '—'}</dd>
            <dt>国家</dt><dd>{inquiry.country}</dd>
            <dt>市场</dt><dd>{marketForCountry(inquiry.country)}</dd>
            <dt>语言</dt><dd>{inquiry.locale}</dd>
          </dl>
        </div>

        <div class="card">
          <h2>询盘内容</h2>
          <dl>
            <dt>类型</dt><dd>{inquiry.inquiry_type}</dd>
            <dt>产品</dt><dd>{inquiry.product_interest || '—'}</dd>
            <dt>数量(kg)</dt><dd>{inquiry.quantity_kg || '—'}</dd>
            <dt>数量(m)</dt><dd>{inquiry.quantity_m || '—'}</dd>
            <dt>数量(件)</dt><dd>{inquiry.quantity_pcs || '—'}</dd>
            <dt>创建时间</dt><dd>{fmtDate(inquiry.created_at)}</dd>
            <dt>首次响应 SLA</dt><dd>{firstResponseSla(inquiry)}</dd>
          </dl>
          {inquiry.message && (
            <>
              <label style="margin-top: 1rem;">留言内容</label>
              <div class="message">{inquiry.message}</div>
            </>
          )}
        </div>

        {lead && (
          <div class="card">
            <h2>Linked Lead #{lead.id}</h2>
            <dl>
              <dt>Grade</dt><dd><span class={`b b-${(lead.lead_grade || 'grey').toLowerCase()}`}>{lead.lead_grade || 'ungraded'}</span></dd>
              <dt>Score</dt><dd>{lead.lead_score || 0}</dd>
              <dt>Status</dt><dd>{lead.status}</dd>
              <dt>Source</dt><dd>{lead.source}</dd>
              <dt>Customer success</dt><dd><a href={`/admin/customers/${lead.id}/`}>打开客户协同档案</a></dd>
              <dt>Email step</dt><dd>{lead.email_sequence_step} / 8</dd>
              <dt>Last email</dt><dd>{fmtDate(lead.email_last_sent_at)}</dd>
              <dt>Notes</dt><dd>{stripWorkflowSummary(lead.notes) || '—'}</dd>
            </dl>
          </div>
        )}

        {lead && (
          <div class="card">
            <h2>报价与样品协同</h2>
            <div class="workflow-summary">
              <div><small>当前阶段</small><strong>{stageLabels[workflow.stage] || '询盘评估'}</strong></div>
              <div><small>报价</small><strong>{quoteLabels[workflow.quote] || '未开始'}</strong></div>
              <div><small>样品</small><strong>{sampleLabels[workflow.sample] || '未申请'}</strong></div>
              <div><small>下一动作</small><strong>{workflow.next_action && workflow.next_action !== 'not_set' ? workflow.next_action : '未设置'}</strong></div>
            </div>
            <form method="POST" action={`/api/admin/inquiries/?id=${id}`}>
              <input type="hidden" name="status" value={inquiry.status || 'new'} />
              <input type="hidden" name="lead_grade" value={inquiry.lead_grade || ''} />
              <div class="workflow-grid">
                <div>
                  <label for="deal_stage">转化阶段</label>
                  <select name="deal_stage" id="deal_stage">
                    {DEAL_STAGES.map((value) => <option value={value} selected={(workflow.stage || 'inquiry_review') === value}>{stageLabels[value]}</option>)}
                  </select>
                </div>
                <div>
                  <label for="quote_status">报价状态</label>
                  <select name="quote_status" id="quote_status">
                    {QUOTE_STATUSES.map((value) => <option value={value} selected={(workflow.quote || 'not_started') === value}>{quoteLabels[value]}</option>)}
                  </select>
                </div>
                <div>
                  <label for="sample_status">样品状态</label>
                  <select name="sample_status" id="sample_status">
                    {SAMPLE_STATUSES.map((value) => <option value={value} selected={(workflow.sample || 'not_requested') === value}>{sampleLabels[value]}</option>)}
                  </select>
                </div>
                <div>
                  <label for="next_action_date">下一动作日期</label>
                  <input type="date" name="next_action_date" id="next_action_date" value={workflow.next_action && workflow.next_action !== 'not_set' ? workflow.next_action : ''} />
                </div>
              </div>
              <label for="workflow_notes">跟进记录（保存到关联线索）</label>
              <textarea name="notes" id="workflow_notes">{stripWorkflowSummary(lead.notes)}</textarea>
              <button type="submit" class="primary">保存报价与样品进度</button>
            </form>
          </div>
        )}

        <div class="card">
          <h2>Update</h2>
          <form method="POST" action={`/api/admin/inquiries/?id=${id}`}>
            <label for="status">Status</label>
            <select name="status" id="status">
              <option value="new" selected={inquiry.status === 'new'}>new</option>
              <option value="contacted" selected={inquiry.status === 'contacted'}>contacted</option>
              <option value="qualified" selected={inquiry.status === 'qualified'}>qualified</option>
              <option value="won" selected={inquiry.status === 'won'}>won</option>
              <option value="lost" selected={inquiry.status === 'lost'}>lost</option>
            </select>

            <label for="lead_grade">Lead grade</label>
            <select name="lead_grade" id="lead_grade">
              <option value="" selected={!inquiry.lead_grade}>—</option>
              <option value="A" selected={inquiry.lead_grade === 'A'}>A</option>
              <option value="B" selected={inquiry.lead_grade === 'B'}>B</option>
              <option value="C" selected={inquiry.lead_grade === 'C'}>C</option>
              <option value="D" selected={inquiry.lead_grade === 'D'}>D</option>
            </select>

            {lead && (
              <>
                <label for="notes">Notes (saved to lead)</label>
                <textarea name="notes" id="notes">{lead.notes || ''}</textarea>
              </>
            )}

            <button type="submit" class="primary">Save changes</button>
          </form>
        </div>

        <div class="card">
          <h2>Tracking</h2>
          <dl>
            <dt>UTM source</dt><dd>{inquiry.utm_source || '—'}</dd>
            <dt>UTM medium</dt><dd>{inquiry.utm_medium || '—'}</dd>
            <dt>UTM campaign</dt><dd>{inquiry.utm_campaign || '—'}</dd>
            <dt>Referrer</dt><dd>{inquiry.referrer || '—'}</dd>
            <dt>IP</dt><dd>{inquiry.ip_address || '—'}</dd>
            <dt>User agent</dt><dd style="font-family: monospace; font-size: 0.75rem;">{inquiry.user_agent || '—'}</dd>
          </dl>
        </div>
      </>
    )}
  </div>
</body>
</html>
