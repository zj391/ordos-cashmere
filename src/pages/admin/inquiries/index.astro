---
// Admin inquiries list
// /admin/inquiries/
// - Table of all inquiries, filterable by grade/status/country
// - Link to /admin/inquiries/[id] for detail
// - CSV export link

export const prerender = false;

const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';

const url = new URL(Astro.request.url);
const grade = url.searchParams.get('grade') || '';
const status = url.searchParams.get('status') || '';
const country = url.searchParams.get('country') || '';
const search = url.searchParams.get('q') || '';
const market = url.searchParams.get('market') || '';
const sla = url.searchParams.get('sla') || '';
const source = url.searchParams.get('source') || '';

let inquiries: any[] = [];
let error = '';

if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    let q = '/rest/v1/inquiries?order=created_at.desc&limit=200&select=id,created_at,contact_name,company_name,country,email,phone,inquiry_type,locale,product_interest,quantity_kg,quantity_m,quantity_pcs,lead_grade,lead_score,status,message,utm_source';
    const filters: string[] = [];
    if (grade) filters.push(`lead_grade=eq.${grade}`);
    if (status) filters.push(`status=eq.${status}`);
    if (country) filters.push(`country=eq.${country}`);
    const safeSearch = search.trim().replace(/[(),.*]/g, '');
    if (safeSearch) filters.push(`or=(contact_name.ilike.*${safeSearch}*,company_name.ilike.*${safeSearch}*,email.ilike.*${safeSearch}*)`);
    if (filters.length) q += '&' + filters.join('&');

    const res = await fetch(SUPABASE_URL + q, {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY },
    });
    if (res.ok) {
      inquiries = await res.json();
    } else {
      error = `Supabase ${res.status}: ${(await res.text()).slice(0, 200)}`;
    }
  } catch (e) {
    error = e.message;
  }
}

const MARKET_GROUPS: Record<string, string[]> = {
  china: ['CN', 'HK', 'TW'],
  north_america: ['US', 'CA', 'MX'],
  europe: ['DE', 'FR', 'IT', 'ES', 'PT', 'NL', 'BE', 'CH', 'AT', 'PL', 'GB'],
  apac: ['JP', 'KR', 'SG', 'AU', 'NZ', 'IN', 'VN', 'TH', 'ID', 'PH', 'MY'],
  middle_east: ['AE', 'SA', 'TR'],
  latin_america: ['BR', 'AR'],
};

function marketForCountry(value: string | null | undefined) {
  const countryCode = String(value || '').toUpperCase();
  for (const [key, codes] of Object.entries(MARKET_GROUPS)) {
    if (codes.includes(countryCode)) return key;
  }
  return 'other';
}

function slaForInquiry(inquiry: any) {
  const ageHours = Math.max(0, (Date.now() - new Date(inquiry.created_at || Date.now()).getTime()) / 3_600_000);
  if (inquiry.status && inquiry.status !== 'new') return { key: 'progress', label: '已更新', hours: ageHours };
  if (ageHours >= 24) return { key: 'overdue', label: '超过 24 小时', hours: ageHours };
  if (ageHours >= 4) return { key: 'attention', label: '4–24 小时待跟进', hours: ageHours };
  return { key: 'awaiting', label: '4 小时内', hours: ageHours };
}

inquiries = inquiries.filter((inquiry) => {
  if (market && marketForCountry(inquiry.country) !== market) return false;
  if (sla && slaForInquiry(inquiry).key !== sla) return false;
  if (source && !(inquiry.utm_source || '').toLowerCase().includes(source.toLowerCase())) return false;
  return true;
});

// Summary stats
const byGrade: Record<string, number> = {};
const byStatus: Record<string, number> = {};
const slaCounts: Record<string, number> = { awaiting: 0, attention: 0, overdue: 0, progress: 0 };
inquiries.forEach(i => {
  const g = i.lead_grade || 'ungraded';
  byGrade[g] = (byGrade[g] || 0) + 1;
  const s = i.status || 'unknown';
  byStatus[s] = (byStatus[s] || 0) + 1;
  const queue = slaForInquiry(i).key;
  slaCounts[queue] = (slaCounts[queue] || 0) + 1;
});

function fmtDate(iso: string) {
  if (!iso) return '';
  return new Date(iso).toISOString().slice(0, 16).replace('T', ' ');
}

function badgeGrade(g: string | null) {
  if (!g) return '<span class="b b-grey">—</span>';
  return `<span class="b b-${g.toLowerCase()}">${g}</span>`;
}

function badgeStatus(s: string | null) {
  if (!s) return '<span class="b b-grey">—</span>';
  const colors: Record<string, string> = {
    new: 'blue', contacted: 'amber', qualified: 'green', won: 'emerald', lost: 'red',
  };
  return `<span class="b b-${colors[s] || 'grey'}">${s}</span>`;
}

function badgeSla(inquiry: any) {
  const queue = slaForInquiry(inquiry);
  return `<span class="b b-sla-${queue.key}">${queue.label}</span>`;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>询盘管理 — DONGXIAO 后台</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #fafaf9; color: #1c1917; padding: 1.5rem; }
    .header { max-width: 1400px; margin: 0 auto 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    h1 { font-size: 1.5rem; font-weight: 600; }
    .actions { display: flex; gap: 0.5rem; }
    a, button { font: inherit; cursor: pointer; padding: 0.5rem 1rem; border-radius: 0.375rem; border: 1px solid #d6d3d1; background: white; color: #1c1917; text-decoration: none; font-size: 0.875rem; }
    a:hover, button:hover { background: #f5f5f4; }
    .primary { background: #1c1917; color: white; border-color: #1c1917; }
    .primary:hover { background: #44403c; }
    .stats { max-width: 1400px; margin: 0 auto 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .stat { background: white; padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid #e7e5e4; }
    .stat-label { font-size: 0.75rem; color: #78716c; text-transform: uppercase; }
    .stat-value { font-size: 1.25rem; font-weight: 600; }
    .filters { max-width: 1400px; margin: 0 auto 1rem; background: white; padding: 1rem; border-radius: 0.5rem; border: 1px solid #e7e5e4; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: end; }
    .filter { display: flex; flex-direction: column; }
    .filter label { font-size: 0.75rem; color: #57534e; margin-bottom: 0.25rem; }
    .filter select, .filter input { padding: 0.4rem 0.6rem; border: 1px solid #d6d3d1; border-radius: 0.25rem; font: inherit; font-size: 0.875rem; }
    table { width: 100%; max-width: 1400px; margin: 0 auto; background: white; border-collapse: collapse; border: 1px solid #e7e5e4; border-radius: 0.5rem; overflow: hidden; }
    th { background: #f5f5f4; text-align: left; padding: 0.625rem 0.75rem; font-size: 0.75rem; text-transform: uppercase; color: #57534e; font-weight: 600; }
    td { padding: 0.625rem 0.75rem; font-size: 0.875rem; border-top: 1px solid #f5f5f4; }
    tr:hover { background: #fafaf9; }
    tr a { color: #1c1917; font-weight: 500; border: none; padding: 0; background: none; }
    tr a:hover { text-decoration: underline; }
    .b { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600; }
    .b-a { background: #d1fae5; color: #065f46; }
    .b-b { background: #fef3c7; color: #92400e; }
    .b-c { background: #dbeafe; color: #1e40af; }
    .b-d { background: #fee2e2; color: #991b1b; }
    .b-ungraded, .b-grey { background: #e7e5e4; color: #57534e; }
    .b-new { background: #dbeafe; color: #1e40af; }
    .b-contacted { background: #fef3c7; color: #92400e; }
    .b-qualified { background: #d1fae5; color: #065f46; }
    .b-won { background: #a7f3d0; color: #047857; }
    .b-lost { background: #fee2e2; color: #991b1b; }
    /* Row tinting by grade */
    tr.row-a { background: #f0fdf4; }
    tr.row-a:hover { background: #dcfce7; }
    tr.row-b { background: #fffbeb; }
    tr.row-b:hover { background: #fef3c7; }
    tr.row-d { background: #fef2f2; }
    tr.row-d:hover { background: #fee2e2; }
    /* Grade distribution bar chart */
    .dist { max-width: 1400px; margin: 0 auto 1rem; background: white; padding: 1rem; border-radius: 0.5rem; border: 1px solid #e7e5e4; }
    .dist h3 { font-size: 0.75rem; text-transform: uppercase; color: #57534e; margin-bottom: 0.75rem; font-weight: 600; }
    .dist-rows { display: flex; flex-direction: column; gap: 0.4rem; }
    .dist-row { display: grid; grid-template-columns: 60px 1fr 60px; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
    .dist-label { font-weight: 600; }
    .dist-bar { background: #f5f5f4; height: 1.25rem; border-radius: 0.25rem; overflow: hidden; }
    .dist-fill { height: 100%; transition: width 0.3s; }
    .dist-fill-a { background: linear-gradient(90deg, #10b981, #34d399); }
    .dist-fill-b { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .dist-fill-c { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .dist-fill-d { background: linear-gradient(90deg, #ef4444, #f87171); }
    .dist-count { font-weight: 600; text-align: right; }
    .err { background: #fee2e2; color: #991b1b; padding: 0.75rem 1rem; border-radius: 0.5rem; max-width: 1400px; margin: 0 auto 1rem; }
    .empty { padding: 3rem; text-align: center; color: #78716c; }
    .score-cell { font-family: ui-monospace, monospace; font-size: 0.75rem; color: #57534e; }
    .sla-panel { max-width: 1400px; margin: 0 auto 1rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
    .sla-card { display: block; background: white; border: 1px solid #e7e5e4; padding: 1rem; border-radius: 0.5rem; }
    .sla-card:hover { background: #fafaf9; }
    .sla-card small { display:block; color:#78716c; text-transform:uppercase; font-size:0.7rem; letter-spacing:.04em; margin-bottom:.35rem; }
    .sla-card strong { font-size:1.35rem; }
    .sla-card-overdue { border-color:#fecaca; background:#fff7f7; }
    .sla-card-attention { border-color:#fde68a; background:#fffbeb; }
    .b-sla-awaiting { background:#dbeafe; color:#1e40af; }
    .b-sla-attention { background:#fef3c7; color:#92400e; }
    .b-sla-overdue { background:#fee2e2; color:#991b1b; }
    .b-sla-progress { background:#d1fae5; color:#065f46; }
    .market { font-size:0.75rem; color:#57534e; text-transform:uppercase; letter-spacing:.03em; }
    @media (max-width: 720px) { .sla-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); } table { display:block; overflow-x:auto; } }
  </style>
</head>
<body>
  <div class="header">
    <div><h1>询盘运营</h1><p style="font-size:.8rem;color:#78716c;margin-top:.25rem">按优先级处理新询盘，并在首次联系后更新状态。</p></div>
    <div class="actions">
      <a href="/admin/customers/">客户协同</a>
      <a href="/api/admin/inquiries/?action=export&{url.searchParams.toString()}" class="primary">导出 CSV</a>
      <a href="/api/admin/auth?action=logout">退出登录</a>
    </div>
  </div>

  {error && <div class="err">Error: {error}</div>}

  <div class="stats">
    <div class="stat"><div class="stat-label">总计</div><div class="stat-value">{inquiries.length}</div></div>
    <div class="stat"><div class="stat-label">A 级</div><div class="stat-value">{byGrade['A'] || 0}</div></div>
    <div class="stat"><div class="stat-label">B 级</div><div class="stat-value">{byGrade['B'] || 0}</div></div>
    <div class="stat"><div class="stat-label">C 级</div><div class="stat-value">{byGrade['C'] || 0}</div></div>
    <div class="stat"><div class="stat-label">待首次联系</div><div class="stat-value">{byStatus['new'] || 0}</div></div>
    <div class="stat"><div class="stat-label">合格线索</div><div class="stat-value">{byStatus['qualified'] || 0}</div></div>
  </div>

  <div class="sla-panel" aria-label="首次响应 SLA 队列">
    <a class="sla-card" href="/admin/inquiries/?sla=awaiting"><small>4 小时内待跟进</small><strong>{slaCounts.awaiting || 0}</strong></a>
    <a class="sla-card sla-card-attention" href="/admin/inquiries/?sla=attention"><small>4–24 小时待跟进</small><strong>{slaCounts.attention || 0}</strong></a>
    <a class="sla-card sla-card-overdue" href="/admin/inquiries/?sla=overdue"><small>超过 24 小时</small><strong>{slaCounts.overdue || 0}</strong></a>
    <a class="sla-card" href="/admin/inquiries/?status=contacted"><small>已开始跟进</small><strong>{byStatus.contacted || 0}</strong></a>
  </div>

  <div class="dist">
    <h3>线索等级分布</h3>
    <div class="dist-rows">
      {(() => {
        const total = Math.max(1, inquiries.length);
        const a = byGrade['A'] || 0;
        const b = byGrade['B'] || 0;
        const c = byGrade['C'] || 0;
        const d = byGrade['D'] || 0;
        const max = Math.max(1, a, b, c, d);
        return (
          <>
            <div class="dist-row">
              <div class="dist-label" style="color:#065f46">A</div>
              <div class="dist-bar"><div class="dist-fill dist-fill-a" style={`width:${(a/max)*100}%`}></div></div>
              <div class="dist-count">{a} ({Math.round((a/total)*100)}%)</div>
            </div>
            <div class="dist-row">
              <div class="dist-label" style="color:#92400e">B</div>
              <div class="dist-bar"><div class="dist-fill dist-fill-b" style={`width:${(b/max)*100}%`}></div></div>
              <div class="dist-count">{b} ({Math.round((b/total)*100)}%)</div>
            </div>
            <div class="dist-row">
              <div class="dist-label" style="color:#1e40af">C</div>
              <div class="dist-bar"><div class="dist-fill dist-fill-c" style={`width:${(c/max)*100}%`}></div></div>
              <div class="dist-count">{c} ({Math.round((c/total)*100)}%)</div>
            </div>
            <div class="dist-row">
              <div class="dist-label" style="color:#991b1b">D</div>
              <div class="dist-bar"><div class="dist-fill dist-fill-d" style={`width:${(d/max)*100}%`}></div></div>
              <div class="dist-count">{d} ({Math.round((d/total)*100)}%)</div>
            </div>
          </>
        );
      })()}
    </div>
  </div>

  <form class="filters" method="GET">
    <div class="filter">
      <label>搜索</label>
      <input type="text" name="q" value={search} placeholder="姓名 / 公司 / 邮箱">
    </div>
    <div class="filter">
      <label>等级</label>
      <select name="grade">
        <option value="">全部</option>
        <option value="A" selected={grade === 'A'}>A</option>
        <option value="B" selected={grade === 'B'}>B</option>
        <option value="C" selected={grade === 'C'}>C</option>
        <option value="D" selected={grade === 'D'}>D</option>
      </select>
    </div>
    <div class="filter">
      <label>状态</label>
      <select name="status">
        <option value="">全部</option>
        <option value="new" selected={status === 'new'}>新询盘</option>
        <option value="contacted" selected={status === 'contacted'}>已联系</option>
        <option value="qualified" selected={status === 'qualified'}>合格</option>
        <option value="won" selected={status === 'won'}>成交</option>
        <option value="lost" selected={status === 'lost'}>流失</option>
      </select>
    </div>
    <div class="filter">
      <label>国家</label>
      <input type="text" name="country" value={country} placeholder="US / IT / DE...">
    </div>
    <div class="filter">
      <label>市场</label>
      <select name="market">
        <option value="">全部</option>
        <option value="china" selected={market === 'china'}>中国 / 大中华</option>
        <option value="north_america" selected={market === 'north_america'}>北美</option>
        <option value="europe" selected={market === 'europe'}>欧洲</option>
        <option value="apac" selected={market === 'apac'}>亚太</option>
        <option value="middle_east" selected={market === 'middle_east'}>中东</option>
        <option value="latin_america" selected={market === 'latin_america'}>拉丁美洲</option>
        <option value="other" selected={market === 'other'}>其他市场</option>
      </select>
    </div>
    <div class="filter">
      <label>首次响应 SLA</label>
      <select name="sla">
        <option value="">全部</option>
        <option value="awaiting" selected={sla === 'awaiting'}>4 小时内待跟进</option>
        <option value="attention" selected={sla === 'attention'}>4–24 小时待跟进</option>
        <option value="overdue" selected={sla === 'overdue'}>超过 24 小时</option>
      </select>
    </div>
    <div class="filter">
      <label>来源</label>
      <input type="text" name="source" value={source} placeholder="google / linkedin...">
    </div>
    <button type="submit">筛选</button>
    <a href="/admin/inquiries/">清除</a>
  </form>

  {inquiries.length === 0 ? (
    <table><tr><td class="empty">没有匹配的询盘。</td></tr></table>
  ) : (
    <table>
      <thead>
        <tr>
          <th>日期</th>
          <th>联系人</th>
          <th>公司</th>
          <th>国家</th>
          <th>市场</th>
          <th>类型</th>
          <th>产品</th>
          <th>数量</th>
          <th>等级</th>
          <th>评分</th>
          <th>首次响应</th>
          <th>状态</th>
        </tr>
      </thead>
      <tbody>
        {inquiries.map((i) => (
          <tr class={`row-${(i.lead_grade || 'ungraded').toLowerCase()} sla-${slaForInquiry(i).key}`}>
            <td>{fmtDate(i.created_at)}</td>
            <td><a href={`/admin/inquiries/${i.id}/`}>{i.contact_name}</a></td>
            <td>{i.company_name}</td>
            <td>{i.country}</td>
            <td><span class="market">{marketForCountry(i.country)}</span></td>
            <td>{i.inquiry_type}</td>
            <td>{i.product_interest || '—'}</td>
            <td>{i.quantity_kg || i.quantity_m || i.quantity_pcs || '—'}</td>
            <td set:html={badgeGrade(i.lead_grade)} />
            <td class="score-cell">{i.lead_score ?? '—'}</td>
            <td set:html={badgeSla(i)} />
            <td set:html={badgeStatus(i.status)} />
          </tr>
        ))}
      </tbody>
    </table>
  )}
</body>
</html>
