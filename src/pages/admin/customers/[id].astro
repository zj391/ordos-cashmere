---
// Customer success profile — protected by src/middleware.ts.
export const prerender = false;
import { ACCOUNT_TIERS, SERVICE_CADENCES, readCustomerSuccess, stripCustomerSuccessSummary } from '../../../lib/customer-success';
import { stripWorkflowSummary } from '../../../lib/deal-workflow';
const { id } = Astro.params;
const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';
let lead: any = null; let inquiries: any[] = []; let error = '';
if (SUPABASE_URL && SUPABASE_KEY) { try { const headers = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY }; const leadRes = await fetch(`${SUPABASE_URL}/rest/v1/leads?id=eq.${encodeURIComponent(id)}&limit=1`, { headers }); if (leadRes.ok) { lead = (await leadRes.json())?.[0] || null; if (lead?.email) { const inquiryRes = await fetch(`${SUPABASE_URL}/rest/v1/inquiries?email=eq.${encodeURIComponent(lead.email)}&order=created_at.desc&limit=100&select=id,created_at,inquiry_type,product_interest,lead_grade,status,quantity_kg,quantity_m,quantity_pcs,message`, { headers }); if (inquiryRes.ok) inquiries = await inquiryRes.json(); } } else error = `Supabase ${leadRes.status}`; } catch (err: any) { error = err.message; } }
const profile = readCustomerSuccess(lead?.notes);
const plainNotes = stripWorkflowSummary(stripCustomerSuccessSummary(lead?.notes));
const tierLabels: Record<string, string> = { strategic: '重点客户', active: '活跃客户', nurture: '培育客户', paused: '暂停跟进' };
const cadenceLabels: Record<string, string> = { weekly: '每周', monthly: '每月', quarterly: '每季度' };
function fmtDate(value: string) { return value ? new Date(value).toISOString().slice(0, 16).replace('T',' ') : '—'; }
---
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>客户协同 — DONGXIAO 后台</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:system-ui,sans-serif;background:#fafaf9;color:#1c1917;padding:1.5rem}.wrap{max-width:1100px;margin:auto}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem}.header h1{font-size:1.35rem}.header p{font-size:.8rem;color:#78716c;margin-top:.25rem}a,button{font:inherit;cursor:pointer;padding:.5rem 1rem;border-radius:.375rem;border:1px solid #d6d3d1;background:white;color:#1c1917;text-decoration:none;font-size:.875rem}a:hover,button:hover{background:#f5f5f4}.primary{background:#1c1917;color:#fff;border-color:#1c1917}.card{background:#fff;border:1px solid #e7e5e4;border-radius:.5rem;padding:1.4rem;margin-bottom:1rem}.card h2{font-size:1rem;text-transform:uppercase;letter-spacing:.025em;color:#57534e;margin-bottom:1rem}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.summary div{background:#f5f5f4;border-radius:.375rem;padding:.75rem}.summary small{display:block;color:#78716c;text-transform:uppercase;font-size:.7rem;margin-bottom:.25rem}dl{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.2rem;font-size:.875rem}dt{color:#78716c}dd{word-break:break-word}label{display:block;font-size:.72rem;color:#57534e;text-transform:uppercase;margin-bottom:.25rem;font-weight:600}select,input,textarea{width:100%;padding:.5rem .7rem;border:1px solid #d6d3d1;border-radius:.375rem;font:inherit;font-size:.875rem;margin-bottom:1rem}textarea{min-height:110px;resize:vertical}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.table{width:100%;border-collapse:collapse}.table th{text-align:left;background:#f5f5f4;padding:.65rem;font-size:.72rem;color:#57534e;text-transform:uppercase}.table td{padding:.65rem;border-top:1px solid #f5f5f4;font-size:.85rem}.message{background:#f5f5f4;padding:.7rem;border-radius:.375rem;white-space:pre-wrap;font-size:.82rem}.err{background:#fee2e2;color:#991b1b;padding:.75rem;border-radius:.5rem}@media(max-width:720px){.header{align-items:flex-start;flex-direction:column}.summary,.grid{grid-template-columns:1fr}.table{display:block;overflow-x:auto}}</style></head><body><main class="wrap"><header class="header"><div><h1>{lead?.company_name || '客户协同档案'}</h1><p>服务节奏、资料版本和历史询盘汇总。</p></div><div><a href="/admin/customers/">← 客户协同</a> <a class="primary" href="/api/admin/auth?action=logout">退出登录</a></div></header>{error && <div class="err">{error}</div>}{!lead ? <div class="card">未找到客户协同档案。</div> : <><section class="card"><h2>客户概览</h2><div class="summary"><div><small>服务层级</small><strong>{tierLabels[profile.tier || 'nurture'] || '培育客户'}</strong></div><div><small>服务节奏</small><strong>{cadenceLabels[profile.cadence || 'quarterly'] || '每季度'}</strong></div><div><small>下次复盘</small><strong>{profile.next_review && profile.next_review !== 'not_set' ? profile.next_review : '未设置'}</strong></div><div><small>历史询盘</small><strong>{inquiries.length}</strong></div></div></section><section class="card"><h2>联系人与客户信息</h2><dl><dt>联系人</dt><dd>{lead.contact_name || '—'}</dd><dt>邮箱</dt><dd><a href={`mailto:${lead.email}`}>{lead.email}</a></dd><dt>电话</dt><dd>{lead.phone || '—'}</dd><dt>国家</dt><dd>{lead.country || '—'}</dd><dt>业务类型</dt><dd>{lead.industry || '—'}</dd><dt>线索等级</dt><dd>{lead.lead_grade || '—'} / {lead.lead_score ?? '—'}</dd></dl></section><section class="card"><h2>客户服务节奏与资料版本</h2><form method="POST" action={`/api/admin/customers/?id=${id}`}><div class="grid"><div><label for="account_tier">服务层级</label><select id="account_tier" name="account_tier">{ACCOUNT_TIERS.map((value) => <option value={value} selected={(profile.tier || 'nurture')===value}>{tierLabels[value]}</option>)}</select></div><div><label for="service_cadence">服务节奏</label><select id="service_cadence" name="service_cadence">{SERVICE_CADENCES.map((value) => <option value={value} selected={(profile.cadence || 'quarterly')===value}>{cadenceLabels[value]}</option>)}</select></div><div><label for="next_review_date">下次复盘日期</label><input id="next_review_date" name="next_review_date" type="date" value={profile.next_review && profile.next_review !== 'not_set' ? profile.next_review : ''} /></div><div><label for="catalog_version">已发送目录版本</label><input id="catalog_version" name="catalog_version" value={profile.catalog_version && profile.catalog_version !== 'not_set' ? profile.catalog_version : ''} placeholder="例如：FW26 wholesale catalog" /></div><div><label for="color_card_version">已发送色卡版本</label><input id="color_card_version" name="color_card_version" value={profile.color_card_version && profile.color_card_version !== 'not_set' ? profile.color_card_version : ''} placeholder="例如：AW26 color card" /></div></div><label for="notes">客户服务记录</label><textarea id="notes" name="notes">{plainNotes}</textarea><button class="primary" type="submit">保存客户协同记录</button></form></section><section class="card"><h2>历史询盘</h2>{inquiries.length===0?<p style="color:#78716c">暂无关联询盘。</p>:<table class="table"><thead><tr><th>时间</th><th>类型</th><th>产品</th><th>数量</th><th>状态</th></tr></thead><tbody>{inquiries.map((item)=><tr><td><a href={`/admin/inquiries/${item.id}/`}>{fmtDate(item.created_at)}</a></td><td>{item.inquiry_type || '—'}</td><td>{item.product_interest || '—'}</td><td>{item.quantity_kg || item.quantity_m || item.quantity_pcs || '—'}</td><td>{item.status || '—'}</td></tr>)}</tbody></table>}</section></>}</main></body></html>
