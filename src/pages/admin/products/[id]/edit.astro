---
/**
 * Admin /admin/products/[id]/edit — inline edit form for one product.
 *
 * Layout: a 2-column form: left = the editable fields, right = image previews + meta.
 * Submits to POST /api/admin/products/[id] which PATCHes the row.
 *
 * Phase 2 status: backend wired (POST handler reads JSON file / Supabase depending on env).
 * The Supabase migration is documented in docs/products-table.sql.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { LOCALES } from '@/lib/i18n';
import { products as productsData, getCategoryImageUrl } from '@/data/products';

function getAdminLocale(req: Request): string {
  const cookieHeader = req.headers.get('cookie') || '';
  const m = cookieHeader.match(/(?:^|;\s*)admin-locale=([^;]+)/);
  if (m && LOCALES.some((l) => l === m[1])) return m[1]!;
  return LOCALES[0];
}
const locale = getAdminLocale(Astro.request);

const { id } = Astro.params;

// Locate the product in the static catalog (fallback base)
let found: { category: string; categoryId: string; cat: any; product: any } | null = null;
for (const cat of productsData.categories) {
  const product = cat.products.find((p) => p.id === id);
  if (product) {
    found = { category: cat.name, categoryId: cat.id, cat, product };
    break;
  }
}

// Phase 1.5: the DB is the source of truth for admin editing — overlay the row
// so DB-only products (added via /admin/products/new) can be edited too, and
// so saved edits are shown on the next load.
const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';
let dbRow: Record<string, any> | null = null;
const dbCatNames = new Map<string, string>();
if (SUPABASE_URL && SUPABASE_KEY && id) {
  try {
    const headers = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` };
    const [catsRes, prodRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/categories?select=id,name`, { headers }),
      fetch(
        `${SUPABASE_URL}/rest/v1/products?id=eq.${encodeURIComponent(id)}&select=id,category_id,code,name,moq,price,currency,material,micron,lead,description,colors,images,tags,weight,sample_time`,
        { headers }
      ),
    ]);
    if (catsRes.ok) {
      for (const c of (await catsRes.json()) as Array<{ id: string; name: string }>) {
        dbCatNames.set(c.id, c.name);
      }
    }
    if (prodRes.ok) {
      const rows = (await prodRes.json()) as any[];
      dbRow = rows[0] ?? null;
    }
  } catch {
    /* DB unreachable — fall back to the static catalog */
  }
}

if (dbRow) {
  const catId = String(dbRow.category_id ?? '');
  const catName = dbCatNames.get(catId) || found?.category || catId;
  const base = found?.product ?? {};
  const product = {
    ...base,
    id: String(dbRow.id ?? id),
    name: String(dbRow.name ?? base.name ?? ''),
    code: dbRow.code != null ? String(dbRow.code) : (base.code ?? ''),
    moq: dbRow.moq != null ? dbRow.moq : base.moq,
    price: dbRow.price != null ? String(dbRow.price) : (base.price ?? ''),
    currency: dbRow.currency ? String(dbRow.currency) : (base.currency ?? 'USD'),
    material: dbRow.material != null ? String(dbRow.material) : (base.material ?? ''),
    micron: dbRow.micron != null ? String(dbRow.micron) : (base.micron ?? ''),
    lead: dbRow.lead != null ? String(dbRow.lead) : (base.lead ?? ''),
    description: dbRow.description != null ? String(dbRow.description) : (base.description ?? ''),
    colors: Array.isArray(dbRow.colors) ? dbRow.colors : (base.colors ?? []),
    images: Array.isArray(dbRow.images) ? dbRow.images : (base.images ?? []),
    tags: Array.isArray(dbRow.tags) ? dbRow.tags : (base.tags ?? []),
    weight: dbRow.weight != null ? String(dbRow.weight) : (base.weight ?? ''),
    sample_time: dbRow.sample_time != null ? String(dbRow.sample_time) : (base.sample_time ?? ''),
  };
  found = { category: catName, categoryId: catId, cat: found?.cat ?? null, product };
}

if (!found) {
  // Show a friendly 404 inside the admin chrome
  return new Response('Product not found', { status: 404 });
}

const L = (en: string, cn: string) => (locale === 'cn' ? cn : en);
const p = found.product;
const cover = p.images?.[0] ?? '';

// Read ?saved=1 query to show confirmation; ?saved=preview = form wired but backend stub.
const url = new URL(Astro.request.url);
const justSaved = url.searchParams.get('saved') === '1';
const savedPreview = url.searchParams.get('saved') === 'preview';
const saveError = url.searchParams.get('error') || '';
const noSupabase = url.searchParams.get('notice') === 'no_supabase';
---
<AdminLayout locale={locale} activeNav="products" title={L('Edit product', '编辑产品')} breadcrumb={[L('Products', '产品管理'), p.name]}>
  <a href={`/admin/products/?cat=${found.categoryId}`} class="mb-4 inline-flex items-center gap-1 text-sm text-stone-600 hover:text-primary">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    {L('Back to product list', '返回产品列表')}
  </a>

  {justSaved && (
    <div class="mb-4 rounded-md border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-800">
      ✓ {L('Saved to Supabase. Reload the catalog to see the change.', '已写入 Supabase。重新加载产品列表可见变更。')}
    </div>
  )}
  {savedPreview && noSupabase && (
    <div class="mb-4 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
      ⚠️ {L('Form submitted, but no Supabase credentials / products table found. Backend is in preview-only mode. See docs/products-table.sql.', '表单已提交，但缺少 Supabase 凭证或 products 表。Backend 当前为 preview 模式。详见 docs/products-table.sql。')}
    </div>
  )}
  {savedPreview && !noSupabase && (
    <div class="mb-4 rounded-md border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-800">
      ✓ {L('Preview saved.', '预览已保存。')}
    </div>
  )}
  {saveError && (
    <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-800">
      ✗ {decodeURIComponent(saveError)}
    </div>
  )}

  <form method="post" action={`/api/admin/products/${p.id}`} class="grid gap-6 lg:grid-cols-3">
    <!-- Left: editable fields -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basics -->
      <div class="rounded-lg border border-stone-200 bg-white p-5">
        <h3 class="mb-4 text-sm font-medium text-stone-500 uppercase tracking-wider">{L('Basics', '基本信息')}</h3>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="block md:col-span-2">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Product name', '产品名称')}</span>
            <input
              name="name"
              value={p.name}
              required
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Code', '编号')}</span>
            <input
              name="code"
              value={(p as any).code ?? ''}
              placeholder="DX-XX-000"
              class="w-full rounded-md border border-stone-300 px-3 py-2 font-mono text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('MOQ', '起订量')}</span>
            <input
              type="number"
              name="moq"
              value={p.moq}
              min="1"
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Price', '价格')}</span>
            <input
              name="price"
              value={p.price}
              placeholder="9.2-16.5"
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Currency', '货币')}</span>
            <select name="currency" class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
              <option value="USD" selected={(p as any).currency === 'USD'}>USD</option>
              <option value="EUR" selected={(p as any).currency === 'EUR'}>EUR</option>
              <option value="CNY" selected={(p as any).currency === 'CNY'}>CNY</option>
            </select>
          </label>
        </div>
      </div>

      <!-- Spec -->
      <div class="rounded-lg border border-stone-200 bg-white p-5">
        <h3 class="mb-4 text-sm font-medium text-stone-500 uppercase tracking-wider">{L('Specifications', '规格参数')}</h3>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="block md:col-span-2">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Material', '材质')}</span>
            <input
              name="material"
              value={p.material}
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Micron (μm)', '细度 (μm)')}</span>
            <input
              name="micron"
              value={p.micron}
              placeholder="14–15.5"
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Lead time', '交货期')}</span>
            <input
              name="lead"
              value={p.lead}
              placeholder="30–35 days"
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </label>
          <label class="block md:col-span-2">
            <span class="mb-1 block text-sm font-medium text-stone-700">{L('Description', '描述')}</span>
            <textarea
              name="description"
              rows="4"
              class="w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            >{p.description}</textarea>
          </label>
        </div>
      </div>

      <!-- Submit row -->
      <div class="flex items-center justify-between">
        <a href={`/admin/products/?cat=${found.categoryId}`} class="text-sm text-stone-600 hover:text-primary">
          {L('Cancel', '取消')}
        </a>
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          {L('Save changes', '保存')}
        </button>
      </div>
    </div>

    <!-- Right: previews + meta -->
    <div class="space-y-4">
      <!-- Cover preview + upload -->
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="mb-2 text-xs uppercase tracking-wider text-stone-500">{L('Cover image', '封面图')}</div>
        <div id="cover-preview" class="aspect-square w-full rounded border border-stone-200 bg-stone-100 flex items-center justify-center text-xs text-stone-400 overflow-hidden">
          {cover ? (
            <img src={getCategoryImageUrl(cover)} alt={p.name} class="w-full h-full object-cover" />
          ) : (
            <span>{L('No image', '无图片')}</span>
          )}
        </div>
        <input type="hidden" name="cover" id="cover-input" value={cover} />
        <div class="mt-3 flex items-center gap-2">
          <input id="img-input" type="file" accept="image/jpeg,image/png,image/webp" class="block w-full text-xs text-stone-500 file:mr-2 file:rounded file:border-0 file:bg-stone-100 file:px-3 file:py-1.5 file:text-xs file:font-medium hover:file:bg-stone-200" />
          <button type="button" id="img-upload-btn" class="shrink-0 rounded bg-stone-800 px-3 py-1.5 text-xs text-white hover:bg-stone-700">{L('Upload', '上传')}</button>
        </div>
        <p class="mt-2 text-xs text-stone-500">{L('Upload images (JPG/PNG/WebP, max 5MB each). First image becomes the cover. Click X to remove.', '上传图片（JPG/PNG/WebP，单张≤5MB）。第一张为封面。悬停图片点 X 删除。')}</p>
        <div id="img-grid" class="mt-3 grid grid-cols-3 gap-2"></div>
        <input type="hidden" name="images" id="images-input" value={JSON.stringify(p.images ?? [])} />
      </div>

      <!-- Meta -->
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="mb-3 text-xs uppercase tracking-wider text-stone-500">{L('Product meta', '产品元数据')}</div>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-stone-500">{L('ID', 'ID')}</dt>
            <dd class="font-mono text-stone-700">{p.id}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-stone-500">{L('Category', '类别')}</dt>
            <dd class="text-stone-700">{found.category}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-stone-500">{L('Image count', '图片数')}</dt>
            <dd class="text-stone-700">{p.images?.length ?? 0}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-stone-500">{L('Sample time', '打样周期')}</dt>
            <dd class="text-stone-700">{p.sample_time || '—'}</dd>
          </div>
        </dl>
      </div>

      <!-- Quick preview links -->
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="mb-2 text-xs uppercase tracking-wider text-stone-500">{L('Quick links', '快捷链接')}</div>
        <div class="space-y-1 text-sm">
          <a href={`/${locale === 'cn' ? '' : locale + '/'}products/${p.id}`} target="_blank" rel="noopener" class="block text-primary hover:underline">
            {L('View on site →', '在网站上查看 →')}
          </a>
          <a href="/api/admin/products/export.csv" class="block text-stone-500 hover:text-primary">
            {L('Export all (CSV)', '导出全部 (CSV)')}
          </a>
        </div>
      </div>
    </div>
  </form>

  <script>
    const imgInput = document.getElementById('img-input');
    const uploadBtn = document.getElementById('img-upload-btn');
    const imagesInput = document.getElementById('images-input');
    const coverInput = document.getElementById('cover-input');
    const coverPreview = document.getElementById('cover-preview');
    const grid = document.getElementById('img-grid');
    let images = [];
    try { images = JSON.parse(imagesInput.value || '[]'); } catch (e) { images = []; }
    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function render() {
      imagesInput.value = JSON.stringify(images);
      grid.innerHTML = '';
      images.forEach((url, i) => {
        const d = document.createElement('div');
        d.className = 'relative aspect-square rounded border border-stone-200 overflow-hidden group';
        d.innerHTML =
          '<img src="' + esc(url) + '" class="w-full h-full object-cover" alt="img' + i + '" />' +
          '<button type="button" class="absolute top-1 right-1 rounded bg-red-600/90 px-1.5 py-0.5 text-[10px] text-white opacity-0 group-hover:opacity-100" data-i="' + i + '">✕</button>' +
          (i === 0 ? '<span class="absolute bottom-1 left-1 rounded bg-stone-800/80 px-1 py-0.5 text-[9px] text-white">COVER</span>' : '');
        d.querySelector('button').addEventListener('click', () => { images.splice(i, 1); render(); });
        grid.appendChild(d);
      });
      if (images.length > 0 && coverInput) {
        coverInput.value = images[0];
        coverPreview.innerHTML = '<img src="' + esc(images[0]) + '" class="w-full h-full object-cover" alt="cover" />';
      } else if (coverInput) {
        coverPreview.innerHTML = '<span>No image</span>';
      }
    }
    uploadBtn.addEventListener('click', () => imgInput.click());
    imgInput.addEventListener('change', async () => {
      const file = imgInput.files && imgInput.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { alert('图片不能超过 5MB / Max 5MB'); imgInput.value = ''; return; }
      uploadBtn.disabled = true; uploadBtn.textContent = '...';
      try {
        const dataUrl = await new Promise((resolve, reject) => {
          const r = new FileReader();
          r.onload = () => resolve(String(r.result));
          r.onerror = reject;
          r.readAsDataURL(file);
        });
        const data = dataUrl.split(',')[1];
        const r = await fetch('/api/admin/products/new/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'upload', filename: file.name, data }),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || 'upload failed');
        images.push(j.url);
        render();
        alert('上传成功 / Uploaded');
      } catch (e) {
        alert('上传失败: ' + e.message + ' / Upload failed');
      } finally {
        uploadBtn.disabled = false; uploadBtn.textContent = 'Upload';
        imgInput.value = '';
      }
    });
    render();
  </script>
</AdminLayout>
