---
/**
 * Admin /admin/downloads/ 鈥?download center resources + lead captures.
 * Lists the resource cards shown on the public download page and the
 * download-lead capture stats from Supabase (download_leads table).
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { LOCALES } from '@/lib/i18n';

function getAdminLocale(req: Request): string {
  const cookieHeader = req.headers.get('cookie') || '';
  const m = cookieHeader.match(/(?:^|;\s*)admin-locale=([^;]+)/);
  if (m && LOCALES.some((l) => l === m[1])) return m[1]!;
  return LOCALES[0];
}
const locale = getAdminLocale(Astro.request);
const L = (en: string, cn: string) => (locale === 'cn' ? cn : en);

// Mirror of the public download page resource cards (src/pages/[locale]/download.astro)
const downloads = [
  { type: 'catalog', titleEn: 'Product Catalog 2024', titleCn: '产品目录 2024', size: '12.4 MB', format: 'PDF' },
  { type: 'specs', titleEn: 'Raw Material Specifications', titleCn: '羊绒原料规格表', size: '2.1 MB', format: 'PDF' },
  { type: 'cert', titleEn: 'ISO 9001 Certificate', titleCn: 'ISO 9001 证书', size: '0.8 MB', format: 'PDF' },
  { type: 'cert', titleEn: 'OEKO-TEX Certificate', titleCn: 'OEKO-TEX 证书', size: '1.2 MB', format: 'PDF' },
  { type: 'cert', titleEn: 'Good Cashmere Standard', titleCn: 'Good Cashmere Standard', size: '0.9 MB', format: 'PDF' },
  { type: 'report', titleEn: 'Factory Audit Report', titleCn: '工厂验厂报告', size: '5.6 MB', format: 'PDF' },
];

// Download lead stats from Supabase (best-effort)
const SUPABASE_URL = process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_KEY || '';
let leadCount = 0;
let leadError = '';
let recentLeads: Array<Record<string, unknown>> = [];
if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/download_leads?select=id&limit=1`,
      { headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY } }
    );
    if (res.ok) {
      const range = res.headers.get('content-range') || '';
      const total = range.split('/')[1];
      leadCount = total && total !== '*' ? parseInt(total, 10) : 0;
      if (isNaN(leadCount)) leadCount = 0;
      const r2 = await fetch(
        `${SUPABASE_URL}/rest/v1/download_leads?order=created_at.desc&limit=10&select=created_at,contact_name,company_name,contact_email,country,download_title`,
        { headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY } }
      );
      if (r2.ok) recentLeads = await r2.json();
    } else {
      leadError = `HTTP ${res.status}`;
    }
  } catch (e: any) {
    leadError = String(e?.message || e);
  }
}

const TYPE_LABEL: Record<string, { en: string; cn: string }> = {
  catalog: { en: 'Catalog', cn: '目录' },
  specs: { en: 'Specs', cn: '规格' },
  cert: { en: 'Certificate', cn: '证书' },
  report: { en: 'Report', cn: '报告' },
};
---
<AdminLayout locale={locale} activeNav="downloads" title={L('Download Center', '下载资源')} breadcrumb={[L('Downloads', '下载资源')]}>
  <div class="grid gap-6 lg:grid-cols-3">
    <!-- Resource cards -->
    <div class="lg:col-span-2 rounded-lg border border-stone-200 bg-white p-5">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Resource cards', '下载资源卡片')}</h3>
      <div class="space-y-2">
        {downloads.map((d, i) => (
          <div class="flex items-center gap-4 rounded-lg border border-stone-200 p-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-stone-100 text-stone-500">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="truncate text-sm font-medium text-stone-900">{locale === 'cn' ? d.titleCn : d.titleEn}</div>
              <div class="text-xs text-stone-500">{TYPE_LABEL[d.type]?.[locale === 'cn' ? 'cn' : 'en'] || d.type} 路 {d.format} 路 {d.size}</div>
            </div>
            <span class="text-xs text-stone-400">#{i + 1}</span>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-stone-500">
        {L('Resources are defined in the download page source. To add or change a file, update the download page and redeploy.', '资源定义在下载页面源码中。新增或修改文件请更新下载页面后重新部署。')}
      </p>
    </div>

    <!-- Lead capture stats -->
    <div class="rounded-lg border border-stone-200 bg-white p-5">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-stone-500">{L('Lead captures', '留资统计')}</h3>
      <div class="mb-4 rounded-lg border border-stone-200 bg-stone-50 p-4 text-center">
        <div class="text-3xl font-light text-stone-900">{leadCount.toLocaleString()}</div>
        <div class="mt-1 text-xs text-stone-500">{L('total download leads', '累计下载留资')}</div>
      </div>
      {leadError && (
        <div class="mb-3 rounded-md border border-amber-300 bg-amber-50 p-2 text-xs text-amber-800">
          {L('Supabase unavailable:', 'Supabase 不可用：')} {leadError}
        </div>
      )}
      {recentLeads.length > 0 ? (
        <div class="space-y-2">
          {recentLeads.map((r) => (
            <div class="rounded border border-stone-100 p-2 text-xs">
              <div class="truncate font-medium text-stone-800">{String(r.company_name || r.contact_name || '—')}</div>
              <div class="truncate text-stone-500">{String(r.contact_email || '')}</div>
              <div class="text-stone-400">{String(r.country || '')} 路 {String(r.download_title || '')}</div>
            </div>
          ))}
        </div>
      ) : !leadError ? (
        <div class="text-center text-sm text-stone-400">{L('No leads captured yet.', '暂无留资记录。')}</div>
      ) : null}
    </div>
  </div>
</AdminLayout>
