---
/**
 * Admin /admin/news/ 鈥?blog post management.
 * Reads every post from the Astro content collection (src/content/blog/{locale}/*.md)
 * and groups them by locale. Read-only list: posts are generated by the daily
 * blog automation and edited in the repo, so this page is the status overview.
 */
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { LOCALES } from '@/lib/i18n';
import { getCollection } from 'astro:content';

function getAdminLocale(req: Request): string {
  const cookieHeader = req.headers.get('cookie') || '';
  const m = cookieHeader.match(/(?:^|;\s*)admin-locale=([^;]+)/);
  if (m && LOCALES.some((l) => l === m[1])) return m[1]!;
  return LOCALES[0];
}
const locale = getAdminLocale(Astro.request);
const L = (en: string, cn: string) => (locale === 'cn' ? cn : en);

const LOCALE_LABEL: Record<string, string> = {
  en: 'English', cn: '中文', de: 'Deutsch', fr: 'Français', ja: '日本語', kr: '한국어',
};

// Load all blog posts (Astro content collection)
const allPosts = await getCollection('blog');
const posts = allPosts.map((p) => {
  const parts = p.id.split('/');
  const loc = parts[0] || 'en';
  const slug = p.id.replace(/\.md$/, '').split('/').slice(1).join('/') || p.id;
  const body = (p.body || '');
  return {
    locale: loc,
    slug,
    title: p.data.title || '',
    excerpt: p.data.excerpt || '',
    date: p.data.publishDate ? p.data.publishDate.toISOString().slice(0, 10) : '',
    tags: Array.isArray(p.data.tags) ? p.data.tags : [],
    aiGenerated: Boolean((p.data as any).aiGenerated),
    words: body.trim() ? body.trim().split(/\s+/).length : 0,
  };
});

// Group by locale
const byLocale: Record<string, typeof posts> = {};
for (const p of posts) {
  (byLocale[p.locale] = byLocale[p.locale] || []).push(p);
}
const localeOrder = ['en', 'cn', 'de', 'fr', 'ja', 'kr'];
const totalPosts = posts.length;

// Search + locale filter from query string
const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim().toLowerCase();
const locFilter = url.searchParams.get('locale') || '';

let filtered = posts;
if (locFilter) filtered = filtered.filter((p) => p.locale === locFilter);
if (q) {
  filtered = filtered.filter((p) =>
    (p.title + ' ' + p.slug + ' ' + p.excerpt).toLowerCase().includes(q)
  );
}
filtered = filtered.sort((a, b) => (a.date < b.date ? 1 : -1));

const buildHref = (over: Record<string, string>) => {
  const params = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(over)) {
    if (v) params.set(k, v); else params.delete(k);
  }
  const s = params.toString();
  return s ? `/admin/news/?${s}` : '/admin/news/';
};
---
<AdminLayout locale={locale} activeNav="news" title={L('News / Blog', '新闻 / 博客管理')} breadcrumb={[L('News', '新闻管理')]}>
  <!-- Stats -->
  <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
    {[
      { label: L('Total posts', '文章总数'), val: totalPosts },
      { label: 'English', val: byLocale['en']?.length ?? 0 },
      { label: '中文', val: byLocale['cn']?.length ?? 0 },
      { label: L('Other locales', '其他语言'), val: (byLocale['de']?.length ?? 0) + (byLocale['fr']?.length ?? 0) + (byLocale['ja']?.length ?? 0) + (byLocale['kr']?.length ?? 0) },
    ].map((s) => (
      <div class="rounded-lg border border-stone-200 bg-white px-4 py-3">
        <div class="text-xs uppercase tracking-wider text-stone-500">{s.label}</div>
        <div class="font-display text-2xl font-light">{s.val}</div>
      </div>
    ))}
  </div>

  <!-- Filter bar -->
  <form method="get" class="mb-4 flex items-center gap-2 rounded-lg border border-stone-200 bg-white p-3">
    <input
      type="text"
      name="q"
      value={q}
      placeholder={L('Search posts by title or slug', '按标题或链接搜索文章')}
      class="flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
    />
    <select
      name="locale"
      class="rounded-md border border-stone-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary"
      onchange="this.form.submit()"
    >
      <option value="">{L('All locales', '全部语言')}</option>
      {localeOrder.map((lc) => (
        <option value={lc} selected={locFilter === lc}>{LOCALE_LABEL[lc] || lc}</option>
      ))}
    </select>
    <button type="submit" class="rounded-md bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700">
      {L('Search', '搜索')}
    </button>
    {(q || locFilter) && (
      <a href="/admin/news/" class="rounded-md border border-stone-300 px-3 py-2 text-sm text-stone-600 hover:bg-stone-50">
        {L('Reset', '重置')}
      </a>
    )}
  </form>

  <div class="mb-3 text-sm text-stone-600">
    {L('Showing', '显示')} <span class="font-medium text-stone-900">{filtered.length}</span> {L('posts', '篇文章')}
  </div>

  <!-- Table -->
  <div class="overflow-hidden rounded-lg border border-stone-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
        <tr>
          <th class="px-3 py-2 w-20">{L('Locale', '语言')}</th>
          <th class="px-3 py-2">{L('Title', '标题')}</th>
          <th class="px-3 py-2 hidden md:table-cell">{L('Date', '日期')}</th>
          <th class="px-3 py-2 hidden lg:table-cell">{L('Tags', '标签')}</th>
          <th class="px-3 py-2 text-right">{L('Words', '字数')}</th>
          <th class="px-3 py-2 w-24">{L('Actions', '操作')}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        {filtered.length === 0 ? (
          <tr><td colspan="6" class="px-3 py-12 text-center text-stone-400">{L('No posts found.', '没有找到文章。')}</td></tr>
        ) : filtered.map((p) => (
          <tr class="hover:bg-stone-50">
            <td class="px-3 py-2">
              <span class="inline-block rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">{LOCALE_LABEL[p.locale] || p.locale}</span>
            </td>
            <td class="px-3 py-2">
              <div class="font-medium text-stone-900 line-clamp-1">{p.title}</div>
              <div class="text-xs text-stone-400 font-mono">{p.slug}</div>
            </td>
            <td class="px-3 py-2 hidden md:table-cell text-stone-600 tabular-nums">{p.date}</td>
            <td class="px-3 py-2 hidden lg:table-cell">
              <div class="flex flex-wrap gap-1">
                {p.tags.slice(0, 3).map((t) => (
                  <span class="rounded bg-stone-100 px-1.5 py-0.5 text-[10px] text-stone-500">{t}</span>
                ))}
                {p.aiGenerated && (
                  <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[10px] text-blue-700">{L('AI', 'AI')}</span>
                )}
              </div>
            </td>
            <td class="px-3 py-2 text-right tabular-nums text-stone-700">{p.words.toLocaleString()}</td>
            <td class="px-3 py-2">
              <a
                href={`/${p.locale}/blog/${p.slug}/`}
                target="_blank"
                rel="noopener"
                class="inline-block rounded-md border border-stone-300 bg-white px-2 py-1 text-xs text-stone-700 hover:bg-stone-50"
              >
                {L('View', '查看')}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Note -->
  <div class="mt-4 rounded-lg border border-stone-200 bg-white p-4 text-sm text-stone-600">
    {L('Posts are stored as Markdown in the repo and regenerated by the daily blog automation. This page is a read-only overview. To edit or publish, update the markdown file in src/content/blog or use the blog generation workflow.', '文章以 Markdown 存储在仓库中，由每日博客自动化重新生成。本页为只读总览。要编辑或发布，请更新 src/content/blog 下的文件，或使用博客生成工作流。')}
  </div>
</AdminLayout>
