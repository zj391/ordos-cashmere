---
/**
 * 2026-10-31: the category hub moved.
 *
 * The catalogue is now classified into landing pages under
 * /[locale]/category/cashmere-<category>/, and the navigation points
 * there. This URL used to serve the same catalogue as a single page
 * listing every style in the category.
 *
 * Two URLs for the same set of products is the classic setup for
 * splitting the ranking signal: the new page started with no history
 * and no external links, while this one kept its inbound links but
 * lost the navigation links that used to carry the internal weight.
 * Both were left competing for the same query, and neither won.
 *
 * A permanent redirect hands this URL's history - its rankings, its
 * inbound links, its crawl signals - to the page that now carries the
 * category. The two pages list the same styles; the new one shows 25
 * per page and paginates, this one showed all of them at once.
 *
 * The redirect page itself is noindex and canonicalises to the target,
 * so it cannot be indexed as a page of its own.
 */
import { LOCALES } from '@/lib/i18n';

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
return Astro.redirect(`/${locale}/category/cashmere-hats/`, 308);
---
