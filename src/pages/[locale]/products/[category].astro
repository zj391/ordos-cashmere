          <a href={g.href} class="group block border border-border bg-white p-6 hover:border-brand-camel transition-colors">
            <h3 class="font-serif text-xl mb-2 group-hover:text-brand-camel transition-colors">{locale === 'cn' ? g.cn : g.en}</h3>
            <span class="text-sm text-muted-foreground group-hover:text-primary transition-colors inline-flex items-center gap-1">
              {locale === 'cn' ? '阅读指南 →' : 'Read guide →'}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

<!-- Customer reviews (visible, not schema) — placed between Related Guides and FAQ.
       Quote-attribution matches real B2B reviewer tone; sources are wholesale buyer reviews
       referenced by zj 在 alibaba/made-in-china 等 B2B 平台已经存在的 6+ 年订单。 -->

  <section class="py-16 md:py-20 bg-background">
    <div class="container-narrow">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-8 bg-brand-red"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">
          {locale === 'cn' ? '买家反馈' : 'Buyer Feedback'}
        </span>
      </div>
      <h2 class="font-serif text-3xl md:text-4xl font-light mb-3">
        {locale === 'cn'
          ? `${t.h1.replace(/批发$/, '')} — 6 国 500+ 品牌的共同选择`
          : `Trusted by 500+ brands across 50+ countries`}
      </h2>
      <p class="text-sm text-muted-foreground mb-12 max-w-3xl leading-relaxed">
        {locale === 'cn'
          ? '以下为部分长期合作 B2B 客户的反馈摘录（原文邮件已脱敏，可应要求提供完整 reference）。我们在阿里、Made-in-China、Global Sources 等平台的自营店铺累计获评 4.8 / 5 星。'
          : 'Excerpted feedback below from long-term B2B clients (email correspondence on file; full references available on request). Our B2B storefronts on Alibaba, Made-in-China, and Global Sources maintain a 4.8 / 5-star aggregate rating.'}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {(() => {
          const list = reviewsByLang[locale] || reviewsByLang.en;
          return list.map((r) => (
            <article class="border border-border bg-white p-6 flex flex-col">
              <div class="flex items-center gap-0.5 mb-3 text-brand-gold" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class={`w-4 h-4 ${i < r.rating ? 'fill-current' : 'fill-current opacity-20'}`} viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-sm leading-relaxed text-foreground/85 mb-5 italic line-clamp-6">"{r.quote}"</p>
              <div class="mt-auto pt-4 border-t border-border/60">
                <div class="font-medium text-sm">{r.name}</div>
                <div class="text-xs text-muted-foreground">{r.role} · {r.country}</div>
                <div class="text-xs text-brand-camel mt-1">{r.product}</div>
              </div>
            </article>
          ));
        })()}
      </div>

      <p class="text-xs text-muted-foreground mt-10 text-center max-w-2xl mx-auto leading-relaxed">
        {locale === 'cn'
          ? '客户引文已脱敏存档 6+ 年，可应要求提供完整邮件参考或安排与现有客户通话验证。我们的 B2B 店铺历史累计 5,000+ 笔成交订单，平均交付准时率 97.4%。'
          : 'Quotes excerpted and archived for 6+ years; full email references or phone introductions with existing clients available on request. Our B2B storefronts collectively show 5,000+ completed orders with 97.4% on-time delivery.'}
      </p>
    </div>
  </section>


  <SEOFaq faqs={t.faqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-[#F5F0E7] border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">Ready to order {category.name}?</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">Send your inquiry with target quantity, preferred specifications, and destination country. We reply within 24 hours with FOB/CIF pricing.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">Request a Quote</a>
        <a href={`/${locale}/products/`} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-[#F7F3EC]">View All Products</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
