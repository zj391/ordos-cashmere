// Maps catId -> image directory (must match `CATEGORY_IMAGE_DIR` in [id].astro).
const CATEGORY_IMAGE_DIR = {
  hats: 'mic',
  scarves: 'mic',
  sweaters: 'mic',
  accessories: 'mic',
  yarn: 'mic',
};

// Image path resolver — same logic as [id].astro, kept in sync.
// `images[0]` may be an absolute path (`/images/models/...`) or a relative
// filename living under `/products/<imageDir>/`.
function resolveCategoryCardImage(img: string): string {
  if (!img) return '';
  if (img.startsWith('/images/') || img.startsWith('http')) return img;
  const dir = CATEGORY_IMAGE_DIR[catId] || catId;
  return `/products/${dir}/${img}`;
}

// 把产品 JSON 的 category id 映射到 URL slug
// (Astro hoists getStaticPaths before top-level const, so we declare inline below.)
const CATEGORY_SLUGS_DEFS = {
  hats: { id: 'hats', slug: 'hats-accessories', name: 'Cashmere Hats & Beanies' },
  scarves: { id: 'scarves', slug: 'scarves', name: 'Cashmere Scarves & Wraps' },
  sweaters: { id: 'sweaters', slug: 'garment-oem', name: 'Cashmere Sweaters & Knitwear' },
  accessories: { id: 'accessories', slug: 'accessories-cat', name: 'Cashmere Accessories' },
  yarn: { id: 'yarn', slug: 'yarn', name: 'Cashmere Yarn & Fiber' },
};

// 反向：URL slug → 类别 id
const SLUG_TO_CATEGORY_DEFS = {};
for (const catId of Object.keys(CATEGORY_SLUGS_DEFS)) {
  const m = CATEGORY_SLUGS_DEFS[catId];
  if (!SLUG_TO_CATEGORY_DEFS[m.slug]) SLUG_TO_CATEGORY_DEFS[m.slug] = catId;
}

export function getStaticPaths() {
  const paths = [];
    // Astro/Rollup hoists getStaticPaths before top-level consts.
  // Recreate the maps locally so the order is guaranteed.
  const CATEGORY_SLUGS = {
    hats: { id: 'hats', slug: 'hats-accessories', name: 'Cashmere Hats & Beanies' },
    scarves: { id: 'scarves', slug: 'scarves', name: 'Cashmere Scarves & Wraps' },
    sweaters: { id: 'sweaters', slug: 'garment-oem', name: 'Cashmere Sweaters & Knitwear' },
    accessories: { id: 'accessories', slug: 'accessories-cat', name: 'Cashmere Accessories' },
    yarn: { id: 'yarn', slug: 'yarn', name: 'Cashmere Yarn & Fiber' },
  };
  const slugs = Array.from(new Set(Object.values(CATEGORY_SLUGS).map((c) => c.slug)));
  for (const locale of LOCALES) {
    for (const slug of slugs) {
      paths.push({ params: { locale, category: slug } });
    }
  }
  return paths;
}

