// Some catalog records repeat the same filename twice. Keep source order while

// removing duplicates so the gallery and Product schema expose each image once.

const uniqueProductImages = Array.from(new Set(product.images));

// Resolve image paths: an image is either an absolute path (starts with /images/)

// or a product photo filename in /products/<imageDir>/.

function resolveProductImage(img: string): string {

  if (img.startsWith('/images/') || img.startsWith('http')) return img;

  return `/products/${imageDir}/${img}`;

}
/**
 * SEO-optimized alt text for product images.
 * Includes: material + name + micron + audience tags + brand origin + MOQ.
 * Helps Google Image Search rank for "cashmere X wholesale" long-tail queries.
 */
function buildSeoAlt(p: typeof product): string {
  const parts: string[] = [];
  if (p.material && !p.name.toLowerCase().includes(p.material.toLowerCase())) {
    parts.push(p.material);
  }
  const nameClean = p.name
    .replace(/^(Premium|Wholesale|China|Inner Mongolia|Ordos|High Quality|European Style|Europe Style|Classic|New|Hot|Best|2024|2025|2026)\s+/i, '')
    .replace(/\s+(Wholesale|Manufacturer|China|Inner Mongolia)$/i, '');
  parts.push(nameClean);
  if (p.micron) parts.push(p.micron);
  const tags = (p.tags || []).filter((t: string) => /women|men|kids|unisex|ladies|girls|boys|outerwear|winter|spring|summer|fall|autumn/i.test(t));
  if (tags.length > 0) parts.push(tags.slice(0, 2).join(' / '));
  return parts.join(', ');
}


const primaryImage = resolveProductImage(uniqueProductImages[0]);

// galleryImages = studio product shots followed by the lifestyle / model photo

// (if any). The model photo is appended LAST so the cover thumbnail and the

// JSON-LD Product schema stay product-first; users can swap to the model

// shot via the thumbnail strip and the lightbox magnifier handles both.

const galleryImages = uniqueProductImages.map(resolveProductImage);

if (product.modelPhoto && !galleryImages.includes(product.modelPhoto)) {

  galleryImages.push(product.modelPhoto);

}

// Map image src -> { label: 'product' | 'model' } so the gallery strip can

