function suffixFor(id: string, list: readonly string[]): string {
  // Simple hash: sum char codes mod list length
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) | 0;
  return list[Math.abs(h) % list.length];
}

const tdk = {
  en: (p, c) => {
    const shortName = p.name.length > 22 ? `${p.name.substring(0, 22).trim()}…` : p.name;
    const colors = listColors(p);
    const sizes = listSizes(p);
    const season = pickSeason(p);
    const gender = pickGender(p);
    const pattern = pickPattern(p);
    const knit = pickAttr(p.knittingTechnology);
    const attrs = [
      p.material ? cleanAttr(p.material) : '',
      p.micron ? `${cleanAttr(p.micron)} micron` : '',
      colors ? (isSelfContainedColorLabel(colors) ? colors : `${colors} colors`) : '',
      pattern ? `${pattern} pattern` : '',
      knit && !/details?/i.test(knit) ? knit : '',
      season ? `for ${season}` : '',
      gender ? `${gender.toLowerCase()} fit` : '',
      sizes ? `sizes ${sizes}` : '',
    ].filter(Boolean);
    const descCore = attrs.length ? ` ${attrs.join(', ')}.` : '';
    const suffix = suffixFor(p.id, EN_SUFFIXES);
    const description = clip(
      `${shortName}.${descCore} MOQ ${p.moq} pcs, lead ${cleanAttr(p.lead)}${suffix}`,
      158
    );
    return {
      title: `${shortName} | ${SHORT_CAT[p.categoryId] || c} Wholesale | MOQ ${p.moq}`,
      description,
      keywords: [
        `${p.name}`,
        `${p.name} wholesale`,
        `wholesale ${c.toLowerCase()}`,
        `cashmere ${c.toLowerCase()} wholesale`,
        `cashmere manufacturer China`,
        `cashmere supplier China`,
        `cashmere factory China`,
        `buy ${c.toLowerCase()} wholesale`,
        `bulk ${c.toLowerCase()}`,
        `OEM ${c.toLowerCase()}`,
        `ODM ${c.toLowerCase()}`,
        `MOQ ${p.moq} ${c.toLowerCase()}`,
        `${p.material} ${c.toLowerCase()}`,
        `Ordos cashmere factory`,
        `Inner Mongolia cashmere`,
        `B2B cashmere supplier`,
        `private label cashmere ${c.toLowerCase()}`,
      ],
      buyCta: 'Request Quote',
      hideFormCta: 'Hide Form',
    };
  },
  cn: (p, _c) => {
    const shortName = p.name.length > 16 ? `${p.name.substring(0, 16).trim()}…` : p.name;
    const categoryName = cnCategoryNames[p.categoryId] || '羊绒制品';
    const leadDays = cleanAttr(p.lead).replace(/\s*days?\b/i, '天').replace(/\s+/g, '');
    const colors = listColors(p);
    const sizes = listSizes(p);
    const season = pickSeason(p);
    const gender = pickGender(p);
    const attrs = [
      p.material ? cleanAttr(p.material) : '',
      p.micron ? `${cleanAttr(p.micron)}微米` : '',
      colors ? (isSelfContainedColorLabel(colors) ? colors : `颜色${colors}`) : '',
      season ? `${season}季节` : '',
      gender ? `${gender === 'Women' ? '女款' : gender === 'Men' ? '男款' : gender}` : '',
      sizes ? `尺码${sizes}` : '',
    ].filter(Boolean);
    const description = clip(
      `${shortName}。${attrs.join('，')}。MOQ ${p.moq}件，交期${leadDays}${suffixFor(p.id, CN_SUFFIXES)}`,
      150
    );
    return {
