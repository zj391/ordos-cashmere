                <div class="aspect-square bg-brand-cream overflow-hidden">
                  {rpImg && (
                    <img
                      src={rpImg}
                      alt={`${rp.name} — ${rp.categoryName}, ${rp.material}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  )}
                </div>
                <div class="p-2.5 md:p-3">
                  <p class="text-[10px] uppercase tracking-wider text-muted-foreground mb-0.5 truncate">{rp.categoryName}</p>
                  <h3 class="text-xs md:text-sm font-medium text-foreground line-clamp-2 group-hover:text-brand-camel leading-snug">{rp.name}</h3>
                  <p class="text-[11px] md:text-xs text-brand-red font-medium mt-1">{locale === 'cn' ? '项目条件书面确认' : 'Project terms confirmed in writing'}</p>
                </div>
              </a>
            );
          })}
        </div>
        <a
          href={`/${locale}/products/?cat=${product.categoryId}`}
          class="sm:hidden mt-6 inline-flex items-center gap-1.5 text-sm text-primary hover:text-brand-red transition-colors"
        >
          {relatedViewAll[locale]}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  )}

