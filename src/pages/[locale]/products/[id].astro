  <script is:inline>

    (function () {

      var btns = document.querySelectorAll('[data-add-to-inquiry]');

      var dataEl = document.getElementById('dx-product-data');

      if (!btns.length || !dataEl) return;

      var product;

      try { product = JSON.parse(dataEl.textContent || '{}'); } catch (e) { return; }

      var labels = {};

      try {

        var lEl = document.getElementById('dx-product-labels');

        if (lEl) labels = JSON.parse(lEl.textContent || '{}');

      } catch (e) {}

      function getColor() {

        var checked = document.querySelector('input[name="color"]:checked');

        if (checked) {

          if (checked.dataset && checked.dataset.colorName) return checked.dataset.colorName;

          if (checked.value) return checked.value;

        }

        var picker = document.querySelector('[data-color-picker] [aria-checked="true"]');

        if (picker && picker.dataset && picker.dataset.colorName) return picker.dataset.colorName;

        return undefined;

      }

      var bound = false;

      function bind() {

        if (bound || !window.dxCart) return;

        bound = true;

        for (var i = 0; i < btns.length; i++) attach(btns[i]);

      }

      function attach(btn) {

        var labelEl = btn.querySelector('[data-add-label]');

        var original = labelEl ? labelEl.textContent : '';

        btn.addEventListener('click', function () {

          var item = {};

          for (var k in product) item[k] = product[k];

          item.qty = product.moq || 1;

          var color = getColor();

          if (color) item.color = color;

          window.dxCart.add(item);

          if (labelEl) {

            labelEl.textContent = (labels && labels.added) || '✓ Added';

            setTimeout(function () { labelEl.textContent = original; }, 1800);

          }

        });

      }

      bind();

      window.addEventListener('dx-cart-ready', bind, { once: true });

    })();

  </script>



  <!-- Client-side interactivity (7-9): image gallery + inquiry form toggle -->

  <script is:inline>

    (function() {

      function init() {

              // Image gallery: click thumbnail ONLY swaps the main image

              // (no lightbox modal — the user wants direct inline swap, per product feedback).

              var mainImg = document.getElementById('main-product-img');

              var zoomPanel = document.getElementById('product-zoom-panel');

              var thumbs = document.querySelectorAll('[data-gallery-thumb]');



              function updateZoomImage(src) {

                if (!zoomPanel || !src) return;

                zoomPanel.style.backgroundImage = 'url("' + src.replace(/"/g, '%22') + '")';

                // Do not over-magnify low-resolution catalog images.

                var probe = new Image();

                probe.onload = function() {

                  var shortestSide = Math.min(probe.naturalWidth, probe.naturalHeight);

                  var zoomScale = shortestSide >= 1000 ? 2.5 : shortestSide >= 700 ? 1.8 : 1.3;

                  zoomPanel.style.backgroundSize = (zoomScale * 100) + '%';

                };

                probe.src = src;

              }



              function setActiveImage(src) {

                if (!src) return;

                if (mainImg) mainImg.src = src;

                updateZoomImage(src);

              }



              updateZoomImage(mainImg ? mainImg.src : '');



              for (var i = 0; i < thumbs.length; i++) {

                thumbs[i].addEventListener('click', (function(thumb) {

                  return function() {

                    setActiveImage(thumb.dataset.galleryThumb);

                  };

                })(thumbs[i]));

              }



              // Desktop magnifier: the panel beside the image shows the hovered area.

              var mainFrame = document.querySelector('[data-main-frame]');

              if (mainFrame && zoomPanel && window.matchMedia('(min-width: 768px)').matches) {

                mainFrame.addEventListener('pointerenter', function() {

                  zoomPanel.classList.remove('opacity-0', 'invisible');

                  zoomPanel.classList.add('opacity-100', 'visible');

                });

                mainFrame.addEventListener('pointermove', function(e) {

                  var rect = mainFrame.getBoundingClientRect();

                  var x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));

                  var y = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));

                  zoomPanel.style.backgroundPosition = x.toFixed(2) + '% ' + y.toFixed(2) + '%';

                });

                mainFrame.addEventListener('pointerleave', function() {

                  zoomPanel.classList.remove('opacity-100', 'visible');

                  zoomPanel.classList.add('opacity-0', 'invisible');

                });

              }



        // Inquiry form toggle

        var btn = document.querySelector('[data-inquiry-toggle]');

        var form = document.getElementById('inquiry-form');

        if (btn && form) {

          var showText = btn.textContent.trim();

          // Extract hide text by removing trailing ▼ (show) → ▲ (hide)

          var hideText = showText.replace(/[\u25BC\u2193]\s*$/, '\u25B2').replace(/$/, ' \u25B2');

          btn.addEventListener('click', function(e) {

            e.preventDefault();

            e.stopPropagation();

            form.classList.toggle('hidden');

            var isHidden = form.classList.contains('hidden');

            btn.textContent = isHidden ? showText : hideText;

          });

        }



        var quickForm = document.getElementById('quick-inquiry-form');

        if (quickForm) {

          quickForm.addEventListener('submit', async function(e) {

            e.preventDefault();

            var submit = quickForm.querySelector('button[type="submit"]');

            if (submit) submit.disabled = true;

            try {

              var payload = Object.fromEntries(new FormData(quickForm).entries());

              var response = await fetch('/api/inquiry', {

                method: 'POST',

                headers: { 'Content-Type': 'application/json' },

                body: JSON.stringify(payload),

              });

              var result = await response.json().catch(function() { return {}; });

              if (!response.ok || !result.success) throw new Error(result.error || 'Submission failed');

              quickForm.reset();

              alert('Inquiry sent. We will reply within 24 hours.');

            } catch (error) {

              alert('Could not send. Please try again or use the contact page.');

            } finally {

              if (submit) submit.disabled = false;

            }

          });

        }

      }



      if (document.readyState === 'loading') {

        document.addEventListener('DOMContentLoaded', init);

      } else {

        init();

      }

    })();

  </script>



