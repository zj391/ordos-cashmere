            </section>
          )}



                    <!-- Spec table (imf 2-column style) -->

          <div class="product-spec-sheet border border-border rounded-lg overflow-hidden mb-6">

            <table class="w-full text-sm">

              <tbody>

                <tr class="border-b border-border">

