function localizedCategory(categoryId: string, locale: string, fallback: string): string {
  const map = LOCALE_CATEGORY_NAMES[locale];
  if (map && map[categoryId]) return map[categoryId];
  return fallback;
}



const SKIP_VALUES = /^(details?|description|n\/a|na|various|custom(ized|izable)?|多种颜色可选|customize)$/i;
function cleanAttr(v: unknown): string {
  return String(v ?? '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&times;/g, 'x')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
}
function pickAttr(v: unknown): string {
  const s = cleanAttr(v);
  if (!s || SKIP_VALUES.test(s)) return '';
  return s;
}
