            </dl>
          </div>

          <p class="product-summary-copy text-base text-foreground/80 mb-6">{productBodyText}</p>



          <!-- Detailed Description (imf-derived, 7-10) -->

{productExtraText && (

          <div class="mb-6 pb-5 border-b border-border">

            <p class="text-base text-foreground/80 leading-relaxed">{productExtraText}</p>

          </div>

)}

          {enrichedDescription && (
            <section class="mb-6 pb-5 border-b border-border">
              <h2 class="font-display text-2xl font-light mb-3 text-primary">Product Description</h2>
              <p class="text-base text-foreground/80 leading-relaxed">{enrichedDescription}</p>
            </section>
          )}

          {enrichedAdvantages.length > 0 && (
