// --- SEO copy helpers: build unique, attribute-rich TDK from catalog fields ---
const SHORT_CAT: Record<string, string> = {
  hats: 'Hats',
  sweaters: 'Sweaters',
  scarves: 'Scarves',
  accessories: 'Accessories',
  yarn: 'Yarn',
};
const SKIP_VALUES = /^(details?|description|n\/a|na|various|custom(ized|izable)?|多种颜色可选|customize)$/i;
function cleanAttr(v: unknown): string {
  return String(v ?? '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&times;/g, 'x')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
}
function pickAttr(v: unknown): string {
  const s = cleanAttr(v);
  if (!s || SKIP_VALUES.test(s)) return '';
  return s;
}
const COLOR_WORDS = [
  'Beige', 'Black', 'Blue', 'Brown', 'Burgundy', 'Camel', 'Cream', 'Gray', 'Grey',
  'Green', 'Ivory', 'Khaki', 'Maroon', 'Navy', 'Olive', 'Orange', 'Pink', 'Purple',
  'Red', 'Rose', 'Royal Blue', 'Silver', 'Tan', 'Teal', 'White', 'Yellow',
  'Aqua', 'Coral', 'Charcoal', 'Coffee', 'Dark Blue', 'Dark Gray', 'Dark Grey',
  'Fuchsia', 'Gold', 'Lavender', 'Light Blue', 'Light Gray', 'Light Grey',
  'Lime', 'Magenta', 'Mint', 'Mustard', 'Peach', 'Rust', 'Sand', 'Sky Blue',
  'Turquoise', 'Wine', 'Apricot', 'Beetroot', 'Brick Red', 'Bubblegum',
];
const GENDER_WORDS = [
  'Women', 'Ladies', 'Female', 'Women\'s', 'Lady',
  'Men', 'Male', 'Gentlemen', 'Men\'s',
  'Unisex', 'Adult', 'Baby', 'Kids', 'Children',
];
const SEASON_WORDS = ['Spring', 'Summer', 'Fall', 'Autumn', 'Winter', 'All-season', 'Four-season'];
const PATTERN_WORDS = [
  'Solid Color', 'Stripe', 'Striped', 'Plaid', 'Cable', 'Cable Knit', 'Ribbed',
  'Knit', 'Crochet', 'Floral', 'Geometric', 'Argyle', 'Herringbone', 'Jacquard',
  'Quilted', 'Plain', 'Printed', 'Digital Print', 'Tassel',
];
const SIZE_HINTS = [
  /(\d{2,3})\s*[xX×]\s*(\d{2,3})\s*(cm|mm|inch|in|")/, // 100x205 cm
  /\bXXS\b|\bXS\b|\bS\b|\bM\b|\bL\b|\bXL\b|\bXXL\b|\bXXXL\b/,
  /One Size/i,
  /Free Size/i,
  /Custom Size/i,
];

// Color variant hints when no concrete color name is found in product text.
// These signal "this product uses colors but the catalog didn't record specifics",
// so the fallback can return a useful SEO phrase instead of empty string.
//
// The label field is the FINAL string used in the meta description — these
// labels are self-contained (e.g. "Solid color", "Multi-color") so they
// should NOT be followed by the locale-specific " colors" suffix in the
// TDK template. The TDK template uses isSelfContainedColorLabel() to detect
// this and skip the suffix for self-contained labels.
const COLOR_VARIANT_HINTS = [
  { re: /\b(silver|gold|copper|metallic)\s+(threads?|yarn|wire|stripe)\b/i, label: 'Silver thread accent' },
  { re: /\b(multi-?color(ed)?|multi-?colou?r|rainbow|variegated|multicolored)\b/i, label: 'Multi-color' },
  { re: /\b(space[\s-]?dyed|spaced\s*dyed)\b/i, label: 'Space-dyed' },
  { re: /\b(melange|heather|marl)\b/i, label: 'Heathered melange' },
  { re: /\b(plaid|tartan|check(ed)?)\b/i, label: 'Plaid pattern' },
  { re: /\b(stripe(d)?|ribbed?)\b/i, label: 'Striped' },
  { re: /\b(solid)\b/i, label: 'Solid color' },
];
const CATEGORY_DEFAULT_COLORS: Record<string, string> = {
  hats: 'Custom dye available',
  scarves: 'Custom colors available',
  accessories: 'Various colors available',
  sweaters: 'Custom colors available',
  yarn: 'Color card available',
};

// Self-contained color labels end with "color" or equivalent — the TDK
// template should NOT append " colors" / " Farben" / " coloris" etc.
// after these. Concrete color names (Brown, Maroon) get the suffix.
function isSelfContainedColorLabel(s: string): boolean {
  return /(^|\s)(color|colors|colour|colours|farben?|coloris|色|색상)\s*$/i.test(s.trim());
}

function inferFromText(p: typeof product): { colors: string; gender: string; season: string; pattern: string; sizes: string } {
  // Build a haystack from name + tags + description + detailedDescription
  const tagStr = Array.isArray(p.tags) ? p.tags.join(' ') : String(p.tags || '');
  const hay = [
    p.name || '',
    p.description || '',
    p.detailedDescription || '',
    tagStr,
    pickAttr(p.collar),
    pickAttr(p.function),
  ].join(' ');

  const result = { colors: '', gender: '', season: '', pattern: '', sizes: '' };

  // colors: first try concrete color names
  const colorHits: string[] = [];
  for (const w of COLOR_WORDS) {
    const re = new RegExp(`\\b${w.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&')}\\b`, 'i');
    if (re.test(hay) && !colorHits.some((h) => h.toLowerCase() === w.toLowerCase())) {
      colorHits.push(w);
    }
  }
  if (colorHits.length) {
    result.colors = colorHits.length > 3 ? `${colorHits.slice(0, 3).join(', ')} +${colorHits.length - 3}` : colorHits.join(', ');
  } else {
    // No concrete color: look for color-variant hints (silver threads, multi-color, etc.)
    for (const hint of COLOR_VARIANT_HINTS) {
      if (hint.re.test(hay)) {
        result.colors = hint.label;
        break;
      }
    }
    // Still empty: use category default
    if (!result.colors) {
      const catId = String(p.categoryId || '').toLowerCase();
      result.colors = CATEGORY_DEFAULT_COLORS[catId] || 'Custom colors available';
    }
  }

  // gender
  for (const w of GENDER_WORDS) {
    const re = new RegExp(`\\b${w.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&')}\\b`, 'i');
    if (re.test(hay)) {
      // normalize to canonical
      const lw = w.toLowerCase();
      if (lw.includes('women') || lw === 'ladies' || lw === 'female' || lw === 'lady') {
        result.gender = 'Women';
      } else if (lw.includes('men') || lw === 'male' || lw === 'gentlemen') {
        result.gender = 'Men';
      } else if (lw === 'unisex' || lw === 'adult') {
        result.gender = 'Unisex';
      } else if (lw === 'kids' || lw === 'children') {
        result.gender = 'Kids';
      } else if (lw === 'baby') {
        result.gender = 'Baby';
      }
      break;
    }
  }

  // season
  for (const w of SEASON_WORDS) {
    const re = new RegExp(`\\b${w}\\b`, 'i');
    if (re.test(hay)) {
      result.season = w === 'Fall' ? 'Autumn' : w;
      break;
    }
  }

  // pattern
  for (const w of PATTERN_WORDS) {
    const re = new RegExp(`\\b${w.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&')}\\b`, 'i');
    if (re.test(hay)) {
      result.pattern = w;
      break;
    }
  }

  // sizes
  for (const re of SIZE_HINTS) {
    const m = hay.match(re);
    if (m) {
      result.sizes = m[0];
      break;
    }
  }

  return result;
}

function listColors(p: typeof product): string {
  const raw = Array.isArray(p.colors)
    ? p.colors.join(', ')
    : String(p.colorsOffered || p.colors || '');
  const s = cleanAttr(raw).replace(/,\s*Custom(ized|ize)?(,|$)/gi, '').replace(/^Custom(ized|ize)?[, ]*/i, '');
  if (s && !SKIP_VALUES.test(s)) {
    const items = s.split(/[,/]/).map((x) => x.trim()).filter(Boolean);
    return items.length > 4 ? `${items.slice(0, 4).join(', ')} +${items.length - 4}` : s;
  }
  // Fallback: infer from text + pattern signals
  return inferFromText(p).colors;
}
function listSizes(p: typeof product): string {
  const raw = Array.isArray(p.sizes) ? p.sizes.join(', ') : String(p.sizes || '');
  const s = cleanAttr(raw);
  if (s && !SKIP_VALUES.test(s)) {
    const items = s.split(/[,;]/).map((x) => x.trim()).filter(Boolean);
    return items.length > 4 ? `${items.slice(0, 4).join(', ')} +${items.length - 4}` : s;
  }
  return inferFromText(p).sizes;
}
function pickGender(p: typeof product): string {
  const direct = pickAttr(p.gender);
  if (direct && !/EU\s*\//i.test(direct)) return direct;
  return inferFromText(p).gender;
}
function pickSeason(p: typeof product): string {
  const direct = pickAttr(p.season);
  if (direct) return direct;
  return inferFromText(p).season;
}
function pickPattern(p: typeof product): string {
  const direct = pickAttr(p.pattern);
  if (direct && !/single strand/i.test(direct)) return direct;
  return inferFromText(p).pattern;
}
function clip(s: string, max: number): string {
  if (s.length <= max) return s;
  return s.slice(0, max - 1).replace(/\s+\S*$/, '') + '…';
}

function cleanScraped(text: unknown): string {
  let s = String(text ?? '').replace(/find complete details about.*?IMField.*$/is, '');
  s = s.replace(/find complete details about.*$/is, '');
  s = s.replace(/-\s*IMField\s*$/i, '');
  s = s.replace(/\s+/g, ' ').trim();
  return s;
}
function buildProductBody(p: typeof product): string {
  const parts: string[] = [];
  if (p.material) parts.push(cleanAttr(p.material));
  if (p.micron) parts.push(`${cleanAttr(p.micron)} micron`);
  const colors = listColors(p);
  if (colors) parts.push(`${colors} colors`);
  const tech = pickAttr(p.knittingTechnology);
  if (tech && !/details?/i.test(tech)) parts.push(tech);
  const patt = pickAttr(p.pattern);
  if (patt && !/single strand/i.test(patt)) parts.push(`${patt} pattern`);
  const season = pickAttr(p.season);
  if (season) parts.push(`suited for ${season}`);
  const gender = pickAttr(p.gender);
  if (gender && !/EU\s*\//i.test(gender)) parts.push(`${gender.toLowerCase()} styles`);
  const sizes = listSizes(p);
  if (sizes) parts.push(`sizes ${sizes}`);
  const core = parts.join('; ');
  return core
    ? `${core}. MOQ ${p.moq} pcs, lead ${cleanAttr(p.lead)}.`
    : `${cleanAttr(p.material)} ${p.name}. MOQ ${p.moq} pcs, lead ${cleanAttr(p.lead)}.`;
}
const productBodyText = buildProductBody(product);
const scrapedExtra = cleanScraped(product.detailedDescription);
const productExtraText =
  scrapedExtra.length > 60 && !productBodyText.includes(scrapedExtra.slice(0, 40))
    ? scrapedExtra
    : '';

