          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg> {locale === 'cn' ? '分享' : 'Share'}
        </a>
      </div>



      <div class="product-detail-layout grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 mb-4">

        <!-- Image gallery: unique thumbnails + desktop hover magnifier -->

        <div class="product-gallery">

          <div class="relative">

                      <div

                        class="product-main-frame aspect-square bg-secondary/30 rounded-lg overflow-hidden mb-4 ring-1 ring-border w-full block hover:ring-2 hover:ring-primary transition-shadow"

