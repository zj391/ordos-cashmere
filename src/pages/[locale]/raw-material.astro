---
/**
 * Raw Material 产品页 - 与首页统一设计语言
 * Hero 真实图 + 文字 / 等级：大图卡 / 规格：6 数据块 / 询盘表单
 */
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import B2BServices from '@/components/B2BServices.astro';
import RawMaterialInquiryForm from '@/components/islands/RawMaterialInquiryForm.tsx';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: {
    tagline: '01 / RAW CASHMERE',
    title: 'Premium Raw\nCashmere Fiber',
    subtitle: 'Discuss white, brown or purple cashmere requirements with the intended use, quantity, destination and requested fiber documentation.',
    gradesTitle: 'Three grades.\nOne origin.',
    gradesSub: 'All from Albus goats on the Ordos plateau. Graded by fiber fineness, hand-sorted for purity.',
    specsTitle: 'Specifications',
    specsSub: 'Confirm the lot-specific specification and document requirements in writing before an order is released.',
    inquiryTitle: 'Request a quotation',
    inquirySub: 'Include use, quantity, destination, desired fiber profile and document requirements for a written sourcing discussion.',
  },
  cn: {
    tagline: '01 / 羊绒原料',
    title: '高端羊绒原料',
    subtitle: '围绕白绒、青绒或紫绒的采购需求沟通用途、数量、目的地与所需纤维文件。',
    gradesTitle: '三个等级。\n一个产地。',
    gradesSub: '全部来自鄂尔多斯高原阿尔巴斯白绒山羊。按纤维细度分级，手工分拣保证纯度。',
    specsTitle: '规格参数',
    specsSub: '下单前请以书面形式确认批次规格与文件要求。',
    inquiryTitle: '立即询盘',
    inquirySub: '请提供用途、数量、目的地、目标纤维特征和文件要求，以启动书面采购沟通。',
  },
  de: { tagline: '01 / ROHKASCHMIR', title: 'Premium\nRohkaschmir', subtitle: 'Beschaffungsanfrage für weißen, braunen oder violetten Kaschmir mit Einsatz, Menge, Zielort und Dokumentenbedarf.', gradesTitle: 'Drei Varianten.\nEine Anfrage.', gradesSub: 'Die Produktspezifikation wird je Charge schriftlich abgestimmt.', specsTitle: 'Spezifikationen', specsSub: 'Chargenspezifikation und Dokumente vor Freigabe schriftlich bestätigen.', inquiryTitle: 'Angebot anfordern', inquirySub: 'Einsatz, Menge, Zielort und Dokumentenbedarf angeben.' },
  fr: { tagline: '01 / CACHEMIRE BRUT', title: 'Cachemire brut\npremium', subtitle: 'Demande d’approvisionnement pour cachemire blanc, brun ou violet avec usage, quantité, destination et documents requis.', gradesTitle: 'Trois variantes.\nUne demande.', gradesSub: 'La spécification est confirmée par écrit pour chaque lot.', specsTitle: 'Spécifications', specsSub: 'Confirmez spécification et documents du lot par écrit.', inquiryTitle: 'Demander un devis', inquirySub: 'Indiquez usage, quantité, destination et documents requis.' },
  ja: { tagline: '01 / 原料カシミア', title: 'プレミアム\n原料カシミア', subtitle: '白・青・紫カシミアについて、用途、数量、仕向地、必要書類を含めて調達相談します。', gradesTitle: '三つの種類。\n一つの相談。', gradesSub: 'ロット別仕様は書面で確認します。', specsTitle: '仕様', specsSub: '出荷前にロット仕様と書類要件を確認します。', inquiryTitle: '見積もり依頼', inquirySub: '用途、数量、仕向地、必要書類をご記入ください。' },
  kr: { tagline: '01 / 원료 캐시미어', title: '프리미엄\n원료 캐시미어', subtitle: '백색, 청색, 자색 캐시미어에 대해 용도, 수량, 목적지, 필요 서류를 포함해 소싱 상담을 진행합니다.', gradesTitle: '세 가지 종류.\n하나의 상담.', gradesSub: '로트별 사양은 서면으로 확인합니다.', specsTitle: '사양', specsSub: '출고 전 로트 사양과 서류 요건을 서면으로 확인합니다.', inquiryTitle: '견적 요청', inquirySub: '용도, 수량, 목적지, 필요 서류를 기재해 주세요.' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const grades = [
  { code: 'W', key: 'white' },
  { key: 'brown' },
  { key: 'purple' },
];
const gradeData: Record<string, { name: string; desc: string; fineness: string; color: string }> = {
  white: { name: locale === 'cn' ? '白绒' : 'White Cashmere', desc: locale === 'cn' ? '阿尔巴斯白山羊，最高级别' : 'Albus white goat, finest grade', fineness: '14.5-15.5μm', color: 'from-brand-cream to-brand-sand' },
  brown: { name: locale === 'cn' ? '青绒' : 'Brown Cashmere', desc: locale === 'cn' ? '性价比高，主流规格' : 'Best value, mainstream spec', fineness: '15.5-16.5μm', color: 'from-brand-sand to-brand-camel' },
  purple: { name: locale === 'cn' ? '紫绒' : 'Purple Cashmere', desc: locale === 'cn' ? '深色，适合混色产品' : 'Deep tones, for blends', fineness: '15.5-16.5μm', color: 'from-brand-camel to-brand-chocolate' },
};

const specs = [
  { label: locale === 'cn' ? '纤维细度' : 'Fiber Fineness', value: '14.5-16.5', unit: 'μm', desc: locale === 'cn' ? 'A 级 14.0-15.5 / B 级 15.5-16.5 / C 级 16.5-19.0' : 'Grade A 14.0-15.5 / Grade B 15.5-16.5 / Grade C 16.5-19.0' },
  { label: locale === 'cn' ? '纤维长度' : 'Staple Length', value: '34-42', unit: 'mm', desc: locale === 'cn' ? '平均 38mm，A 级 ≥38mm' : 'Average 38mm, Grade A ≥38mm' },
  { label: locale === 'cn' ? '净绒率' : 'Down Yield', value: '≥45', unit: '%', desc: locale === 'cn' ? '分梳后纯绒/原毛比' : 'Dehaired down to raw fiber ratio' },
  { label: locale === 'cn' ? '含杂率' : 'Vegetable Impurity', value: '≤0.3', unit: '%', desc: locale === 'cn' ? '植物性杂质+尘垂' : 'Vegetable matter + dust' },
  { label: locale === 'cn' ? '回潮率' : 'Moisture Regain', value: '≤15', unit: '%', desc: locale === 'cn' ? 'GB/T 14593 标准' : 'GB/T 14593 standard' },
  { label: locale === 'cn' ? '含油脂' : 'Grease Content', value: '≤1.5', unit: '%', desc: locale === 'cn' ? '脱脂后残留' : 'Post-degrease residue' },
  { label: locale === 'cn' ? 'AQL 抽样' : 'AQL Sampling', value: '2.5', unit: 'ISO 2859-1', desc: locale === 'cn' ? '出口级合格判定' : 'Export-grade acceptance' },
  { label: locale === 'cn' ? '检验标准' : 'Standard', value: 'GB/T 21209', unit: locale === 'cn' ? '国标' : 'China Std', desc: locale === 'cn' ? '山羊绒分级国家标准' : 'National cashmere grading standard' },
  { label: locale === 'cn' ? '项目条件' : 'Project Terms', value: locale === 'cn' ? '书面' : 'Written', unit: locale === 'cn' ? '确认' : 'confirmation' },
  { label: locale === 'cn' ? '文件需求' : 'Document Needs', value: locale === 'cn' ? '沟通' : 'Discuss', unit: '' },
];

// 真实图
const IMG = {
  hero: '/images/ordos-landscape.webp',
  cashmereFiber: '/images/cashmere-fiber.webp',
};
---

<BaseLayout locale={locale} pageKey="rawMaterial" path="/raw-material">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/raw-material`} />

  <!-- HERO：左文字 / 右大图 -->
  <section class="relative bg-brand-sandwarm border-b border-border/60 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[70vh]">
      <div class="flex items-center py-20 lg:py-0 px-6 lg:pl-12">
        <div class="max-w-xl">
          <div class="flex items-center gap-3 mb-8">
            <span class="h-[2px] w-12 bg-brand-red"></span>
            <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{T('tagline')}</span>
          </div>
          <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8" set:html={T('title').replace(/\n/g, '<br/>')} />
          <p class="text-lg text-muted-foreground leading-relaxed max-w-md font-light">{T('subtitle')}</p>
        </div>
      </div>
      <div class="relative aspect-[4/3] lg:aspect-auto overflow-hidden">
        <img src={IMG.hero} alt="Ordos plateau landscape, Inner Mongolia — high-altitude Albus cashmere goat pasture, 14.5μm fiber source" class="ken-burns absolute inset-0 w-full h-full object-cover opacity-95" decoding="async" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-brand-sandwarm/40"></div>
      </div>
    </div>
  </section>

  <!-- Grades：大图卡（不对称，1 大 2 小） -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '羊绒分级' : 'Grades'}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4" set:html={T('gradesTitle').replace(/\n/g, '<br/>')} />
        <p class="text-muted-foreground leading-relaxed">{T('gradesSub')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
        <!-- 白绒：大卡 + 真实图 -->
        <div class="md:col-span-7 relative aspect-[4/5] md:aspect-[4/5] overflow-hidden group">
          <img src={IMG.cashmereFiber} alt="Premium white cashmere fiber detail — 14.5μm grade, dehaired underdown from Inner Mongolia Albus goat, ready for spinning" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" decoding="async" loading="eager" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/95 via-brand-ink/30 to-transparent"></div>
          <div class="absolute top-6 right-6 font-serif text-7xl text-brand-gold/30 font-light">01</div>
          <div class="absolute bottom-0 left-0 p-8 text-white">
            <div class="text-xs tracking-[0.3em] uppercase text-brand-gold mb-2">White</div>
            <h3 class="reveal font-serif text-3xl md:text-4xl font-light mb-2">{gradeData.white.name}</h3>
            <p class="text-sm text-white/80 mb-3">{gradeData.white.desc}</p>
            <div class="font-serif text-2xl text-brand-gold">{gradeData.white.fineness}</div>
          </div>
        </div>

        <!-- 青绒 + 紫绒：两个堆叠小卡 -->
        <div class="md:col-span-5 grid grid-rows-2 gap-4 md:gap-6">
          <div class={`relative aspect-[4/3] md:aspect-auto overflow-hidden bg-gradient-to-br ${gradeData.brown.color}`}>
            <div class="absolute top-4 right-4 font-serif text-5xl text-white/30 font-light">02</div>
            <div class="absolute bottom-0 left-0 p-6 text-brand-ink">
              <div class="text-xs tracking-[0.3em] uppercase opacity-60 mb-2">Brown</div>
              <h3 class="reveal font-serif text-2xl md:text-3xl font-light mb-1">{gradeData.brown.name}</h3>
              <p class="text-xs opacity-80 mb-2">{gradeData.brown.desc}</p>
              <div class="font-serif text-lg">{gradeData.brown.fineness}</div>
            </div>
          </div>
          <div class={`relative aspect-[4/3] md:aspect-auto overflow-hidden bg-gradient-to-br ${gradeData.purple.color}`}>
            <div class="absolute top-4 right-4 font-serif text-5xl text-white/30 font-light">03</div>
            <div class="absolute bottom-0 left-0 p-6 text-white">
              <div class="text-xs tracking-[0.3em] uppercase text-brand-gold mb-2">Purple</div>
              <h3 class="reveal font-serif text-2xl md:text-3xl font-light mb-1">{gradeData.purple.name}</h3>
              <p class="text-xs opacity-80 mb-2">{gradeData.purple.desc}</p>
              <div class="font-serif text-lg text-brand-gold">{gradeData.purple.fineness}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs：6 个数据块（细线分隔，serif 大数字） -->
  <section class="py-24 bg-brand-cream/50 border-y border-border">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '规格' : 'Specs'}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('specsTitle')}</h2>
        <p class="text-muted-foreground leading-relaxed">{T('specsSub')}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-border">
        {specs.map((s) => (
          <div class="bg-background p-8 md:p-10">
            <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4">{s.label}</div>
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-4xl md:text-5xl text-brand-chocolate font-light">{s.value}</span>
              <span class="text-sm text-muted-foreground">{s.unit}</span>
            </div>
            {s.desc && <div class="text-xs text-muted-foreground mt-3 leading-relaxed">{s.desc}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inquiry：表单 + 文字 -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '询盘' : 'Inquiry'}</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-6">{T('inquiryTitle')}</h2>
          <p class="text-muted-foreground leading-relaxed mb-8">{T('inquirySub')}</p>
          <B2BServices locale={locale} variant="raw-material" />
        </div>
        <div>
          <RawMaterialInquiryForm client:visible locale={locale} enableAttachments={true} />
        </div>
      </div>
    </div>
  </section>

  <SEOFaq faqs={[
    locale === 'cn' ? { q: '原料羊绒询盘应提供哪些信息？', a: '请提供用途、数量、目的地、目标颜色或纤维方向，以及需要随项目审核的规格或文件。' } : { q: 'What should a raw cashmere inquiry include?', a: 'Include the intended use, quantity, destination, color or fiber direction, and any specification or document requirements to review for the project.' },
    locale === 'cn' ? { q: '如何确认批次规格？', a: '请在订单释放前将批次规格、验货方式和文件需求写入书面沟通或报价文件。' } : { q: 'How are lot specifications confirmed?', a: 'Confirm the lot specification, inspection approach and document requirements in written project correspondence or the quotation before an order is released.' },
    locale === 'cn' ? { q: '起订量和交付条件何时确认？', a: '应结合具体产品、数量、目的地和商务背景，在书面报价或销售协议中确认。' } : { q: 'When are MOQ and delivery terms confirmed?', a: 'They are confirmed against the individual product, quantity, destination and commercial context in the written quotation or sales agreement.' },
  ]} />

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
