---
/**
 * Cashmere Yarn Types - dedicated SEO hub (7-8)
 * Target: cashmere yarn 2/48Nm 2/60Nm / worsted cashmere yarn / dyed cashmere yarn
 * Route: /[locale]/cashmere-yarn-types × 6 locales = 6 URLs
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

const tdk = {
  en: {
    title: 'Cashmere Yarn Types | 2/26 to 2/60 Nm | Worsted & Woolen | DONGXIAO®',
    description: 'Cashmere yarn 2/26 to 2/60 Nm. Worsted, woolen, dyed, bleached. 100% cashmere + blends (wool, silk). Custom Nm counts and colors. Bulk wholesale from Ordos.',
    h1: 'Cashmere Yarn Types & Specifications',
    intro: 'Choose from 73 yarn configurations for hand knitting, machine knitting, and weaving. Custom Nm counts and color matching available.',
    bullets: [
      'Counts: 2/26 Nm to 2/60 Nm (stock); 2/16 to 2/80 Nm (custom 200kg+)',
      'Process: Worsted (smooth) or Woolen (soft, lofty)',
      'Colors: Natural white, brown, purple + 200+ dyed colors',
      'Blends: 100% cashmere, cashmere/wool, cashmere/silk',
    ],
    faqs: [
      { q: 'What is the difference between worsted and woolen cashmere yarn?', a: 'Worsted yarn is spun with parallel fibers for a smooth, strong thread ideal for machine knitting and weaving. Woolen yarn is spun with random fiber orientation for a softer, loftier feel — perfect for hand knitting and chunky sweaters.' },
      { q: 'What Nm count should I use for a 12-gauge sweater?', a: 'For 12-gauge machine knitting, use 2/48 Nm or 2/60 Nm. For 7-gauge (chunky), use 2/26 Nm or 2/32 Nm.' },
      { q: 'Can I get custom dye colors?', a: 'Yes — Pantone match for orders 5kg+ per color. Lab dip approval in 5-7 days. Bulk production 15-20 days after approval.' },
      { q: 'Do you offer anti-pilling treated yarn?', a: 'Yes — both standard and anti-pilling treated. Anti-pilling is recommended for garments that will see heavy use (sweaters, socks).' },
    ],
  },
  cn: {
    title: '羊绒纱线规格 | 2/26 至 2/60 Nm | 精纺/粗纺 | DONGXIAO®',
    description: '羊绒纱线 2/26 至 2/60 Nm。精纺/粗纺/染色/漂白。100% 羊绒 + 混纺。',
    h1: '羊绒纱线规格',
    intro: '73 种纱线配置可选，手织/机织/梭织。',
    bullets: ['2/26 至 2/60 Nm（常备）；2/16 至 2/80 Nm（200kg+ 定制）', '精纺/粗纺', '200+ 染色', '100% 羊绒/羊绒羊毛/羊绒真丝'],
    faqs: [{ q: '精纺和粗纺区别？', a: '精纺纤维平行，光滑结实适合机织；粗纺纤维随机，柔软蓬松适合手织。' }],
  },
  // 8-20: de/fr/ja/kr 翻译补齐
  de: {
    title: 'Kaschmirgarn-Spezifikationen | 2/26 bis 2/60 Nm | Kammgarn & Streichgarn | DONGXIAO®',
    description: 'Kaschmirgarn 2/26 bis 2/60 Nm. Kammgarn, Streichgarn, gefärbt, gebleicht. 100 % Kaschmir + Mischungen (Wolle, Seide). Kundenspezifische Nm-Stärken und Farben. Großhandel aus Ordos.',
    h1: 'Kaschmirgarn-Typen & Spezifikationen',
    intro: 'Wählen Sie aus 73 Garnkonfigurationen für Handstrick, Maschinenstrick und Weberei. Kundenspezifische Nm-Stärken und Farbabstimmung verfügbar.',
    bullets: [
      'Stärken: 2/26 Nm bis 2/60 Nm (Lager); 2/16 bis 2/80 Nm (kundenspezifisch ab 200 kg)',
      'Verarbeitung: Kammgarn (glatt) oder Streichgarn (weich, locker)',
      'Farben: Naturweiß, Braun, Lila + 200+ gefärbte Farben',
      'Mischungen: 100 % Kaschmir, Kaschmir/Wolle, Kaschmir/Seide',
    ],
    faqs: [
      { q: 'Was ist der Unterschied zwischen Kammgarn und Streichgarn?', a: 'Kammgarn wird mit parallelen Fasern gesponnen – glatt und fest, ideal für Maschinenstrick und Weberei. Streichgarn wird mit zufälliger Faserorientierung gesponnen – weicher und lockerer, perfekt für Handstrick und grobe Pullover.' },
      { q: 'Welche Nm-Stärke sollte ich für einen 12-Gauge-Pullover verwenden?', a: 'Für 12-Gauge-Maschinenstrick verwenden Sie 2/48 Nm oder 2/60 Nm. Für 7-Gauge (grob) verwenden Sie 2/26 Nm oder 2/32 Nm.' },
      { q: 'Kann ich kundenspezifische Farben erhalten?', a: 'Ja — Pantone-Abstimmung für Bestellungen ab 5 kg pro Farbe. Lab-Dip-Freigabe in 5–7 Tagen. Massenproduktion 15–20 Tage nach Freigabe.' },
      { q: 'Bieten Sie Anti-Pilling-behandeltes Garn an?', a: 'Ja — sowohl Standard als auch Anti-Pilling-behandelt. Anti-Pilling wird für stark beanspruchte Kleidungsstücke empfohlen (Pullover, Socken).' },
    ],
  },
  fr: {
    title: 'Types de fil cachemire | 2/26 à 2/60 Nm | Peigné et cardé | DONGXIAO®',
    description: 'Fil cachemire 2/26 à 2/60 Nm. Peigné, cardé, teint, blanchi. 100 % cachemire + mélanges (laine, soie). Nm et couleurs personnalisés. Gros depuis Ordos.',
    h1: 'Types de fil cachemire et spécifications',
    intro: 'Choisissez parmi 73 configurations de fil pour tricot main, tricot machine et tissage. Nm personnalisés et correspondance de couleurs disponibles.',
    bullets: [
      'Nm : 2/26 à 2/60 Nm (stock) ; 2/16 à 2/80 Nm (personnalisé 200 kg+)',
      'Procédé : Peigné (lisse) ou cardé (doux, volumineux)',
      'Couleurs : Blanc, brun, violet naturels + 200+ teintes',
      'Mélanges : 100 % cachemire, cachemire/laine, cachemire/soie',
    ],
    faqs: [
      { q: 'Quelle est la différence entre fil peigné et fil cardé ?', a: 'Le fil peigné est filé avec des fibres parallèles pour un fil lisse et solide, idéal pour le tricot machine et le tissage. Le fil cardé est filé avec une orientation aléatoire des fibres pour un toucher plus doux et volumineux — parfait pour le tricot main et les gros pulls.' },
      { q: 'Quel Nm utiliser pour un pull 12 jauges ?', a: 'Pour le tricot machine 12 jauges, utilisez 2/48 Nm ou 2/60 Nm. Pour le 7 jauges (gros), utilisez 2/26 Nm ou 2/32 Nm.' },
      { q: 'Puis-je obtenir des couleurs personnalisées ?', a: 'Oui — Pantone pour les commandes de 5 kg+ par couleur. Validation bain de laboratoire en 5–7 jours. Production en série 15–20 jours après validation.' },
      { q: 'Proposez-vous du fil traité anti-bouloches ?', a: 'Oui — standard et traité anti-bouloches. L\'anti-bouloches est recommandé pour les vêtements à usage intensif (pulls, chaussettes).' },
    ],
  },
  ja: {
    title: 'カシミア糸の規格 | 2/26〜2/60 Nm | 梳毛・紡毛 | DONGXIAO®',
    description: 'カシミア糸 2/26〜2/60 Nm。梳毛/紡毛/染色/漂白。100%カシミア + 混紡（ wool、シルク）。Nm・カラー特注可。オルドス直送卸売。',
    h1: 'カシミア糸のタイプと規格',
    intro: '手編み・機編み・織物向けに 73 種の糸構成をご用意。Nm とカラー 맞춤 対応可。',
    bullets: [
      '番手：2/26〜2/60 Nm（在庫）；2/16〜2/80 Nm（200kg〜 特注）',
      '製法：梳毛（滑らか）または紡毛（柔らかくバルキー）',
      'カラー：ナチュラル白・茶・紫 + 200色以上の染色',
      '混紡：100%カシミア、カシミア/ウール、カシミア/シルク',
    ],
    faqs: [
      { q: '梳毛と紡毛の違いは？', a: '梳毛は繊維を平行に紡ぐため、滑らかで丈夫な糸になり、機編みや織物に最適。紡毛は繊維をランダムに紡ぐため、柔らかくバルキーな風合い — 手編みや厚手セーターに最適。' },
      { q: '12 ゲージ セーターにはどの Nm を使えばよいですか？', a: '12 ゲージ機編みには 2/48 Nm または 2/60 Nm を推奨。7 ゲージ（厚手）には 2/26 Nm または 2/32 Nm を推奨。' },
      { q: '特注カラー染色は可能ですか？', a: 'はい — 1 色 5kg 以上で Pantone 対応可。ラボ dip 承認 5〜7 日。承認後量産 15〜20 日。' },
      { q: 'アンチピリング加工糸はありますか？', a: 'はい — 標準糸とアンチピリング加工糸の両方をご用意。セーターやソックスなど高頻度使用製品にはアンチピリング推奨。' },
    ],
  },
  kr: {
    title: '캐시미어 원사 규격 | 2/26~2/60 Nm | 소면방적·방면방적 | DONGXIAO®',
    description: '캐시미어 원사 2/26~2/60 Nm. 소면/방면/염색/표백. 100% 캐시미어 + 혼방 (울, 실크). Nm·컬러 맞춤 가능. 오르도스 직송 도매.',
    h1: '캐시미어 원사 유형 및 규격',
    intro: '손뜨기·기계뜨기·직조용 73가지 원사 구성. Nm 및 컬러 매칭 맞춤 가능.',
    bullets: [
      '번수: 2/26~2/60 Nm (재고); 2/16~2/80 Nm (맞춤 200kg+)',
      '방식: 소면방적 (매끄러움) 또는 방면방적 (부드럽고 볼키)',
      '컬러: 내추럴 화이트/브라운/퍼플 + 200+ 염색 컬러',
      '혼방: 100% 캐시미어, 캐시미어/울, 캐시미어/실크',
    ],
    faqs: [
      { q: '소면방적과 방면방적의 차이는?', a: '소면방적은 섬유를 평행하게纺사하여 매끄럽고 견고한 실이 되어 기계뜨기와 직조에 적합. 방면방적은 섬유 방향이 랜덤하여 부드럽고 볼키한 촉감 — 손뜨기와 후키 스웨터에 최적.' },
      { q: '12 게이지 스웨터에는 어떤 Nm을 사용해야 하나요?', a: '12 게이지 기계뜨기에는 2/48 Nm 또는 2/60 Nm 사용. 7 게이지 (후키)에는 2/26 Nm 또는 2/32 Nm 사용.' },
      { q: '맞춤 염색 컬러가 가능한가요?', a: '예 — 컬러당 5kg 이상 주문 시 Pantone 매칭. 랩 dip 승인 5~7일. 승인 후 양산 15~20일.' },
      { q: '안티필링 가공 원사가 있나요?', a: '예 — 일반 원사와 안티필링 가공 원사 모두 제공. 스웨터, 양말 등 사용 강도가 높은 의류에는 안티필링 추천.' },
    ],
  },
};

const t = tdk[locale] || tdk.en;
const faqs = t.faqs || tdk.en.faqs;

const yarnCopy = locale === 'cn'
  ? { title: '羊绒纱线规格沟通 | DONGXIAO®', description: '提交目标纱支、用途、颜色、数量、目的地及资料需求，以开展书面纱线采购沟通。', h1: '羊绒纱线规格沟通', intro: '纱线形态、可用规格、颜色与项目条件会因具体需求而异。请提供您的应用场景和规格要求，以书面确认适用范围。', cta: '联系采购团队' }
  : { title: 'Cashmere Yarn Specification Requests | DONGXIAO®', description: 'Prepare target count, use, colour, quantity, destination and document requirements for a written yarn-sourcing discussion.', h1: 'Cashmere Yarn Specification Requests', intro: 'Yarn construction, available counts, colours and project terms vary by requirement. Share your intended use and specification needs so the applicable scope can be confirmed in writing.', cta: 'Contact our sourcing team' };

const yarnProjectFaqs = [
  { q: locale === 'cn' ? '纱线询盘应包含哪些信息？' : 'What should a yarn inquiry include?', a: locale === 'cn' ? '请提供预期用途、目标纱支或织造要求、颜色、数量、目的地、验货方式和资料范围。' : 'Provide intended use, target count or construction, colour, quantity, destination, inspection approach and document scope.' },
  { q: locale === 'cn' ? '价格、可用性和交期何时确认？' : 'When are price, availability and lead time confirmed?', a: locale === 'cn' ? '价格、可用性、打样、交期、验货和交付条款将针对具体项目在书面沟通、报价或协议中确认。' : 'Price, availability, sampling, lead time, inspection and delivery terms are confirmed for the specific project in written correspondence, quotation or agreement.' },
];

const yarnTypes = [
  { nm: '2/26', use: 'Chunky knit, 5-7 gauge', weight: '~770 dtex', stock: true },
  { nm: '2/32', use: 'Mid-gauge knit, 9 gauge', weight: '~625 dtex', stock: true },
  { nm: '2/36', use: 'Standard knit, 12 gauge', weight: '~555 dtex', stock: true },
  { nm: '2/48', use: 'Fine knit, 14-16 gauge', weight: '~415 dtex', stock: true },
  { nm: '2/60', use: 'Ultra-fine knit, 18 gauge', weight: '~335 dtex', stock: true },
  { nm: 'Custom', use: '2/16 to 2/80', weight: 'On request', stock: false, note: '200kg+ MOQ' },
];

const yarnSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.h1,
  description: t.description,
  numberOfItems: yarnTypes.length,
  itemListElement: yarnTypes.map((y, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${y.nm} Nm cashmere yarn`,
    description: `${y.use} (${y.weight})${y.note ? ' — ' + y.note : ''}`,
  })),
};
---

<BaseLayout
  locale={locale}
  pageKey="yarn-fabric"
  path={'/' + locale + '/cashmere-yarn-types'}
  title={yarnCopy.title}
  description={yarnCopy.description}
  keywords={['cashmere yarn', 'cashmere yarn specification', 'cashmere yarn sourcing']}
  schema="general"
  noIndex={true}
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/cashmere-yarn-types'} />

  <section class="bg-[#F5F0E7] border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Yarn Specifications</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{yarnCopy.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{yarnCopy.intro}</p>
    </div>
  </section>

  {false && <section class="py-16 bg-background">
    <div class="container-narrow">
      <h2 class="font-display text-3xl font-light mb-8">Standard Yarn Counts (Nm)</h2>
      <div class="overflow-x-auto">
        <table class="w-full border border-border rounded-lg overflow-hidden">
          <thead class="bg-secondary/30">
            <tr>
              <th class="text-left p-3 font-medium">Count (Nm)</th>
              <th class="text-left p-3 font-medium">Typical Use</th>
              <th class="text-left p-3 font-medium">Weight</th>
              <th class="text-left p-3 font-medium">Stock</th>
            </tr>
          </thead>
          <tbody>
            {yarnTypes.map((y) => (
              <tr class="border-t border-border">
                <td class="p-3 font-mono">{y.nm}</td>
                <td class="p-3">{y.use}{y.note && <span class="text-xs text-muted-foreground"> — {y.note}</span>}</td>
                <td class="p-3 text-sm text-muted-foreground">{y.weight}</td>
                <td class="p-3 text-sm">
                  {y.stock ? (
                    <span class="text-green-600">In stock</span>
                  ) : (
                    <span class="text-amber-600">On request</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>}

  <section class="py-16 bg-secondary/20">
    <div class="container-narrow max-w-4xl">
      <h2 class="font-display text-3xl font-light mb-6">Worsted vs Woolen — which to choose?</h2>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        <strong>Worsted cashmere</strong> is spun from long, parallel-aligned fibers using a combing process. The result is a smooth, dense, strong yarn with a slight sheen — perfect for 12+ gauge machine knitting, fine-gauge scarves, and suiting-weight woven fabrics. Worsted yarn holds its shape through wear and washing.
      </p>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        <strong>Woolen cashmere</strong> is spun from shorter fibers with random orientation. The result is a softer, loftier, lighter yarn with more air trapped between fibers — perfect for hand knitting, chunky sweaters, and felted applications. Woolen cashmere feels warmer for its weight but pills more easily.
      </p>
      <p class="text-base leading-relaxed text-foreground/80">
        Yarn selection should be assessed against the intended construction, gauge, handle and testing requirements for the specific project.
      </p>
    </div>
  </section>

  <SEOFaq faqs={yarnProjectFaqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-[#F5F0E7] border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">{locale === 'cn' ? '准备纱线规格沟通' : 'Prepare a yarn specification request'}</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">{locale === 'cn' ? '请提供用途、目标纱支、颜色、数量、目的地、验货方式和资料需求；适用项目条件将书面确认。' : 'Share intended use, target count, colour, quantity, destination, inspection approach and document needs. Applicable project conditions are confirmed in writing.'}</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={'/' + locale + '/contact'} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">{yarnCopy.cta}</a>
        <a href={'/' + locale + '/yarn-fabric'} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-[#F7F3EC]">View Yarn & Fabric Page</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>
