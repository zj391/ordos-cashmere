const groupLabelsJson = JSON.stringify(GROUP_LABELS);
const procurementCopyJson = JSON.stringify(listingFilterCopy);
---

<BaseLayout
  locale={locale}
  pageKey="products"
  path="/products"
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  schema="products"
>

  <Navigation slot="header" locale={locale} currentPath={`/${locale}/products`} />

  <!-- Page header -->
  <section class="bg-background border-b border-border">
    <div class="container-narrow py-12 sm:py-16">
      <div class="flex items-center gap-3 mb-4"><span class="h-[2px] w-8 bg-brand-red"></span><span class="text-xs tracking-[0.3em] uppercase text-brand-camel">
        {locale === 'cn' ? 'B2B 采购目录' : 'B2B Sourcing Catalog'}
      </span></div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-light text-brand-ink mb-4">
        {labels.title}
      </h1>
      <p class="text-muted-foreground max-w-3xl leading-relaxed">
        {labels.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-muted-foreground">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-brand-gold rounded-full"></span>
          {locale === 'cn' ? `${allProducts.length} 款精选代表款` : `${allProducts.length} Curated Styles`}
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-camel rounded-full"></span>
          {locale === 'cn' ? '5大品类' : '5 Categories'}
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-camel rounded-full"></span>
          {locale === 'cn' ? '项目条件书面确认' : 'Project terms confirmed in writing'}
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-camel rounded-full"></span>
          {locale === 'cn' ? '采购资料准备' : 'Sourcing brief preparation'}
        </span>
      </div>
    </div>
  </section>


  <!-- Filter bar (静态渲染，按钮 + 搜索 + 排序) -->
  <section class="container-narrow py-8">
    <div class="flex flex-col lg:flex-row gap-4 mb-6 lg:items-center lg:justify-between">
      <div id="filter-buttons" class="flex flex-wrap gap-2">
        <button data-cat="all" class="filter-btn px-4 py-2 text-sm border bg-brand-ink text-brand-cream border-brand-ink transition-colors">
          {labels.filterAll} ({allProducts.length})
        </button>
        {categories.map((cat) => (
          <button data-cat={cat.id} class="filter-btn px-4 py-2 text-sm border bg-white text-muted-foreground border-border hover:border-brand-ink transition-colors">
            {cat.name} ({curatedCountsByCategory[cat.id] || 0})
          </button>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          id="search-input"
          type="text"
          placeholder={labels.searchPlaceholder}
          class="w-full sm:w-auto sm:min-w-[180px] px-4 py-2 text-sm border border-border bg-white focus:outline-none focus:border-brand-ink"
        />
        <select
          id="sort-select"
          class="px-4 py-2 text-sm border border-border bg-white focus:outline-none focus:border-brand-ink"
        >
          {listingSortOptions.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
      </div>
    </div>
    <p id="result-count" class="text-sm text-muted-foreground mb-4"></p>

    <div id="procurement-filters" class="border border-border bg-brand-cream/25 p-5 mb-5">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
        <div>
          <p class="text-xs tracking-[0.24em] uppercase text-brand-camel font-medium mb-2">{listingFilterCopy.title}</p>
          <p class="text-sm text-muted-foreground">{listingFilterCopy.intro}</p>
        </div>
        <button type="button" data-proc-reset class="text-xs uppercase tracking-[0.14em] text-brand-ink hover:text-brand-camel underline underline-offset-4">{listingFilterCopy.reset}</button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-5">
        <fieldset>
          <legend class="text-xs uppercase tracking-[0.16em] text-muted-foreground mb-2">{listingFilterCopy.material}</legend>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-proc-filter="material" data-value="all" class="proc-filter active px-3 py-2 text-xs border bg-brand-ink text-brand-cream border-brand-ink transition-colors">{listingFilterCopy.all}</button>
            <button type="button" data-proc-filter="material" data-value="pure" class="proc-filter px-3 py-2 text-xs border border-border bg-white text-muted-foreground hover:border-brand-ink transition-colors">{listingFilterCopy.pure}</button>
            <button type="button" data-proc-filter="material" data-value="blend" class="proc-filter px-3 py-2 text-xs border border-border bg-white text-muted-foreground hover:border-brand-ink transition-colors">{listingFilterCopy.blend}</button>
            <button type="button" data-proc-filter="material" data-value="wool" class="proc-filter px-3 py-2 text-xs border border-border bg-white text-muted-foreground hover:border-brand-ink transition-colors">{listingFilterCopy.wool}</button>
          </div>
        </fieldset>
        <div class="text-sm text-muted-foreground leading-relaxed">
          {locale === 'cn' ? '起订量、样品、价格、交期、交付与文件范围将结合具体款式、数量和目的地书面确认。' : 'MOQ, sampling, price, lead time, delivery and document scope are confirmed in writing for the selected style, quantity and destination.'}
        </div>
      </div>
    </div>

    <!-- Active subcategory chips (populated by JS from URL params). Hidden when no active tags. -->
    <div id="active-chips" class="hidden flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs text-muted-foreground uppercase tracking-wider mr-1" data-chip-prefix></span>
      <!-- chips injected by JS -->
    </div>

    <!-- 591 个产品卡片（全部静态渲染，初始只显示前 24 个，其余懒加载） -->
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {/* 8-20 SEO: SSR emit at least 6 cards per category so Googlebot can discover
          every category from /products/ without depending on JS pagination.
          Before: allProducts.slice(0,24) emitted only hats (first category) → 0
          sweaters/scarves/yarn/accessories links in raw HTML. After: 6 cards ×
          5 categories = 30 mixed cards, each category gets indexed. */}
      {(() => {
        const PER_CAT = 6;
        const featured: typeof allProducts = [];
        for (const cat of categories) {
          const bucket = allProducts.filter((p) => p.categoryId === cat.id).slice(0, PER_CAT);
          featured.push(...bucket);
        }
        return featured.map((p) => (
        <a
          href={`/${locale}/products/${p.id}/`}
          class="product-card bg-white border border-border overflow-hidden hover:border-brand-camel hover:shadow-[0_16px_32px_-20px_rgba(28,24,19,0.18)] transition-colors transition-shadow duration-300 group block"
          data-id={p.id}
          data-cat={p.categoryId}
          data-name={p.name.toLowerCase()}
          data-material={(p.material || '').toLowerCase()}
        >
          <div class="aspect-square bg-brand-cream cursor-pointer overflow-hidden">
            {p.images && p.images[0] && (
              <img
                src={(p.images[0].startsWith('/images/') || p.images[0].startsWith('http'))
                  ? p.images[0]
                  : `/products/mic/${p.images[0]}`}
                alt={(() => {
                  // SEO alt text: "Material + Product Name + Micron + Audience/Tag"
                  // Helps Google Image Search rank for "cashmere X wholesale" queries.
                  const parts = [];
                  if (p.material && !p.name.toLowerCase().includes(p.material.toLowerCase())) parts.push(p.material);
                  // Strip generic prefixes ("Fold up", "European Style"...) to avoid repeating
                  const nameClean = p.name
                    .replace(/^(Premium|Wholesale|China|Inner Mongolia|Ordos|High Quality|European Style|Europe Style|Classic|New|Hot|Best|2024|2025|2026)\s+/i, '')
                    .replace(/\s+(Wholesale|Manufacturer|China|Inner Mongolia)$/i, '');
                  parts.push(nameClean);
                  if (p.micron) parts.push(p.micron);
                  const tags = (p.tags || []).filter((t) => /women|men|kids|unisex|ladies|girls|boys|outerwear|winter|spring|summer|fall|autumn/i.test(t));
                  if (tags.length > 0) parts.push(tags.slice(0, 2).join(' / '));
                  return parts.join(', ');
                })()}
                loading="lazy"
                decoding="async"
                width={400}
                height={400}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            )}
          </div>
          <div class="p-4">
            <p class="text-xs text-muted-foreground uppercase tracking-wider mb-1">{p.categoryName}</p>
            <h3 class="text-sm font-medium text-foreground mb-2 line-clamp-2 hover:text-brand-camel">
              {p.name}
            </h3>
            <div class="space-y-1 text-xs text-muted-foreground mb-3">
              <div class="flex justify-between"><span>{labels.material}:</span><span class="font-medium">{p.material}</span></div>
              <div class="flex justify-between"><span>{labels.micron}:</span><span class="font-medium">{p.micron}</span></div>
            </div>
            <p class="text-xs text-muted-foreground mb-2">{listingDiscovery.projectTerms}</p>
            <span class="block w-full px-3 py-2 bg-brand-ink text-brand-cream text-xs hover:bg-brand-camel transition-colors text-center">
              {labels.requestQuote}
            </span>
          </div>
        </a>
        ));
      })()}
    </div>
    <section class="mt-12 border-t border-border pt-12" aria-labelledby="category-discovery-title">
      <div class="max-w-3xl mb-8">
        <p class="text-xs tracking-[0.22em] uppercase text-brand-camel font-medium mb-3">{listingDiscovery.eyebrow}</p>
        <h2 id="category-discovery-title" class="font-display text-3xl md:text-4xl text-brand-ink font-light mb-4">{listingDiscovery.title}</h2>
        <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{listingDiscovery.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {categories.map((category) => {
          const hub = CATEGORY_HUBS[category.id];
          if (!hub) return null;
          return (
            <a href={`/${locale}/products/${hub.slug}/`} class="group border border-border bg-white p-5 hover:border-brand-gold hover:shadow-[0_14px_28px_-22px_rgba(28,24,19,0.28)] transition-colors transition-shadow">
              <p class="text-[10px] uppercase tracking-[0.18em] text-brand-camel mb-3">{locale === 'cn' ? '产品系列' : 'PRODUCT FAMILY'}</p>
              <h3 class="font-serif text-lg text-brand-ink leading-snug group-hover:text-brand-camel transition-colors">{hub.label[locale] || hub.label.en}</h3>
              <span class="inline-flex mt-4 text-xs uppercase tracking-[0.14em] text-muted-foreground group-hover:text-brand-ink transition-colors">{listingDiscovery.action} <span aria-hidden="true" class="ml-2">→</span></span>
            </a>
          );
        })}
      </div>
    </section>
    <!-- 分页控件（vanilla JS 控制） -->
    <div id="pagination-wrap" class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-border pt-6">
      <p id="page-info" class="text-sm text-muted-foreground"></p>
      <nav id="pagination" class="flex items-center gap-1" aria-label="Pagination"></nav>
    </div>

    <div id="compare-bar" class="hidden sticky bottom-4 z-30 mt-6 border border-brand-ink bg-brand-ink text-brand-cream px-4 py-3 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <p class="text-sm"><span data-compare-count>0</span> <span data-compare-selected>{procurementCopy.selected}</span> · <span class="text-brand-cream/70">{procurementCopy.compareLimit}</span></p>
        <div class="flex items-center gap-3">
          <button type="button" data-compare-clear class="text-xs uppercase tracking-[0.14em] underline underline-offset-4 hover:text-brand-gold">{procurementCopy.clear}</button>
          <button type="button" data-compare-open class="px-4 py-2 bg-brand-cream text-brand-ink text-xs uppercase tracking-[0.12em] font-medium hover:bg-brand-gold transition-colors">{procurementCopy.compareCta}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- All Products Index — 2026-08-19 移除: 用户反馈 /en/products/?cat=X 页面下半部分"所有产品"区域。
       原因: 列了 587 个产品链接, 布局臃肿; 已被上方 sticky filter + 前 24 张静态卡片 + 582 个产品按 filter 切换覆盖。
       替代内链: header mega-menu (按品类) + sidebar nav + 各 category hub 页 + 底部 sitemap。
  -->

  <!-- SEO Content Block -->
