// 591 产品 + 5 分类精简前 gzip 后 ~6 MB，精简后 ~120 KB（98%↓）。
// 详情页 (/en/products/<id>/) 继续用 getAllProducts() 全量，不受影响。
const LISTING_FIELDS = [
  'id', 'name', 'categoryId', 'categoryName',
  'material', 'micron', 'images', 'tags',
] as const;
function pickListFields(p: any) {
  const out: Record<string, unknown> = {};
  for (const k of LISTING_FIELDS) out[k] = p[k];
  return out;
}
function pickListCategory(c: any) {
  return {
    id: c.id,
    name: c.name,
    description: c.description,
    productCount: curatedCountsByCategory[c.id] || 0,
  };
}
const listProducts = allProducts.map(pickListFields);
const listCategories = categories.map(pickListCategory);
const productsJson = JSON.stringify(listProducts);
const categoriesJson = JSON.stringify(listCategories);
