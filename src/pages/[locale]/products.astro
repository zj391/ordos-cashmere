const procurementCopy = PROCUREMENT_COPY[locale] || PROCUREMENT_COPY.en;
const LISTING_FILTER_COPY: Record<string, { title: string; intro: string }> = {
  en: { title: 'Catalog filters', intro: 'Refine the curated catalog by listed material and product attributes.' },
  cn: { title: '目录筛选', intro: '按已列的材质与产品属性缩小精选目录。' },
