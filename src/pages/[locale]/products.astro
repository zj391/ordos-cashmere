  <!-- 隐藏的 JSON 数据源（vanilla JS 用） -->
  <script id="products-data" type="application/json" set:html={productsJson}></script>
  <script id="categories-data" type="application/json" set:html={categoriesJson}></script>
  <script id="labels-data" type="application/json" set:html={labelsJson}></script>
  <script id="product-tags-data" type="application/json" set:html={productTagsJson}></script>
  <script id="sub-labels-data" type="application/json" set:html={subLabelsJson}></script>
  <script id="group-labels-data" type="application/json" set:html={groupLabelsJson}></script>
    <script id="procurement-copy-data" type="application/json" set:html={procurementCopyJson}></script>
    <script id="listing-discovery-data" type="application/json" set:html={listingDiscoveryJson}></script>

  <!-- 交互逻辑：vanilla JS，零依赖 -->
  <script is:inline>
    (function() {
      window.__LOCALE__ = document.documentElement.lang || 'en';
      const products = JSON.parse(document.getElementById('products-data').textContent);
      const categories = JSON.parse(document.getElementById('categories-data').textContent);
      const labels = JSON.parse(document.getElementById('labels-data').textContent);
      const productTags = JSON.parse(document.getElementById('product-tags-data').textContent);
      const subLabels = JSON.parse(document.getElementById('sub-labels-data').textContent);
      const groupLabels = JSON.parse(document.getElementById('group-labels-data').textContent);
      const procurementCopy = JSON.parse(document.getElementById('procurement-copy-data').textContent);
      const listingDiscovery = JSON.parse(document.getElementById('listing-discovery-data').textContent);

      const PAGE_SIZE = 24;
      let activeCat = 'all';
      let searchQ = '';
      let sortBy = 'default';
      let currentPage = 1;
      const procurementFilters = { material: 'all' };
      const comparedIds = new Set();
      // Active subcategory filters from URL (e.g. ?byStyle=beanies&byMaterial=100pct-cashmere).
      // Mega menu links use ?groupKey=subKey; multiple params AND together.
      const activeTags = new Set();

      function materialBucket(material) {
        const value = String(material || '').toLowerCase();
        if (value.includes('cashmere') && value.includes('100%')) return 'pure';
        if (value.includes('cashmere') && (value.includes('wool') || value.includes('blend'))) return 'blend';
        if (value.includes('wool') || value.includes('merino')) return 'wool';
        return 'other';
      }

      function matchesProcurementFilters(product) {
        if (procurementFilters.material !== 'all' && materialBucket(product.material) !== procurementFilters.material) return false;
        return true;
      }

      // ---------- Parse URL params on load ----------

      // ---------- 筛选/搜索/排序 ----------
      const filterButtons = document.querySelectorAll('#filter-buttons .filter-btn');
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCat = btn.getAttribute('data-cat');
          filterButtons.forEach((b) => {
            if (b === btn) {
              b.classList.add('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
              b.classList.remove('bg-white', 'text-muted-foreground', 'border-border');
            } else {
              b.classList.remove('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
              b.classList.add('bg-white', 'text-muted-foreground', 'border-border');
            }
          });
          currentPage = 1;
          render();
        });
      });

      document.getElementById('search-input').addEventListener('input', (e) => {
        searchQ = e.target.value.trim().toLowerCase();
        currentPage = 1;
        render();
      });

      document.getElementById('sort-select').addEventListener('change', (e) => {
        sortBy = e.target.value;
        currentPage = 1;
        render();
      });

      const procurementFilterButtons = document.querySelectorAll('[data-proc-filter]');
      procurementFilterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-proc-filter');
          const value = button.getAttribute('data-value');
          if (!key || !value) return;
          procurementFilters[key] = value;
          document.querySelectorAll('[data-proc-filter="' + key + '"]').forEach((peer) => {
            const active = peer.getAttribute('data-value') === value;
            peer.classList.toggle('active', active);
            peer.classList.toggle('bg-brand-ink', active);
            peer.classList.toggle('text-brand-cream', active);
            peer.classList.toggle('border-brand-ink', active);
          });
          currentPage = 1;
          render();
        });
      });

      document.querySelector('[data-proc-reset]').addEventListener('click', () => {
        Object.keys(procurementFilters).forEach((key) => { procurementFilters[key] = 'all'; });
        procurementFilterButtons.forEach((button) => {
          const active = button.getAttribute('data-value') === 'all';
          button.classList.toggle('active', active);
          button.classList.toggle('bg-brand-ink', active);
          button.classList.toggle('text-brand-cream', active);
          button.classList.toggle('border-brand-ink', active);
        });
        currentPage = 1;
        render();
      });

      document.querySelector('[data-compare-clear]').addEventListener('click', () => {
        comparedIds.clear();
        updateCompareBar();
        render();
      });
      document.querySelector('[data-compare-open]').addEventListener('click', openCompareModal);

      // ---------- Mega-menu URL params: ?byStyle=beanies&byMaterial=100pct-cashmere ----------
      // Read URL params at load. Each ?groupKey=subKey is one filter.
      // Auto-derive activeCat from the first URL tag if no explicit ?cat=... given.
      function readUrlParams() {
        const params = new URLSearchParams(window.location.search);
        const KNOWN_GROUPS = Object.keys(subLabels.hats || {}).concat(
          Object.keys(subLabels.sweaters || {}),
          Object.keys(subLabels.scarves || {}),
          Object.keys(subLabels.accessories || {}),
          Object.keys(subLabels.yarn || {})
        );
        const seen = new Set();
        for (const [group, sub] of params.entries()) {
          if (KNOWN_GROUPS.includes(group)) {
            activeTags.add(`${group}=${sub}`);
            seen.add(group);
          }
        }
        // Auto-set category from first active tag if no explicit cat
        if (!params.get('cat') && activeTags.size > 0) {
          for (const catId of Object.keys(subLabels)) {
            for (const group of Object.keys(subLabels[catId] || {})) {
              if (seen.has(group)) { activeCat = catId; break; }
            }
            if (activeCat !== 'all') break;
          }
        }
      }

      function clearAllTags() {
        activeTags.clear();
        // Remove tag params from URL without reloading
        const url = new URL(window.location.href);
        for (const group of Object.keys(groupLabels)) {
          url.searchParams.delete(group);
        }
        url.searchParams.delete('cat');
        window.history.replaceState({}, '', url.toString());
        // Reset category filter to all
        activeCat = 'all';
        // Also reset category button UI
        filterButtons.forEach((b) => {
          if (b.getAttribute('data-cat') === 'all') {
            b.classList.add('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
            b.classList.remove('bg-white', 'text-muted-foreground', 'border-border');
          } else {
            b.classList.remove('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
            b.classList.add('bg-white', 'text-muted-foreground', 'border-border');
          }
        });
        render();
      }

      function removeTag(group, sub) {
        activeTags.delete(`${group}=${sub}`);
        const url = new URL(window.location.href);
        url.searchParams.delete(group);
        window.history.replaceState({}, '', url.toString());
        // If no more tags, reset to all-categories
        if (activeTags.size === 0) {
          activeCat = 'all';
          filterButtons.forEach((b) => {
            if (b.getAttribute('data-cat') === 'all') {
              b.classList.add('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
              b.classList.remove('bg-white', 'text-muted-foreground', 'border-border');
            } else {
              b.classList.remove('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
              b.classList.add('bg-white', 'text-muted-foreground', 'border-border');
            }
          });
        }
        render();
      }

      function renderActiveChips() {
        const container = document.getElementById('active-chips');
        if (!container || activeTags.size === 0) {
          if (container) container.classList.add('hidden');
          return;
        }
        container.classList.remove('hidden');
        const localeKey = window.__LOCALE__ || 'en';
        const prefix = labels.activeFilterPrefix?.[localeKey] || labels.activeFilterPrefix?.en || 'Filtered by:';
        const clearAll = labels.clearAll?.[localeKey] || labels.clearAll?.en || 'Clear all';
        // Rebuild contents
        container.innerHTML = '';
        const prefixEl = document.createElement('span');
        prefixEl.className = 'text-xs text-muted-foreground uppercase tracking-wider mr-1';
        prefixEl.textContent = prefix + ' ';
        container.appendChild(prefixEl);
        for (const tag of activeTags) {
          const [group, sub] = tag.split('=');
          const subText = subLabels[activeCat]?.[group]?.[sub]?.[localeKey] || subLabels[activeCat]?.[group]?.[sub]?.en || sub;
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'inline-flex items-center gap-1 px-3 py-1 text-xs border border-border bg-white hover:border-brand-ink transition-colors';
          chip.innerHTML = `<span>${subText}</span><span aria-hidden="true">&times;</span>`;
          chip.addEventListener('click', () => removeTag(group, sub));
          container.appendChild(chip);
        }
        const clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'ml-2 text-xs text-muted-foreground hover:text-foreground underline';
        clearBtn.textContent = clearAll;
        clearBtn.addEventListener('click', clearAllTags);
        container.appendChild(clearBtn);
      }

      function getFiltered() {
        let result = products;
        if (activeCat !== 'all') result = result.filter((p) => p.categoryId === activeCat);
        result = result.filter(matchesProcurementFilters);
        // Apply tag filters (AND across groups, OR within a group)
        if (activeTags.size > 0) {
          // Group tags by groupKey
          const byGroup = {};
          for (const tag of activeTags) {
            const [g, s] = tag.split('=');
            (byGroup[g] ||= []).push(s);
          }
          result = result.filter((p) => {
            const productTagsForId = productTags[p.id] || [];
            // Every active group must have at least one matching subKey on the product
            for (const group of Object.keys(byGroup)) {
              const subs = byGroup[group];
              const matchInGroup = subs.some((sub) => productTagsForId.includes(`${group}=${sub}`));
              if (!matchInGroup) return false;
            }
            return true;
          });
        }
        if (searchQ) {
          result = result.filter((p) =>
            (p.name && p.name.toLowerCase().includes(searchQ)) ||
            (p.id && p.id.toLowerCase().includes(searchQ)) ||
            (p.material && p.material.toLowerCase().includes(searchQ))
          );
        }
        if (sortBy === 'price-asc') {
          result = [...result].sort((a, b) => parseFloat((a.price || '0').split('-')[0]) - parseFloat((b.price || '0').split('-')[0]));
        } else if (sortBy === 'price-desc') {
          result = [...result].sort((a, b) => parseFloat((b.price || '0').split('-')[0]) - parseFloat((a.price || '0').split('-')[0]));
        } else if (sortBy === 'moq-asc') {
          result = [...result].sort((a, b) => (a.moq || 0) - (b.moq || 0));
        }
        return result;
      }

      function render() {
        renderActiveChips();
        const filtered = getFiltered();
        document.getElementById('result-count').textContent =
          labels.showingProducts ? labels.showingProducts(filtered.length) : ('Showing ' + filtered.length + ' products');

        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        const start = (currentPage - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;
        const slice = filtered.slice(start, end);

        const grid = document.getElementById('product-grid');
        grid.innerHTML = slice.map(cardHtml).join('');

        // 分页控件
        renderPagination(filtered.length, totalPages);

        bindCardEvents();
        updateCompareBar();

        // 切换筛选/页码后滚到网格顶部
        const gridEl = document.getElementById('product-grid');
        if (gridEl && currentPage > 1) {
          gridEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function renderPagination(total, totalPages) {
        const info = document.getElementById('page-info');
        const start = (currentPage - 1) * PAGE_SIZE + 1;
        const end = Math.min(currentPage * PAGE_SIZE, total);
        info.textContent = total > 0
          ? ('Showing ' + start + '–' + end + ' of ' + total + ' products')
          : 'No products match your filters';

        const nav = document.getElementById('pagination');
        if (totalPages <= 1) { nav.innerHTML = ''; return; }

        // 页码：显示当前 ±2，加上首页/末页/prev/next
        const pages = new Set([1, totalPages, currentPage, currentPage - 1, currentPage - 2, currentPage + 1, currentPage + 2]);
        const visiblePages = [...pages].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b);

        let html = '';
        // Prev
        html += pageBtnHtml('‹', currentPage > 1 ? currentPage - 1 : null, currentPage === 1);

        let last = 0;
        for (const p of visiblePages) {
          if (p - last > 1) html += '<span class="px-2 text-muted-foreground/70">…</span>';
          html += pageBtnHtml(String(p), p, false, p === currentPage);
          last = p;
        }

        // Next
        html += pageBtnHtml('›', currentPage < totalPages ? currentPage + 1 : null, currentPage === totalPages);
        nav.innerHTML = html;

        // 绑定事件
        nav.querySelectorAll('button[data-page]').forEach((b) => {
          b.addEventListener('click', () => {
            const p = parseInt(b.getAttribute('data-page'));
            if (!isNaN(p) && p !== currentPage) {
              currentPage = p;
              render();
            }
          });
        });
      }

      function pageBtnHtml(label, page, disabled, active) {
        const baseCls = 'min-w-[40px] h-10 px-3 inline-flex items-center justify-center text-sm border transition-colors';
        if (disabled) {
          return '<button disabled class="' + baseCls + ' bg-brand-cream text-muted-foreground/50 border-border cursor-not-allowed">' + label + '</button>';
        }
        if (active) {
          return '<button data-page="' + page + '" class="' + baseCls + ' bg-brand-ink text-brand-cream border-brand-ink">' + label + '</button>';
        }
        return '<button data-page="' + page + '" class="' + baseCls + ' bg-white text-muted-foreground border-border hover:border-brand-ink hover:text-foreground">' + label + '</button>';
      }

      function cardHtml(p) {
        const rawImg = (p.images && p.images[0]) || '';
        // Absolute paths (e.g. `/images/models/...`) pass through; relative
        // filenames get the `/products/mic/` prefix.
        const img = rawImg.startsWith('/images/') || rawImg.startsWith('http')
          ? rawImg
          : '/products/mic/' + rawImg;
        const selected = comparedIds.has(p.id);
        return (
          '<article class="product-card bg-white border border-border overflow-hidden hover:border-brand-camel hover:shadow-[0_16px_32px_-20px_rgba(28,24,19,0.18)] transition-colors transition-shadow duration-300" data-id="' + escapeHtml(p.id) + '">' +
            '<a href="/' + (window.__LOCALE__ || 'en') + '/products/' + escapeHtml(p.id) + '/" class="block group">' +
            '<div class="aspect-square bg-brand-cream cursor-pointer overflow-hidden">' +
              (img ? '<img src="' + img + '" alt="' + escapeHtml(p.name) + '" decoding="async" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />' : '') +
            '</div>' +
            '<div class="p-4">' +
              '<p class="text-xs text-muted-foreground uppercase tracking-wider mb-1">' + escapeHtml(p.categoryName || '') + '</p>' +
              '<h3 class="text-sm font-medium text-foreground mb-2 line-clamp-2 hover:text-brand-camel">' + escapeHtml(p.name) + '</h3>' +
              '<div class="space-y-1 text-xs text-muted-foreground mb-3">' +
                '<div class="flex justify-between"><span>' + escapeHtml(labels.material) + ':</span><span class="font-medium">' + escapeHtml(p.material || '') + '</span></div>' +
                '<div class="flex justify-between"><span>' + escapeHtml(labels.micron) + ':</span><span class="font-medium">' + escapeHtml(p.micron || '') + '</span></div>' +
              '</div>' +
              '<p class="text-xs text-muted-foreground mb-2">' + escapeHtml(listingDiscovery.projectTerms) + '</p>' +
              '<span class="block w-full px-3 py-2 bg-brand-ink text-brand-cream text-xs hover:bg-brand-camel transition-colors text-center">' + escapeHtml(labels.requestQuote) + '</span>' +
            '</div>' +
            '</a>' +
            '<div class="px-4 pb-4">' +
              '<button type="button" data-compare="' + escapeHtml(p.id) + '" class="w-full px-3 py-2 text-xs border transition-colors ' + (selected ? 'bg-brand-gold/15 border-brand-gold text-brand-ink' : 'bg-white border-border text-muted-foreground hover:border-brand-ink') + '">' + escapeHtml(procurementCopy.compare) + (selected ? ' ✓' : '') + '</button>' +
            '</div>' +
          '</article>'
        );
      }

      function escapeHtml(s) {
        if (s == null) return '';
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // ---------- 弹窗 ----------
      const modal = document.getElementById('product-modal');
      const modalContent = document.getElementById('modal-content');
      const modalBackdrop = document.getElementById('modal-backdrop');

      function bindCardEvents() {
        document.querySelectorAll('[data-compare]').forEach((button) => {
          button.addEventListener('click', () => {
            const id = button.getAttribute('data-compare');
            if (!id) return;
            if (comparedIds.has(id)) {
              comparedIds.delete(id);
            } else if (comparedIds.size < 3) {
              comparedIds.add(id);
            } else {
              showToast(procurementCopy.compareLimit);
              return;
            }
            updateCompareBar();
            render();
          });
        });
      }

      function selectedProducts() {
        return products.filter((product) => comparedIds.has(product.id));
      }

      function updateCompareBar() {
        const bar = document.getElementById('compare-bar');
        const count = bar?.querySelector('[data-compare-count]');
        if (count) count.textContent = String(comparedIds.size);
        if (bar) bar.classList.toggle('hidden', comparedIds.size === 0);
      }

      function closeCompareModal() {
        const existing = document.getElementById('catalog-compare-modal');
        if (existing) existing.remove();
        document.body.style.overflow = '';
      }

      function addComparedToInquiry() {
        if (!window.dxCart) {
          showToast('Inquiry list is loading. Please try again.');
          return;
        }
        selectedProducts().forEach((product) => {
          window.dxCart.add({ ...product, price: '', currency: '', moq: 0, image: (product.images || [])[0] || '', href: '/' + (window.__LOCALE__ || 'en') + '/products/' + product.id + '/', qty: 1 });
        });
        closeCompareModal();
        showToast(procurementCopy.addToInquiry);
      }

      function openCompareModal() {
        const selected = selectedProducts();
        if (!selected.length) return;
        closeCompareModal();
        const modalEl = document.createElement('div');
        modalEl.id = 'catalog-compare-modal';
        modalEl.className = 'fixed inset-0 z-[260] bg-black/60 p-4 flex items-center justify-center';
        const columns = selected.map((product) => '<th class="min-w-[180px] p-3 text-left font-medium align-top"><a class="hover:text-brand-camel" href="/' + (window.__LOCALE__ || 'en') + '/products/' + escapeHtml(product.id) + '/">' + escapeHtml(product.name) + '</a></th>').join('');
        const row = (label, getValue) => '<tr class="border-t border-border"><th scope="row" class="p-3 text-left text-xs uppercase tracking-wider text-muted-foreground whitespace-nowrap">' + escapeHtml(label) + '</th>' + selected.map((product) => '<td class="p-3 text-sm text-foreground">' + escapeHtml(getValue(product) || '—') + '</td>').join('') + '</tr>';
        modalEl.innerHTML = '<div class="w-full max-w-5xl max-h-[88vh] overflow-auto bg-brand-cream border border-brand-ink shadow-2xl">' +
          '<div class="flex items-start justify-between gap-4 p-5 border-b border-border"><div><p class="text-xs uppercase tracking-[0.2em] text-brand-camel mb-2">' + escapeHtml(procurementCopy.compareLimit) + '</p><h2 class="font-serif text-2xl text-brand-ink">' + escapeHtml(procurementCopy.compareTitle) + '</h2></div><button type="button" data-compare-close class="text-sm text-muted-foreground hover:text-brand-ink">' + escapeHtml(procurementCopy.close) + ' ×</button></div>' +
          '<div class="overflow-x-auto"><table class="w-full border-collapse"><thead><tr><th class="p-3"></th>' + columns + '</tr></thead><tbody>' +
            row('Category', (product) => product.categoryName) +
            row(labels.material || 'Material', (product) => product.material) +
            row(labels.micron || 'Micron', (product) => product.micron) +
          '</tbody></table></div>' +
          '<div class="p-5 border-t border-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"><p class="text-sm text-muted-foreground">' + escapeHtml(procurementCopy.compareLimit) + '</p><button type="button" data-compare-inquiry class="px-5 py-3 bg-brand-ink text-brand-cream text-xs uppercase tracking-[0.14em] hover:bg-brand-camel transition-colors">' + escapeHtml(procurementCopy.addToInquiry) + '</button></div>' +
        '</div>';
        modalEl.addEventListener('click', (event) => { if (event.target === modalEl) closeCompareModal(); });
        modalEl.querySelector('[data-compare-close]').addEventListener('click', closeCompareModal);
        modalEl.querySelector('[data-compare-inquiry]').addEventListener('click', addComparedToInquiry);
        document.body.appendChild(modalEl);
        document.body.style.overflow = 'hidden';
      }

      // 颜色名 → 大致色相（hash 后映射到一组固定颜色）；不命中走灰色
      // 仅用于「文字色名 + 圆色块」的视觉化兜底（products.json 颜色都是文字）
      const COLOR_PALETTE = [
        '#1f2937', // 黑
        '#f5f5f4', // 白
        '#7c2d12', // 棕
        '#9a3412', // 焦糖
        '#a16207', // 驼
        '#365314', // 墨绿
        '#1e3a8a', // 藏青
        '#7e22ce', // 紫
        '#9f1239', // 酒红
        '#b91c1c', // 红
        '#ca8a04', // 芥末
        '#52525b', // 灰
      ];
      const COLOR_KEYWORDS = [
        ['black', '黑'], ['white', '白', 'ivory', 'cream'], ['brown', '棕', 'chocolate'], ['tan', 'caramel', '焦糖', 'beige'],
        ['camel', '驼', 'khaki'], ['green', 'forest', '墨绿', 'olive'],
        ['navy', '藏青', 'blue'], ['purple', '紫', 'lavender'], ['burgundy', 'wine', '酒红', 'maroon'],
        ['red', '红', 'crimson'], ['mustard', 'yellow', '芥末', '黄', 'gold'], ['grey', 'gray', '灰', 'silver'],
      ];
      function colorNameToHex(name) {
        const s = (name || '').toLowerCase();
        for (let i = 0; i < COLOR_KEYWORDS.length; i++) {
          for (const kw of COLOR_KEYWORDS[i]) {
            if (s.includes(kw)) return COLOR_PALETTE[i];
          }
        }
        return null; // 命中不了（如「多种颜色可选」）走文字 fallback
      }
      function swatchHtml(name) {
        const hex = colorNameToHex(name);
        const isLight = hex === '#f5f5f4' || hex === '#ca8a04';
        const ring = isLight ? 'ring-1 ring-border' : '';
        const chip = hex
          ? '<span class="inline-block w-4 h-4 rounded-full ' + ring + '" style="background:' + hex + '"></span>'
          : '<span class="inline-block w-4 h-4 rounded-full bg-brand-cream border border-dashed border-border"></span>';
        return '<span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 bg-brand-cream text-muted-foreground border border-border">' +
                 chip + '<span>' + escapeHtml(name) + '</span>' +
               '</span>';
      }

      // 内联 SVG 图标（specs 行首），零依赖
      function specIcon(kind) {
        const common = 'class="w-3.5 h-3.5 text-muted-foreground/70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"';
        if (kind === 'material') return '<svg ' + common + '><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h10"/></svg>';
        if (kind === 'micron')   return '<svg ' + common + '><circle cx="12" cy="12" r="8" stroke-width="1.8"/><circle cx="12" cy="12" r="3" stroke-width="1.8" fill="currentColor"/></svg>';
        if (kind === 'lead')     return '<svg ' + common + '><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        if (kind === 'sample')   return '<svg ' + common + '><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8 8-4-4M20 7v6h-6"/></svg>';
        if (kind === 'weight')   return '<svg ' + common + '><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 6h18l-2 13H5L3 6zM8 6V4a4 4 0 018 0v2"/></svg>';
        return '';
      }
      // 规格表行：图标 + label + value
      function specRowIcon(icon, label, value) {
        if (!value) return '';
        return '<div class="flex items-start gap-2 py-1.5">' +
                 specIcon(icon) +
                 '<div class="min-w-0 flex-1">' +
                   '<dt class="text-[11px] uppercase tracking-wider text-muted-foreground leading-none mb-0.5">' + escapeHtml(label) + '</dt>' +
                   '<dd class="text-sm text-foreground font-medium leading-snug">' + escapeHtml(value) + '</dd>' +
                 '</div>' +
               '</div>';
      }

      // ---------- Lightbox（主图点击放大）+ Toast ----------
      // Lightbox 节点 lazy 注入
      let lightboxEl = null;
      function openLightbox(src, alt) {
        if (!lightboxEl) {
          lightboxEl = document.createElement('div');
          lightboxEl.id = 'lightbox';
          lightboxEl.className = 'fixed inset-0 z-[300] bg-black/90 flex items-center justify-center p-4 cursor-zoom-out';
          lightboxEl.innerHTML = '<img class="max-w-full max-h-full object-contain" />';
          lightboxEl.addEventListener('click', closeLightbox);
          document.body.appendChild(lightboxEl);
        }
        lightboxEl.querySelector('img').src = src;
        lightboxEl.querySelector('img').alt = alt || '';
        lightboxEl.classList.remove('hidden');
        lightboxEl.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
      function closeLightbox() {
        if (!lightboxEl) return;
        lightboxEl.style.display = 'none';
        // 还原 modal 锁定的 scroll（如果 modal 仍开着）
        if (!modal.classList.contains('hidden')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      }

      // Toast 节点 lazy 注入
      let toastEl = null;
      let toastTimer = null;
      function showToast(msg) {
        if (!toastEl) {
          toastEl = document.createElement('div');
          toastEl.id = 'app-toast';
          toastEl.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[400] px-4 py-2 bg-brand-ink text-brand-cream text-sm rounded-none shadow-lg transition-opacity duration-200 opacity-0 pointer-events-none';
          document.body.appendChild(toastEl);
        }
        toastEl.textContent = msg;
        // force reflow then fade in
        toastEl.style.opacity = '0';
        requestAnimationFrame(() => {
          toastEl.style.opacity = '1';
        });
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toastEl.style.opacity = '0';
        }, 1800);
      }

      // ESC 关闭，← → 切换产品
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          // 优先关 lightbox，再关 modal
          if (lightboxEl && lightboxEl.style.display !== 'none') { closeLightbox(); return; }
          if (!modal.classList.contains('hidden')) { closeModal(); return; }
          return;
        }
        if (modal.classList.contains('hidden')) return;
        const prevBtn = document.getElementById('modal-prev');
        const nextBtn = document.getElementById('modal-next');
        if (e.key === 'ArrowLeft' && prevBtn && !prevBtn.disabled) prevBtn.click();
        if (e.key === 'ArrowRight' && nextBtn && !nextBtn.disabled) nextBtn.click();
      });

      // 初次渲染：SSR 已渲染 24 张卡片 + 分页
      bindCardEvents(); // 绑定卡片 click → openModal

      // ---------- Init: read URL params, apply filter, render ----------
      readUrlParams();
      // If URL auto-set activeCat (from mega-menu link), update the category button UI
      if (activeCat !== 'all') {
        filterButtons.forEach((b) => {
          if (b.getAttribute('data-cat') === activeCat) {
            b.classList.add('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
            b.classList.remove('bg-white', 'text-muted-foreground', 'border-border');
          } else {
            b.classList.remove('bg-brand-ink', 'text-brand-cream', 'border-brand-ink');
            b.classList.add('bg-white', 'text-muted-foreground', 'border-border');
          }
        });
      }

      (function initPagination() {
        renderActiveChips();
        // Get total filtered count for pagination, but render full SSR list first
        const filtered = getFiltered();
        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        currentPage = 1;
        renderPagination(filtered.length, totalPages);
        render(); // re-render with filters applied
      })();
    })();
  </script>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
