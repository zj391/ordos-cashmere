  title: (LISTING_FILTER_COPY[locale] || LISTING_FILTER_COPY.en).title,
  intro: (LISTING_FILTER_COPY[locale] || LISTING_FILTER_COPY.en).intro,
  material: procurementCopy.material,
  all: procurementCopy.all,
  pure: procurementCopy.pure,
  blend: procurementCopy.blend,
  wool: procurementCopy.wool,
  reset: procurementCopy.reset,
  compare: procurementCopy.compare,
  selected: procurementCopy.selected,
  compareCta: procurementCopy.compareCta,
  clear: procurementCopy.clear,
  compareTitle: procurementCopy.compareTitle,
  compareLimit: procurementCopy.compareLimit,
  addToInquiry: procurementCopy.addToInquiry,
