---
/**
 * 采购信任页 SEO：质量控制与核验
 * 设计原则：只描述页面可见且可在询盘中进一步确认的采购准备信息。
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

type Copy = {
  eyebrow: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  checksTitle: string;
  checks: { title: string; text: string }[];
  linksTitle: string;
  faqTitle: string;
  faqs: { q: string; a: string }[];
  ctaTitle: string;
  ctaText: string;
  cta: string;
};

const content: Record<string, Copy> = {
  en: {
    eyebrow: 'PURCHASING VERIFICATION',
    title: 'Cashmere Quality Control & Buyer Verification | DONGXIAO®',
    description: 'Prepare a cashmere quality-control brief before ordering: material, measurements, sample approval, inspection scope, packing and shipment records.',
    h1: 'Cashmere Quality Control & Buyer Verification',
    intro: 'Use this page to prepare the product and inspection details that should be aligned in writing before bulk approval. Final specifications, sampling scope and acceptance criteria are confirmed for the individual order.',
    checksTitle: 'Three checkpoints for a clearer inspection brief',
    checks: [
      { title: '01 — Product specification', text: 'Record the style reference, fiber composition target, color reference, measurements or gauge, label requirements and approved sample version.' },
      { title: '02 — Production review', text: 'Align the pre-production sample, approved trims, packaging direction, measurement tolerances and any buyer-appointed inspection requirements before bulk work proceeds.' },
      { title: '03 — Pre-shipment review', text: 'Confirm the order quantity, packing list, carton marks, document requirements and agreed inspection scope before shipment is released.' },
    ],
    linksTitle: 'Build the verification path',
    faqTitle: 'Quality-control planning FAQ',
    faqs: [
      { q: 'What should be included in a cashmere quality-control brief?', a: 'Include the product reference, material target, color reference, key measurements, labeling, packaging, order quantity, destination requirements and the sample version used for approval.' },
      { q: 'When should an inspection scope be agreed?', a: 'Agree the inspection scope before bulk approval so the supplier and buyer can use the same product, measurement, packing and document references.' },
      { q: 'Can a buyer request independent testing or inspection?', a: 'State the requested test, inspection company, timing and reporting requirements in the inquiry or purchase agreement so feasibility and commercial terms can be confirmed in writing.' },
    ],
    ctaTitle: 'Prepare your product verification brief',
    ctaText: 'Send the product link, target quantity, material or color direction, destination and required verification points with your inquiry.',
    cta: 'Request a specification review',
  },
  cn: {
    eyebrow: '采购核验',
    title: '羊绒质量控制与采购核验 | DONGXIAO®',
    description: '在下单前准备羊绒质量控制需求：材质、尺寸、样品确认、验货范围、包装与出运文件。',
    h1: '羊绒质量控制与采购核验',
    intro: '本页帮助采购方在大货确认前整理产品与验货信息。最终规格、抽检范围与验收标准应在对应订单中以书面形式确认。',
    checksTitle: '建立清晰验货需求的三项检查',
    checks: [
      { title: '01 — 产品规格', text: '记录款号、材质目标、颜色参考、尺寸或针型、洗标要求和已确认样品版本。' },
      { title: '02 — 生产确认', text: '在大货开始前对产前样、辅料、包装方向、尺寸公差以及买方指定验货要求进行确认。' },
      { title: '03 — 出运前核验', text: '在放货前确认订单数量、装箱单、外箱唛头、文件要求和双方约定的验货范围。' },
    ],
    linksTitle: '建立核验链路',
    faqTitle: '质控准备常见问题',
    faqs: [
      { q: '羊绒质控需求应包含哪些信息？', a: '建议包含产品链接或款号、材质目标、颜色参考、关键尺寸、标签、包装、数量、目的国要求和确认样品版本。' },
      { q: '何时确定验货范围？', a: '应在大货确认前确定，以便买卖双方使用同一产品、尺寸、包装和文件依据。' },
      { q: '买方可以要求第三方检测或验货吗？', a: '请在询盘或采购协议中说明检测项目、验货机构、时间和报告要求，以便书面确认可行性与商业条款。' },
    ],
    ctaTitle: '准备产品核验需求',
    ctaText: '请在询盘中提供产品链接、目标数量、材质或颜色方向、目的国和所需核验项目。',
    cta: '申请规格沟通',
  },
  de: { eyebrow: 'EINKAUFSVERIFIKATION', title: 'Kaschmir-Qualitätskontrolle & Einkaufsprüfung | DONGXIAO®', description: 'Bereiten Sie vor der Bestellung Material-, Maß-, Muster-, Verpackungs- und Prüfanforderungen vor.', h1: 'Kaschmir-Qualitätskontrolle & Einkaufsprüfung', intro: 'Spezifikationen und Abnahmekriterien werden für jede Bestellung schriftlich abgestimmt.', checksTitle: 'Drei Prüfpunkte', checks: [{ title: '01 — Spezifikation', text: 'Stil, Material, Farbe, Maße, Etiketten und freigegebenes Muster festhalten.' }, { title: '02 — Produktionsprüfung', text: 'Vorproduktion, Zutaten, Verpackung und Prüfumfang vor Bulk-Freigabe abgleichen.' }, { title: '03 — Versandprüfung', text: 'Menge, Packliste, Kartonmarkierung und Dokumente vor Versand bestätigen.' }], linksTitle: 'Prüfpfad aufbauen', faqTitle: 'FAQ zur Qualitätsplanung', faqs: [{ q: 'Was gehört in einen Prüfbrief?', a: 'Produktreferenz, Material, Farbe, Maße, Etiketten, Verpackung, Menge und freigegebenes Muster.' }, { q: 'Wann wird der Prüfumfang vereinbart?', a: 'Vor der Bulk-Freigabe, damit beide Seiten dieselben Referenzen verwenden.' }, { q: 'Kann eine unabhängige Prüfung angefragt werden?', a: 'Nennen Sie Institut, Zeitpunkt und Berichtsanforderungen in Ihrer Anfrage zur schriftlichen Bestätigung.' }], ctaTitle: 'Prüfanforderungen vorbereiten', ctaText: 'Senden Sie Produktlink, Menge, Zielmarkt und Prüfanforderungen mit Ihrer Anfrage.', cta: 'Spezifikation besprechen' },
  fr: { eyebrow: 'VÉRIFICATION ACHAT', title: 'Contrôle qualité cachemire & vérification achat | DONGXIAO®', description: 'Préparez matière, mesures, échantillon, emballage et exigences de contrôle avant de commander.', h1: 'Contrôle qualité cachemire & vérification achat', intro: 'Les spécifications et critères d’acceptation sont confirmés par écrit pour chaque commande.', checksTitle: 'Trois points de contrôle', checks: [{ title: '01 — Spécification', text: 'Consignez le style, la matière, la couleur, les mesures, les étiquettes et l’échantillon approuvé.' }, { title: '02 — Revue production', text: 'Alignez échantillon, accessoires, emballage et périmètre de contrôle avant le lancement.' }, { title: '03 — Revue expédition', text: 'Confirmez quantité, liste de colisage, marquage cartons et documents avant expédition.' }], linksTitle: 'Construire le parcours de vérification', faqTitle: 'FAQ contrôle qualité', faqs: [{ q: 'Que doit contenir un brief qualité ?', a: 'Référence produit, matière, couleur, mesures, étiquettes, emballage, quantité et échantillon validé.' }, { q: 'Quand définir le contrôle ?', a: 'Avant l’approbation de production pour utiliser les mêmes références.' }, { q: 'Une inspection indépendante est-elle possible ?', a: 'Indiquez organisme, calendrier et rapport demandé dans votre demande pour confirmation écrite.' }], ctaTitle: 'Préparer vos exigences', ctaText: 'Envoyez le lien produit, la quantité, le marché et les exigences de vérification.', cta: 'Discuter des spécifications' },
  ja: { eyebrow: '調達検証', title: 'カシミヤ品質管理・調達検証 | DONGXIAO®', description: '発注前に素材、寸法、承認サンプル、梱包、検品要件を整理します。', h1: 'カシミヤ品質管理・調達検証', intro: '仕様と受入基準は注文ごとに書面で確認します。', checksTitle: '3つの確認ポイント', checks: [{ title: '01 — 仕様', text: 'スタイル、素材、色、寸法、ラベル、承認サンプルを記録します。' }, { title: '02 — 生産確認', text: '量産前にサンプル、付属品、梱包、検品範囲を合わせます。' }, { title: '03 — 出荷前確認', text: '数量、パッキングリスト、カートンマーク、書類を確認します。' }], linksTitle: '検証経路を作る', faqTitle: '品質計画 FAQ', faqs: [{ q: '品質要件には何を含めますか？', a: '製品、素材、色、寸法、ラベル、梱包、数量、承認サンプルです。' }, { q: '検品範囲はいつ決めますか？', a: '量産承認前に双方が同じ基準を使えるよう決めます。' }, { q: '第三者検品は依頼できますか？', a: '検査機関、時期、報告要件を問い合わせに記載し書面で確認します。' }], ctaTitle: '検証要件を準備する', ctaText: '製品リンク、数量、市場、検証要件をお問い合わせに添えてください。', cta: '仕様を相談する' },
  kr: { eyebrow: '구매 검증', title: '캐시미어 품질 관리 및 구매 검증 | DONGXIAO®', description: '주문 전 소재, 치수, 승인 샘플, 포장, 검사 요건을 준비하세요.', h1: '캐시미어 품질 관리 및 구매 검증', intro: '사양과 수락 기준은 주문별로 서면 확인합니다.', checksTitle: '세 가지 확인 단계', checks: [{ title: '01 — 제품 사양', text: '스타일, 소재, 색상, 치수, 라벨, 승인 샘플을 기록합니다.' }, { title: '02 — 생산 검토', text: '양산 전 샘플, 부자재, 포장, 검사 범위를 조율합니다.' }, { title: '03 — 출하 전 검토', text: '수량, 패킹리스트, 카톤 마크, 서류를 확인합니다.' }], linksTitle: '검증 경로 만들기', faqTitle: '품질 계획 FAQ', faqs: [{ q: '품질 브리프에는 무엇이 필요합니까?', a: '제품, 소재, 색상, 치수, 라벨, 포장, 수량, 승인 샘플입니다.' }, { q: '검사 범위는 언제 정합니까?', a: '양산 승인 전에 양측이 같은 기준을 사용하도록 정합니다.' }, { q: '독립 검사를 요청할 수 있습니까?', a: '검사 기관, 시점, 보고 요건을 문의에 기재해 서면 확인을 받으세요.' }], ctaTitle: '검증 요건 준비', ctaText: '제품 링크, 수량, 시장, 검증 요건을 문의에 포함해 주세요.', cta: '사양 상담하기' },
};

const copy = content[locale] || content.en;
const pathwayLinks = [
  { href: `/${locale}/products/`, en: 'Product specifications', cn: '产品规格' },
  { href: `/${locale}/cashmere-grades/`, en: 'Cashmere grade guide', cn: '羊绒等级指南' },
  { href: `/${locale}/payment-terms/`, en: 'Prepare commercial terms', cn: '准备商务条件' },
  { href: `/${locale}/shipping-logistics/`, en: 'Shipping preparation', cn: '物流准备' },
];
---

<BaseLayout locale={locale} pageKey="quality-control" path="/quality-control" title={copy.title} description={copy.description} keywords={['cashmere quality control', 'cashmere inspection brief', 'cashmere sample approval', 'cashmere buyer verification']} schema="general">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/quality-control`} />
  <section class="bg-brand-sandwarm border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow max-w-4xl">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">{copy.eyebrow}</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{copy.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{copy.intro}</p>
    </div>
  </section>
  <section class="py-16 md:py-20 bg-background">
    <div class="container-narrow">
      <h2 class="font-display text-3xl font-light mb-10">{copy.checksTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {copy.checks.map((item) => <article class="border border-border bg-white p-6"><h3 class="font-serif text-xl mb-3">{item.title}</h3><p class="text-sm text-muted-foreground leading-relaxed">{item.text}</p></article>)}
      </div>
    </div>
  </section>
  <section class="py-16 bg-secondary/20 border-y border-border/60">
    <div class="container-narrow"><h2 class="font-display text-3xl font-light mb-8">{copy.linksTitle}</h2><div class="grid grid-cols-1 md:grid-cols-4 gap-4">{pathwayLinks.map((link) => <a href={link.href} class="border border-border bg-white p-5 text-sm font-medium hover:border-brand-camel transition-colors">{locale === 'cn' ? link.cn : link.en} →</a>)}</div></div>
  </section>
  <SEOFaq faqs={copy.faqs} title={copy.faqTitle} />
  <section class="py-16 bg-brand-sandwarm border-y border-border/60"><div class="container-narrow text-center"><h2 class="font-display text-3xl font-light mb-4">{copy.ctaTitle}</h2><p class="opacity-90 mb-8 max-w-2xl mx-auto">{copy.ctaText}</p><a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-brand-cream uppercase tracking-wider text-sm">{copy.cta}</a></div></section>
  <Footer slot="footer" locale={locale} /><FloatingChatButtons slot="footer" locale={locale} /><CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
