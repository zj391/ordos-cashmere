---
/**
 * Certifications - dedicated SEO hub (7-8)
 * Target: ISO OEKO-TEX cashmere supplier / OEKO-TEX certified cashmere clothing
 * Route: /[locale]/certifications × 6 locales = 6 URLs
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

const tdk = {
  en: {
    title: 'ISO 9001 & OEKO-TEX Certified Cashmere Supplier | DONGXIAO®',
    description: 'OEKO-TEX Standard 100, ISO 9001:2015, GOTS (on request), RWS certified cashmere factory. Audit reports available for B2B buyers. Download certificates.',
    h1: 'Certified Cashmere Manufacturer',
    intro: 'Every shipment ships with full documentation. We hold the certifications global B2B buyers require — and the audit reports to back them up.',
    bullets: [
      'ISO 9001:2015 (Quality Management)',
      'OEKO-TEX Standard 100 (Class I — safe for babies)',
      'GOTS (Global Organic Textile Standard) — on request for orders 500kg+',
      'RWS (Responsible Wool Standard) — for blended products',
    ],
    faqs: [
      { q: 'Are your certifications available for download?', a: 'Yes — visit our Download Center for current PDF certificates. We also share audit reports under NDA for serious buyers.' },
      { q: 'Do you test for harmful substances?', a: 'Yes — OEKO-TEX Standard 100 tests for formaldehyde, heavy metals, pesticides, and 300+ harmful substances. Tests run annually at Hohenstein and SGS.' },
      { q: 'Can you provide GOTS certification for organic cashmere?', a: 'Yes — for orders 500kg+ sourced from certified organic farms. Lead time +30 days for certification processing.' },
      { q: 'What about REACH compliance for EU buyers?', a: 'All our dyestuffs and auxiliaries are REACH-compliant. SDS available on request.' },
    ],
  },
  cn: {
    title: 'ISO 9001 + OEKO-TEX 认证羊绒工厂 | DONGXIAO®',
    description: 'OEKO-TEX 100、ISO 9001:2015、GOTS（按需）、RWS 认证羊绒工厂。',
    h1: '认证羊绒制造商',
    intro: '每批货附完整文件。国际 B2B 采购商所需的全部认证。',
    bullets: ['ISO 9001:2015', 'OEKO-TEX 100 一类（婴儿级安全）', 'GOTS（500kg+ 按需）', 'RWS（混纺产品）'],
    faqs: [{ q: '认证可下载？', a: '是，下载中心 PDF 证书。' }],
  },
  // 8-20: de/fr/ja/kr 翻译补齐
  de: {
    title: 'ISO 9001 & OEKO-TEX zertifizierter Kaschmir-Lieferant | DONGXIAO®',
    description: 'OEKO-TEX Standard 100, ISO 9001:2015, GOTS (auf Anfrage), RWS zertifizierte Kaschmirfabrik. Auditberichte für B2B-Käufer verfügbar. Zertifikate herunterladen.',
    h1: 'Zertifizierter Kaschmir-Hersteller',
    intro: 'Jede Lieferung wird mit vollständiger Dokumentation versandt. Wir halten die Zertifizierungen, die globale B2B-Käufer verlangen — und die dazugehörigen Auditberichte.',
    bullets: [
      'ISO 9001:2015 (Qualitätsmanagement)',
      'OEKO-TEX Standard 100 (Klasse I — babygeeignet)',
      'GOTS (Global Organic Textile Standard) — auf Anfrage ab 500 kg',
      'RWS (Responsible Wool Standard) — für Mischprodukte',
    ],
    faqs: [
      { q: 'Sind Ihre Zertifizierungen zum Download verfügbar?', a: 'Ja — besuchen Sie unser Download-Center für aktuelle PDF-Zertifikate. Auditberichte teilen wir auf Anfrage unter NDA mit ernsthaften Käufern.' },
      { q: 'Testen Sie auf Schadstoffe?', a: 'Ja — OEKO-TEX Standard 100 testet auf Formaldehyd, Schwermetalle, Pestizide und 300+ Schadstoffe. Tests jährlich bei Hohenstein und SGS.' },
      { q: 'Können Sie GOTS-Zertifizierung für Bio-Kaschmir anbieten?', a: 'Ja — für Bestellungen ab 500 kg aus zertifizierten Bio-Farmen. Vorlaufzeit +30 Tage für Zertifizierungsprozess.' },
      { q: 'Wie sieht es mit REACH-Konformität für EU-Käufer aus?', a: 'Alle unsere Farbstoffe und Hilfsmittel sind REACH-konform. SDS auf Anfrage.' },
    ],
  },
  fr: {
    title: 'Fournisseur cachemire certifié ISO 9001 & OEKO-TEX | DONGXIAO®',
    description: 'Usine cachemire certifiée OEKO-TEX Standard 100, ISO 9001:2015, GOTS (sur demande), RWS. Rapports d\'audit disponibles pour acheteurs B2B. Téléchargez les certificats.',
    h1: 'Fabricant cachemire certifié',
    intro: 'Chaque expédition est accompagnée de documents complets. Nous détenons les certifications exigées par les acheteurs B2B du monde entier — et les rapports d\'audit pour les étayer.',
    bullets: [
      'ISO 9001:2015 (Management de la qualité)',
      'OEKO-TEX Standard 100 (Classe I — adapté aux bébés)',
      'GOTS (Global Organic Textile Standard) — sur demande à partir de 500 kg',
      'RWS (Responsible Wool Standard) — pour produits mélangés',
    ],
    faqs: [
      { q: 'Vos certifications sont-elles téléchargeables ?', a: 'Oui — consultez notre Centre de téléchargement pour les certificats PDF à jour. Nous partageons également les rapports d\'audit sous NDA pour les acheteurs sérieux.' },
      { q: 'Testez-vous les substances nocives ?', a: 'Oui — OEKO-TEX Standard 100 teste formaldéhyde, métaux lourds, pesticides et 300+ substances nocives. Tests annuels chez Hohenstein et SGS.' },
      { q: 'Pouvez-vous fournir la certification GOTS pour cachemire bio ?', a: 'Oui — pour les commandes de 500 kg+ provenant de fermes bio certifiées. Délai +30 jours pour le processus de certification.' },
      { q: 'Qu\'en est-il de la conformité REACH pour les acheteurs UE ?', a: 'Tous nos colorants et auxiliaires sont conformes REACH. FDS disponibles sur demande.' },
    ],
  },
  ja: {
    title: 'ISO 9001 & OEKO-TEX 認証カシミア サプライヤー | DONGXIAO®',
    description: 'OEKO-TEX Standard 100、ISO 9001:2015、GOTS（ご要望対応）、RWS 認証カシミア工場。監査レポート B2B バイヤー向け提供可能。証明書ダウンロード可。',
    h1: '認証取得カシミア製造元',
    intro: '全 shipments に完整書類を同梱。世界の B2B バイヤーが求める認証をすべて取得 — 監査レポートも完備。',
    bullets: [
      'ISO 9001:2015（品質マネジメント）',
      'OEKO-TEX Standard 100（クラス I — 乳幼児対応）',
      'GOTS（グローバルオーガニック繊維基準）— 500kg〜 要望対応',
      'RWS（責任ある羊毛基準）— 混紡製品向け',
    ],
    faqs: [
      { q: '認証はダウンロードできますか？', a: 'はい — ダウンロードセンターで最新の PDF 認証書を公開。監査レポートは真摯なバイヤーに NDA 締結の上で共有可能。' },
      { q: '有害物質の検査はしていますか？', a: 'はい — OEKO-TEX Standard 100 はホルムアルデヒド・重金属・農薬・300+ 種の有害物質を検査。Hohenstein と SGS で年 1 回実施。' },
      { q: 'オーガニックカシミア向け GOTS 認証は取得できますか？', a: 'はい — 認証オーガニックファーム産 500kg 以上のご注文で対応。認証プロセスに +30 日。' },
      { q: 'EU バイヤー向け REACH 対応は？', a: '染料・助剤すべて REACH 準拠。SDS はご要望対応。' },
    ],
  },
  kr: {
    title: 'ISO 9001 & OEKO-TEX 인증 캐시미어 공급사 | DONGXIAO®',
    description: 'OEKO-TEX Standard 100, ISO 9001:2015, GOTS (문의 요망), RWS 인증 캐시미어 공장. B2B 바이어 대상 감사 보고서 제공. 인증서 다운로드 가능.',
    h1: '인증 취득 캐시미어 제조사',
    intro: '모든 출하에 완비 서류 동봉. 글로벌 B2B 바이어가 요구하는 인증과 이를 뒷받침하는 감사 보고서를 모두 보유.',
    bullets: [
      'ISO 9001:2015 (품질경영)',
      'OEKO-TEX Standard 100 (Class I — 유아 적합)',
      'GOTS (글로벌 유기 섬유 기준) — 500kg+ 문의 요망',
      'RWS (책임 있는 울 표준) — 혼방 제품용',
    ],
    faqs: [
      { q: '인증서 다운로드 가능한가요?', a: '예 — 다운로드 센터에서 최신 PDF 인증서 제공. 진지한 바이어에게는 NDA 체결 후 감사 보고서 공유 가능.' },
      { q: '유해 물질을 테스트하나요?', a: '예 — OEKO-TEX Standard 100는 포름알데히드, 중금속, 농약, 300+ 종 유해 물질을 테스트. Hohenstein 및 SGS에서 매년 실시.' },
      { q: '유기농 캐시미어 GOTS 인증이 가능한가요?', a: '예 — 인증 유기농 목장에서 조달한 500kg+ 주문 시 가능. 인증 프로세스에 +30일 소요.' },
      { q: 'EU 바이어의 REACH 준수 사항은?', a: '모든 염료와 보조제는 REACH 준수. SDS는 문의 시 제공.' },
    ],
  },
};

const t = tdk[locale] || tdk.en;
const faqs = t.faqs || tdk.en.faqs;

const certList = [
  { code: 'ISO 9001', name: 'ISO 9001:2015', scope: 'Quality Management System', year: 'Since 2018', icon: '🏆' },
  { code: 'OEKO-TEX', name: 'OEKO-TEX Standard 100 (Class I)', scope: 'Tested for harmful substances — safe for babies & toddlers', year: 'Since 2020', icon: '🛡️' },
  { code: 'GOTS', name: 'GOTS (on request)', scope: 'Global Organic Textile Standard — for organic cashmere', year: 'On request', icon: '🌱' },
  { code: 'RWS', name: 'RWS (Responsible Wool Standard)', scope: 'Animal welfare + land management for blended products', year: 'Since 2022', icon: '🐑' },
  { code: 'BSCI', name: 'BSCI (Business Social Compliance)', scope: 'Social compliance + worker welfare audit', year: 'Since 2019', icon: '🤝' },
  { code: 'Sedex', name: 'Sedex SMETA 4-Pillar', scope: 'Ethical Trade audit (Labor, Health, Safety, Environment)', year: 'Since 2020', icon: '📋' },
];

const certSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DONGXIAO® Cashmere',
  award: certList.map((c) => ({
    '@type': 'CreativeWork',
    name: c.code,
    description: c.scope,
  })),
  hasCredential: certList.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: c.code,
    recognizedBy: { '@type': 'Organization', name: c.code },
  })),
};
---

<BaseLayout
  locale={locale}
  pageKey="factory"
  path={'/' + locale + '/certifications'}
  title={t.title}
  description={t.description}
  keywords={['ISO OEKO-TEX cashmere supplier', 'OEKO-TEX certified cashmere clothing supplier', 'ISO 9001 cashmere', 'GOTS certified cashmere', 'RWS cashmere supplier']}
  schema="factory"
  customSchemas={[certSchema]}
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/certifications'} />

  <section class="bg-[#F5F0E7] border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Certifications & Compliance</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{t.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{t.intro}</p>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="container-narrow">
      <h2 class="font-display text-3xl font-light mb-8 text-center">Active Certifications</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {certList.map((c) => (
          <div class="border border-border rounded-lg p-6 bg-card">
            <div class="text-3xl mb-3">{c.icon}</div>
            <h3 class="font-medium text-lg mb-1">{c.name}</h3>
            <p class="text-xs text-brand-gold uppercase tracking-wider mb-3">{c.code} · {c.year}</p>
            <p class="text-sm text-foreground/80">{c.scope}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SEOFaq faqs={faqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-secondary/20">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">Download certificates & audit reports</h2>
      <p class="opacity-80 mb-8 max-w-2xl mx-auto">All current PDF certificates are available in our Download Center. For audit reports and additional documentation, contact us under NDA.</p>
      <a href={'/' + locale + '/download'} class="inline-block px-8 py-3 bg-primary text-primary-foreground rounded-none font-medium hover:bg-primary/90">Visit Download Center</a>
    </div>
  </section>

  {locale === 'en' && (
  <section class="py-12 md:py-16 bg-secondary/20">
    <div class="container-narrow">
      <h2 class="font-display text-3xl md:text-4xl font-light mb-4">How to Read a Cashmere Certification: 5 Standards Explained</h2>
      <p class="text-base text-muted-foreground mb-8 max-w-3xl">
        The cashmere industry uses at least 5 different certification systems, and most "eco-friendly" or "ethical" claims rely on just one of them. Here's what each certification actually covers — and what it doesn't — so you can make an informed supplier decision.
      </p>

      <div class="space-y-6">
        <div class="border border-border rounded-lg p-6 bg-card">
          <h3 class="font-serif text-2xl mb-3">1. OEKO-TEX Standard 100 — What it Tests</h3>
          <p class="text-muted-foreground leading-relaxed mb-3">Tests the <strong>final textile product</strong> for harmful substances (formaldehyde, heavy metals, pesticides, azo dyes). Covers 350+ substances. Validates against human-ecological safety.</p>
          <p class="text-muted-foreground leading-relaxed mb-2"><strong>What it does NOT cover:</strong> Working conditions, environmental impact, animal welfare.</p>
          <p class="text-muted-foreground leading-relaxed"><strong>How to verify:</strong> Look up the certificate number on <a href="https://www.oeko-tex.com/" class="text-primary hover:underline" target="_blank" rel="noopener">oeko-tex.com</a>. Expired certificates are worthless.</p>
        </div>

        <div class="border border-border rounded-lg p-6 bg-card">
          <h3 class="font-serif text-2xl mb-3">2. BSCI (amfori BSCI) — Social Compliance</h3>
          <p class="text-muted-foreground leading-relaxed mb-3">Audits the <strong>factory's working conditions</strong> against 11 performance areas: forced labor, child labor, working hours, wages, health & safety. Audit grade: A (best) to E (worst). Most European buyers require BSCI grade C or above.</p>
          <p class="text-muted-foreground leading-relaxed mb-2"><strong>What it does NOT cover:</strong> Product quality, environmental impact, animal welfare.</p>
          <p class="text-muted-foreground leading-relaxed"><strong>How to verify:</strong> Request the most recent audit report (PDF) — it includes specific findings, not just a pass/fail.</p>
        </div>

        <div class="border border-border rounded-lg p-6 bg-card">
          <h3 class="font-serif text-2xl mb-3">3. ISO 9001 — Quality Management System</h3>
          <p class="text-muted-foreground leading-relaxed mb-3">Certifies the factory has a documented <strong>quality management process</strong>: incoming material inspection, in-process control, final inspection, corrective action procedures.</p>
          <p class="text-muted-foreground leading-relaxed mb-2"><strong>What it does NOT cover:</strong> Specific product quality, sustainability, social compliance.</p>
          <p class="text-muted-foreground leading-relaxed"><strong>How to verify:</strong> ISO 9001:2015 is the current version. The certificate must list a specific factory address (not just a parent company).</p>
        </div>

        <div class="border border-border rounded-lg p-6 bg-card">
          <h3 class="font-serif text-2xl mb-3">4. GOTS — Global Organic Textile Standard</h3>
          <p class="text-muted-foreground leading-relaxed mb-3">Certifies the <strong>entire supply chain</strong> from raw fiber to finished product: organic fiber content (≥70% for "made with organic", ≥95% for "organic"), environmental processing, social criteria.</p>
          <p class="text-muted-foreground leading-relaxed mb-2"><strong>What it does NOT cover:</strong> Animal welfare (no cashmere-specific standards yet), full traceability of fiber origin.</p>
          <p class="text-muted-foreground leading-relaxed"><strong>How to verify:</strong> GOTS is the only standard that covers the whole chain. Annual audits. Expensive certification (~USD 5,000+ for a small facility).</p>
        </div>

        <div class="border border-border rounded-lg p-6 bg-card">
          <h3 class="font-serif text-2xl mb-3">5. SFA (Sustainable Fibre Alliance) — Cashmere-Specific</h3>
          <p class="text-muted-foreground leading-relaxed mb-3">The <strong>only certification</strong> specific to cashmere and mohair. Covers: goat welfare, grassland management, social compliance, traceability from herder to finished product. Membership-based.</p>
          <p class="text-muted-foreground leading-relaxed mb-2"><strong>Coverage:</strong> Currently focused on Mongolia, China (Inner Mongolia/Alashan), Scotland. Herder cooperatives + processors must both be certified.</p>
          <p class="text-muted-foreground leading-relaxed"><strong>How to verify:</strong> SFA membership list is public at <a href="https://sustainablefibre.org/" class="text-primary hover:underline" target="_blank" rel="noopener">sustainablefibre.org</a>. SFA-certified products carry a transaction certificate number.</p>
        </div>
      </div>

      <div class="mt-10 p-6 border-l-4 border-brand-gold bg-brand-gold/5 rounded-r">
        <h3 class="font-serif text-xl mb-3">3 Things to Ask Every Cashmere Supplier About Certifications</h3>
        <ol class="list-decimal pl-5 space-y-2 text-muted-foreground">
          <li><strong>"Can you send the actual PDF certificate, not a photo?"</strong> Photos can be from a different factory, year, or scope. PDFs include the certificate number you can verify.</li>
          <li><strong>"Does the certificate cover the specific product I'll be buying, or just the parent company?"</strong> Some certificates cover the legal entity, not the actual production line.</li>
          <li><strong>"What was the date of your most recent audit, and what were the findings?"</strong> A 5-year-old audit tells you little. A current audit with specific findings (even minor) is more credible than an expired "pass".</li>
        </ol>
      </div>

      <div class="mt-10 text-center">
        <a href="/en/contact/" class="inline-block px-8 py-3 bg-primary text-primary-foreground rounded-none font-medium hover:bg-primary/90 transition-colors">Request Our Certification Documents →</a>
      </div>
    </div>
  </section>
  )}

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>