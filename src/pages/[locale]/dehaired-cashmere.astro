/** The closing call to action, per locale. */
const ctaHeading = {
  en: 'Prepare a raw-material specification request',
  cn: '准备原料规格沟通',
  de: 'Bereiten Sie eine Rohstoff-Spezifikationsanfrage vor',
  fr: 'Préparez une demande de spécification de matière première',
  ja: '原料の仕様相談を準備する',
  kr: '원자재 사양 상담을 준비하세요',
}[locale];

const ctaBody = {
  en: 'Share target specification, quantity, destination, inspection approach and document needs. Applicable project conditions are confirmed in writing.',
  cn: '请提供目标规格、数量、目的地、验货方式和资料需求；适用项目条件将书面确认。',
  de: 'Teilen Sie Ziel-Spezifikation, Menge, Zielort, Prüfansatz und Dokumentenanforderungen mit. Anwendbare Projektbedingungen werden schriftlich bestätigt.',
  fr: 'Communiquez la spécification cible, la quantité, la destination, l’approche de contrôle et les besoins documentaires. Les conditions du projet applicables sont confirmées par écrit.',
  ja: '目標仕様、数量、目的地、検品方法、書類要件をお知らせください。適用されるプロジェクト条件は書面で確認されます。',
  kr: '목표 사양, 수량, 목적지, 검수 방식, 서류 요건을 알려주십시오. 적용되는 프로젝트 조건은 서면으로 확인됩니다.',
}[locale];

const productCounts = {
  raw: productsData.categories.find((c) => c.id === 'raw'),
};

---

<BaseLayout
  locale={locale}
  pageKey="raw-material"
  path={'/' + locale + '/dehaired-cashmere'}
  title={dehairedCopy.title}
  description={dehairedCopy.description}
  keywords={['dehaired cashmere', 'cashmere fibre specification', 'cashmere raw material sourcing']}
  schema="general"
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/dehaired-cashmere'} />

  <section class="bg-brand-sandwarm border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Dehaired Cashmere Tops</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{dehairedCopy.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{dehairedCopy.intro}</p>
      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-2 max-w-3xl">
        {dehairedCopy.bullets.map((b) => (
          <li class="flex items-start gap-2 text-sm opacity-90">
            <span class="text-brand-camel mt-1">•</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {false && <section class="py-16 bg-background">
    <div class="container-narrow max-w-4xl">
      <h2 class="font-display text-3xl font-light mb-6">Dehairing Process</h2>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        Our dehairing line uses Italian-imported equipment that mechanically separates the fine underdown (cashmere) from the coarse guard hair. The process is purely mechanical — no chemicals, no dye, no water waste. Output is then hand-sorted by trained workers to ensure uniform fiber length and micron consistency.
      </p>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        <strong>Yield:</strong> 1 ton of raw (greasy) cashmere produces approximately 350kg of dehaired cashmere, depending on grade. White cashmere has the highest yield (40-45%), brown 30-35%, purple 25-30%.
      </p>
      <p class="text-base leading-relaxed text-foreground/80">
        <strong>Quality control:</strong> Every batch is tested for fiber diameter (laser scan), length (comb sorter), and purity (visual + microscope). A certificate of analysis ships with every order.
      </p>
    </div>
  </section>}

  <SEOFaq faqs={projectFaqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-brand-sandwarm border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">{ctaHeading[locale]}</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">{ctaBody[locale]}</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={'/' + locale + '/contact'} class="inline-block px-8 py-3 bg-brand-ink text-brand-cream rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">{dehairedCopy.cta}</a>
        <a href={'/' + locale + '/products'} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-brand-cream">View All Products</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>
