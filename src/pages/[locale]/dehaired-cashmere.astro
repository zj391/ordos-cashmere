---
/**
 * Dehaired Cashmere Tops - dedicated SEO hub (7-8)
 * Target: dehaired cashmere tops / cashmere combed top wholesale / Ordos dehaired cashmere
 * Route: /[locale]/dehaired-cashmere × 6 locales = 6 URLs
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';
import { products as productsData } from '@/data/products';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

const tdk = {
  en: {
    title: 'Dehaired Cashmere Tops Wholesale | Combed Cashmere from Ordos | DONGXIAO',
    description: 'Dehaired cashmere tops (combed) direct from Ordos. 14.5-15.5μm superfine. White, brown, purple. Bulk supply for global spinners. MOQ 100kg.',
    h1: 'Dehaired Cashmere Tops from Ordos',
    intro: 'Combed, sorted, and ready for spinning. Our dehaired cashmere is produced in a 38,000 sqm facility in Ordos, Inner Mongolia — the world\'s premium cashmere origin.',
    bullets: [
      'Italian-imported dehairing lines',
      'Cashmere purity ≥99.95%',
      'No dye, no chemical treatment',
      'Hand-sorted for fiber length + micron uniformity',
    ],
    faqs: [
      { q: 'What is the MOQ for dehaired cashmere tops?', a: 'MOQ is 100kg per grade/color. Mixed grades available within the same color.' },
      { q: 'What micron ranges do you offer?', a: 'White: 14.5-15.5μm. Brown: 15.5-16.5μm. Purple: 15.5-16.5μm. Custom micron sorting on request.' },
      { q: 'Do you offer eco-friendly scoured cashmere?', a: 'Yes — our standard scoured cashmere uses plant-based detergents. GOTS organic certification available on request for orders 500kg+.' },
      { q: 'What is the lead time?', a: 'In-stock grades ship in 7-10 days. Custom micron sorting: 20-25 days.' },
    ],
  },
  cn: {
    title: '羊绒分梳套毛批发 | 鄂尔多斯分梳羊绒 | DONGXIAO®',
    description: '鄂尔多斯源头分梳套毛，直供全球纺纱厂。14.5-15.5μm 超细，白/青/紫多色可选。MOQ 100kg。',
    h1: '鄂尔多斯源头分梳套毛',
    intro: '分梳+手拣+可直接纺纱。38,000 平米鄂尔多斯工厂，世界顶级羊绒产区。',
    bullets: ['意大利进口分梳设备', '羊绒纯度 ≥99.95%', '无染色无化学处理', '按细度+长度手拣分级'],
    faqs: [
      { q: '羊绒分梳套毛起订量？', a: '每色 100kg。同色可混级。' },
      { q: '细度范围？', a: '白绒 14.5-15.5μm，青绒 15.5-16.5μm，紫绒 15.5-16.5μm。可按需定制。' },
    ],
  },
  // 8-20: de/fr/ja/kr 翻译补齐（之前只 en/cn，其它 locale 全部 fallback 到英文）
  de: {
    title: 'Entgranntes Kaschmir im Großhandel | Gekämmtes Kaschmir aus Ordos | DONGXIAO®',
    description: 'Entgrannte Kaschmiranteile (gekämmt) direkt aus Ordos. 14,5–15,5 μm superfein. Weiß, Braun, Lila. Großmengen für globale Spinnereien. MOQ 100 kg.',
    h1: 'Entgrannte Kaschmiranteile aus Ordos',
    intro: 'Gekämmt, sortiert und sofort verspinnbar. Unser entgranntes Kaschmir wird in einer 38.000 m² großen Anlage in Ordos, Innere Mongolei – dem weltweit führenden Kaschmir-Ursprung – hergestellt.',
    bullets: [
      'Importierte Entgrannungslinien aus Italien',
      'Kaschmirreinheit ≥99,95 %',
      'Keine Färbung, keine chemische Behandlung',
      'Handsortierung nach Faserlänge und Micron-Gleichmäßigkeit',
    ],
    faqs: [
      { q: 'Wie hoch ist die Mindestbestellmenge für entgrannte Kaschmiranteile?', a: 'Die MOQ beträgt 100 kg pro Sorte/Farbe. Sortenmischungen innerhalb derselben Farbe möglich.' },
      { q: 'Welche Micron-Bereiche bieten Sie an?', a: 'Weiß: 14,5–15,5 μm. Braun: 15,5–16,5 μm. Lila: 15,5–16,5 μm. Kundenspezifische Micron-Sortierung auf Anfrage.' },
      { q: 'Bieten Sie umweltfreundliches gewaschenes Kaschmir an?', a: 'Ja – unser Standard-Waschkaschmir verwendet pflanzliche Waschmittel. GOTS-Bio-Zertifizierung auf Anfrage für Bestellungen ab 500 kg.' },
      { q: 'Wie ist die Lieferzeit?', a: 'Lagerbestände werden in 7–10 Tagen versendet. Kundenspezifische Micron-Sortierung: 20–25 Tage.' },
    ],
  },
  fr: {
    title: 'Cachemire dégrillé en gros | Cachemire peigné d\'Ordos | DONGXIAO®',
    description: 'Cachemire dégrillé (peigné) directement d\'Ordos. 14,5–15,5 μm superfin. Blanc, brun, violet. Approvisionnement en vrac pour filateurs mondiaux. MOQ 100 kg.',
    h1: 'Cachemire dégrillé d\'Ordos',
    intro: 'Peigné, trié et prêt à filer. Notre cachemire dégrillé est produit dans une installation de 38 000 m² à Ordos, Mongolie-Intérieure — la première région mondiale de cachemire.',
    bullets: [
      'Lignes de dégrillage importées d\'Italie',
      'Pureté du cachemire ≥99,95 %',
      'Sans teinture, sans traitement chimique',
      'Tri manuel selon la longueur et l\'uniformité du micron',
    ],
    faqs: [
      { q: 'Quel est le MOQ pour le cachemire dégrillé ?', a: 'Le MOQ est de 100 kg par qualité/couleur. Qualités mélangées disponibles dans la même couleur.' },
      { q: 'Quelles plages de microns proposez-vous ?', a: 'Blanc : 14,5–15,5 μm. Brun : 15,5–16,5 μm. Violet : 15,5–16,5 μm. Tri personnalisé sur demande.' },
      { q: 'Proposez-vous du cachemire décreusé écologique ?', a: 'Oui — notre cachemire standard utilise des détergents végétaux. Certification GOTS sur demande pour les commandes de 500 kg et plus.' },
      { q: 'Quel est le délai de livraison ?', a: 'Stocks expédiés en 7–10 jours. Tri personnalisé : 20–25 jours.' },
    ],
  },
  ja: {
    title: 'カシミア分梳（デヘア）卸売 | オルドス産コームドカシミア | DONGXIAO®',
    description: 'オルドス直送の分梳カシミア（コーム済み）。14.5–15.5μm 超細。ホワイト・ブラウン・パープル。世界中の紡績工場へ大量供給。MOQ 100kg。',
    h1: 'オルドス産カシミア分梳トップ',
    intro: 'コーミング・選別済みで即紡績可能。当社の分梳カシミアは内モンゴル・オルドスの38,000㎡工場で生産 — 世界最高級カシミア産地。',
    bullets: [
      'イタリア製デヘアリングライン',
      'カシミア純度 ≥99.95%',
      '染色なし、化学処理なし',
      '繊維長＋ミクロン均一性の手作業選別',
    ],
    faqs: [
      { q: 'カシミア分梳トップの最小発注量は？', a: '1グレード/色あたり 100kg。同色内でのグレード混合可。' },
      { q: 'ミクロン範囲は？', a: 'ホワイト：14.5–15.5μm。ブラウン：15.5–16.5μm。パープル：15.5–16.5μm。要望によりカスタム選別可。' },
      { q: 'エコ洗滌カシミアはありますか？', a: 'はい — 標準洗滌カシミアは植物性洗剤を使用。500kg 以上のご注文で GOTS オーガニック認証取得可能（要相談）。' },
      { q: 'リードタイムは？', a: '在庫品は 7–10 日で出荷。カスタム選別は 20–25 日。' },
    ],
  },
  kr: {
    title: '캐시미어 분梳理수 도매 | 오르도스 코임드 캐시미어 | DONGXIAO®',
    description: '오르도스 직송 분梳理수 (코임 완료). 14.5–15.5μm 슈퍼파인. 화이트/브라운/퍼플. 글로벌 방적사 대상 대량 공급. MOQ 100kg.',
    h1: '오르도스 캐시미어 분梳 탑',
    intro: '코임·핸드픽 완료, 즉시 방적 가능. 본사 분梳理수는 내몽골 오르도스 38,000㎡ 공장에서 생산 — 세계 최고 캐시미어 산지.',
    bullets: [
      '이탈리아 수입 분梳 라인',
      '캐시미어 순도 ≥99.95%',
      '무염색, 무화학 처리',
      '섬유장 + 마이크론 균일성 수작업 선별',
    ],
    faqs: [
      { q: '분梳理수 최소 주문 수량은?', a: '등급/색상당 100kg. 동일 색상 내 혼합 등급 가능.' },
      { q: '마이크론 범위는?', a: '화이트: 14.5–15.5μm. 브라운: 15.5–16.5μm. 퍼플: 15.5–16.5μm. 맞춤 선별 가능 (문의 요망).' },
      { q: '친환경 세정 캐시미어도 있나요?', a: '예 — 표준 세정 캐시미어는 식물성 세정제 사용. 500kg 이상 주문 시 GOTS 유기농 인증 가능 (문의 요망).' },
      { q: '리드타임은?', a: '재고 품목은 7–10일 출하. 맞춤 선별은 20–25일.' },
    ],
  },
};

const t = tdk[locale] || tdk.en;

const dehairedFaqs = t.faqs || tdk.en.faqs;

const dehairedCopy = locale === 'cn'
  ? { title: '分梳羊绒规格沟通 | DONGXIAO®', description: '提交目标规格、数量、目的地、验货方式和资料需求，以开展书面原料采购沟通。', h1: '分梳羊绒规格沟通', intro: '原料规格、可用性、资料和项目条件会因批次与目的地而异。请书面提供需求，以确认适用范围。', bullets: ['产品与规格参考', '目标数量与目的地', '验货与文件需求', '项目条件书面确认'], cta: '联系采购团队' }
  : { title: 'Dehaired Cashmere Specification Requests | DONGXIAO®', description: 'Prepare target specification, quantity, destination, inspection approach and document requirements for a written raw-material sourcing discussion.', h1: 'Dehaired Cashmere Specification Requests', intro: 'Raw-material specifications, availability, documentation and project terms can vary by batch and destination. Share your requirements in writing so the applicable scope can be confirmed.', bullets: ['Product and specification reference', 'Target quantity and destination', 'Inspection and document requirements', 'Project terms confirmed in writing'], cta: 'Contact our sourcing team' };

const projectFaqs = [
  { q: locale === 'cn' ? '原料询盘应包含哪些信息？' : 'What should a raw-material inquiry include?', a: locale === 'cn' ? '请提供目标规格、数量、目的地、验货方式和资料范围；适用项目条件将书面确认。' : 'Provide the target specification, quantity, destination, inspection approach and document scope. Applicable project conditions are confirmed in writing.' },
  { q: locale === 'cn' ? '价格、可用性和交付何时确认？' : 'When are price, availability and delivery confirmed?', a: locale === 'cn' ? '价格、可用性、检验、交付与资料条款将根据具体项目在书面沟通、报价或协议中确认。' : 'Price, availability, inspection, delivery and documentation terms are confirmed for the selected project in written correspondence, quotation or agreement.' },
];

const productCounts = {
  raw: productsData.categories.find((c) => c.id === 'raw'),
};

---

<BaseLayout
  locale={locale}
  pageKey="raw-material"
  path={'/' + locale + '/dehaired-cashmere'}
  title={dehairedCopy.title}
  description={dehairedCopy.description}
  keywords={['dehaired cashmere', 'cashmere fibre specification', 'cashmere raw material sourcing']}
  schema="general"
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/dehaired-cashmere'} />

  <section class="bg-brand-sandwarm border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Dehaired Cashmere Tops</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{dehairedCopy.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{dehairedCopy.intro}</p>
      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-2 max-w-3xl">
        {dehairedCopy.bullets.map((b) => (
          <li class="flex items-start gap-2 text-sm opacity-90">
            <span class="text-brand-camel mt-1">•</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {false && <section class="py-16 bg-background">
    <div class="container-narrow max-w-4xl">
      <h2 class="font-display text-3xl font-light mb-6">Dehairing Process</h2>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        Our dehairing line uses Italian-imported equipment that mechanically separates the fine underdown (cashmere) from the coarse guard hair. The process is purely mechanical — no chemicals, no dye, no water waste. Output is then hand-sorted by trained workers to ensure uniform fiber length and micron consistency.
      </p>
      <p class="text-base leading-relaxed text-foreground/80 mb-4">
        <strong>Yield:</strong> 1 ton of raw (greasy) cashmere produces approximately 350kg of dehaired cashmere, depending on grade. White cashmere has the highest yield (40-45%), brown 30-35%, purple 25-30%.
      </p>
      <p class="text-base leading-relaxed text-foreground/80">
        <strong>Quality control:</strong> Every batch is tested for fiber diameter (laser scan), length (comb sorter), and purity (visual + microscope). A certificate of analysis ships with every order.
      </p>
    </div>
  </section>}

  <SEOFaq faqs={projectFaqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-brand-sandwarm border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">{locale === 'cn' ? '准备原料规格沟通' : 'Prepare a raw-material specification request'}</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">{locale === 'cn' ? '请提供目标规格、数量、目的地、验货方式和资料需求；适用项目条件将书面确认。' : 'Share target specification, quantity, destination, inspection approach and document needs. Applicable project conditions are confirmed in writing.'}</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={'/' + locale + '/contact'} class="inline-block px-8 py-3 bg-brand-ink text-brand-cream rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">{dehairedCopy.cta}</a>
        <a href={'/' + locale + '/products'} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-brand-cream">View All Products</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>
