 * German or Japanese title - the page looked translated and the
 * FAQ schema it emits was English on a non-English page.
 */
const projectFaqs = {
  en: [
    { q: 'What should a raw-material inquiry include?', a: 'Provide the target specification, quantity, destination, inspection approach and document scope. Applicable project conditions are confirmed in writing.' },
