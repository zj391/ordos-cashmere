    <!-- 轮播图: 3 张明亮图自动循环 (CSS transition + 底部圆点 + JS) -->
    <div class="absolute inset-0" data-hero-slider>
      {[
        { src: IMG.scarvesFolded, alt: 'Cashmere wrap — premium B2B apparel piece styled in urban setting' },
        { src: IMG.heroCraft,    alt: 'Handwoven cashmere detail — craftsmanship' },
        { src: IMG.heroLandscape, alt: 'Inner Mongolian highland landscape — Ordos origin' },
        { src: IMG.uiHero, alt: 'Premium cashmere coat on Ordos highland — material-led B2B collection inspiration' },
      ].map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          class={`ken-burns absolute inset-0 w-full h-full object-cover transition-opacity duration-[1500ms] ease-in-out ${
            i === 0 ? 'opacity-100 visible' : 'opacity-0 invisible'
          }`}
          decoding="async" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'}
          data-hero-slide={i}
        />
      ))}
      <!-- 左侧暗化叠层: 保证文字可读, 右侧保持明亮 (gradient from-left) -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-ink/60 via-brand-ink/25 to-transparent"></div>
    </div>
    <!-- 羊绒纤维纹理 (装饰) -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.05] pointer-events-none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <defs>
        <pattern id="fibers" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M0 30 Q15 22, 30 30 T60 30" stroke="white" stroke-width="0.5" fill="none"/>
          <path d="M0 38 Q15 30, 30 38 T60 38" stroke="white" stroke-width="0.5" fill="none"/>
          <path d="M0 22 Q15 14, 30 22 T60 22" stroke="white" stroke-width="0.5" fill="none"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#fibers)"/>
    </svg>
    <div class="home-hero-trajectory" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="relative container-narrow min-h-[88vh] flex items-center py-24">
      <div class="max-w-3xl">
        <div class="eyebrow eyebrow-on-dark mb-10">
          <span>{c.tagline}</span>
        </div>
        <h1 class="font-serif text-6xl md:text-8xl font-light leading-[1.05] tracking-[-0.02em] mb-10" set:html={c.title.replace(/\n/g, '<br/>')} />
        <p class="text-lg md:text-xl text-white/80 mb-14 leading-relaxed max-w-2xl font-light">
          {c.subtitle}
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <a href={`/${locale}/contact/`} class="home-thread-cta group inline-flex items-center gap-3 px-10 py-5 bg-white text-brand-ink text-sm font-medium uppercase tracking-[0.22em] hover:bg-brand-gold hover:text-white transition-colors duration-300">
