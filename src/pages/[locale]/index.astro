---
/**
 * 雪线静奢首页：以编辑式留白、非对称图文与戈壁赭金纤维轨迹呈现羊绒产地和制造节奏。
 * 此页面保留 BaseLayout 的多语言、SEO、结构化数据与询盘组件，仅替换首页表现层。
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) return Astro.redirect('/en/', 308);
const locale = pickLocale(rawLocale);
const isCn = locale === 'cn';

const copy = isCn ? {
  tagline: '源头工厂 · 鄂尔多斯 · 始于 2002',
  title: '让一季高原风，<br/><em>靠近你的衣橱。</em>',
  intro: '从一束可追溯的原绒开始，陪伴品牌确认纱支、手感和生产节奏，再把它织成值得久穿的系列。',
  primary: '开始材质沟通', secondary: '认识鄂尔多斯',
  nav: ['产地溯源', '产品体系', '制造工艺'],
  originKicker: '01 / ORIGIN', originTitle: '柔软，从来<br/>不是偶然。',
  originLead: '在北纬 39°、海拔 1,300 米的鄂尔多斯，干燥的高原风与漫长寒冬，孕育出纤维细长、自然丰盈的白绒山羊。',
  originBody: '我们将对产地的理解，延续到每一根纱线的选择、每一次织造的密度，和每一件产品的最后检查。好的羊绒，不止要在当下柔软，也应在时间里保持从容。',
  originLink: '探索原料与工艺',
  collectionKicker: '02 / COLLECTIONS', collectionTitle: '从纤维到<br/><em>完整系列。</em>',
  collectionIntro: '像整理一册可触摸的材质档案：记录纱支、针距、色样与交付节奏，让每一件产品承载风格，也适合被长期制造。',
  craftKicker: '03 / CRAFT', craftTitle: '把每一根纤维<br/><em>做成可感知的品质。</em>', craftBody: '从分梳、染整到针织成型，制造不是隐藏在背后的流程，而是产品价值本身。我们把工艺公差、手感校准与生产节奏，逐一写进每次协作的样衣记录。', craftLink: '打开工艺协作档案',
  materialKicker: '04 / MATERIAL STUDY', materialTitle: '颜色，来自<br/>羊绒本身的呼吸。', materialBody: '奶白、燕麦、驼色与石墨灰，以天然、可延展的中性色支撑品牌的长期系列，也让每种配色有更好的材质表达。',
  valueKicker: '05 / WORKING TOGETHER', valueTitle: '将复杂的制造<br/><em>留在我们这里。</em>',
  finalKicker: 'LET\'S MAKE SOMETHING SOFT', finalTitle: '从一块织片，<br/>开始下一件作品。', finalBody: '分享你的品类、预期手感与市场节奏。我们从材质、纱支和样衣时间开始，把一段新的纤维旅程梳理清楚。', finalAction: '提交材质构想',
  footer: '源头工厂 · 鄂尔多斯 · 中国内蒙古', top: '回到顶部',
} : {
  tagline: 'SOURCE FACTORY · ORDOS · SINCE 2002',
  title: 'A season of highland wind,<br/><em>closer to the wardrobe.</em>',
  intro: 'From a traceable strand of fiber, we help brands define yarn count, handfeel and production rhythm—then knit them into pieces made to be worn for years.',
  primary: 'Begin with material', secondary: 'Discover Ordos',
  nav: ['Origin', 'Collections', 'Craft'],
  originKicker: '01 / ORIGIN', originTitle: 'Softness is never<br/>an accident.',
  originLead: 'At 39° north and 1,300 metres above sea level, Ordos’ dry highland winds and long winters nurture cashmere fibers of uncommon length and fullness.',
  originBody: 'We carry our understanding of origin into every yarn choice, knitting density and final inspection. Good cashmere should feel soft today—and remain composed over time.',
  originLink: 'Explore fiber & craft',
  collectionKicker: '02 / COLLECTIONS', collectionTitle: 'From fiber to<br/><em>the whole collection.</em>',
  collectionIntro: 'Like a tactile material archive: recording yarn count, gauge, color and delivery rhythm so every piece holds a point of view and can be made with consistency.',
  craftKicker: '03 / CRAFT', craftTitle: 'Make every fiber<br/><em>into a felt quality.</em>', craftBody: 'From dehairing and dyeing to knit shaping, making is not hidden behind the product—it is the product’s value. Tolerances, handfeel and production rhythm are written into every sample record.', craftLink: 'Open the craft archive',
  materialKicker: '04 / MATERIAL STUDY', materialTitle: 'Color, from<br/>cashmere’s own breath.', materialBody: 'Milk, oatmeal, camel and graphite: natural, flexible neutrals that support a long-lived collection and give each color a more honest material expression.',
  valueKicker: '05 / WORKING TOGETHER', valueTitle: 'We keep the complex<br/><em>making on our side.</em>',
  finalKicker: 'LET\'S MAKE SOMETHING SOFT', finalTitle: 'From one swatch,<br/>to the next piece.', finalBody: 'Share your category, desired handfeel and market rhythm. We start with material, yarn and sampling time to map a new fiber journey clearly.', finalAction: 'Share a material brief',
  footer: 'Source factory · Ordos · Inner Mongolia, China', top: 'Back to top',
};

const collections = isCn ? [
  { number: '01', code: 'ORD / KNIT / 01', name: '针织成衣档案', copy: '以版型、针距与纱支，将系列构想织成经得起时间的日常。', tags: ['18GG–7GG', '样衣节奏 7 天'], href: `/${locale}/garment-oem/`, tone: 'coat' },
  { number: '02', code: 'ORD / YARN / 02', name: '羊绒纱线标本', copy: '从 26/2 到 36/2，让纤维的细度、回弹和触感各得其所。', tags: ['原纱可追溯', '色卡校准'], href: `/${locale}/yarn-fabric/`, tone: 'yarn' },
  { number: '03', code: 'ORD / SOFT / 03', name: '围巾与配饰', copy: '轻柔、贴近，也适于在多次穿戴后仍保有从容的形态。', tags: ['色样定制', '边缘手感'], href: `/${locale}/products/`, tone: 'scarf' },
] : [
  { number: '01', code: 'ORD / KNIT / 01', name: 'Knitwear archive', copy: 'With shape, gauge and yarn count, we knit an idea into a daily piece that stands the test of time.', tags: ['18GG–7GG', '7-day sample rhythm'], href: `/${locale}/garment-oem/`, tone: 'coat' },
  { number: '02', code: 'ORD / YARN / 02', name: 'Cashmere yarn specimens', copy: 'From 26/2 to 36/2, giving fineness, recovery and handfeel their right place.', tags: ['Traceable yarn', 'Color calibration'], href: `/${locale}/yarn-fabric/`, tone: 'yarn' },
  { number: '03', code: 'ORD / SOFT / 03', name: 'Scarves & accessories', copy: 'Soft, close, and composed enough to retain their form after many seasons of wear.', tags: ['Custom color', 'Edge handfeel'], href: `/${locale}/products/`, tone: 'scarf' },
];

const values = isCn ? [
  ['01', '纤维的来处', '聚焦原料的细度、长度与天然色泽，让每一个批次都有清晰的源头。'],
  ['02', '工艺的尺度', '用样衣、织片和反复校准，将柔软落实为稳定的穿着体验。'],
  ['03', '合作的余地', '为品牌保留定制的空间，也把复杂的制造沟通变得清楚、从容。'],
] : [
  ['01', 'Where fiber begins', 'Focusing on fineness, length and natural color so every lot starts with a clear origin.'],
  ['02', 'The scale of craft', 'With swatches, samples and repeated calibration, softness becomes a dependable wearing experience.'],
  ['03', 'Room to collaborate', 'We keep space for custom decisions while making complex manufacturing communication feel clear and calm.'],
];

const asset = '/images/ui-2026';
---

<BaseLayout locale={locale as Locale} pageKey="home" path="/" schema="home" ogImage={`${asset}/hero-highland.webp`}>
  <link slot="head" rel="preload" as="image" href={`${asset}/hero-highland.webp`} fetchpriority="high" />
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="snowline" id="top">
    <header class="snowline-header">
      <a class="brand" href={`/${locale}/`} aria-label="DONGXIAO Cashmere home">
        <img src={`${asset}/fiber-mark.png`} alt="" width="36" height="36" />
        <span>DONGXIAO <em>Cashmere</em></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#origin">{copy.nav[0]}</a>
        <a href="#collections">{copy.nav[1]}</a>
        <a href="#craft">{copy.nav[2]}</a>
      </nav>
      <a class="nav-action" href={`/${locale}/contact/`}>{copy.primary} <span>↗</span></a>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src={`${asset}/hero-highland.webp`} alt={isCn ? '身着燕麦色羊绒大衣的女性伫立于高原草地' : 'Woman in an oatmeal cashmere coat on the Ordos highland'} width="1920" height="1080" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="fiber hero-fiber" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="hero-copy">
        <p class="kicker inverse">{copy.tagline}</p>
        <h1 id="hero-title" set:html={copy.title}></h1>
        <p class="hero-intro">{copy.intro}</p>
        <div class="hero-actions">
          <a class="thread-button" href={`/${locale}/contact/`}>{copy.primary} <span>→</span></a>
          <a class="text-link light" href="#origin">{copy.secondary} <span>↘</span></a>
        </div>
      </div>
      <div class="hero-note"><b>39°N</b><span>{isCn ? '高原气候 · 细软纤维' : 'Highland climate · fine fiber'}</span></div>
      <div class="scroll-note"><span>SCROLL TO DISCOVER</span><i></i></div>
    </section>

    <section class="proof" aria-label={isCn ? '制造资质' : 'Manufacturing credentials'}>
      <div><strong>23<sup>+</sup></strong><p>{isCn ? '年羊绒制造经验' : 'Years of cashmere making'}</p></div>
      <div><strong>50<sup>+</sup></strong><p>{isCn ? '服务国家与地区' : 'Markets served'}</p></div>
      <div><strong>14.5<small>μm</small></strong><p>{isCn ? '优质山羊绒细度' : 'Fine cashmere fiber'}</p></div>
      <div><strong>ISO</strong><p>9001 / OEKO-TEX</p></div>
    </section>

    <section class="origin section-pad" id="origin" aria-labelledby="origin-title">
      <div class="origin-image image-frame"><img src={`${asset}/knit-editorial.webp`} alt={isCn ? '身着深色羊绒针织衫的女性' : 'Woman wearing graphite cashmere knitwear'} width="1200" height="1500" loading="lazy" /></div>
      <div class="origin-content">
        <p class="kicker">{copy.originKicker}</p>
        <h2 id="origin-title" set:html={copy.originTitle}></h2>
        <p class="lead">{copy.originLead}</p>
        <p class="body-copy">{copy.originBody}</p>
        <a class="text-link" href={`/${locale}/ordos-origin/`}>{copy.originLink} <span>↗</span></a>
      </div>
      <aside class="fineness"><b>14.5</b><span>MICRONS<br/>OF FINENESS</span></aside>
      <div class="fiber origin-fiber" aria-hidden="true"><i></i><i></i></div>
    </section>

    <section class="collections section-pad" id="collections" aria-labelledby="collections-title">
      <div class="section-heading">
        <div><p class="kicker">{copy.collectionKicker}</p><h2 id="collections-title" set:html={copy.collectionTitle}></h2></div>
        <p>{copy.collectionIntro}</p>
      </div>
      <div class="collection-list">
        {collections.map((item) => (
          <a class={`collection-row ${item.tone}`} href={item.href}>
            <b class="collection-number">{item.number}</b>
            <h3>{item.name}</h3>
            <p>{item.copy}</p>
            <span class="collection-meta"><small>{item.code}</small><span>{item.tags.map((tag) => <em>{tag}</em>)}</span></span>
            <b class="collection-arrow">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="craft" id="craft" aria-labelledby="craft-title">
      <div class="craft-image image-frame"><img src={`${asset}/craft-detail.webp`} alt={isCn ? '工匠双手正在处理细软的羊绒纱线' : 'Hands working with fine cashmere yarn'} width="1440" height="1080" loading="lazy" /></div>
      <div class="craft-content section-pad">
        <p class="kicker inverse">{copy.craftKicker}</p>
        <h2 id="craft-title" set:html={copy.craftTitle}></h2>
        <p>{copy.craftBody}</p>
        <a class="text-link light" href={`/${locale}/quality-control/`}>{copy.craftLink} <span>↗</span></a>
        <small class="archive-note">ORD / PROCESS / 03</small>
      </div>
    </section>

    <section class="material section-pad" aria-labelledby="material-title">
      <div class="material-copy"><p class="kicker">{copy.materialKicker}</p><h2 id="material-title" set:html={copy.materialTitle}></h2><p>{copy.materialBody}</p></div>
      <div class="material-image image-frame"><img src={`${asset}/material-stilllife.webp`} alt={isCn ? '叠放在石灰岩台座上的羊绒针织品与纤维' : 'Cashmere knitwear and fiber arranged on limestone'} width="1200" height="1500" loading="lazy" /></div>
      <div class="swatches" aria-label={isCn ? '羊绒色彩样本' : 'Cashmere color samples'}><i></i><i></i><i></i><i></i></div>
    </section>

    <section class="values section-pad" aria-labelledby="values-title">
      <div class="values-title"><p class="kicker">{copy.valueKicker}</p><h2 id="values-title" set:html={copy.valueTitle}></h2></div>
      <div class="values-list">
        {values.map(([number, title, detail]) => <article><b>{number}</b><h3>{title}</h3><p>{detail}</p></article>)}
      </div>
    </section>

    <section class="contact-cta" aria-labelledby="cta-title">
      <div class="cta-content"><p class="kicker inverse">{copy.finalKicker}</p><h2 id="cta-title" set:html={copy.finalTitle}></h2><p>{copy.finalBody}</p><a class="thread-button" href={`/${locale}/contact/`}>{copy.finalAction} <span>→</span></a></div>
      <span class="cta-number" aria-hidden="true">06</span>
    </section>

    <footer class="snowline-footer"><a class="brand" href={`/${locale}/`}><img src={`${asset}/fiber-mark.png`} alt="" width="32" height="32" /><span>DONGXIAO <em>Cashmere</em></span></a><p>{copy.footer}</p><a href="#top">{copy.top} ↗</a></footer>
  </div>

  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>

<style>
  /* 雪线静奢：暖白纸张、石墨褐、克制赭金与不规则纤维轨迹构成首屏及章节节奏。 */
  :global(html) { scroll-behavior: smooth; }
  .snowline { --ink:#2d2824; --paper:#f8f6f0; --mist:#efeae0; --stone:#ded6ca; --thread:#a76432; --gold:#e2b78e; color:var(--ink); background:var(--paper); font-family:"Noto Sans SC", Inter, sans-serif; overflow:clip; }
  .snowline *, .snowline *::before, .snowline *::after { box-sizing:border-box; }
  .snowline a { color:inherit; text-decoration:none; }
  .snowline-header { height:88px; position:absolute; inset:0 0 auto; z-index:20; display:flex; align-items:center; justify-content:space-between; gap:30px; padding:0 clamp(22px,5vw,78px); color:#fffdf8; border-bottom:1px solid rgba(255,255,255,.18); }
  .brand { display:inline-flex; align-items:center; gap:12px; flex-shrink:0; }.brand img { width:36px; height:36px; object-fit:contain; }.brand span { font:600 21px/1 "Cormorant Garamond", serif; letter-spacing:.1em; white-space:nowrap; }.brand em { font-size:16px; font-weight:400; letter-spacing:.02em; }.snowline-header nav { display:flex; gap:clamp(20px,3vw,48px); margin-left:auto; }.snowline-header nav a, .nav-action { font-size:12px; font-weight:500; letter-spacing:.12em; }.snowline-header nav a:hover, .nav-action:hover { color:var(--gold); }.nav-action { display:inline-flex; align-items:center; gap:6px; padding-left:26px; border-left:1px solid rgba(255,255,255,.35); }.nav-action span { font-size:17px; }
  .hero { min-height:min(820px,92vh); display:flex; align-items:center; position:relative; isolation:isolate; color:#fffdf8; }.hero-image,.hero-shade { width:100%;height:100%;position:absolute;inset:0; }.hero-image { z-index:-3; object-fit:cover; object-position:center; animation:slowZoom 16s ease-out both; }.hero-shade { z-index:-2; background:linear-gradient(90deg,rgba(27,24,20,.82),rgba(27,24,20,.55) 32%,rgba(27,24,20,.07) 70%,rgba(27,24,20,.14)); }.hero-copy { width:min(790px,100%); margin:108px 0 100px clamp(22px,9vw,150px); padding-right:22px; }.kicker { display:flex; align-items:center; gap:12px; color:var(--thread); font-size:10px; font-weight:600; letter-spacing:.23em; margin:0 0 25px; }.kicker::before { content:""; display:block; width:36px; height:1px; background:currentColor; }.kicker.inverse { color:var(--gold); }.hero h1,.snowline h2,.snowline h3,.snowline p { margin-top:0; }.hero h1,.snowline h2 { font-family:"Cormorant Garamond","Noto Serif SC",serif; font-weight:400; letter-spacing:-.055em; line-height:.91; }.hero h1 { max-width:800px; margin-bottom:34px; font-size:clamp(52px,7vw,108px); }.hero h1 em,.snowline h2 em { font-style:italic; font-weight:400; }.hero-intro { max-width:535px; color:rgba(255,253,248,.82); font-size:15px; line-height:1.95; letter-spacing:.015em; margin-bottom:38px; }.hero-actions { display:flex; align-items:center; gap:30px; flex-wrap:wrap; }.thread-button { min-width:182px; display:inline-flex; align-items:center; justify-content:center; gap:18px; padding:17px 23px 17px 27px; border:1px solid rgba(226,183,142,.72); border-left:4px solid var(--thread); background:rgba(255,253,248,.04); color:#fffdf8; font-size:12px; font-weight:600; letter-spacing:.15em; transition:background .18s ease-out,border-color .18s ease-out,transform .16s ease-out; }.thread-button:hover { background:rgba(167,100,50,.32); border-color:var(--gold); }.thread-button:active { transform:scale(.97); }.text-link { display:inline-flex; align-items:center; gap:10px; padding-bottom:7px; border-bottom:1px solid currentColor; color:var(--ink); font-size:12px; font-weight:600; letter-spacing:.12em; transition:color .18s ease-out,gap .18s ease-out; }.text-link:hover { gap:15px; color:var(--thread); }.text-link.light { color:#fffdf8; }.text-link.light:hover { color:var(--gold); }.hero-note { position:absolute; right:clamp(22px,5vw,78px); bottom:55px; writing-mode:vertical-rl; display:flex; align-items:flex-end; gap:13px; }.hero-note b { color:var(--gold); font:30px/1 "Cormorant Garamond",serif; }.hero-note span { color:rgba(255,253,248,.85); font-size:10px; line-height:1.8; letter-spacing:.14em; }.scroll-note { position:absolute; left:clamp(22px,5vw,78px); bottom:33px; display:flex; align-items:center; gap:13px; color:rgba(255,253,248,.7); font-size:9px; letter-spacing:.2em; }.scroll-note i { width:47px; height:1px; background:rgba(255,253,248,.7); }.fiber { position:absolute; pointer-events:none; opacity:.5; }.fiber i { position:absolute; display:block; border-top:1px solid currentColor; border-radius:50%; }.hero-fiber { width:350px; height:210px; right:13%; top:32%; color:rgba(255,253,248,.35); transform:rotate(-17deg); }.hero-fiber i:nth-child(1){width:335px;top:15px}.hero-fiber i:nth-child(2){width:270px;top:71px;left:45px;transform:rotate(8deg)}.hero-fiber i:nth-child(3){width:225px;top:137px;left:82px;transform:rotate(-8deg)}
  .proof { display:grid; grid-template-columns:repeat(4,1fr); padding:31px clamp(22px,8vw,150px); background:#eae3d7; }.proof>div { padding:0 clamp(14px,2.4vw,37px); border-left:1px solid rgba(45,40,36,.16); }.proof>div:first-child { padding-left:0;border-left:0; }.proof strong { display:block; font:500 clamp(34px,3.2vw,51px)/.82 "Cormorant Garamond",serif; letter-spacing:-.04em; }.proof sup,.proof small { color:var(--thread); font-size:.55em; margin-left:3px; }.proof p { margin:12px 0 0; color:rgba(45,40,36,.7); font-size:10px; line-height:1.5; letter-spacing:.09em; }
