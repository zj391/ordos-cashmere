// 把 "{value}" 拆成数字 + 后缀（用于数字滚动计数动画）
function parseCounter(v: string): { n: number; s: string } {
  const m = v.match(/^(?:[^\d]*?)(\d[\d,]*)(.*)$/);
  if (!m) return { n: 0, s: v };
  const n = parseInt(m[1].replace(/,/g, ''), 10);
  return { n: isFinite(n) ? n : 0, s: m[2] || '' };
}

