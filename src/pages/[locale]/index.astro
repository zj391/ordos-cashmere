// jevseo 2026-10-19 JEV-007 (P3, continuation): every editorial / menu / home
// image on the home page ships without explicit width/height, so CLS scoring
// can never reserve layout space. Each entry pairs the rendered URL with the
// image's intrinsic dimensions read from the file. The Astro template emits
// both width and height attributes; CSS `aspect-*` rules still control the
// actual box. Pages that read IMG pass through these so the dim signal travels
// with the url.
type Img = { url: string; w: number; h: number };
function img(url: string, w: number, h: number): Img { return { url, w, h }; }
/**
 * Image dimensions.
 *
 * 2026-10-29: the homepage hardcoded width/height on its <img> tags. The
 * category-card samples were all declared 750x750, but the real assets are
 * 543x550 (hats), 489x550 (scarves), 400x400 (sweaters, accessories, yarn)
 * and 750x750 (blankets). A browser reserving a square box for a portrait
 * image is what made the pictures and their captions sit out of alignment.
 *
 * scripts/generate_image_dimensions.py reads the actual pixels from disk
 * and writes this table, so the numbers can never drift from the assets
 * again.
 */
import imageDimensions from '@/data/image-dimensions.json';

const dim = (url: string): { w: number; h: number } => {
  const entry = (imageDimensions as Record<string, { w: number; h: number }>)[url];
  return entry ?? { w: 750, h: 750 };
};

