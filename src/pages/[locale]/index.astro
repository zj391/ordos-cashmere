  <script>
    (() => {
      const root = document.querySelector('[data-hero-slider]');
      if (!root) return;
      const slides = root.querySelectorAll('[data-hero-slide]');
      const dots = document.querySelectorAll('[data-hero-dot]');
      if (slides.length < 2) return;
      const total = slides.length;
      let current = 0;
      let timer = null;

      // 尊重用户的 reduced-motion 设置
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const show = (i) => {
        slides.forEach((el, idx) => {
          const active = idx === i;
          el.classList.toggle('opacity-100', active);
          el.classList.toggle('opacity-0', !active);
          // visibility:hidden makes browser skip paint for hidden slides,
          // halving GPU work on the hero stack (3x .ken-burns animations).
          el.classList.toggle('visible', active);
          el.classList.toggle('invisible', !active);
          el.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((d, idx) => {
          d.classList.toggle('bg-brand-gold', idx === i);
          d.classList.toggle('hero-dot-active', idx === i);
          d.classList.toggle('bg-white/40', idx !== i);
          d.setAttribute('aria-current', idx === i ? 'true' : 'false');
        });
        current = i;
      };

      const next = () => show((current + 1) % total);
      const start = () => { if (!reduceMotion) timer = setInterval(next, 7000); };
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };

      dots.forEach((d, i) => {
        d.addEventListener('click', () => {
          stop();
          show(i);
          start();
        });
      });

      start();
    })();
  </script>

