      {[
        { src: IMG.scarvesFolded, alt: 'Cashmere wrap — premium B2B apparel piece styled in urban setting' },
        { src: IMG.heroCraft,    alt: 'Handwoven cashmere detail — craftsmanship' },
        { src: IMG.heroLandscape, alt: 'Inner Mongolian highland landscape — Ordos origin' },
        { src: IMG.uiHero, alt: 'Premium cashmere coat on Ordos highland — material-led B2B collection inspiration' },
      ].map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          class={`ken-burns absolute inset-0 w-full h-full object-cover transition-opacity duration-[1500ms] ease-in-out ${
            i === 0 ? 'opacity-100 visible' : 'opacity-0 invisible'
          }`}
          decoding="async" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'}
          data-hero-slide={i}
        />
      ))}
      <!-- 左侧暗化叠层: 保证文字可读, 右侧保持明亮 (gradient from-left) -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-ink/60 via-brand-ink/25 to-transparent"></div>
