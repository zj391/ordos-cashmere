import { getCollection } from 'astro:content';
import { getBlogSlugFromId, isIndexableBlogPost } from '@/lib/blog-indexability';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/', 308);
}
const locale = pickLocale(rawLocale);

// 拿该 locale 最新 3 篇博客（首页展示用）
const allPosts = await getCollection('blog', ({ id }) =>
  id.startsWith(`${locale}/`) && isIndexableBlogPost(locale, getBlogSlugFromId(id))
);
const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: getBlogSlugFromId(p.id),
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.publishDate.toISOString().slice(0, 10),
  }));

// 首页产品中心：拉取产品数据（DB 叠加层失败时回退静态目录）
await ensureDbOverlay();
const allProducts = getAllProducts();
const featured: any[] = [];
// 2026-08-20 SEO fix: 每类 1 -> 3. 首页产品可见数 5 -> 15.
// 每产品页多 1 跳可达 — Googlebot 从首页发现 15 个产品详情页 (vs 5).
for (const cid of ['hats', 'scarves', 'sweaters', 'accessories', 'yarn']) {
  const catProducts = allProducts.filter((x: any) => x.categoryId === cid);
  for (const p of catProducts.slice(0, 3)) featured.push(p);
}
const homeImg = (p: any): string =>
  p.images && p.images[0] && (p.images[0].startsWith('/images/') || p.images[0].startsWith('http'))
    ? p.images[0]
