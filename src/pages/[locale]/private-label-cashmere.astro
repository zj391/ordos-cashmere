---
/**
 * Private Label Cashmere - dedicated SEO hub (7-8)
 * Target: private label cashmere knitwear / private label cashmere sweater factory
 * Route: /[locale]/private-label-cashmere × 6 locales = 6 URLs
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

const tdk = {
  en: {
    title: 'Private Label Cashmere Knitwear | OEM/ODM Manufacturer | DONGXIAO®',
    description: 'Private label cashmere sweaters, scarves, hats for global brands. Custom labels, hangtags, packaging. MOQ 100pcs/style. 23+ years OEM/ODM experience. Ordos factory direct.',
    h1: 'Private Label Cashmere Manufacturer',
    intro: 'Build your own cashmere brand with our 23+ years of OEM/ODM experience. From yarn selection to final packaging, we handle every step under your label.',
    bullets: [
      'Custom woven labels, printed labels, or hangtags',
      'Custom packaging (boxes, polybags, tissue paper)',
      'Pattern + sample development in 7-10 days',
      'Bulk production 30-45 days',
      'MOQ 100 pieces per style',
    ],
    faqs: [
      { q: 'What is the MOQ for private label cashmere?', a: 'MOQ is 100 pieces per style. We can mix colors within a style to help meet MOQ.' },
      { q: 'How long does sampling take?', a: 'Counter-sample: 7-10 days. Production-ready sample with your labels: 14-21 days.' },
      { q: 'Can you handle custom packaging?', a: 'Yes — boxes, polybags, tissue paper, hangtags, barcodes. We can source or work with your supplied packaging.' },
      { q: 'Do you offer design support?', a: 'Yes — in-house design team can develop tech packs from sketches, reference photos, or trend briefs.' },
    ],
  },
  cn: {
    title: '羊绒私人标签代工 | OEM/ODM 贴牌生产 | DONGXIAO®',
    description: '羊绒衫/围巾/帽子 贴牌代工。定制标签、吊牌、包装。MOQ 100件/款。23年 OEM/ODM 经验。',
    h1: '羊绒私人标签代工',
    intro: '23年 OEM/ODM 经验，从纱线选择到包装一站式贴牌。',
    bullets: ['定制织标/印标/吊牌', '定制包装（盒/袋/纸）', '打样 7-10 天', '大货 30-45 天', 'MOQ 每款 100 件'],
    faqs: [{ q: '羊绒贴牌起订量？', a: '每款 100 件。' }],
  },
};

const t = tdk[locale] || tdk.en;
const faqs = t.faqs || tdk.en.faqs;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Private Label Cashmere Manufacturing',
  provider: { '@type': 'Organization', name: 'DONGXIAO® Cashmere' },
  areaServed: 'Worldwide',
  serviceType: 'OEM/ODM Cashmere Manufacturing',
  description: t.description,
};
---

<BaseLayout
  locale={locale}
  pageKey="garment-oem"
  path={'/' + locale + '/private-label-cashmere'}
  title={t.title}
  description={t.description}
  keywords={['private label cashmere', 'private label cashmere knitwear', 'private label cashmere sweater factory', 'cashmere OEM ODM', 'custom cashmere knitwear', 'cashmere hat glove wholesale', 'wholesale cashmere shawl with custom logo']}
  schema="general"
  customSchemas={[serviceSchema]}
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/private-label-cashmere'} />

  <section class="bg-[#F5F0E7] border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Private Label · OEM · ODM</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{t.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{t.intro}</p>
      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-2 max-w-3xl">
        {t.bullets.map((b) => (
          <li class="flex items-start gap-2 text-sm opacity-90">
            <span class="text-brand-camel mt-1">•</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="container-narrow max-w-4xl">
      <h2 class="font-display text-3xl font-light mb-6">Our Private Label Process</h2>
      <ol class="space-y-6">
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-display text-lg">1</span>
          <div>
            <h3 class="font-medium text-lg mb-1">Design & Tech Pack</h3>
            <p class="text-sm text-foreground/80">Share your sketch, reference photo, or tech pack. Our in-house design team develops full tech packs including yarn spec, gauge, measurements, and colorway.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-display text-lg">2</span>
          <div>
            <h3 class="font-medium text-lg mb-1">Counter Sample</h3>
            <p class="text-sm text-foreground/80">We knit a counter sample in 7-10 days. Sample cost is refundable against orders 500+ pcs.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-display text-lg">3</span>
          <div>
            <h3 class="font-medium text-lg mb-1">Sample Approval & Labels</h3>
            <p class="text-sm text-foreground/80">You approve the sample. We produce custom woven/printed labels, hangtags, and packaging. Production-ready sample in 14-21 days.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-display text-lg">4</span>
          <div>
            <h3 class="font-medium text-lg mb-1">Bulk Production</h3>
            <p class="text-sm text-foreground/80">30-45 days for garments, 30-45 days for scarves/hats. 5-stage QC: incoming material, in-process, pre-finishing, post-finishing, pre-shipment.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-display text-lg">5</span>
          <div>
            <h3 class="font-medium text-lg mb-1">Shipping & After-Sales</h3>
            <p class="text-sm text-foreground/80">FOB Tianjin/Shanghai, CIF, DDP. Door-to-door logistics for DDP. After-sales support for quality issues within 30 days of receipt.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <SEOFaq faqs={faqs} title="Frequently Asked Questions" />

  <section class="py-16 bg-[#F5F0E7] border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">Start your private label project</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">Send your reference, tech pack, or just a sketch. We'll reply within 24 hours with a feasibility assessment and quote.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={'/' + locale + '/contact'} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] rounded-none font-medium uppercase tracking-[0.15em] hover:bg-brand-chocolate">Start Your Project</a>
        <a href={'/' + locale + '/garment-oem'} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-[0.15em] hover:bg-brand-ink hover:text-[#F7F3EC]">View Garment OEM Page</a>
      </div>
    </div>
  </section>

  {locale === 'en' && (
  <section class="py-12 md:py-16 bg-secondary/20">
    <div class="container-narrow">
      <h2 class="font-display text-3xl md:text-4xl font-light mb-4">Private Label Cashmere: 5 Decisions Before You Start</h2>
      <p class="text-base text-muted-foreground mb-8 max-w-3xl">
        Launching a private label cashmere brand is a 90-day project if planned well, or a 9-month struggle if you make the wrong decisions upfront. Below are the 5 questions we ask every new private label client — and the answers that work for 80% of emerging cashmere brands.
      </p>

      <div class="space-y-8">
        <div>
          <h3 class="font-serif text-2xl mb-3">1. Where will you sell? (DTC, Wholesale, Department Store)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Your sales channel determines MOQ, packaging requirements, and price point. DTC Shopify brands typically start at 100-200 pieces total (low MOQ, basic packaging, premium pricing). Wholesale brands targeting boutiques need 300-1000 pieces per SKU (higher MOQ, branded labels/hangtags, mid-market pricing). Department store buyers (Nordstrom, Galeries Lafayette, Isetan) require 1000+ pieces per SKU + full compliance documentation (BSCI, OEKO-TEX, ISO 9001).</p>
          <p class="text-sm text-muted-foreground"><strong>Recommendation:</strong> Start with 1 channel, prove demand, then expand. Mixing channels from day 1 dilutes focus and inflates MOQ.</p>
        </div>

        <div>
          <h3 class="font-serif text-2xl mb-3">2. What's your target micron and gauge?</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Micron (fiber fineness) determines hand feel and price tier: 14.5-15.5μm = premium (Loro Piana tier), 15.5-16.5μm = mid-market (most DTC brands), 16.5-19μm = entry-level (less soft, more durable). Gauge (stitches per inch) determines weight and seasonality: 12gg = chunky winter, 14gg = mid-weight, 16gg = fine all-season. Most private label brands start at 15.5μm / 14gg for sweaters — the sweet spot for hand feel vs. price.</p>
          <p class="text-sm text-muted-foreground"><strong>Cost impact:</strong> Each 0.5μm micron improvement adds ~8-12% to yarn cost. Each gauge increase (12→14→16) adds ~5-8% to knitting time.</p>
        </div>

        <div>
          <h3 class="font-serif text-2xl mb-3">3. How will you brand? (Labels, Hangtags, Packaging)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Three branding levels: (a) Woven main label + care label + paper hangtag — USD 0.30-0.50 per piece, MOQ 500 labels; (b) Custom woven labels with your logo + branded packaging (silk paper, branded zip lock) + outer carton with your sticker — USD 1.20-2.00 per piece, MOQ 1000 sets; (c) Full custom packaging (printed inner box, custom tissue paper, ribbon, branded mailer) — USD 3.50-6.00 per piece, MOQ 2000+ pieces. We can source labels and packaging separately or bundle into the knitwear quote.</p>
          <p class="text-sm text-muted-foreground"><strong>Lead time:</strong> Custom labels take 15-20 days to produce; packaging 20-30 days. Add this to your timeline if launching a new collection.</p>
        </div>

        <div>
          <h3 class="font-serif text-2xl mb-3">4. What colors do you need? (Standard vs. Custom Pantone)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Standard yarn colors (we hold 200+ shades in stock — see our <a href="/en/color-cards/" class="text-primary hover:underline">color cards</a>) ship in 7-10 days. Custom Pantone matching takes 25-35 days for dyeing + minimum dye lot 50kg per color. We recommend launching with 3-5 standard colors (camel, ivory, charcoal, navy, blush) and adding custom colors once you've validated sell-through. Dye-to-order cost is USD 2-4 per piece extra vs. stock yarn.</p>
          <p class="text-sm text-muted-foreground"><strong>Inventory tip:</strong> Stock yarn is 40% cheaper than custom dye. Custom dye is 40% cheaper than "perfect" custom dye with multiple lab dips.</p>
        </div>

        <div>
          <h3 class="font-serif text-2xl mb-3">5. How will you handle inventory risk? (MOQ, Lead Time, Reorder)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Cashmere has 16-25 day production lead time, so you cannot "test and reorder in 2 weeks" like fast fashion. We recommend a 3-phase inventory plan: (a) Launch order 200-500 pieces per SKU to test the market; (b) Core reorder 500-1500 pieces for proven SKUs (book capacity 60 days ahead); (c) Seasonal expansion 1500+ pieces for confirmed winners. For new brands we offer a 100-piece MOQ on standard colors/styles to lower the initial capital risk.</p>
          <p class="text-sm text-muted-foreground"><strong>Working capital rule:</strong> Keep at least 3 reorder cycles in cash. Cash flow kills more emerging cashmere brands than product quality does.</p>
        </div>
      </div>

      <div class="mt-10 p-6 border-l-4 border-brand-gold bg-brand-gold/5 rounded-r">
        <h3 class="font-serif text-xl mb-3">3 Mistakes First-Time Private Label Brands Make</h3>
        <ol class="list-decimal pl-5 space-y-2 text-muted-foreground">
          <li><strong>Starting with too many SKUs.</strong> Five well-chosen styles outperform twenty mediocre ones. Cashmere buyers expect curated collections.</li>
          <li><strong>Underestimating working capital.</strong> First order + customs duties + marketing = 4x the unit cost in cash needed before you see a single sale.</li>
          <li><strong>Skipping the sample round.</strong> "Looks the same on screen" costs 6-8 weeks of rework. Always approve a physical hand-loom sample before bulk.</li>
        </ol>
      </div>

      <div class="mt-10 text-center">
        <a href="/en/contact?type=garment" class="inline-block px-8 py-3 bg-primary text-primary-foreground rounded-none font-medium hover:bg-primary/90 transition-colors">Discuss Your Private Label Project →</a>
      </div>
    </div>
  </section>
  )}

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>