---
/**
 * 私牌 OEM SEO：以采购方可准备的资料为核心；具体规格、样品、MOQ、交期、费用与交付条款均在书面报价中确认。
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

type Copy = { title: string; description: string; h1: string; intro: string; stepsTitle: string; steps: { title: string; text: string }[]; faqTitle: string; faqs: { q: string; a: string }[]; ctaTitle: string; ctaText: string; cta: string };
const content: Record<string, Copy> = {
  en: { title: 'Private Label Cashmere | OEM/ODM Sourcing Discussion | DONGXIAO®', description: 'Plan a private-label cashmere sourcing discussion with product references, specifications, sample requirements, destination and commercial documentation.', h1: 'Private Label Cashmere Sourcing', intro: 'Use this page to prepare the product information needed for a private-label project. Product scope, sample route, MOQ, timing, price, packaging and delivery terms are confirmed for the individual project in writing.', stepsTitle: 'Prepare a clearer private-label brief', steps: [{ title: '01 — Product reference', text: 'Share the product link, sketch, reference photo or technical pack, together with the intended category and buyer requirements.' }, { title: '02 — Specification direction', text: 'State the material target, color direction, measurements or gauge, label and packaging requirements, target quantity and destination.' }, { title: '03 — Sample and verification plan', text: 'Describe the sample purpose, approval route, inspection points, document needs and desired launch or delivery window.' }], faqTitle: 'Private-label sourcing FAQ', faqs: [{ q: 'What information should a private-label inquiry include?', a: 'Include a product reference, quantity, destination, material and color direction, measurements or gauge where known, label or packaging needs, and required documents.' }, { q: 'When are MOQ, sampling and lead-time terms confirmed?', a: 'They are reviewed against the individual product and order context, then confirmed in the written quotation or sales agreement.' }, { q: 'Can a buyer request custom labels or packaging?', a: 'State the label, hangtag, barcode or packaging requirements in the brief so feasibility, documentation and commercial terms can be discussed in writing.' }], ctaTitle: 'Start a documented private-label discussion', ctaText: 'Send your product reference, target quantity, destination and required specifications to begin a written project review.', cta: 'Request a sourcing discussion' },
  cn: { title: '羊绒私人标签 | OEM/ODM 采购沟通 | DONGXIAO®', description: '围绕产品参考、规格、打样要求、目的地和商务文件准备羊绒贴牌采购沟通。', h1: '羊绒私人标签采购沟通', intro: '本页帮助采购方准备贴牌项目所需信息。产品范围、样品路径、起订量、时效、价格、包装和交付条款均应按具体项目书面确认。', stepsTitle: '准备更清晰的贴牌需求', steps: [{ title: '01 — 产品参考', text: '提供产品链接、草图、参考图片或技术包，以及预期品类和买方要求。' }, { title: '02 — 规格方向', text: '说明材质目标、颜色方向、尺寸或针型、标签和包装要求、目标数量与目的地。' }, { title: '03 — 打样与核验计划', text: '说明打样用途、确认路径、验货要点、文件需求和期望上市或交付窗口。' }], faqTitle: '贴牌采购常见问题', faqs: [{ q: '贴牌询盘应包含哪些信息？', a: '建议提供产品参考、数量、目的地、材质和颜色方向、已知尺寸或针型、标签或包装需求及文件要求。' }, { q: '何时确认起订量、打样和交期？', a: '应结合具体产品与订单背景审核，并在书面报价或销售协议中确认。' }, { q: '可以提出定制标签或包装需求吗？', a: '可以。请在需求中说明标签、吊牌、条码或包装要求，以便书面沟通可行性、文件与商务条款。' }], ctaTitle: '开始书面贴牌沟通', ctaText: '请提供产品参考、目标数量、目的地和所需规格，以启动书面项目审核。', cta: '申请采购沟通' },
  de: { title: 'Private Label Kaschmir | OEM/ODM Beschaffung | DONGXIAO®', description: 'Bereiten Sie eine Private-Label-Beschaffungsanfrage mit Produktreferenz, Spezifikation, Musteranforderungen und Zielort vor.', h1: 'Private Label Kaschmir Beschaffung', intro: 'Produktscope, Bemusterung, MOQ, Zeitplan, Preis, Verpackung und Lieferung werden für jedes Projekt schriftlich bestätigt.', stepsTitle: 'Beschaffungsbrief vorbereiten', steps: [{ title: '01 — Produktreferenz', text: 'Produktlink, Skizze, Referenzfoto oder Tech Pack sowie Produktkategorie angeben.' }, { title: '02 — Spezifikationsrichtung', text: 'Material, Farbe, Maße oder Gauge, Etiketten, Verpackung, Menge und Zielort benennen.' }, { title: '03 — Muster und Prüfung', text: 'Musterzweck, Freigabe, Prüfpunkte, Dokumente und Lieferfenster beschreiben.' }], faqTitle: 'FAQ Private Label', faqs: [{ q: 'Was gehört in eine Anfrage?', a: 'Produktreferenz, Menge, Zielort, Material, Farbe, Maße, Etiketten, Verpackung und Dokumente.' }, { q: 'Wann werden MOQ und Zeiten bestätigt?', a: 'Nach Prüfung des individuellen Produkts und Auftrags im schriftlichen Angebot oder Vertrag.' }, { q: 'Kann ich eigene Etiketten oder Verpackungen anfragen?', a: 'Ja. Nennen Sie die Anforderungen zur schriftlichen Prüfung von Machbarkeit und Bedingungen.' }], ctaTitle: 'Schriftliche Projektabstimmung starten', ctaText: 'Senden Sie Referenz, Menge, Zielort und Spezifikationen.', cta: 'Beschaffung besprechen' },
  fr: { title: 'Cachemire marque privée | Approvisionnement OEM/ODM | DONGXIAO®', description: 'Préparez une demande marque privée avec référence produit, spécifications, échantillonnage et destination.', h1: 'Approvisionnement cachemire marque privée', intro: 'Périmètre, échantillons, MOQ, délai, prix, emballage et livraison sont confirmés par écrit pour chaque projet.', stepsTitle: 'Préparer votre brief', steps: [{ title: '01 — Référence produit', text: 'Partagez lien produit, croquis, photo de référence ou dossier technique.' }, { title: '02 — Direction des spécifications', text: 'Indiquez matière, couleur, mesures ou jauge, étiquettes, emballage, quantité et destination.' }, { title: '03 — Échantillon et vérification', text: 'Décrivez le but de l’échantillon, l’approbation, les contrôles, documents et fenêtre de livraison.' }], faqTitle: 'FAQ marque privée', faqs: [{ q: 'Que doit contenir la demande ?', a: 'Référence, quantité, destination, matière, couleur, mesures, étiquettes, emballage et documents.' }, { q: 'Quand confirmer MOQ et délai ?', a: 'Après revue du produit et de la commande dans le devis ou contrat écrit.' }, { q: 'Puis-je demander étiquettes ou packaging ?', a: 'Oui, indiquez les exigences pour évaluer faisabilité et conditions par écrit.' }], ctaTitle: 'Lancer la discussion écrite', ctaText: 'Envoyez référence, quantité, destination et spécifications.', cta: 'Discuter approvisionnement' },
  ja: { title: 'プライベートブランド カシミア | OEM/ODM 調達 | DONGXIAO®', description: '製品参考、仕様、サンプル要件、仕向地を含むプライベートブランド調達相談を準備します。', h1: 'プライベートブランド カシミア調達', intro: '製品範囲、サンプル、MOQ、時期、価格、包装、引渡条件は案件ごとに書面で確認します。', stepsTitle: '調達ブリーフを準備する', steps: [{ title: '01 — 製品参考', text: '製品リンク、スケッチ、参考写真、技術パックを共有します。' }, { title: '02 — 仕様方向', text: '素材、色、寸法またはゲージ、ラベル、包装、数量、仕向地を示します。' }, { title: '03 — サンプルと検証', text: 'サンプル目的、承認、検品、書類、希望時期を説明します。' }], faqTitle: 'プライベートブランド FAQ', faqs: [{ q: '問い合わせには何が必要ですか？', a: '製品参考、数量、仕向地、素材、色、寸法、ラベル、包装、書類です。' }, { q: 'MOQと時期はいつ確認しますか？', a: '個別製品と注文を確認後、書面見積もりまたは契約で確認します。' }, { q: 'ラベルや包装を依頼できますか？', a: 'はい。要件を記載し、実現可能性と条件を文書で確認します。' }], ctaTitle: '書面で相談を開始する', ctaText: '参考、数量、仕向地、仕様をお送りください。', cta: '調達を相談する' },
  kr: { title: '프라이빗 라벨 캐시미어 | OEM/ODM 소싱 | DONGXIAO®', description: '제품 참고, 사양, 샘플 요건, 목적지를 포함한 프라이빗 라벨 소싱 상담을 준비하세요.', h1: '프라이빗 라벨 캐시미어 소싱', intro: '제품 범위, 샘플, MOQ, 일정, 가격, 포장, 인도 조건은 프로젝트별로 서면 확인합니다.', stepsTitle: '소싱 브리프 준비', steps: [{ title: '01 — 제품 참고', text: '제품 링크, 스케치, 참고 사진 또는 기술 팩을 공유합니다.' }, { title: '02 — 사양 방향', text: '소재, 색상, 치수 또는 게이지, 라벨, 포장, 수량, 목적지를 제시합니다.' }, { title: '03 — 샘플 및 검증', text: '샘플 목적, 승인, 검사, 서류, 희망 시기를 설명합니다.' }], faqTitle: '프라이빗 라벨 FAQ', faqs: [{ q: '문의에는 무엇이 필요합니까?', a: '제품 참고, 수량, 목적지, 소재, 색상, 치수, 라벨, 포장, 서류입니다.' }, { q: 'MOQ와 일정은 언제 확정합니까?', a: '개별 제품과 주문 검토 후 서면 견적 또는 계약에서 확정합니다.' }, { q: '라벨 또는 포장을 요청할 수 있습니까?', a: '네. 요건을 기재해 실현 가능성과 조건을 서면으로 확인합니다.' }], ctaTitle: '서면 상담 시작', ctaText: '참고 자료, 수량, 목적지, 사양을 보내 주세요.', cta: '소싱 상담하기' },
};
const copy = content[locale] || content.en;
const serviceSchema = { '@context': 'https://schema.org', '@type': 'Service', name: copy.h1, description: copy.description, provider: { '@id': 'https://www.erdosdx.com/#organization' }, serviceType: 'Private-label cashmere sourcing discussion' };
const pathwayLinks = [{ href: `/${locale}/garment-oem/`, en: 'Garment OEM information', cn: '成衣 OEM 信息' }, { href: `/${locale}/quality-control/`, en: 'Quality-control preparation', cn: '质控准备' }, { href: `/${locale}/shipping-logistics/`, en: 'Delivery preparation', cn: '物流准备' }, { href: `/${locale}/contact/`, en: 'Send an inquiry', cn: '发起询盘' }];
---

<BaseLayout locale={locale} pageKey="garment-oem" path="/private-label-cashmere" title={copy.title} description={copy.description} keywords={['private label cashmere', 'cashmere OEM ODM', 'custom cashmere knitwear', 'cashmere sourcing discussion']} schema="general" customSchemas={[serviceSchema]}>
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/private-label-cashmere`} />
  <section class="bg-brand-sandwarm border-b border-border/60 py-20 md:py-28"><div class="container-narrow max-w-4xl"><span class="text-xs tracking-[0.4em] text-brand-camel uppercase">PRIVATE LABEL · OEM · ODM</span><h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{copy.h1}</h1><p class="text-lg md:text-xl max-w-3xl opacity-90">{copy.intro}</p></div></section>
  <section class="py-16 md:py-20 bg-background"><div class="container-narrow"><h2 class="font-display text-3xl font-light mb-10">{copy.stepsTitle}</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-6">{copy.steps.map((step) => <article class="border border-border bg-white p-6"><h3 class="font-serif text-xl mb-3">{step.title}</h3><p class="text-sm text-muted-foreground leading-relaxed">{step.text}</p></article>)}</div></div></section>
  <section class="py-16 bg-secondary/20 border-y border-border/60"><div class="container-narrow"><div class="grid grid-cols-1 md:grid-cols-4 gap-4">{pathwayLinks.map((link) => <a href={link.href} class="border border-border bg-white p-5 text-sm font-medium hover:border-brand-camel transition-colors">{locale === 'cn' ? link.cn : link.en} →</a>)}</div></div></section>
  <SEOFaq faqs={copy.faqs} title={copy.faqTitle} />
  <section class="py-16 bg-brand-sandwarm border-y border-border/60"><div class="container-narrow text-center"><h2 class="font-display text-3xl font-light mb-4">{copy.ctaTitle}</h2><p class="opacity-90 mb-8 max-w-2xl mx-auto">{copy.ctaText}</p><a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-brand-cream uppercase tracking-wider text-sm">{copy.cta}</a></div></section>
  <Footer slot="footer" locale={locale} /><FloatingChatButtons slot="footer" locale={locale} /><CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
