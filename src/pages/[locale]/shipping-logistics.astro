---
/**
 * Shipping and Logistics - B2B SEO hub (long-tail: "cashmere shipping China", "FOB CIF DDP")
 * Route: /[locale]/shipping-logistics × 6 locales
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

const tdk = {
  en: {
    title: 'Cashmere Shipping and Logistics - FOB CIF DDP Worldwide - DONGXIAO Cashmere',
    description: 'Cashmere wholesale shipping logistics from China. FOB Tianjin and Shanghai, CIF, DDP and EXW all supported. Sea freight LCL and FCL, air freight, courier DHL FedEx UPS TNT. HS code 5108.20 classification and customs clearance support included. Free DDP quotes for US and EU buyers.'
    h1: 'Cashmere Shipping and Logistics',
    intro: 'Worldwide shipping for cashmere wholesale orders from our Ordos factory. FOB Tianjin and Shanghai, CIF, DDP and EXW all supported. Sea freight LCL and FCL, air freight, courier DHL FedEx UPS TNT and EMS. Customs clearance and HS code classification included for all destinations.'
    bullets: [
      'Incoterms 2020: FOB Tianjin, CIF, DDP, EXW all supported',
      'Sea freight: LCL (1-10 m³) or FCL (20ft/40ft container)',
      'Air freight: 5-7 days to EU/US, 3-5 days to Asia/Middle East',
      'Courier: DHL/FedEx/UPS/TNT for samples and small orders',
      'Customs clearance + HS code 5108.20 classification included',
    ],
    faqs: [
      { q: 'What shipping methods do you support for cashmere wholesale orders?', a: 'We support sea freight (LCL/FCL), air freight, courier (DHL/FedEx/UPS/TNT), and DDP door-to-door. Incoterms 2020: FOB Tianjin/Shanghai, CIF, DDP, EXW all available. Sea freight is most cost-effective for orders over 100 kg; air freight for samples or urgent restocks (5-7 days to EU/US); courier for under 100 kg samples and small orders.' },
      { q: 'What is the transit time for cashmere shipping from China to my country?', a: 'Sea freight LCL: 25-35 days to EU/US, 18-25 days to Asia/Middle East, 30-40 days to South America/Africa. Sea freight FCL: 22-30 days to EU/US, 15-22 days to Asia. Air freight: 5-7 days to EU/US, 3-5 days to Asia/Middle East. Courier (DHL/FedEx/UPS): 3-7 days worldwide door-to-door.' },
      { q: 'What is the HS code for cashmere products when importing to EU/US?', a: 'Cashmere knitwear (sweaters, scarves, hats): HS code 6110 (knitted). Cashmere woven fabric and yarn: HS code 5108.20. Cashmere coats: HS code 6202 (women) or 6201 (men). EU import duty for cashmere knitwear is 12%, US is duty-free under most-favored-nation tariff. We provide complete HS code classification with every shipment.' },
      { q: 'Can you arrange DDP (Delivered Duty Paid) shipping to my country?', a: 'Yes — we offer DDP door-to-door for US, EU, UK, Canada, Australia. We pre-pay customs duties, GST/VAT, and last-mile delivery. Final landed cost is locked-in (no surprise fees). We use Amazon FBA Prep partner for US-bound shipments and EU 3PL warehouses for EU-bound. DDP quotes valid for 14 days; service adds 15-20% to FOB price.' },
      { q: 'What is the difference between FOB, CIF, and DDP for cashmere orders?', a: 'FOB (Free on Board): We deliver goods to Tianjin/Shanghai port and load them on your nominated vessel. You pay for sea freight and insurance. CIF (Cost Insurance Freight): We pay for sea freight and insurance to your destination port; you pay customs duties. DDP (Delivered Duty Paid): We pay for everything including customs duties, GST/VAT, and last-mile delivery to your door. Most US/EU buyers prefer DDP for simplicity.' },
      { q: 'How is cashmere packed for export to prevent damage during shipping?', a: 'Each garment in a polybag, 10-20 pieces per master polybag, then in an ISPM-15 compliant fumigation-free export carton (5-ply corrugated). Cartons stacked on standard wooden pallets, shrink-wrapped, and loaded into 20ft or 40ft containers. Knitwear is compressed 30-50% in vacuum bags for FCL loading. Average carton size 60x40x40 cm; 40ft container holds ~1,200 standard cartons.' },
    ],
  },
  cn: {
    title: '羊绒海运物流 | FOB CIF DDP 全球 | DONGXIAO®',
    description: '羊绒批发海运物流：中国起运 FOB 天津/上海、CIF、DDP 全球。海运散货/整柜、空运、DHL/FedEx/UPS/TNT 快递。5108.20 HS 编码清关支持。美国/欧盟买家免费 DDP 报价。'
    h1: '羊绒海运与物流'
    intro: '从鄂尔多斯工厂全球发货：FOB 天津/上海、CIF、DDP、EXW 全支持。海运散货/整柜、空运、DHL/FedEx/UPS/TNT/EMS 快递。清关 + HS 编码支持全目的地。'
    bullets: ['Incoterms 2020：FOB / CIF / DDP / EXW 全支持', '海运：散货（1-10 m³）或整柜（20/40 英尺）', '空运：欧美 5-7 天，亚洲/中东 3-5 天', '快递：DHL/FedEx/UPS/TNT 样品和小单', '清关 + HS 编码 5108.20 支持'],
    faqs: [
      { q: '羊绒海运物流支持哪些方式？', a: '海运散货 LCL / 整柜 FCL（20/40 英尺）、空运、DHL/FedEx/UPS/TNT 快递、DDP 门到门服务。Incoterms 2020：FOB 天津/上海、CIF、DDP、EXW 全支持。' },
      { q: '中国到欧美的海运时间？', a: '海运 LCL：欧美 25-35 天、亚洲/中东 18-25 天、南美/非洲 30-40 天。海运 FCL：欧美 22-30 天、亚洲 15-22 天。空运：欧美 5-7 天、亚洲/中东 3-5 天。快递（DHL/FedEx/UPS）：3-7 天门到门。' },
      { q: '羊绒产品的 HS 编码是什么？', a: '羊绒针织品（毛衫/围巾/帽子）：HS 6110。羊绒机织面料/纱线：HS 5108.20。羊绒大衣：HS 6202（女）/ 6201（男）。欧盟进口羊绒针织品关税 12%，美国最惠国关税免税。我们每次出货都提供完整 HS 编码分类。' },
      { q: '能提供 DDP 门到门吗？', a: '可以。我们提供美国、欧盟、英国、加拿大、澳大利亚 DDP 服务：预付关税、GST/VAT、尾程派送。最终到岸价格锁定（无意外费用）。美国用亚马逊 FBA 准备合作伙伴、欧盟用 EU 3PL 仓库。DDP 报价 14 天有效，比 FOB 加价 15-20%。' },
    ],
  },
  de: {
    title: 'B2B Kaschmir Zahlungsbedingungen | T/T, L/C, O/A | DONGXIAO®',
    description: 'Kaschmir-Großhandel Zahlungsbedingungen: T/T, L/C, O/A, D/P. Erste Bestellung 30% Anzahlung + 70% gegen B/L-Kopie. Stammkunden bis 30% O/A nach 6 Monaten.',
    h1: 'B2B Kaschmir Zahlungsbedingungen',
    intro: 'Transparente, international standardisierte Zahlungsbedingungen für Kaschmir-Großhandelsbestellungen. Wir akzeptieren T/T, L/C, O/A und D/P.',
    bullets: ['Erste Bestellung: 30% T/T Anzahlung, 70% gegen B/L-Kopie', 'Stammkunden (nach 6 Monaten): bis 30% O/A, 70% netto 30', 'L/C akzeptiert bei Sicht oder 30/60/90 Tagen', 'Alibaba Trade Assurance akzeptiert'],
    faqs: [
      { q: 'Welche Zahlungsbedingungen gelten für Erstbestellungen?', a: 'Erstbesteller: 30% T/T Anzahlung bei Auftragsbestätigung, 70% Restzahlung T/T gegen B/L-Kopie. Bei Bestellungen unter USD 5.000 verlangen wir 100% T/T im Voraus.' },
      { q: 'Akzeptieren Sie Akkreditive (L/C)?', a: 'Ja — wir akzeptieren unwiderrufliches L/C bei Sicht für Bestellungen ab USD 50.000. Für Beträge unter USD 50.000 empfehlen wir T/T.' },
    ],
  },
  fr: {
    title: 'Conditions de paiement cachemire B2B | T/T, L/C, O/A | DONGXIAO®',
    description: 'Conditions de paiement pour cachemire en gros: T/T, L/C, O/A, D/P. Première commande 30% d\'acompte + 70% contre copie B/L.',
    h1: 'Conditions de paiement cachemire B2B',
    intro: 'Conditions de paiement standard internationales pour commandes de cachemire en gros.',
    bullets: ['Première commande : 30% T/T d\'acompte, 70% contre copie B/L', 'Clients réguliers (après 6 mois) : jusqu\'à 30% O/A', 'L/C accepté à vue ou 30/60/90 jours'],
    faqs: [
      { q: 'Quelles conditions de paiement pour les premières commandes ?', a: '30% T/T d\'acompte à la confirmation, 70% contre copie B/L. Pour commandes inférieures à USD 5.000, 100% T/T à l\'avance.' },
    ],
  },
  ja: {
    title: 'カシミア B2B 支払条件 | T/T、L/C、O/A | DONGXIAO®',
    description: 'カシミア卸売の支払条件：T/T、L/C、O/A、D/P。初回注文30%前払い+70%B/Lコピーに対し支払い。',
    h1: 'カシミア B2B 支払条件',
    intro: '国際標準のカシミア卸売支払条件。T/T、L/C、O/A、D/P に対応。',
    bullets: ['初回：30% T/T 前払い + 70% B/L コピー', 'リピート（6ヶ月後）：30% O/A まで', 'L/C は USD 50,000 以上で受付'],
    faqs: [
      { q: '初回注文の支払条件は？', a: '初回：30% T/T 前払い（注文確認時）+ 70% B/L コピー支払い。USD 5,000 未満は 100% 前払い。' },
    ],
  },
  kr: {
    title: '캐시미어 B2B 결제 조건 | T/T, L/C, O/A | DONGXIAO®',
    description: '캐시미어 도매 결제 조건: T/T, L/C, O/A, D/P. 첫 주문 30% 계약금 + 70% B/L 사본 결제.',
    h1: '캐시미어 B2B 결제 조건',
    intro: '국제 표준 캐시미어 도매 결제 조건. T/T, L/C, O/A, D/P 지원.',
    bullets: ['첫 주문: 30% T/T 계약금 + 70% B/L 사본', '재주문 (6개월 후): 최대 30% O/A', 'L/C USD 50,000 이상'],
    faqs: [
      { q: '첫 주문 결제 조건은?', a: '첫 주문: 30% T/T 계약금 (주문 확정 시) + 70% B/L 사본 결제. USD 5,000 미만은 100% 선불.' },
    ],
  },
};

const t = tdk[locale] || tdk.en;
const faqs = t.faqs || tdk.en.faqs;

const shippingMethods = [
  { method: 'Sea Freight LCL', firstOrder: '100-500 kg / 5-30 m³', repeatOrder: 'Same', minOrder: '5 m³ / USD 500 freight', risk: 'Low', speed: '25-35 days (EU/US), 18-25 days (Asia), 30-40 days (SAm/Africa)' },
  { method: 'Sea Freight FCL 20ft', firstOrder: '~25-28 m³ / 12,000 kg knitwear', repeatOrder: 'Same', minOrder: 'USD 2,500-4,500 freight (varies by route)', risk: 'Low', speed: '22-30 days (EU/US), 15-22 days (Asia)' },
  { method: 'Sea Freight FCL 40ft', firstOrder: '~54-58 m³ / 24,000 kg knitwear', repeatOrder: 'Same', minOrder: 'USD 4,000-7,000 freight', risk: 'Low', speed: '22-30 days (EU/US), 15-22 days (Asia)' },
  { method: 'Air Freight', firstOrder: '20-500 kg / 0.1-2 m³', repeatOrder: 'Same', minOrder: 'USD 8-15/kg', risk: 'Low', speed: '5-7 days (EU/US), 3-5 days (Asia/Middle East)' },
  { method: 'Courier (DHL/FedEx/UPS/TNT)', firstOrder: 'Samples + small orders under 100 kg', repeatOrder: 'Same', minOrder: 'USD 30-100 per shipment', risk: 'Low', speed: '3-7 days worldwide door-to-door' },
  { method: 'DDP Door-to-Door', firstOrder: 'US/EU/UK/CA/AU destinations', repeatOrder: 'Same', minOrder: 'Add 15-20% to FOB price', risk: 'Very low (duties pre-paid)', speed: '25-35 days door-to-door' },
];
---

<BaseLayout
  locale={locale}
  pageKey="shipping-logistics"
  path={'/' + locale + '/shipping-logistics'}
  title={t.title}
  description={t.description}
  keywords={['cashmere shipping China', 'FOB CIF DDP cashmere', 'cashmere wholesale shipping', 'cashmere air freight', 'cashmere sea freight LCL FCL', 'cashmere customs clearance']}
  schema="general"
>
  <Navigation slot="header" locale={locale} currentPath={'/' + locale + '/payment-terms'} />

  <section class="bg-[#F5F0E7] border-b border-border/60 py-20 md:py-28">
    <div class="container-narrow">
      <span class="text-xs tracking-[0.4em] text-brand-camel uppercase">Shipping and Logistics</span>
      <h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{t.h1}</h1>
      <p class="text-lg md:text-xl max-w-3xl opacity-90">{t.intro}</p>
      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-2 max-w-3xl">
        {t.bullets.map((b) => (
          <li class="flex items-start gap-2 text-sm opacity-90">
            <span class="text-brand-camel mt-1">•</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="container-narrow">
      <h2 class="font-display text-3xl font-light mb-8">Shipping Methods at a Glance</h2>
      <div class="overflow-x-auto">
        <table class="w-full border border-border rounded-lg overflow-hidden text-sm">
          <thead class="bg-secondary/30">
            <tr>
              <th class="text-left p-3 font-medium">Method</th>
              <th class="text-left p-3 font-medium">Best For</th>
              <th class="text-left p-3 font-medium">Transit Time</th>
              <th class="text-left p-3 font-medium">Min Order</th>
              <th class="text-left p-3 font-medium">Cost Range</th>
              <th class="text-left p-3 font-medium">Tracking</th>
            </tr>
          </thead>
          <tbody>
            {paymentMethods.map((p) => (
              <tr class="border-t border-border">
                <td class="p-3 font-medium">{p.method}</td>
                <td class="p-3">{p.firstOrder}</td>
                <td class="p-3">{p.repeatOrder}</td>
                <td class="p-3 text-xs">{p.minOrder}</td>
                <td class="p-3 text-xs">{p.risk}</td>
                <td class="p-3 text-xs">{p.speed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-muted-foreground">All methods include export customs declaration, ISPM-15 compliant fumigation-free cartons, and door-to-port or door-to-door options. HS code 5108.20 used for woven cashmere; 6110 for knitwear.</p>
    </div>
  </section>

  <section class="py-16 bg-secondary/20">
    <div class="container-narrow max-w-4xl">
      <h2 class="font-display text-3xl font-light mb-6">Which shipping method is right for your order?</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-serif text-2xl mb-3">Small orders (under 100 kg / 5 m³)</h3>
          <p class="text-base leading-relaxed text-foreground/80">
            Use <strong>Courier (DHL / FedEx / UPS / TNT)</strong> for samples and orders under 100 kg. Transit time 3-7 days to EU/US, 2-5 days to Asia. Cost is high per kg (USD 8-15/kg) but no minimum order, no customs paperwork on your side. We ship from our Tianjin warehouse with door-to-door tracking.
          </p>
        </div>
        <div>
          <h3 class="font-serif text-2xl mb-3">Mid-size orders (100-500 kg / 5-30 m³)</h3>
          <p class="text-base leading-relaxed text-foreground/80">
            Use <strong>LCL (Less than Container Load) sea freight</strong> for orders 100-500 kg or 5-30 m³. Transit time 25-35 days to EU/US, 18-25 days to Southeast Asia/Middle East. Cost USD 80-200 per m³ depending on destination. We consolidate at our warehouse, load to LCL container at Tianjin port, and provide B/L (Bill of Lading) for customs clearance.
          </p>
        </div>
        <div>
          <h3 class="font-serif text-2xl mb-3">Container orders (500+ kg / 30+ m³)</h3>
          <p class="text-base leading-relaxed text-foreground/80">
            Use <strong>FCL (Full Container Load)</strong> — 20ft container holds ~25-28 m³ (≈ 12,000 kg cashmere knitwear) or 40ft container holds ~54-58 m³ (≈ 24,000 kg). FCL is the cheapest per-cbm option. Transit time 22-30 days to EU/US, 15-22 days to Asia. We handle export customs at Tianjin port and provide full set of shipping documents (B/L, commercial invoice, packing list, certificate of origin).
          </p>
        </div>
        <div>
          <h3 class="font-serif text-2xl mb-3">DDP buyers (US / EU door-to-door)</h3>
          <p class="text-base leading-relaxed text-foreground/80">
            Use <strong>DDP (Delivered Duty Paid)</strong> for door-to-door delivery to US/EU. We pre-pay customs duties, GST/VAT, and last-mile delivery. Final landed cost is locked-in (no surprise fees for you). DDP quotes valid for 14 days. We use Amazon FBA Prep partner for US-bound shipments, EU 3PL for EU-bound shipments. Add 15-20% to FOB price for DDP service.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SEOFaq faqs={faqs} title="Payment Terms FAQ" />

  <section class="py-16 bg-[#F5F0E7] border-y border-border/60">
    <div class="container-narrow text-center">
      <h2 class="font-display text-3xl font-light mb-4">Ready to ship cashmere worldwide?</h2>
      <p class="opacity-90 mb-8 max-w-2xl mx-auto">Request a DDP quote for US/EU or FOB/CIF terms for other destinations. Our logistics team responds within 24 hours with full landed cost breakdown.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={'/' + locale + '/contact'} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] rounded-none font-medium uppercase tracking-wider text-sm">Request a Shipping Quote</a>
        <a href={'/' + locale + '/payment-terms'} class="inline-block px-8 py-3 border border-brand-ink/30 rounded-none uppercase tracking-wider text-sm">View Payment Terms</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
