---
/**
 * 采购信任页 SEO：物流准备。所有路线、报价和文件要求应按目的地书面确认。
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

type Copy = { eyebrow: string; title: string; description: string; h1: string; intro: string; planningTitle: string; planning: { title: string; text: string }[]; faqTitle: string; faqs: { q: string; a: string }[]; ctaTitle: string; ctaText: string; cta: string };
const content: Record<string, Copy> = {
  en: { eyebrow: 'DELIVERY PREPARATION', title: 'Cashmere Shipping & Logistics Preparation | DONGXIAO®', description: 'Prepare a cashmere shipping brief covering destination, packing, documents, Incoterms and delivery timing before requesting a landed quote.', h1: 'Cashmere Shipping & Logistics Preparation', intro: 'Shipping mode, route availability, quoted Incoterms, customs responsibilities and delivery timing vary by destination, order and buyer requirements. Confirm the final logistics plan in the written quotation.', planningTitle: 'Three details for a useful shipping quote', planning: [{ title: '01 — Destination and delivery point', text: 'Provide the destination country, city or port, postal code where relevant, and whether the quote should cover a port or final delivery point.' }, { title: '02 — Order and packing profile', text: 'Include product type, estimated quantity, carton or pallet preferences, sample versus bulk status, and the required ready-date window.' }, { title: '03 — Documents and terms', text: 'State the documents your importer needs and the Incoterm you want discussed. Customs classification and responsibilities should be confirmed for the specific shipment.' }], faqTitle: 'Shipping-planning FAQ', faqs: [{ q: 'What should I include when requesting a shipping quote?', a: 'Include product type, quantity, destination, requested delivery point, ready-date window, packing requirements and any document or Incoterm preference.' }, { q: 'Can a buyer request sea, air or courier options?', a: 'Yes. State the preferred mode and timing requirements so available options can be evaluated for the individual route and order.' }, { q: 'When are customs and delivery responsibilities confirmed?', a: 'They should be confirmed in the written quotation or sales agreement for the exact destination and agreed delivery term.' }], ctaTitle: 'Prepare a destination-specific logistics brief', ctaText: 'Share your product link, target quantity, destination, delivery point and timing requirements with the inquiry.', cta: 'Discuss shipping preparation' },
  cn: { eyebrow: '出运准备', title: '羊绒物流与出运准备 | DONGXIAO®', description: '在申请落地物流报价前，准备目的地、包装、文件、贸易术语和交期需求。', h1: '羊绒物流与出运准备', intro: '运输方式、路线可行性、贸易术语、清关责任和交付时间会随目的地、订单和买方要求变化，最终物流方案应在书面报价中确认。', planningTitle: '获得有效物流报价的三项信息', planning: [{ title: '01 — 目的地与交付点', text: '提供目的国、城市或港口、必要时的邮编，以及报价是否覆盖到港或最终交付点。' }, { title: '02 — 订单与包装情况', text: '说明产品类型、预计数量、外箱或托盘偏好、样品或大货状态和预计备货时间。' }, { title: '03 — 文件与条款', text: '说明进口方需要的文件和希望讨论的贸易术语，报关归类和责任应按具体货运确认。' }], faqTitle: '物流准备常见问题', faqs: [{ q: '申请物流报价时应提供什么？', a: '请提供产品、数量、目的地、交付点、备货时间、包装要求和文件或贸易术语偏好。' }, { q: '可以指定海运、空运或快递吗？', a: '可以。请说明偏好运输方式和时效需求，以便按具体路线和订单评估。' }, { q: '何时确认清关和交付责任？', a: '应在对应目的地和约定交付条款的书面报价或销售协议中确认。' }], ctaTitle: '准备目的地物流需求', ctaText: '请在询盘中提供产品链接、目标数量、目的地、交付点和时效需求。', cta: '沟通物流准备' },
  de: { eyebrow: 'LIEFERVORBEREITUNG', title: 'Kaschmir Versand- und Logistikvorbereitung | DONGXIAO®', description: 'Bereiten Sie Zielort, Verpackung, Dokumente, Incoterms und Lieferfenster vor.', h1: 'Kaschmir Versand- und Logistikvorbereitung', intro: 'Route, Lieferbedingung und Zuständigkeiten werden je Sendung schriftlich bestätigt.', planningTitle: 'Drei Angaben für ein Angebot', planning: [{ title: '01 — Zielort', text: 'Land, Stadt oder Hafen und gewünschter Lieferpunkt.' }, { title: '02 — Auftrag und Verpackung', text: 'Produkt, Menge, Verpackung und Bereitstellungsfenster.' }, { title: '03 — Dokumente und Bedingungen', text: 'Importdokumente und gewünschte Incoterms benennen.' }], faqTitle: 'FAQ zur Versandplanung', faqs: [{ q: 'Was gehört in eine Transportanfrage?', a: 'Produkt, Menge, Zielort, Lieferpunkt, Zeitfenster und Dokumentanforderungen.' }, { q: 'Kann ich die Versandart nennen?', a: 'Ja, nennen Sie Modus und Timing zur Prüfung pro Route.' }, { q: 'Wann werden Zuständigkeiten bestätigt?', a: 'In schriftlichem Angebot oder Vertrag für die konkrete Sendung.' }], ctaTitle: 'Logistikbrief vorbereiten', ctaText: 'Senden Sie Produktlink, Menge, Zielort und Zeitfenster.', cta: 'Logistik besprechen' },
  fr: { eyebrow: 'PRÉPARATION LIVRAISON', title: 'Préparation logistique cachemire | DONGXIAO®', description: 'Préparez destination, emballage, documents, Incoterms et délai avant un devis.', h1: 'Préparation logistique cachemire', intro: 'Itinéraire, terme de livraison et responsabilités sont confirmés par écrit pour chaque expédition.', planningTitle: 'Trois éléments pour un devis', planning: [{ title: '01 — Destination', text: 'Pays, ville ou port et point de livraison souhaité.' }, { title: '02 — Commande et emballage', text: 'Produit, quantité, emballage et fenêtre de disponibilité.' }, { title: '03 — Documents et termes', text: 'Documents import et Incoterm souhaité.' }], faqTitle: 'FAQ préparation logistique', faqs: [{ q: 'Que fournir pour un devis transport ?', a: 'Produit, quantité, destination, point de livraison, délai et documents.' }, { q: 'Puis-je demander un mode de transport ?', a: 'Oui, indiquez mode et délai pour évaluation par route.' }, { q: 'Quand les responsabilités sont-elles confirmées ?', a: 'Dans le devis ou contrat écrit de l’expédition.' }], ctaTitle: 'Préparer votre brief logistique', ctaText: 'Envoyez lien produit, quantité, destination et délai.', cta: 'Discuter de la logistique' },
  ja: { eyebrow: '出荷準備', title: 'カシミヤ物流・出荷準備 | DONGXIAO®', description: '見積もり前に仕向地、梱包、書類、インコタームズ、納期を整理します。', h1: 'カシミヤ物流・出荷準備', intro: 'ルート、引渡条件、責任は出荷ごとに書面で確認します。', planningTitle: '見積もりに必要な3項目', planning: [{ title: '01 — 仕向地', text: '国、都市または港、希望引渡地点。' }, { title: '02 — 注文と梱包', text: '製品、数量、梱包、出荷可能期間。' }, { title: '03 — 書類と条件', text: '輸入書類と希望インコタームズ。' }], faqTitle: '出荷計画 FAQ', faqs: [{ q: '見積もりに必要な情報は？', a: '製品、数量、仕向地、引渡地点、時期、書類要件です。' }, { q: '輸送方法を指定できますか？', a: 'はい。方法と希望時期を記載してください。' }, { q: '責任はいつ確認しますか？', a: '具体的な出荷の書面見積もりまたは契約で確認します。' }], ctaTitle: '物流ブリーフを準備する', ctaText: '製品リンク、数量、仕向地、時期をお送りください。', cta: '物流を相談する' },
  kr: { eyebrow: '출하 준비', title: '캐시미어 물류 및 출하 준비 | DONGXIAO®', description: '견적 전 목적지, 포장, 서류, 인코텀즈, 납기를 준비하세요.', h1: '캐시미어 물류 및 출하 준비', intro: '경로, 인도 조건, 책임은 선적별로 서면 확인합니다.', planningTitle: '견적을 위한 세 가지 정보', planning: [{ title: '01 — 목적지', text: '국가, 도시 또는 항구와 희망 인도 지점.' }, { title: '02 — 주문 및 포장', text: '제품, 수량, 포장, 준비 가능 기간.' }, { title: '03 — 서류 및 조건', text: '수입 서류와 희망 인코텀즈.' }], faqTitle: '물류 계획 FAQ', faqs: [{ q: '운송 견적에 필요한 정보는?', a: '제품, 수량, 목적지, 인도 지점, 일정, 서류 요건입니다.' }, { q: '운송 방식을 지정할 수 있나요?', a: '네. 방식과 일정 요건을 알려 주세요.' }, { q: '책임은 언제 확정합니까?', a: '해당 선적의 서면 견적 또는 계약에서 확정합니다.' }], ctaTitle: '물류 브리프 준비', ctaText: '제품 링크, 수량, 목적지, 일정을 보내 주세요.', cta: '물류 상담하기' },
};
const copy = content[locale] || content.en;
const planningLinks = [{ href: `/${locale}/products/`, en: 'Product catalog', cn: '产品目录' }, { href: `/${locale}/quality-control/`, en: 'Quality-control planning', cn: '质控准备' }, { href: `/${locale}/payment-terms/`, en: 'Payment discussion', cn: '付款沟通' }, { href: `/${locale}/contact/`, en: 'Request a quote', cn: '发起询盘' }];
---

<BaseLayout locale={locale} pageKey="shipping-logistics" path="/shipping-logistics" title={copy.title} description={copy.description} keywords={['cashmere shipping logistics', 'cashmere export preparation', 'cashmere Incoterms', 'cashmere delivery quote']} schema="general">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/shipping-logistics`} />
  <section class="bg-[#F5F0E7] border-b border-border/60 py-20 md:py-28"><div class="container-narrow max-w-4xl"><span class="text-xs tracking-[0.4em] text-brand-camel uppercase">{copy.eyebrow}</span><h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{copy.h1}</h1><p class="text-lg md:text-xl max-w-3xl opacity-90">{copy.intro}</p></div></section>
  <section class="py-16 md:py-20 bg-background"><div class="container-narrow"><h2 class="font-display text-3xl font-light mb-10">{copy.planningTitle}</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-6">{copy.planning.map((item) => <article class="border border-border bg-white p-6"><h3 class="font-serif text-xl mb-3">{item.title}</h3><p class="text-sm text-muted-foreground leading-relaxed">{item.text}</p></article>)}</div></div></section>
  <section class="py-16 bg-secondary/20 border-y border-border/60"><div class="container-narrow"><div class="grid grid-cols-1 md:grid-cols-4 gap-4">{planningLinks.map((link) => <a href={link.href} class="border border-border bg-white p-5 text-sm font-medium hover:border-brand-camel transition-colors">{locale === 'cn' ? link.cn : link.en} →</a>)}</div></div></section>
  <SEOFaq faqs={copy.faqs} title={copy.faqTitle} />
  <section class="py-16 bg-[#F5F0E7] border-y border-border/60"><div class="container-narrow text-center"><h2 class="font-display text-3xl font-light mb-4">{copy.ctaTitle}</h2><p class="opacity-90 mb-8 max-w-2xl mx-auto">{copy.ctaText}</p><a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-[#F7F3EC] uppercase tracking-wider text-sm">{copy.cta}</a></div></section>
  <Footer slot="footer" locale={locale} /><FloatingChatButtons slot="footer" locale={locale} /><CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
