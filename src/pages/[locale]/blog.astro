---
/**
 * Blog 列表 - 从 src/content/blog/{locale}/*.md 读取
 * 由 scripts/generate-blog.mjs + GitHub Actions 每日自动生成
 * 内容策略：归档文章可供访客阅读；仅独立审阅文章进入 sitemap 与 ItemList 搜索入口。
 */
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';
import { getCollection } from 'astro:content';
import { getBlogSlugFromId, isIndexableBlogPost } from '@/lib/blog-indexability';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: { title: 'Cashmere Insights', subtitle: 'Industry guides and B2B sourcing tips' },
  cn: { title: '羊绒行业洞察', subtitle: '行业指南与 B2B 采购技巧' },
  de: { title: 'Kaschmir-Einblicke', subtitle: 'Branchenführer und B2B-Beschaffungstipps' },
  fr: { title: 'Aperçus cachemire', subtitle: 'Guides sectoriels et conseils B2B' },
  ja: { title: 'カシミアインサイト', subtitle: '業界ガイドと B2B 調達のヒント' },
  kr: { title: '캐시미어 인사이트', subtitle: '산업 가이드 및 B2B 소싱 팁' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const visibilityCopy = {
  en: { eyebrow: 'Blog archive', title: 'Articles remain available to readers', body: 'Search indexing is limited to articles reviewed for sources, visible content and sourcing relevance. Other archive articles remain accessible here and are not submitted as search-entry pages.' },
  cn: { eyebrow: '博客归档', title: '文章仍可供访客阅读', body: '搜索索引仅包含已完成引用、可见内容与采购相关性审阅的文章。其他归档文章仍在此保留访问，但不会作为搜索入口提交。' },
  de: { eyebrow: 'Blogarchiv', title: 'Artikel bleiben für Leser verfügbar', body: 'Für die Suche werden nur Artikel mit geprüften Quellen, sichtbaren Inhalten und Beschaffungsbezug verwendet. Weitere Archivartikel bleiben hier zugänglich, werden jedoch nicht als Sucheinstiege eingereicht.' },
  fr: { eyebrow: 'Archives du blog', title: 'Les articles restent accessibles aux lecteurs', body: 'L’indexation est limitée aux articles vérifiés pour leurs sources, leur contenu visible et leur utilité pour l’approvisionnement. Les autres archives restent accessibles ici sans être soumises comme pages d’entrée de recherche.' },
  ja: { eyebrow: 'ブログアーカイブ', title: '記事は引き続き閲覧できます', body: '検索インデックスには、出典・表示内容・調達上の関連性を確認した記事のみを掲載します。その他のアーカイブ記事もここで閲覧できますが、検索導線としては送信しません。' },
  kr: { eyebrow: '블로그 아카이브', title: '글은 계속 열람할 수 있습니다', body: '검색 색인에는 출처, 표시 내용 및 소싱 관련성을 검토한 글만 포함됩니다. 다른 아카이브 글도 이곳에서 계속 볼 수 있지만 검색 진입 페이지로 제출되지는 않습니다.' },
}[locale] || { eyebrow: 'Blog archive', title: 'Articles remain available to readers', body: 'Search indexing is limited to reviewed articles. Other archive articles remain accessible here.' };

// 从 Content Collections 读取该 locale 的全部博客（按发布日期倒序）。
// 可见性与搜索索引是两个独立维度：历史文章不应因 noindex 而从读者面前消失。
const allPosts = await getCollection('blog', ({ id }) => {
  return id.startsWith(`${locale}/`);
});
const posts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .map((p) => ({
    slug: getBlogSlugFromId(p.id),
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.publishDate.toISOString().slice(0, 10),
    tags: p.data.tags,
  }));
const indexablePosts = posts.filter((p) => isIndexableBlogPost(locale, p.slug));

// ItemList JSON-LD: 让 Google 把博客列表做成富结果
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: T('title'),
  description: T('subtitle'),
  numberOfItems: indexablePosts.length,
  itemListElement: indexablePosts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.erdosdx.com/${locale}/blog/${p.slug}/`,
    name: p.title,
  })),
};

// BreadcrumbList JSON-LD: 首页 > Blog
---

<BaseLayout locale={locale} pageKey="blog" path="/blog" noIndex={true} customSchemas={[itemListSchema]}>
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/blog`} />

  <section class="relative bg-brand-sandwarm border-b border-border/60 overflow-hidden">
    <div class="container-narrow py-24 md:py-32">
      <div class="flex items-center gap-3 mb-8">
        <span class="h-[2px] w-12 bg-brand-red"></span>
        <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{locale === 'cn' ? '博客' : 'Blog'}</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8 text-balance">{T('title')}</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-xl font-light">{T('subtitle')}</p>
    </div>
  </section>

  {false && locale === 'en' && (
    <section class="py-20 md:py-28 bg-brand-cream/40 border-y border-border" aria-labelledby="knowledge-hub">
      <div class="container-narrow">
        <div class="flex items-center gap-3 mb-6">
          <span class="h-[2px] w-12 bg-brand-red"></span>
          <span class="text-xs tracking-[0.4em] text-brand-gold uppercase font-medium">Knowledge Hub</span>
        </div>
        <h2 id="knowledge-hub" class="font-serif text-4xl md:text-5xl font-light leading-[1.1] mb-6 text-balance">
          Cashmere Buyer Knowledge Hub
        </h2>
        <div class="max-w-3xl space-y-4 text-base md:text-lg text-muted-foreground leading-relaxed mb-14">
          <p>
            This knowledge hub groups the English articles by the decisions a B2B buyer may need to prepare: material
            requirements, quality verification, commercial questions, and product-development context. Use the
            articles as discussion aids alongside your own specifications, test requirements and sourcing review.
          </p>
          <p>
            Product, price, compliance, delivery and contract conditions vary by project. Use the supporting articles
            to frame the right questions, then confirm the relevant scope in written correspondence for the product,
            quantity, destination and requirements under review.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Cluster 1: Sourcing & Origin -->
          <div class="bg-background border border-border p-8">
            <div class="flex items-baseline justify-between mb-4">
              <h3 class="font-serif text-2xl">Sourcing &amp; Origin</h3>
              <span class="text-xs font-mono text-muted-foreground">01</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
              Background reading for fiber terminology, origin questions and supplier-verification preparation.
            </p>
            <ul class="space-y-3 text-sm">
              <li>
                <a href="/en/cashmere-grades/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Cashmere Grades A vs B vs C — pillar reference
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/alashan-vs-ordos-cashmere-goats/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Alashan vs Ordos vs Mongolian goats compared
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/from-pasture-to-garment-23-steps-ordos-cashmere/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    From pasture to garment: 23 production steps
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/where-to-buy-bulk-raw-mongolian-cashmere/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Where to buy bulk raw Mongolian cashmere
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/ordos-cashmere-fiber-supplier-verification-guide/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Ordos cashmere fiber supplier verification guide
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Cluster 2: Quality & Materials -->
          <div class="bg-background border border-border p-8">
            <div class="flex items-baseline justify-between mb-4">
              <h3 class="font-serif text-2xl">Quality &amp; Materials</h3>
              <span class="text-xs font-mono text-muted-foreground">02</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
              Background reading for yarn construction, spinning terminology, specifications and test-report preparation.
            </p>
            <ul class="space-y-3 text-sm">
              <li>
                <a href="/en/blog/how-to-identify-premium-cashmere/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    How to identify premium cashmere in 10 minutes
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/cashmere-yarn-counts-2-26-to-2-60-nm/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Yarn counts 2/26 to 2/60 Nm explained
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/dehaired-cashmere-tops-wholesale-guide/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Dehaired cashmere tops wholesale guide
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/worsted-vs-woolen-cashmere-yarn-guide/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Worsted vs woolen cashmere yarn guide
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/oeko-tex-certified-cashmere-clothing-guide/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    OEKO-TEX certified cashmere clothing guide
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/cashmere-test-report-checklist-b2b-buyers/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Cashmere test-report checklist for B2B buyers
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Cluster 3: Pricing, Contracts & Logistics -->
          <div class="bg-background border border-border p-8">
            <div class="flex items-baseline justify-between mb-4">
              <h3 class="font-serif text-2xl">Pricing, Contracts &amp; Logistics</h3>
              <span class="text-xs font-mono text-muted-foreground">03</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
              Background reading for commercial questions, freight planning and documentation discussions.
            </p>
            <ul class="space-y-3 text-sm">
              <li>
                <a href="/en/blog/cashmere-market-report-2026/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    2026 cashmere market outlook &amp; price drivers
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/cashmere-cost-breakdown-wholesale/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Why cashmere costs USD 8–50 per piece (cost breakdown)
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/cashmere-shipping-import-guide/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Cashmere shipping &amp; import playbook
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/wholesale-cashmere-sweater-pricing-b2b-2026/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Wholesale cashmere sweater pricing for B2B 2026
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/cashmere-b2b-contract-template-payment-terms/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    B2B contract template &amp; payment terms
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Cluster 4: Product Development & Care -->
          <div class="bg-background border border-border p-8">
            <div class="flex items-baseline justify-between mb-4">
              <h3 class="font-serif text-2xl">Product Development &amp; Care</h3>
              <span class="text-xs font-mono text-muted-foreground">04</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
              Background reading for private-label briefs, product development questions and care guidance.
            </p>
            <ul class="space-y-3 text-sm">
              <li>
                <a href="/en/blog/how-to-wash-care-for-cashmere/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    How to wash, dry, and store cashmere at home
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/private-label-cashmere-sweater-ordos-factory/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Private-label cashmere sweater from our Ordos factory
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/direct-cashmere-mill-no-middleman/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Going direct to a cashmere mill, no middleman
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/wholesale-cashmere-shawl-custom-logo/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Wholesale cashmere shawls with custom logo
                  </span>
                </a>
              </li>
              <li>
                <a href="/en/blog/small-moq-cashmere-coat-manufacturer/" class="group flex items-start gap-3 hover:text-brand-chocolate">
                  <span class="text-brand-gold mt-0.5">◆</span>
                  <span class="border-b border-transparent group-hover:border-brand-gold pb-0.5">
                    Small-MOQ cashmere coat manufacturer
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {indexablePosts.length > 0 && (
    <section class="py-16 md:py-20 bg-brand-cream/40 border-y border-border" aria-labelledby="verified-knowledge">
      <div class="container-narrow max-w-3xl">
        <span class="text-xs tracking-[0.32em] text-brand-camel uppercase font-medium">{visibilityCopy.eyebrow}</span>
        <h2 id="verified-knowledge" class="font-serif text-3xl md:text-4xl font-light leading-tight mt-3 mb-4">
          {visibilityCopy.title}
        </h2>
        <p class="text-base text-muted-foreground leading-relaxed">
          {visibilityCopy.body}
        </p>
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <section class="py-16 md:py-20 bg-brand-cream/40 border-y border-border">
      <div class="container-narrow max-w-3xl text-muted-foreground leading-relaxed">
        {locale === 'cn'
          ? '我们正在逐篇审阅历史文章的引用、适用范围与采购断言。审核完成前，请通过询盘确认具体产品、文件和项目条件。'
          : 'We are reviewing historical articles for sources, applicability and sourcing claims. Please confirm product, documentation and project conditions through an inquiry while this review is in progress.'}
      </div>
    </section>
  )}

  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      {/* Featured — 最新 1 篇用大图, 其余走 3-col compact 列表 (突出新内容, 提升 CTR) */}
      {posts.length > 0 && posts[0] && (
        <a href={`/${locale}/blog/${posts[0].slug}/`} class="group block mb-12 border border-border bg-white hover:border-brand-gold hover:shadow-2xl transition-colors transition-shadow duration-300 overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-5">
            <div class="md:col-span-2 aspect-[16/10] md:aspect-auto bg-gradient-to-br from-brand-cream via-brand-shell to-brand-sandhi flex items-center justify-center">
              <div class="text-center px-6">
                <div class="text-xs font-mono text-muted-foreground tracking-widest uppercase mb-3">{posts[0].date}</div>
                <div class="text-xs tracking-[0.4em] text-brand-red uppercase font-medium">
                  {locale === 'cn' ? '精选 / 最新' : 'Featured'}
                </div>
              </div>
            </div>
            <div class="md:col-span-3 p-8 md:p-12 flex flex-col justify-center">
              <h3 class="font-serif text-3xl md:text-4xl mb-4 group-hover:text-brand-chocolate transition-colors leading-tight text-balance">{posts[0].title}</h3>
              <p class="text-muted-foreground leading-relaxed mb-6 text-base md:text-lg line-clamp-3">{posts[0].excerpt}</p>
              <span class="inline-flex items-center gap-2 text-sm text-brand-chocolate font-medium border-b border-brand-chocolate pb-0.5 group-hover:border-brand-gold group-hover:text-brand-gold transition-colors w-fit">
                {locale === 'cn' ? '阅读精选文章' : 'Read featured article'}
                <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </div>
        </a>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.slice(1).map((p) => (
          <a href={`/${locale}/blog/${p.slug}/`} class="group block border border-border p-8 hover:border-brand-gold hover:shadow-lg transition-colors transition-shadow duration-300">
            <div class="text-xs text-muted-foreground tracking-wider mb-3 font-mono">{p.date}</div>
            <h3 class="font-serif text-2xl mb-3 group-hover:text-brand-chocolate transition-colors leading-tight">{p.title}</h3>
            <p class="text-muted-foreground leading-relaxed mb-6 text-sm">{p.excerpt}</p>
            <span class="inline-flex items-center gap-2 text-sm text-brand-chocolate font-medium border-b border-brand-chocolate pb-0.5 group-hover:border-brand-gold group-hover:text-brand-gold transition-colors">
              {locale === 'cn' ? '阅读全文' : 'Read more'}
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
