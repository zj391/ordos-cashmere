---
/**
 * 采购信任页 SEO：付款沟通。实际币种、方式、账期和费用以书面报价为准。
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) { return new Response('Not Found', { status: 404 }); }
const locale = pickLocale(rawLocale);

type Copy = { eyebrow: string; title: string; description: string; h1: string; intro: string; stepsTitle: string; steps: { title: string; text: string }[]; faqTitle: string; faqs: { q: string; a: string }[]; ctaTitle: string; ctaText: string; cta: string };
const content: Record<string, Copy> = {
  en: { eyebrow: 'COMMERCIAL PREPARATION', title: 'B2B Cashmere Payment Discussion | DONGXIAO®', description: 'Prepare a clear payment discussion for a cashmere quotation: buyer entity, order value, destination, documentary requirements and preferred commercial terms.', h1: 'B2B Cashmere Payment Discussion', intro: 'Payment method, currency, schedule, fees and documentary requirements are agreed in the written quotation or sales agreement for the individual transaction. This page helps buyers prepare the commercial information needed for that discussion.', stepsTitle: 'Prepare the commercial brief', steps: [{ title: '01 — Identify the buying entity', text: 'Provide the legal buyer name, billing country and the contact responsible for commercial documentation.' }, { title: '02 — Define the order context', text: 'Share the product link, quantity, estimated order value, destination and intended shipment window.' }, { title: '03 — State documentary needs', text: 'List the proforma invoice, shipping, banking or import documents your team requires so terms can be reviewed for the transaction.' }], faqTitle: 'Payment-discussion FAQ', faqs: [{ q: 'When are payment terms confirmed?', a: 'They are confirmed in the written quotation or sales agreement after the order, buyer and destination details have been reviewed.' }, { q: 'Can a buyer request a particular payment or documentary method?', a: 'Yes. Include the preferred method and documentary requirements in the inquiry so feasibility can be confirmed in writing.' }, { q: 'What should be reviewed before paying a deposit?', a: 'Review the product specification, quotation, buyer and seller details, delivery term, payment schedule and document requirements before proceeding.' }], ctaTitle: 'Start a documented commercial discussion', ctaText: 'Send your product selection, quantity, buying entity, destination and requested commercial or document requirements.', cta: 'Request a commercial quotation' },
  cn: { eyebrow: '商务准备', title: '羊绒 B2B 付款沟通 | DONGXIAO®', description: '在申请羊绒报价前，准备买方主体、订单金额、目的地、文件要求和期望商务条款。', h1: '羊绒 B2B 付款沟通', intro: '付款方式、币种、付款节点、费用和单据要求应按具体交易在书面报价或销售协议中确认。本页帮助采购方准备沟通所需的商务信息。', stepsTitle: '准备商务需求', steps: [{ title: '01 — 明确采购主体', text: '提供买方公司法定名称、开票国家和负责商务文件的联系人。' }, { title: '02 — 说明订单背景', text: '提供产品链接、数量、预计订单金额、目的地和计划出运窗口。' }, { title: '03 — 列明文件要求', text: '说明团队需要的形式发票、运输、银行或进口文件，以便针对交易评估条款。' }], faqTitle: '付款沟通常见问题', faqs: [{ q: '何时确认付款条款？', a: '在审核订单、买方和目的地信息后，于书面报价或销售协议中确认。' }, { q: '买方可以提出付款或单据方式吗？', a: '可以。请在询盘中说明偏好方式与单据要求，以便书面确认可行性。' }, { q: '支付定金前应核对什么？', a: '应核对产品规格、报价、买卖方信息、交付条款、付款节点和文件要求。' }], ctaTitle: '开始书面商务沟通', ctaText: '请提供产品选择、数量、采购主体、目的地和希望讨论的商务或单据要求。', cta: '申请商务报价' },
  de: { eyebrow: 'KAUFMÄNNISCHE VORBEREITUNG', title: 'B2B Kaschmir Zahlungsabstimmung | DONGXIAO®', description: 'Bereiten Sie Käufer, Auftragswert, Zielort und Dokumentanforderungen für ein Angebot vor.', h1: 'B2B Kaschmir Zahlungsabstimmung', intro: 'Zahlungsart, Währung, Zeitplan und Dokumente werden pro Transaktion schriftlich vereinbart.', stepsTitle: 'Kaufmännischen Brief vorbereiten', steps: [{ title: '01 — Käufer benennen', text: 'Rechtlicher Firmenname, Rechnungsland und Ansprechpartner.' }, { title: '02 — Auftrag beschreiben', text: 'Produkt, Menge, Wert, Zielort und Lieferfenster.' }, { title: '03 — Dokumente nennen', text: 'Benötigte Proforma-, Versand-, Bank- oder Importdokumente.' }], faqTitle: 'FAQ zur Zahlungsabstimmung', faqs: [{ q: 'Wann werden Zahlungsbedingungen bestätigt?', a: 'Im schriftlichen Angebot oder Vertrag nach Prüfung der Transaktion.' }, { q: 'Kann ein Käufer eine Methode anfragen?', a: 'Ja, nennen Sie sie in der Anfrage zur schriftlichen Prüfung.' }, { q: 'Was ist vor einer Anzahlung zu prüfen?', a: 'Spezifikation, Angebot, Parteien, Lieferbedingung, Zahlungsplan und Dokumente.' }], ctaTitle: 'Kaufmännische Abstimmung starten', ctaText: 'Senden Sie Produktauswahl, Menge, Käufer und Zielort.', cta: 'Angebot anfragen' },
  fr: { eyebrow: 'PRÉPARATION COMMERCIALE', title: 'Discussion paiement cachemire B2B | DONGXIAO®', description: 'Préparez acheteur, valeur, destination et documents requis avant un devis.', h1: 'Discussion paiement cachemire B2B', intro: 'Mode, devise, calendrier et documents sont convenus par écrit pour chaque transaction.', stepsTitle: 'Préparer le brief commercial', steps: [{ title: '01 — Identifier l’acheteur', text: 'Raison sociale, pays de facturation et contact.' }, { title: '02 — Définir la commande', text: 'Produit, quantité, valeur, destination et période d’expédition.' }, { title: '03 — Indiquer les documents', text: 'Documents proforma, transport, banque ou import requis.' }], faqTitle: 'FAQ discussion paiement', faqs: [{ q: 'Quand les termes sont-ils confirmés ?', a: 'Dans le devis ou contrat écrit après revue de la transaction.' }, { q: 'Un acheteur peut-il demander une méthode ?', a: 'Oui, indiquez-la dans la demande pour évaluation écrite.' }, { q: 'Que vérifier avant un acompte ?', a: 'Spécification, devis, parties, livraison, calendrier et documents.' }], ctaTitle: 'Lancer la discussion commerciale', ctaText: 'Envoyez sélection produit, quantité, acheteur et destination.', cta: 'Demander un devis' },
  ja: { eyebrow: '商務準備', title: 'カシミヤ B2B 支払相談 | DONGXIAO®', description: '見積もり前に買主、注文額、仕向地、必要書類を整理します。', h1: 'カシミヤ B2B 支払相談', intro: '支払方法、通貨、スケジュール、書類は取引ごとに書面で合意します。', stepsTitle: '商務ブリーフを準備する', steps: [{ title: '01 — 買主を確認', text: '法人名、請求国、担当者。' }, { title: '02 — 注文を定義', text: '製品、数量、金額、仕向地、出荷時期。' }, { title: '03 — 書類を示す', text: 'プロフォーマ、輸送、銀行、輸入書類。' }], faqTitle: '支払相談 FAQ', faqs: [{ q: '条件はいつ確認しますか？', a: '取引確認後、書面見積もりまたは契約で確認します。' }, { q: '希望する方式を伝えられますか？', a: 'はい。問い合わせに記載し書面で確認します。' }, { q: '前払前に何を確認しますか？', a: '仕様、見積もり、当事者、引渡条件、支払計画、書類です。' }], ctaTitle: '商務相談を開始する', ctaText: '製品、数量、買主、仕向地をお送りください。', cta: '見積もりを依頼する' },
  kr: { eyebrow: '상업 준비', title: '캐시미어 B2B 결제 상담 | DONGXIAO®', description: '견적 전 구매자, 주문 금액, 목적지, 서류 요건을 준비하세요.', h1: '캐시미어 B2B 결제 상담', intro: '결제 방식, 통화, 일정, 서류는 거래별로 서면 합의합니다.', stepsTitle: '상업 브리프 준비', steps: [{ title: '01 — 구매자 확인', text: '법인명, 청구 국가, 담당자.' }, { title: '02 — 주문 정의', text: '제품, 수량, 금액, 목적지, 출하 시기.' }, { title: '03 — 서류 명시', text: '프로포마, 운송, 은행, 수입 서류.' }], faqTitle: '결제 상담 FAQ', faqs: [{ q: '조건은 언제 확정합니까?', a: '거래 검토 후 서면 견적 또는 계약에서 확정합니다.' }, { q: '선호 방식을 요청할 수 있습니까?', a: '네. 문의에 기재해 서면 검토를 받으세요.' }, { q: '선금 전 무엇을 확인합니까?', a: '사양, 견적, 당사자, 인도 조건, 결제 일정, 서류입니다.' }], ctaTitle: '상업 상담 시작', ctaText: '제품, 수량, 구매자, 목적지를 보내 주세요.', cta: '견적 요청하기' },
};
const copy = content[locale] || content.en;
const commercialLinks = [{ href: `/${locale}/products/`, en: 'Select products', cn: '选择产品' }, { href: `/${locale}/quality-control/`, en: 'Plan verification', cn: '准备核验' }, { href: `/${locale}/shipping-logistics/`, en: 'Plan delivery', cn: '准备物流' }, { href: `/${locale}/download/`, en: 'Request procurement documents', cn: '申请采购资料' }];
---

<BaseLayout locale={locale} pageKey="payment-terms" path="/payment-terms" title={copy.title} description={copy.description} keywords={['cashmere payment discussion', 'B2B cashmere quotation', 'cashmere commercial documents', 'cashmere purchase agreement']} schema="general">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/payment-terms`} />
  <section class="bg-brand-sandwarm border-b border-border/60 py-20 md:py-28"><div class="container-narrow max-w-4xl"><span class="text-xs tracking-[0.4em] text-brand-camel uppercase">{copy.eyebrow}</span><h1 class="font-display text-4xl md:text-5xl font-light mt-4 mb-6">{copy.h1}</h1><p class="text-lg md:text-xl max-w-3xl opacity-90">{copy.intro}</p></div></section>
  <section class="py-16 md:py-20 bg-background"><div class="container-narrow"><h2 class="font-display text-3xl font-light mb-10">{copy.stepsTitle}</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-6">{copy.steps.map((item) => <article class="border border-border bg-white p-6"><h3 class="font-serif text-xl mb-3">{item.title}</h3><p class="text-sm text-muted-foreground leading-relaxed">{item.text}</p></article>)}</div></div></section>
  <section class="py-16 bg-secondary/20 border-y border-border/60"><div class="container-narrow"><div class="grid grid-cols-1 md:grid-cols-4 gap-4">{commercialLinks.map((link) => <a href={link.href} class="border border-border bg-white p-5 text-sm font-medium hover:border-brand-camel transition-colors">{locale === 'cn' ? link.cn : link.en} →</a>)}</div></div></section>
  <SEOFaq faqs={copy.faqs} title={copy.faqTitle} />
  <section class="py-16 bg-brand-sandwarm border-y border-border/60"><div class="container-narrow text-center"><h2 class="font-display text-3xl font-light mb-4">{copy.ctaTitle}</h2><p class="opacity-90 mb-8 max-w-2xl mx-auto">{copy.ctaText}</p><a href={`/${locale}/contact/`} class="inline-block px-8 py-3 bg-brand-ink text-brand-cream uppercase tracking-wider text-sm">{copy.cta}</a></div></section>
  <Footer slot="footer" locale={locale} /><FloatingChatButtons slot="footer" locale={locale} /><CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
