---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { LOCALES, type Locale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const titleMap: Record<string, string> = {
  en: 'Frequently Asked Questions',
  de: 'Häufig gestellte Fragen',
  fr: 'Questions fréquentes',
  ja: 'よくある質問',
  kr: '자주 묻는 질문',
  cn: '常见问题',
};
const subMap: Record<string, string> = {
  en: 'Common questions about cashmere sourcing and listed product information',
  de: 'Häufige Fragen zur Kaschmir-Beschaffung und zu aufgeführten Produktinformationen',
  fr: 'Questions courantes sur l’approvisionnement en cachemire et les informations produit listées',
  ja: 'カシミア調達と記載製品情報に関するよくある質問',
  kr: '캐시미어 소싱 및 기재 제품 정보에 관한 자주 묻는 질문',
  cn: '关于羊绒采购与已列产品信息的常见问题',
};
const title = titleMap[locale] || 'FAQ';
const subtitle = subMap[locale] || '';

const legacyFaq: Array<{ q: string; a: string }> = (() => {
  const map: Record<string, Array<{ q: string; a: string }>> = {
    en: [
      { q: 'What is the MOQ for cashmere products?', a: 'Raw cashmere fiber: 100 kg per grade per color. Cashmere yarn: 50-200 kg per count per color. Cashmere fabric: 200 m+ per design. Garment OEM: 100 pieces per style per color. Hat / accessory OEM: 30-200 pieces depending on item.' },
      { q: 'What is the production lead time?', a: 'Raw fiber 15-25 days, yarn 20-30 days, fabric 30-45 days, garment OEM 45-60 days including sampling. Air freight adds 5-7 days door-to-door; sea freight 25-35 days.' },
      { q: 'Do you provide samples?', a: 'Yes. Free 100 g color card samples ship in 5 days. Paid custom samples USD 30-180 per piece, refundable against bulk orders of 200+ pcs (garments) or 50 kg+ (yarn).' },
      { q: 'What are your payment terms?', a: 'T/T 30% deposit + 70% balance before shipment for orders under USD 50,000. L/C at sight for orders above USD 50,000. Western Union and PayPal accepted for samples under USD 1,000.' },
