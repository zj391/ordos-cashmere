    { q: 'Wann werden MOQ, Preis, Muster und Lieferzeit bestätigt?', a: 'Diese Bedingungen werden nach Prüfung von Produkt, Menge, Zielort und Anforderungen schriftlich im Angebot oder Vertrag bestätigt.' },
    { q: 'Wie werden Qualitäts-, Compliance- und Herkunftsanforderungen behandelt?', a: 'Benennen Sie Prüfverfahren, Abnahmeanforderungen und benötigte Unterlagen; der anwendbare Umfang wird schriftlich abgestimmt.' },
    { q: 'Wie werden Lieferung und Handelsbedingungen behandelt?', a: 'Nennen Sie Zielort und Geschäftskontext. Lieferung, Logistik, Zahlung und Dokumente werden je Projekt schriftlich bestätigt.' },
  ],
  fr: [
    { q: 'Que doit contenir une demande d’approvisionnement en cachemire ?', a: 'Indiquez référence produit, usage, spécifications, quantité, destination, objectif d’échantillon, méthode d’inspection et documents requis.' },
    { q: 'Quand le MOQ, le prix, l’échantillonnage et le délai sont-ils confirmés ?', a: 'Ces conditions sont confirmées par écrit dans la correspondance, le devis ou l’accord de vente après examen du projet.' },
    { q: 'Comment traiter les exigences de qualité, conformité et origine ?', a: 'Précisez méthode de vérification, exigences d’acceptation et documents requis; le périmètre applicable est discuté et documenté par écrit.' },
    { q: 'Comment traiter livraison et conditions commerciales ?', a: 'Indiquez destination et contexte commercial. Livraison, logistique, paiement et documents sont confirmés par écrit selon le projet.' },
  ],
  ja: [
    { q: 'カシミア調達の問い合わせには何を含めるべきですか？', a: '製品参考、用途、目標仕様、数量、仕向地、サンプル用途、検品方法、必要書類を記載してください。' },
    { q: 'MOQ、価格、サンプル、納期はいつ確認されますか？', a: '製品、数量、仕向地、要件を確認後、書面の連絡、見積書または売買契約で確認します。' },
    { q: '品質、コンプライアンス、原産地の要件はどのように扱いますか？', a: '検証方法、受入要件、必要書類を示してください。適用範囲を案件ごとに書面で確認します。' },
    { q: '納品と商務条件はどのように扱いますか？', a: '仕向地と商務背景を問い合わせに記載してください。納品、物流、支払い、書類要件を案件ごとに書面で確認します。' },
  ],
  kr: [
    { q: '캐시미어 소싱 문의에는 어떤 정보가 필요한가요?', a: '제품 참고, 용도, 목표 사양, 수량, 목적지, 샘플 목적, 검사 방식과 필요 서류를 기재해 주세요.' },
    { q: 'MOQ, 가격, 샘플 및 납기는 언제 확인되나요?', a: '제품, 수량, 목적지와 요구사항을 검토한 뒤 서면 연락, 견적서 또는 계약서에서 확인됩니다.' },
    { q: '품질, 규정 준수 및 원산지 요건은 어떻게 처리하나요?', a: '검증 방법, 인수 요건과 필요 서류를 알려 주세요. 적용 범위는 프로젝트별로 서면 확인합니다.' },
    { q: '납품과 상업 조건은 어떻게 처리하나요?', a: '문의에 목적지와 상업 맥락을 기재해 주세요. 납품, 물류, 결제와 서류 요건은 프로젝트별로 서면 확인합니다.' },
  ],
};
const faq = faqByLocale[locale] || faqByLocale.en;

const ctaMap: Record<string, string> = {
  en: 'Browse all answers or get in touch with our sales team',
  de: 'Alle Antworten durchsehen oder unser Verkaufsteam kontaktieren',
  fr: 'Parcourez toutes les réponses ou contactez notre équipe commerciale',
  ja: 'すべての回答を見るか、営業チームにお問い合わせください',
  kr: '모든 답변을 보거나 영업팀에 문의하세요',
  cn: '查看全部问答或联系我们的销售团队',
};
const ctaLabelMap: Record<string, string> = {
  en: 'View all FAQ categories',
  de: 'Alle FAQ-Kategorien ansehen',
  fr: 'Voir toutes les catégories FAQ',
  ja: 'FAQカテゴリを見る',
  kr: '전체 FAQ 카테고리 보기',
  cn: '查看全部分类',
};
const ctaHref = `/${locale}/contact/`;
---

<BaseLayout locale={locale} pageKey="faq" path="/faq" schema="faq" faqs={faq}>
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/faq`} />

  <section class="relative bg-brand-sandwarm border-b border-border/60 overflow-hidden">
    <div class="container-narrow py-24 md:py-32">
      <div class="flex items-center gap-3 mb-8">
        <span class="h-[2px] w-12 bg-brand-red"></span>
        <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">FAQ</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8 text-balance">{title}</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-xl font-light">{subtitle}</p>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow max-w-3xl">
      <div class="space-y-4">
        {faq.map((item, i) => (
          <details class="group border border-border rounded-lg p-6 cursor-pointer hover:border-brand-gold transition-colors">
            <summary class="flex justify-between items-center font-medium text-lg list-none">
              <span class="flex items-baseline gap-3">
                <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
                <span>{item.q}</span>
              </span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-muted-foreground leading-relaxed pl-8">{item.a}</p>
          </details>
        ))}
      </div>

      <div class="mt-16 pt-12 border-t border-border text-center">
        <p class="text-muted-foreground mb-4">{ctaMap[locale] || ctaMap.en}</p>
        <a href={ctaHref} class="inline-flex items-center gap-2 text-brand-chocolate border-b border-brand-chocolate hover:border-brand-gold hover:text-brand-gold transition-colors font-medium">
          {ctaLabelMap[locale] || ctaLabelMap.en} →
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
