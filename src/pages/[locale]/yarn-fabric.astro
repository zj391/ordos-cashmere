---
/**
 * Yarn & Fabric 产品页
 */
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import B2BServices from '@/components/B2BServices.astro';
import YarnFabricInquiryForm from '@/components/islands/YarnFabricInquiryForm.tsx';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: {
    tagline: '02 / YARN & FABRIC',
    title: 'Cashmere Yarn\n& Woven Fabric',
    subtitle: 'Discuss yarn and fabric construction, color direction, quantity, destination and required documentation for a written sourcing review.',
    yarnTitle: 'Cashmere Yarn',
    yarnSub: 'Use the inquiry to outline the yarn construction, composition target, color direction and application requirements for your project.',
    fabricTitle: 'Cashmere Woven Fabric',
    fabricSub: 'Use the inquiry to outline fabric construction, weight direction, finish, intended use and required documents for your project.',
    greigeTitle: 'Greige / Undyed\nCashmere Yarn',
    greigeKick: 'For brands that dye in-house',
    greigeSub: 'Describe the intended dyeing or knitting application, color direction, yarn form, quantity, destination and document requirements for a written review.',
    greigeCt1: 'Fiber state',
    greigeCv1: '100% raw, dehaired',
    greigeCt2: 'Color',
    greigeCv2: 'White / Brown / Purple',
    greigeCt3: 'Bleach',
    greigeCv3: 'None',
    greigeCt4: 'Yarn forms',
    greigeCv4: 'Cone · Hank · Cake',
    greigeCt5: 'Project terms',
    greigeCv5: 'Written',
    greigeCt6: 'Sample route',
    greigeCv6: 'Discuss',
    greigeUnit: 'confirmation',
    greigeUnit2: '',
    greigeTag: 'GREIGE',
    greigeFormTitle: 'Request greige yarn sample',
    greigeFormSub: 'Include intended use, yarn form, quantity, destination and document requirements for a written sample discussion.',
    greigeFaqQ: 'What is greige cashmere yarn?',
    greigeFaqA: 'Greige (undyed) cashmere yarn is cashmere yarn in its natural fiber color — white, brown, or purple — without any bleaching or dyeing. Knitting brands that dye in-house order greige yarn to control the final color and chemistry of their finished garments.',
    inquiryTitle: 'Request a quotation',
    inquirySub: 'Tell us the construction, quantity, destination and required documents so project terms can be reviewed in writing.',
  },
  cn: {
    tagline: '02 / 纱线 / 面料',
    title: '羊绒纱线\n与羊绒面料',
    subtitle: '围绕纱线和面料结构、颜色方向、数量、目的地与文件需求发起书面采购沟通。',
    yarnTitle: '羊绒纱线',
    yarnSub: '请说明纱线结构、目标成分、颜色方向与使用需求，以便按项目沟通。',
    fabricTitle: '羊绒面料',
    fabricSub: '请说明面料结构、克重方向、后整理、用途和文件需求，以便按项目沟通。',
    inquiryTitle: '立即询盘',
    inquirySub: '请提供结构、数量、目的地和文件需求，以书面方式审核项目条件。',
  },
  de: { tagline: '02 / GARN & STOFF', title: 'Kaschmirgarn\n& Webstoff', subtitle: 'Konstruktion, Farbe, Menge, Zielort und Dokumente schriftlich abstimmen.', yarnTitle: 'Kaschmirgarn', yarnSub: 'Garnkonstruktion, Zusammensetzung und Anwendung im Brief angeben.', fabricTitle: 'Kaschmir-Webstoff', fabricSub: 'Konstruktion, Gewicht, Ausrüstung und Anwendung im Brief angeben.', inquiryTitle: 'Angebot anfordern', inquirySub: 'Projektbedingungen werden schriftlich geprüft.' },
  fr: { tagline: '02 / FIL & TISSU', title: 'Fil & tissu\ncachemire', subtitle: 'Confirmez construction, couleur, quantité, destination et documents par écrit.', yarnTitle: 'Fil cachemire', yarnSub: 'Indiquez construction, composition et application dans le brief.', fabricTitle: 'Tissu cachemire', fabricSub: 'Indiquez construction, poids, finition et application dans le brief.', inquiryTitle: 'Demander un devis', inquirySub: 'Les conditions sont examinées par écrit.' },
  ja: { tagline: '02 / 糸・生地', title: 'カシミア糸\n& 織物', subtitle: '構造、色、数量、仕向地、書類要件を文書で共有します。', yarnTitle: 'カシミア糸', yarnSub: '糸構造、組成、用途をブリーフに記載します。', fabricTitle: 'カシミア織物', fabricSub: '構造、重量、仕上げ、用途をブリーフに記載します。', inquiryTitle: '見積もり依頼', inquirySub: '案件条件を文書で確認します。' },
  kr: { tagline: '02 / 원사·직물', title: '캐시미어 원사\n& 직물', subtitle: '구조, 색상, 수량, 목적지, 서류 요건을 서면으로 공유하세요.', yarnTitle: '캐시미어 원사', yarnSub: '원사 구조, 구성, 용도를 브리프에 기재합니다.', fabricTitle: '캐시미어 직물', fabricSub: '구조, 중량, 마감, 용도를 브리프에 기재합니다.', inquiryTitle: '견적 요청', inquirySub: '프로젝트 조건을 서면으로 검토합니다.' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const yarnSpecs = [
  { label: locale === 'cn' ? '支数' : 'Counts', value: '26/2 · 28/2', unit: '' },
  { label: locale === 'cn' ? '细支' : 'Fine', value: '36/2 · 48/2', unit: '' },
  { label: locale === 'cn' ? '成分' : 'Composition', value: locale === 'cn' ? '100%山羊绒' : '100% Cashmere', unit: '' },
  { label: locale === 'cn' ? '混纺' : 'Blends', value: locale === 'cn' ? '羊毛/真丝' : 'Wool / Silk', unit: '' },
  { label: locale === 'cn' ? '项目条件' : 'Project Terms', value: locale === 'cn' ? '书面' : 'Written', unit: locale === 'cn' ? '确认' : 'confirmation' },
  { label: locale === 'cn' ? '文件需求' : 'Document Needs', value: locale === 'cn' ? '沟通' : 'Discuss', unit: '' },
];

const fabricSpecs = [
  { label: locale === 'cn' ? '克重' : 'Weight', value: '180-450', unit: 'g/m²' },
  { label: locale === 'cn' ? '幅宽' : 'Width', value: '150', unit: 'cm' },
  { label: locale === 'cn' ? '成分' : 'Composition', value: locale === 'cn' ? '100%山羊绒' : '100% Cashmere', unit: '' },
  { label: locale === 'cn' ? '织法' : 'Weave', value: locale === 'cn' ? '平/斜/缎' : 'Plain/Twill/Satin', unit: '' },
  { label: locale === 'cn' ? '项目条件' : 'Project Terms', value: locale === 'cn' ? '书面' : 'Written', unit: locale === 'cn' ? '确认' : 'confirmation' },
  { label: locale === 'cn' ? '文件需求' : 'Document Needs', value: locale === 'cn' ? '沟通' : 'Discuss', unit: '' },
];

const IMG = {
  hero: '/images/cashmere-fiber.webp',
  knit: '/images/knit-shawl.webp',
};
---

<BaseLayout locale={locale} pageKey="yarnFabric" path="/yarn-fabric">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/yarn-fabric`} />

  <section class="relative bg-[#F5F0E7] border-b border-border/60 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[70vh]">
      <div class="flex items-center py-20 lg:py-0 px-6 lg:pl-12 order-2 lg:order-1">
        <div class="max-w-xl">
          <div class="flex items-center gap-3 mb-8">
            <span class="h-[2px] w-12 bg-brand-red"></span>
            <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{T('tagline')}</span>
          </div>
          <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8" set:html={T('title').replace(/\n/g, '<br/>')} />
          <p class="text-lg text-muted-foreground leading-relaxed max-w-md font-light">{T('subtitle')}</p>
        </div>
      </div>
      <div class="relative aspect-[4/3] lg:aspect-auto overflow-hidden order-1 lg:order-2">
        <img src={IMG.hero} alt="Cashmere fiber detail — dehairing process separates 14.5μm underdown from coarse guard hair, 99.95% purity" class="ken-burns absolute inset-0 w-full h-full object-cover opacity-95" decoding="async" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-[#F5F0E7]/40"></div>
      </div>
    </div>
  </section>

  <!-- Yarn 段 -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">02A</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('yarnTitle')}</h2>
        </div>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="text-muted-foreground leading-relaxed text-lg">{T('yarnSub')}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-border">
        {yarnSpecs.map((s, i) => (
          <div class="bg-background p-8 md:p-10">
            <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 flex items-baseline justify-between">
              <span>{s.label}</span>
              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-3xl md:text-4xl text-brand-chocolate font-light">{s.value}</span>
              {s.unit && <span class="text-sm text-muted-foreground">{s.unit}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Greige / Undyed Yarn 段: 目标 keyword "undyed cashmere yarn wholesale" -->
  <section class="py-24 md:py-32 bg-stone-50">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2 py-0.5 border border-brand-chocolate text-brand-chocolate text-[10px] tracking-[0.2em] uppercase font-medium">{T('greigeTag')}</span>
            <span class="h-[2px] w-8 bg-brand-red"></span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4" set:html={T('greigeTitle').replace(/\n/g, '<br/>')} />
          <p class="text-sm text-brand-gold uppercase tracking-[0.2em] mb-4">{T('greigeKick')}</p>
        </div>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="text-muted-foreground leading-relaxed text-lg">{T('greigeSub')}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-border">
        {[
          { label: T('greigeCt1'), value: T('greigeCv1'), unit: '' },
          { label: T('greigeCt2'), value: T('greigeCv2'), unit: '' },
          { label: T('greigeCt3'), value: T('greigeCv3'), unit: '' },
          { label: T('greigeCt4'), value: T('greigeCv4'), unit: '' },
          { label: T('greigeCt5'), value: T('greigeCv5'), unit: T('greigeUnit') },
          { label: T('greigeCt6'), value: T('greigeCv6'), unit: T('greigeUnit2') },
        ].map((s, i) => (
          <div class="bg-stone-50 p-8 md:p-10">
            <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 flex items-baseline justify-between">
              <span>{s.label}</span>
              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-3xl md:text-4xl text-brand-chocolate font-light">{s.value}</span>
              {s.unit && <span class="text-sm text-muted-foreground">{s.unit}</span>}
            </div>
          </div>
        ))}
      </div>

      <!-- 老客户搜索词: undyed cashmere yarn wholesale / greige / raw white cashmere -->
      <p class="text-xs text-muted-foreground mt-8 leading-relaxed">
        {locale === 'cn'
          ? '相关搜索：未染色羊绒纱线批发、本白羊绒纱线、青绒、紫纱、纯天然羊绒纱线、Ordos 毛条原料、染色前纱线、可定制颜色。'
          : 'Related topics: undyed cashmere yarn, greige cashmere yarn, raw white cashmere yarn, brown (qing) cashmere, purple (zi) cashmere, natural cashmere yarn for dyers, yarn construction, color direction and documentation requirements.'}
      </p>

      <div class="mt-12 text-center">
        <h3 class="font-serif text-2xl md:text-3xl mb-3">{T('greigeFormTitle')}</h3>
        <p class="text-muted-foreground mb-6 max-w-2xl mx-auto">{T('greigeFormSub')}</p>
        <a href={`/${locale}/contact?type=yarn&source=greige`} class="inline-flex items-center gap-2 px-8 py-3 bg-brand-chocolate text-white rounded-none font-medium hover:bg-brand-chocolate/90 transition-colors">
          {locale === 'cn' ? '索取未染色纱线样品' : 'Request greige yarn sample'}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Fabric 段：大图 + 数据 -->
  <section class="py-24 md:py-32 bg-brand-cream/50">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">02B</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-6">{T('fabricTitle')}</h2>
          <p class="text-muted-foreground leading-relaxed text-lg mb-8">{T('fabricSub')}</p>
          <div class="grid grid-cols-2 gap-px bg-border">
            {fabricSpecs.slice(0, 4).map((s, i) => (
              <div class="bg-brand-cream/50 p-5">
                <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">{s.label}</div>
                <div class="flex items-baseline gap-1">
                  <span class="font-serif text-2xl text-brand-chocolate font-light">{s.value}</span>
                  {s.unit && <span class="text-xs text-muted-foreground">{s.unit}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="order-1 lg:order-2 aspect-[4/5] overflow-hidden">
          <img src={IMG.knit} alt="Cashmere woven fabric — finished B2B cashmere textile, woven from 100% Inner Mongolian fiber, custom GSM and width" class="w-full h-full object-cover" decoding="async" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <!-- Inquiry -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '询盘' : 'Inquiry'}</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-6">{T('inquiryTitle')}</h2>
          <p class="text-muted-foreground leading-relaxed mb-8">{T('inquirySub')}</p>
          <B2BServices locale={locale} variant="yarn-fabric" />
        </div>
        <div>
          <YarnFabricInquiryForm client:visible locale={locale} enableAttachments={true} />
        </div>
      </div>
    </div>
  </section>

  <SEOFaq faqs={[
    locale === 'cn' ? { q: '纱线或面料询盘应提供哪些信息？', a: '请说明结构、目标成分、颜色方向、用途、数量、目的地与所需文件。' } : { q: 'What should a yarn or fabric inquiry include?', a: 'Describe the construction, composition target, color direction, intended use, quantity, destination and required documents.' },
    locale === 'cn' ? { q: '未染色纱线项目需要说明什么？', a: '请说明后续染色或针织用途、纱线形态、数量、目的地和相关文件需求。' } : { q: 'What should be specified for a greige-yarn project?', a: 'Describe the intended dyeing or knitting application, yarn form, quantity, destination and document requirements.' },
    locale === 'cn' ? { q: '起订量、样品和交期何时确认？', a: '应结合具体结构、颜色、数量、目的地和商务背景，在书面报价或销售协议中确认。' } : { q: 'When are MOQ, sampling and lead-time terms confirmed?', a: 'They are confirmed against the specific construction, color, quantity, destination and commercial context in written project correspondence.' },
  ]} />

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
