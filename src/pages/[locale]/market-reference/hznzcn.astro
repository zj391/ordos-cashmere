// SEO meta — kept short because page is noindex anyway
const meta = {
  en: { title: 'Market Reference · hznzcn.com Cashmere Listings | DONGXIAO', description: 'Reference index of 20 public cashmere listings from hznzcn.com (清河 market) for buyer-side comparison with our Ordos factory catalogue.' },
  cn: { title: '市场参考 · hznzcn.com 羊绒款式索引 | DONGXIAO', description: 'hznzcn.com（清河市场）20 个公开羊绒款式索引，供买家与鄂尔多斯工厂目录对比参考。' },
  de: { title: 'Marktreferenz · hznzcn.com Kaschmir-Listings | DONGXIAO', description: 'Referenzindex mit 20 öffentlichen Kaschmir-Listings von hznzcn.com (清河-Markt) zum Vergleich mit unserem Ordos-Fabrikkatalog.' },
  fr: { title: 'Référence marché · listings cachemire hznzcn.com | DONGXIAO', description: 'Index de référence de 20 annonces cachemire publiques de hznzcn.com (marché 清河) pour comparaison avec notre catalogue d\'usine d\'Ordos.' },
  ja: { title: '市場参考 · hznzcn.com カシミア出品 | DONGXIAO', description: 'hznzcn.com（清河市場）の公開カシミア出品 20 件の参考索引。当社オルドス工場カタログとの比較用。' },
  kr: { title: '시장 참고 · hznzcn.com 캐시미어 출품 | DONGXIAO', description: 'hznzcn.com(칭허 시장) 공개 캐시미어 출품 20건 참고 색인. 당사 오르도스 공장 카탈로그 비교용.' },
}[locale];

// Sort by views desc for richer reference ordering
const products = [...HZNZCN_PRODUCTS].sort((a, b) => b.views - a.views);
const contactLink = `/${locale}/contact?ref=hznzcn`;
---

<BaseLayout
  locale={locale}
  pageKey="market-reference-hznzcn"
  path="/market-reference/hznzcn"
  title={meta.title}
  description={meta.description}
  noIndex={true}
>
  <Navigation slot="nav" locale={locale} />
  <main class="container-narrow py-12 md:py-16">
    <p class="section-eyebrow">{T.eyebrow}</p>
    <h1 class="font-display text-3xl md:text-5xl font-light leading-tight mt-3 mb-4">
      {T.title}
    </h1>
    <p class="text-base text-muted-foreground max-w-3xl mb-8">{T.subtitle}</p>

    <aside class="border-l-2 border-brand-copper pl-4 py-2 mb-10 max-w-3xl bg-secondary/30">
      <p class="font-medium text-sm mb-1">{T.noticeTitle}</p>
      <p class="text-sm text-muted-foreground leading-relaxed">{T.notice}</p>
    </aside>

    <div class="flex flex-wrap gap-3 mb-10">
      <a href={`/${locale}/contact?ref=hznzcn`} class="btn-tier-1">{T.contactCta}</a>
      <a href={`/${locale}/products/`} class="btn-tier-2">{T.mainCatalogue}</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((p) => (
        <article class="bg-background border-t border-stone-200 pt-5 group" data-sku={p.sku}>
          <a
            href={p.images[0] || '#'}
            class="block aspect-square overflow-hidden bg-brand-cream mb-3"
            data-fallback-href={contactLink}
            onclick={`event.preventDefault(); const l=this.getAttribute('href'); if(l && l !== '#') { window.__openImagePreview ? window.__openImagePreview(${JSON.stringify(p.images)}) : window.open(l, '_blank'); } else { location.href = this.getAttribute('data-fallback-href'); }`}
          >
            {p.images[0] && (
              <img
                src={p.images[0]}
                alt={`${p.title} — hznzcn market reference`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            )}
          </a>

          <h2 class="font-serif text-lg font-light leading-snug mb-2 group-hover:text-brand-copper transition-colors">
            {p.title}
          </h2>

          <dl class="text-xs text-muted-foreground space-y-1 mb-3">
            <div class="flex justify-between gap-2">
              <dt class="uppercase tracking-wider text-[10px]">{T.fieldsShop}</dt>
              <dd class="text-right font-medium text-foreground/80">{p.shop}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="uppercase tracking-wider text-[10px]">{T.fieldsViews}</dt>
              <dd class="text-right font-medium text-foreground/80">{p.views.toLocaleString()}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="uppercase tracking-wider text-[10px]">{T.fieldsUpdated}</dt>
              <dd class="text-right font-medium text-foreground/80">{p.updatedAt}</dd>
            </div>
            {p.sizes.length > 0 && (
              <div class="flex justify-between gap-2">
                <dt class="uppercase tracking-wider text-[10px]">{T.fieldsSizes}</dt>
                <dd class="text-right font-medium text-foreground/80">{p.sizes.join(' / ')}</dd>
              </div>
            )}
            {p.colors.length > 0 && (
              <div class="flex justify-between gap-2">
                <dt class="uppercase tracking-wider text-[10px]">{T.fieldsColors}</dt>
                <dd class="text-right font-medium text-foreground/80">{p.colors.join(' / ')}</dd>
              </div>
            )}
            <div class="flex justify-between gap-2">
              <dt class="uppercase tracking-wider text-[10px]">{T.fieldsImages}</dt>
              <dd class="text-right font-medium text-foreground/80">{p.imageCount}</dd>
            </div>
          </dl>

          <a
            href={contactLink}
            class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.18em] text-foreground pb-1 border-b border-foreground/30 hover:text-brand-copper hover:border-brand-copper rounded-none transition-colors"
          >
            {T.inquireCta} →
          </a>
        </article>
      ))}
    </div>
  </main>
  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="footer" locale={locale} />
  <CookieConsent slot="footer" locale={locale} />
</BaseLayout>