---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import DownloadsGrid from '@/components/islands/DownloadsGrid.tsx';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: { title: 'Download Center', subtitle: 'Catalogs, specifications, and certifications. B2B buyers only.' },
  cn: { title: '资料下载中心', subtitle: '产品目录、技术规格、认证文件。填写信息后，我们将在24小时内将资料发送至您的邮箱。' },
  de: { title: 'Download-Center', subtitle: 'Kataloge, Spezifikationen, Zertifizierungen.' },
  fr: { title: 'Centre de téléchargement', subtitle: 'Catalogues, spécifications, certifications.' },
  ja: { title: 'ダウンロードセンター', subtitle: 'カタログ、仕様、認証。B2Bバイヤー専用。' },
  kr: { title: '다운로드 센터', subtitle: '카탈로그, 사양, 인증.' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const downloads = [
  { type: 'catalog', title: locale === 'cn' ? '羊绒产品采购目录' : 'Cashmere Wholesale Catalog', size: locale === 'cn' ? '按需发送' : 'Delivered on request', format: 'PDF dossier' },
  { type: 'specs', title: locale === 'cn' ? '羊绒原料与纱线规格表' : 'Cashmere Fiber & Yarn Specifications', size: locale === 'cn' ? '按需发送' : 'Delivered on request', format: 'PDF dossier' },
  { type: 'cert', title: locale === 'cn' ? 'ISO 9001 认证文件' : 'ISO 9001 Documentation', size: locale === 'cn' ? '最新版本' : 'Current version', format: 'PDF dossier' },
  { type: 'cert', title: locale === 'cn' ? 'OEKO-TEX 合规资料' : 'OEKO-TEX Compliance Documents', size: locale === 'cn' ? '最新版本' : 'Current version', format: 'PDF dossier' },
  { type: 'quality', title: locale === 'cn' ? '质量控制与验货流程' : 'Quality Control & Inspection Process', size: locale === 'cn' ? '按需发送' : 'Delivered on request', format: 'PDF dossier' },
  { type: 'report', title: locale === 'cn' ? '工厂能力与验厂资料' : 'Factory Capability & Audit Dossier', size: locale === 'cn' ? '适用采购商' : 'For qualified buyers', format: 'PDF dossier' },
];

const procurementPaths = [
  { href: 'certifications', number: '01', title: { en: 'Compliance & certification', cn: '合规与认证', de: 'Compliance & Zertifizierung', fr: 'Conformité & certifications', ja: 'コンプライアンス・認証', kr: '규정 준수 및 인증' }, desc: { en: 'Review current certification scope and request the relevant documents for your approval process.', cn: '查看认证范围，并申请与采购审批相关的文件。', de: 'Prüfen Sie den Zertifizierungsumfang und fordern Sie Unterlagen für Ihre Freigabe an.', fr: 'Consultez le périmètre des certifications et demandez les documents utiles à votre validation.', ja: '認証範囲を確認し、承認に必要な資料をご請求ください。', kr: '인증 범위를 검토하고 승인 절차에 필요한 자료를 요청하세요.' } },
  { href: 'quality-control', number: '02', title: { en: 'Quality & inspection', cn: '质量与验货', de: 'Qualität & Inspektion', fr: 'Qualité & inspection', ja: '品質・検品', kr: '품질 및 검사' }, desc: { en: 'See how incoming material, in-process work and final goods are controlled.', cn: '了解原料、生产过程和成品的质控方式。', de: 'Erfahren Sie, wie Material, Produktion und Fertigware kontrolliert werden.', fr: 'Découvrez les contrôles des matières, de la production et des produits finis.', ja: '原料・工程・完成品の管理方法をご確認いただけます。', kr: '원료, 공정 및 완제품 관리 방식을 확인하세요.' } },
  { href: 'private-label-cashmere', number: '03', title: { en: 'Sampling & private label', cn: '打样与贴牌', de: 'Muster & Private Label', fr: 'Échantillons & marque privée', ja: 'サンプル・プライベートラベル', kr: '샘플 및 프라이빗 라벨' }, desc: { en: 'Map samples, color, branding and approval milestones before a bulk quotation.', cn: '在大货报价前梳理样品、颜色、品牌与确认节点。', de: 'Planen Sie Muster, Farbe, Branding und Freigaben vor dem Serienangebot.', fr: 'Planifiez échantillons, couleurs, branding et validations avant le devis production.', ja: '量産見積もり前にサンプル・カラー・ブランド・承認工程を確認します。', kr: '대량 견적 전 샘플, 색상, 브랜딩 및 승인 절차를 확인하세요.' } },
  { href: 'shipping-logistics', number: '04', title: { en: 'Trade & logistics', cn: '贸易与物流', de: 'Handel & Logistik', fr: 'Commerce & logistique', ja: '貿易・物流', kr: '무역 및 물류' }, desc: { en: 'Align delivery terms, origin port and shipment planning with your destination market.', cn: '按目的国确认贸易条款、起运港和运输方案。', de: 'Stimmen Sie Lieferbedingungen, Abgangshafen und Versandplanung auf Ihren Markt ab.', fr: 'Alignez les conditions de livraison, le port de départ et la planification transport.', ja: '仕向地に合わせて貿易条件・出荷港・輸送計画を確認します。', kr: '목적지 시장에 맞춰 거래 조건, 출항 항구 및 운송 계획을 조정하세요.' } },
];

// Trust Packs — 4 themed bundles (multiple PDFs compressed into 1 zip-equivalent)
// B2B buyers save time vs downloading 6+ files individually
const trustPacks = [
  {
    slug: 'factory-pack',
    eyebrow: { en: 'Factory Pack', cn: '工厂实力包', de: 'Fabrik-Paket', fr: 'Pack Usine', ja: '工場パック', kr: '공장 팩' },
    title:   { en: 'Factory Credentials & Audit Pack', cn: '工厂资质 + 验厂报告包', de: 'Fabrikqualifikationen + Auditbericht', fr: 'Qualifications + Audit', ja: '工場資格 + 監査', kr: '공장 자격 + 감사' },
    items: [
      'Product Catalog 2024 (EN/CN)',
      'SGS On-site Factory Audit Report',
      'ISO 9001:2015 Certificate',
      '23 Years Operating History Brief',
    ],
    size: '18.7 MB',
  },
  {
    slug: 'quality-pack',
    eyebrow: { en: 'Quality Pack', cn: '质量保证包', de: 'Qualitätspaket', fr: 'Pack Qualité', ja: '品質パック', kr: '품질 팩' },
    title:   { en: 'Certifications & QC Process Pack', cn: '认证 + 质检流程包', de: 'Zertifizierungen + QC-Prozess', fr: 'Certifications + Processus QC', ja: '認証 + QC プロセス', kr: '인증 + QC 프로세스' },
    items: [
      'ISO 9001 Certificate',
      'OEKO-TEX 100 Standard Certificate',
      'Good Cashmere Standard (GCS) Blendscover',
      'AQL 2.5 IQC/IPQC/OQC Workflow PDF',
      'Inner Mongolia Origin Test Report',
    ],
    size: '4.3 MB',
  },
  {
    slug: 'materials-pack',
    eyebrow: { en: 'Materials Pack', cn: '原料规格包', de: 'Materialpaket', fr: 'Pack Matières', ja: '素材パック', kr: '소재 팩' },
    title:   { en: 'Yarn Count & Dye Specification Pack', cn: '纱线支数 + 染色规格包', de: 'Garnnummer + Färbung Spezifikation', fr: 'Numéro + Teinture', ja: '番手 + 染色 仕様', kr: '번수 + 염색 사양' },
    items: [
      'Yarn Count Reference (2/26 to 2/120 Nm)',
      'Micron Grade Specifications (14.5-19.5μm)',
      'Pantone Color Matching Process (5kg+ MOQ)',
      'Color Fastness Standards (ISO 105-C06 / B02)',
      'Cone vs Hank Yarn Delivery Specifications',
      'Wholesale Pricing Tier Document',
    ],
    size: '6.1 MB',
  },
  {
    slug: 'buyer-pack',
    eyebrow: { en: 'Buyer Pack', cn: '采购流程包', de: 'Käuferpaket', fr: 'Pack Acheteur', ja: 'バイヤーパック', kr: '바이어 팩' },
    title:   { en: 'Sample Policy & Trade Terms Pack', cn: '样品政策 + 贸易条款包', de: 'Musterpolitik + Handelsbedingungen', fr: 'Échantillons + Conditions commerciales', ja: 'サンプル + 取引条件', kr: '샘플 + 무역 조건' },
    items: [
      'Sample Policy (4 sample types + refund terms)',
      'MOQ Reference by Product Category',
      'HS Code Guide (5108.20 / 6110 / 6202)',
      'FOB / CIF / DDP Shipping Terms 2026',
      'OEM/ODM Workflow 8-12 Weeks Timeline',
    ],
    size: '5.2 MB',
  },
];
const packsEyebrow = { en: 'Trust Packs', cn: '一站式下载', de: 'Vertrauenspakete', fr: 'Packs de Confiance', ja: 'トラストパック', kr: '신뢰 팩' };
const packsTitle = { en: 'Download Everything in One Bundle', cn: '一站式获取工厂全部资料', de: 'Alles in einem Paket herunterladen', fr: 'Tout télécharger en un seul pack', ja: '工場資料を 1 つにまとめて', kr: '공장 자료를 한 번에' };
const packsSubtitle = { en: 'Each Trust Pack bundles 4-6 PDFs (catalog + certs + datasheets + trade terms) into one download — saving B2B buyers multiple round-trips.', cn: '每个信任包整合 4-6 份 PDF（目录 + 证书 + 规格表 + 贸易条款）——省去多次下载沟通。', de: 'Jedes Paket bündelt 4-6 PDFs.', fr: 'Chaque pack regroupe 4-6 PDF.', ja: '各パック 4-6 PDF 統合。', kr: '각 팩 4-6 PDF 통합.' };
const packsCta = { en: 'Request a Custom Pack', cn: '索取定制资料包', de: 'Custom-Paket anfordern', fr: 'Pack personnalisé', ja: 'カスタムパック', kr: '맞춤 팩 요청' };

---

<BaseLayout locale={locale} pageKey="download" path="/download">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/download`} />

  <section class="relative bg-[#F5F0E7] border-b border-border/60 overflow-hidden">
    <div class="container-narrow py-24 md:py-32">
      <div class="flex items-center gap-3 mb-8">
        <span class="h-[2px] w-12 bg-brand-red"></span>
        <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{locale === 'cn' ? '资料下载' : 'Downloads'}</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8 text-balance">{T('title')}</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-xl font-light">{T('subtitle')}</p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-background border-b border-border/60">
    <div class="container-narrow">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-10 bg-brand-red"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-camel font-medium">{locale === 'cn' ? '采购核验路径' : 'Buyer verification path'}</span>
      </div>
      <h2 class="font-serif text-3xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '用一套资料完成供应商核验' : 'Verify a supplier with one clear dossier'}</h2>
      <p class="text-base text-muted-foreground max-w-3xl leading-relaxed mb-10">{locale === 'cn' ? '先核验合规与工厂能力，再确认质量、打样和贸易条款；需要正式文件时，可在下方提交资料申请。' : 'Review compliance and factory capability first, then align quality, sampling and trade terms. Request the current supporting documents below when your internal review requires them.'}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {procurementPaths.map((item) => (
          <a href={`/${locale}/${item.href}/`} class="group border border-border bg-card p-5 hover:border-brand-gold transition-colors">
            <span class="text-[10px] tracking-[0.25em] uppercase text-brand-gold font-mono">{item.number}</span>
            <h3 class="font-serif text-xl mt-3 mb-2 group-hover:text-brand-camel transition-colors">{item.title[locale] || item.title.en}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{item.desc[locale] || item.desc.en}</p>
            <span class="inline-flex items-center gap-1.5 mt-5 text-xs font-medium text-brand-ink group-hover:text-brand-camel transition-colors">{locale === 'cn' ? '查看说明' : 'Review details'} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Packs — 一站式获取工厂全部资料,4 个主题 zip 包 -->
  <section class="py-20 md:py-24 bg-[#F8F5EF] border-y border-border/60">
    <div class="container-narrow">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-10 bg-brand-red"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-brand-camel font-medium">{packsEyebrow[locale] || packsEyebrow.en}</span>
      </div>
      <h2 class="font-serif text-3xl md:text-5xl font-light leading-tight mb-3 text-balance">{packsTitle[locale] || packsTitle.en}</h2>
      <p class="text-base md:text-lg text-muted-foreground max-w-2xl mb-12 leading-relaxed">{packsSubtitle[locale] || packsSubtitle.en}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {trustPacks.map((p, idx) => (
          <article class="bg-background border border-border p-6 md:p-8 hover:border-brand-gold hover:shadow-xl transition-colors transition-shadow duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3 gap-4">
              <span class="text-[10px] tracking-[0.3em] uppercase text-brand-gold font-mono font-medium">
                0{idx + 1} · {p.eyebrow[locale] || p.eyebrow.en}
              </span>
              <span class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground font-mono">{locale === 'cn' ? '资料申请' : 'Document request'}</span>
            </div>
            <h3 class="font-serif text-xl md:text-2xl font-light mb-4 leading-tight">{p.title[locale] || p.title.en}</h3>
            <ul class="space-y-2.5 mb-6 flex-grow">
              {p.items.map((item) => (
                <li class="text-sm leading-relaxed text-foreground/85 flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-brand-gold mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-border/60">
              <a href={`/${locale}/contact?inquiry=${p.slug}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-ink text-[#F7F3EC] hover:bg-brand-chocolate transition-colors text-xs uppercase tracking-[0.15em] font-medium">
                {locale === 'cn' ? '索取此包' : 'Get this pack'}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              </a>
              <span class="text-xs text-muted-foreground">
                {locale === 'cn' ? '我们 24 小时内邮件发送' : 'Email delivery within 24 hours'}
              </span>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center max-w-2xl mx-auto p-6 md:p-8 bg-background border border-brand-gold/40">
        <h3 class="font-serif text-xl mb-2">
          {locale === 'cn' ? '需要定制资料包？' : "Don't see the bundle you need?"}
        </h3>
        <p class="text-sm text-muted-foreground mb-5">
          {locale === 'cn'
            ? '指定产品类 + MOQ + 目的国，我们整理专门的资料包给您。'
            : "Tell us your category + target MOQ + destination. We'll build a tailored dossier."}
        </p>
        <a href={`/${locale}/contact?inquiry=custom-pack`} class="inline-flex items-center gap-2 px-6 py-2.5 border border-brand-ink/30 text-brand-ink hover:bg-brand-ink hover:text-[#F7F3EC] transition-colors text-xs uppercase tracking-[0.15em] font-medium">
          {packsCta[locale] || packsCta.en}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <DownloadsGrid client:idle locale={locale} downloads={downloads} />
    </div>
  </section>

  <!-- 底部 CTA：看完资料 → 跳到联系 -->
  <section class="pb-24 md:pb-32 bg-background">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-sm text-muted-foreground mb-4">
          {locale === 'cn' ? '没找到需要的资料？' : "Didn't find what you need?"}
        </p>
        <a
          href={locale === 'cn' ? '/cn/contact' : `/${locale}/contact`}
          class="inline-flex items-center gap-2 px-8 py-3 bg-brand-ink text-[#F7F3EC] hover:bg-brand-camel transition-colors text-sm"
        >
          {locale === 'cn' ? '联系我们获取更多资料' : 'Contact Us for More Resources'}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
