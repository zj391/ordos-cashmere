---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import DownloadsGrid from '@/components/islands/DownloadsGrid.tsx';
import SEOFaq from '@/components/SEOFaq.astro';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: { title: 'Download Center', subtitle: 'Catalogs, specifications, and certifications. B2B buyers only.' },
  cn: { title: '资料下载中心', subtitle: '产品目录、技术规格、认证文件。填写信息后，我们将在24小时内将资料发送至您的邮箱。' },
  de: { title: 'Download-Center', subtitle: 'Kataloge, Spezifikationen, Zertifizierungen.' },
  fr: { title: 'Centre de téléchargement', subtitle: 'Catalogues, spécifications, certifications.' },
  ja: { title: 'ダウンロードセンター', subtitle: 'カタログ、仕様、認証。B2Bバイヤー専用。' },
  kr: { title: '다운로드 센터', subtitle: '카탈로그, 사양, 인증.' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const downloads = [
  { type: 'catalog', title: locale === 'cn' ? '产品目录 2024' : 'Product Catalog 2024', size: '12.4 MB', format: 'PDF' },
  { type: 'specs', title: locale === 'cn' ? '羊绒原料规格表' : 'Raw Material Specifications', size: '2.1 MB', format: 'PDF' },
  { type: 'cert', title: locale === 'cn' ? 'ISO 9001 证书' : 'ISO 9001 Certificate', size: '0.8 MB', format: 'PDF' },
  { type: 'cert', title: locale === 'cn' ? 'OEKO-TEX 证书' : 'OEKO-TEX Certificate', size: '1.2 MB', format: 'PDF' },
  { type: 'cert', title: 'Good Cashmere Standard', size: '0.9 MB', format: 'PDF' },
  { type: 'report', title: locale === 'cn' ? '工厂验厂报告' : 'Factory Audit Report', size: '5.6 MB', format: 'PDF' },
];
---

<BaseLayout locale={locale} pageKey="download" path="/download">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/download`} />

  <section class="relative bg-[#F5F0E7] border-b border-border/60 overflow-hidden">
    <div class="container-narrow py-24 md:py-32">
      <div class="flex items-center gap-3 mb-8">
        <span class="h-[2px] w-12 bg-brand-red"></span>
        <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{locale === 'cn' ? '资料下载' : 'Downloads'}</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8 text-balance">{T('title')}</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-xl font-light">{T('subtitle')}</p>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <DownloadsGrid client:idle locale={locale} downloads={downloads} />
    </div>
  </section>

  <!-- 底部 CTA：看完资料 → 跳到联系 -->
  <section class="pb-24 md:pb-32 bg-background">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-sm text-muted-foreground mb-4">
          {locale === 'cn' ? '没找到需要的资料？' : "Didn't find what you need?"}
        </p>
        <a
          href={locale === 'cn' ? '/cn/contact' : `/${locale}/contact`}
          class="inline-flex items-center gap-2 px-8 py-3 bg-brand-ink text-[#F7F3EC] hover:bg-brand-camel transition-colors text-sm"
        >
          {locale === 'cn' ? '联系我们获取更多资料' : 'Contact Us for More Resources'}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <SEOFaq faqs={[
    locale === 'cn'
      ? { q: '下载资料需要注册账号吗？', a: '不需要。所有资料 PDF 直接点击下载，无强制注册。需发邮件订阅季度新品/新色卡，可选填邮箱。' }
      : { q: 'Do I need an account to download resources?', a: 'No. All PDF resources are direct-download, no registration required. Email signup is optional for quarterly new product and color card updates.' },
    locale === 'cn'
      ? { q: '下载的资料是否含水印？', a: '在线版资料含 DONGXIAO® 水印（仅 PDF 内部，截图可识别来源）。如需无水印高清版（如用于品牌产品册或商业展示），下单后我们提供原文件。' }
      : { q: 'Are the downloads watermarked?', a: 'Web PDFs include a DONGXIAO® watermark (PDF metadata + visible stamp) for source attribution. High-res watermark-free versions are available after B2B order placement for use in brand catalogs and trade show materials.' },
    locale === 'cn'
      ? { q: '可以发实体色卡和样本到我们办公室吗？', a: '可以。B2B 客户免费寄送 25/26 秋冬 Pantone TCX 实体色卡（含 318 色，2-3 个工作日寄达）和 5-10 个面料小样（每个 5cm x 5cm）。私牌定制可申请 30 个颜色色卡。' }
      : { q: 'Can you ship physical color cards and fabric swatches to our office?', a: 'Yes. B2B clients receive free 25/26 AW Pantone TCX physical color card (318 swatches, 2-3 business day delivery) plus 5-10 fabric swatches (5cm x 5cm each). Private label clients can request 30-color custom color cards.' },
    locale === 'cn'
      ? { q: '资料上的证书和检测报告能验证吗？', a: '可以。所有 PDF 上的证书都有证书编号（OEKO-TEX、ISO 9001、GCS、BSCI、SEDEX）。可在对应认证机构官网输入证书编号验证真伪。我们的证书每年更新一次，最新版本均可下载。' }
      : { q: 'Can the certificates and test reports be verified?', a: 'Yes. Every certificate on our PDFs has a registration number (OEKO-TEX, ISO 9001, GCS, BSCI, SEDEX). Verify authenticity on the issuing body website with the certificate number. Our certificates are renewed annually — latest versions always downloadable.' },
    locale === 'cn'
      ? { q: '如何订阅新色卡和新品资料？', a: '在联系我们页面填邮箱 + 选品类（hats/scarves/sweaters/accessories/yarn/raw material），即可每季度收到新品 PDF。已合作的 B2B 客户自动获得新色卡和 5-10 个新款样品邮寄。' }
      : { q: 'How to subscribe to new color card and product catalogs?', a: 'Visit the Contact Us page, submit email + select categories of interest (hats/scarves/sweaters/accessories/yarn/raw material). Quarterly newsletter with new product PDFs. Active B2B customers automatically receive new color cards and 5-10 new samples by mail.' },
  ]} title="Download FAQ" />

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>