---
/**
 * Garment OEM 产品页
 */
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import SEOFaq from '@/components/SEOFaq.astro';
import B2BServices from '@/components/B2BServices.astro';
import GarmentOemInquiryForm from '@/components/islands/GarmentOemInquiryForm.tsx';
import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = pickLocale(rawLocale);

const t: Record<string, Record<string, string>> = {
  en: {
    tagline: '03 / GARMENT OEM',
    title: 'Cashmere Garment\nOEM / ODM',
    subtitle: 'Use a written brief to discuss product references, specifications, quantity, destination, sampling and commercial requirements for a cashmere garment project.',
    catTitle: 'What we make',
    catSub: 'Six core categories, plus custom development for special designs.',
    processTitle: 'How we work',
    processSub: 'A project pathway that records the brief, sample route, quality requirements and written commercial terms.',
    inquiryTitle: 'Start your project',
    inquirySub: 'Share your design or technical pack, quantity, destination and required documentation to begin a written project review.',
  },
  cn: {
    tagline: '03 / 成衣代工',
    title: '羊绒成衣\nOEM / ODM',
    subtitle: '通过书面需求沟通产品参考、规格、数量、目的地、打样与商务要求，启动羊绒成衣项目。',
    catTitle: '产品类目',
    catSub: '六大核心品类，支持特殊款式的定制开发。',
    processTitle: '服务流程',
    processSub: '记录需求、打样路径、质量要求与书面商务条件的项目流程。',
    inquiryTitle: '开始您的项目',
    inquirySub: '请提供设计稿或技术包、数量、目的地和文件要求，以启动书面项目审核。',
  },
  de: { tagline: '03 / BEKLEIDUNG OEM', title: 'Kaschmir-Bekleidung\nOEM / ODM', subtitle: 'Produktreferenz, Spezifikation, Menge, Zielort und Anforderungen schriftlich abstimmen.', catTitle: 'Was wir machen', catSub: 'Produktkategorien als Ausgangspunkt für den Brief.', processTitle: 'Unser Prozess', processSub: 'Brief, Musterweg, Qualitätsanforderungen und Bedingungen werden dokumentiert.', inquiryTitle: 'Projekt starten', inquirySub: 'Design, Menge, Zielort und Dokumente für die schriftliche Prüfung senden.' },
  fr: { tagline: '03 / VÊTEMENT OEM', title: 'Vêtements cachemire\nOEM / ODM', subtitle: 'Discutez par écrit référence produit, spécifications, quantité, destination et exigences.', catTitle: 'Catégories', catSub: 'Catégories produit comme point de départ du brief.', processTitle: 'Processus', processSub: 'Brief, échantillon, qualité et conditions sont documentés.', inquiryTitle: 'Démarrer', inquirySub: 'Envoyez design, quantité, destination et documents pour revue écrite.' },
  ja: { tagline: '03 / 衣料OEM', title: 'カシミア衣料\nOEM / ODM', subtitle: '製品参考、仕様、数量、仕向地、要件を文書で相談します。', catTitle: '製品カテゴリ', catSub: 'ブリーフ作成の出発点となる製品カテゴリ。', processTitle: 'プロセス', processSub: 'ブリーフ、サンプル、品質要件、条件を記録します。', inquiryTitle: 'プロジェクト開始', inquirySub: 'デザイン、数量、仕向地、書類をお送りください。' },
  kr: { tagline: '03 / 의류 OEM', title: '캐시미어 의류\nOEM / ODM', subtitle: '제품 참고, 사양, 수량, 목적지, 요건을 서면으로 협의합니다.', catTitle: '제품 카테고리', catSub: '브리프 작성의 출발점이 되는 제품 카테고리.', processTitle: '프로세스', processSub: '브리프, 샘플, 품질 요건, 조건을 기록합니다.', inquiryTitle: '프로젝트 시작', inquirySub: '디자인, 수량, 목적지, 서류를 보내 주세요.' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

const process = [
  { step: '01', title: locale === 'cn' ? '需求沟通' : 'Design Brief', desc: locale === 'cn' ? '需求沟通、款式确认、面料/支数选择' : 'Brief, design, fabric & count selection' },
  { step: '02', title: locale === 'cn' ? '打样与确认' : 'Sampling & Approval', desc: locale === 'cn' ? '按项目明确样品用途、确认路径与文件需求' : 'Define sample purpose, approval route and documents for the project' },
  { step: '03', title: locale === 'cn' ? '书面项目条件' : 'Written Project Terms', desc: locale === 'cn' ? '结合具体产品、数量与目的地确认商务条件' : 'Confirm commercial terms against the product, quantity and destination' },
  { step: '04', title: locale === 'cn' ? '质量与交付准备' : 'Quality & Delivery Preparation', desc: locale === 'cn' ? '书面确认验货、文件和交付要求' : 'Confirm inspection, documentation and delivery requirements in writing' },
];

const categories = [
  { num: '01', name: locale === 'cn' ? '羊绒衫/开衫' : 'Sweaters & Cardigans', desc: locale === 'cn' ? '圆领/V领/高领' : 'Crew / V-neck / Turtleneck' },
  { num: '02', name: locale === 'cn' ? '羊绒大衣/外套' : 'Coats & Outerwear', desc: locale === 'cn' ? '长款/短款/披肩' : 'Long / Short / Wrap' },
  { num: '03', name: locale === 'cn' ? '羊绒裙' : 'Dresses & Skirts', desc: locale === 'cn' ? '连衣裙/半裙' : 'Dresses / Skirts' },
  { num: '04', name: locale === 'cn' ? '围巾/披肩' : 'Scarves & Shawls', desc: locale === 'cn' ? '染色/提花' : 'Solid / Jacquard' },
  { num: '05', name: locale === 'cn' ? '帽/配饰' : 'Hats & Accessories', desc: locale === 'cn' ? '冷帽/手套' : 'Beanies / Gloves' },
  { num: '06', name: locale === 'cn' ? '定制开发' : 'Custom Development', desc: locale === 'cn' ? 'ODM 全流程' : 'Full ODM cycle' },
];

const IMG = {
  hero: '/images/knit-shawl.webp',
  process: '/images/cashmere-fiber.webp',
};
---

<BaseLayout locale={locale} pageKey="garmentOem" path="/garment-oem">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/garment-oem`} />

  <section class="relative bg-brand-sandwarm border-b border-border/60 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[70vh]">
      <div class="flex items-center py-20 lg:py-0 px-6 lg:pl-12">
        <div class="max-w-xl">
          <div class="flex items-center gap-3 mb-8">
            <span class="h-[2px] w-12 bg-brand-red"></span>
            <span class="text-xs tracking-[0.4em] text-brand-camel uppercase font-medium">{T('tagline')}</span>
          </div>
          <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8" set:html={T('title').replace(/\n/g, '<br/>')} />
          <p class="text-lg text-muted-foreground leading-relaxed max-w-md font-light">{T('subtitle')}</p>
        </div>
      </div>
      <div class="relative aspect-[4/3] lg:aspect-auto overflow-hidden">
        <img src={IMG.hero} alt="Cashmere garments — finished knitwear, scarves and apparel for a sourcing discussion" class="ken-burns absolute inset-0 w-full h-full object-cover opacity-95" decoding="async" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-brand-sandwarm/40"></div>
      </div>
    </div>
  </section>

  <!-- Categories：6 格 + 编号 -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '品类' : 'Categories'}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('catTitle')}</h2>
        <p class="text-muted-foreground leading-relaxed">{T('catSub')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
        {categories.map((c) => (
          <div class="bg-background p-10 hover:bg-brand-cream/30 transition-colors group cursor-pointer">
            <div class="font-serif text-5xl text-brand-gold/40 font-light mb-4 group-hover:text-brand-gold/80 transition-colors">{c.num}</div>
            <h3 class="reveal font-serif text-2xl mb-2 group-hover:text-brand-chocolate transition-colors">{c.name}</h3>
            <p class="text-sm text-muted-foreground">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process：4 步 + 大图 -->
  <section class="py-24 md:py-32 bg-brand-cream/50 border-y border-border">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '流程' : 'Process'}</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('processTitle')}</h2>
        </div>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="text-muted-foreground leading-relaxed text-lg">{T('processSub')}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {process.map((p) => (
          <div class="relative pt-8 border-t border-brand-chocolate/30">
            <div class="font-serif text-6xl text-brand-chocolate font-light mb-4">{p.step}</div>
            <h3 class="reveal font-serif text-xl mb-2">{p.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inquiry -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '询盘' : 'Inquiry'}</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-6">{T('inquiryTitle')}</h2>
          <p class="text-muted-foreground leading-relaxed mb-8">{T('inquirySub')}</p>
          <B2BServices locale={locale} variant="garment-oem" />
        </div>
        <div>
          <GarmentOemInquiryForm client:visible locale={locale} enableAttachments={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Process Guide (EN-only SEO content depth) -->
  {false && locale === 'en' && (
  <section class="py-12 md:py-16 bg-secondary/20">
    <div class="container-narrow">
      <h2 class="reveal font-display text-3xl md:text-4xl font-light mb-4">OEM Process: From Inquiry to Delivery in 6-10 Weeks</h2>
      <p class="text-base text-muted-foreground mb-8 max-w-3xl">
        Working with an overseas cashmere OEM factory involves 7 defined stages. Knowing each step — and the typical timeline — helps you plan inventory, marketing campaigns, and cash flow. Below is the exact process we follow with our B2B clients, refined across 23 years and 50+ countries.
      </p>

      <div class="space-y-8">
        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">01</span> Inquiry & Spec Confirmation</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Send your target product type, quantity, gauge, fiber blend, color (Pantone code if available), and customization requirements (logo embroidery, labels, packaging). We confirm specifications, MOQ, and indicative pricing within 24 hours. No commitment at this stage — we sign an NDA on request for proprietary designs.</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> 1-3 days · <strong>Output:</strong> Quotation sheet with FOB price, MOQ, lead time, payment terms</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">02</span> Sample Development (7-15 days)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">For orders above 500 pieces we develop a hand-loom sample (yarn + gauge + stitch) for your approval. Sample cost USD 50-150 per piece (refundable against bulk order over 1,000 pcs). Sample lead time is 7-15 days plus 3-5 days DHL/FedEx to your office. For orders below 500 pcs, we recommend using our in-stock color-and-style matrix to skip sampling.</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> 10-20 days round-trip · <strong>Output:</strong> Physical sample shipped to your office</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">03</span> Contract & Deposit (30% T/T)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Once the sample is approved (signed swatch + digital confirmation), we issue a Proforma Invoice (PI) with: FOB Tianjin/Shanghai unit price, total value, 30% T/T deposit, 70% balance against B/L copy, production lead time, and Incoterms 2020 reference. Standard payment terms: 30% deposit + 70% against B/L copy. For established clients (3+ orders) we offer 20/80 or L/C at sight.</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> 3-7 days for PI exchange + wire transfer · <strong>Output:</strong> Signed PI, deposit received, production slot booked</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">04</span> Bulk Production (15-25 days)</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Yarn knitting, linking, washing, ironing, labeling, final QA. We send production photos and a pre-shipment sample (PSP) at the 70% completion point so you can request minor adjustments. For orders above 5,000 pieces we offer a mid-production factory visit (your team or third-party inspector).</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> 15-25 days for knitwear · 25-35 days for woven/structured pieces · <strong>Output:</strong> Finished goods, QC report, PSP</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">05</span> Pre-Shipment Inspection</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Inspection options: (a) our internal QA team — AQL 2.5 sampling on 100% of finished goods; (b) your nominated third-party inspector (SGS, Bureau Veritas, Intertek) — fee USD 300-500 per man-day; (c) live video inspection via WhatsApp/WeChat at the 100% completion point. We recommend option (b) for first-time orders over 1,000 pcs.</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> 1-3 days · <strong>Output:</strong> Inspection report, photo set, sign-off for shipment</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">06</span> Shipping & Documentation</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">We book ocean freight (FCL or LCL), air freight, or express courier based on your Incoterms preference. Standard documents: Commercial Invoice, Packing List, Bill of Lading, Certificate of Origin (China), OEKO-TEX / ISO certificates on request. We can arrange DDP (door-to-door) to EU/US warehouses via our long-term freight forwarder partners.</p>
          <p class="text-sm text-muted-foreground"><strong>Typical duration:</strong> Sea 25-35 days (Asia-EU/US) · Air 5-7 days · <strong>Output:</strong> Goods delivered, full document set emailed</p>
        </div>

        <div>
          <h3 class="reveal font-serif text-2xl mb-3 flex items-baseline gap-3"><span class="text-brand-gold text-3xl font-light">07</span> After-Sales & Reorder Support</h3>
          <p class="text-muted-foreground leading-relaxed mb-2">Defect rate is documented in the inspection report. We replace defective units free of charge (typically 0.5-1.5% of total) within 90 days of receipt. For reorder clients we offer a 5% loyalty discount and priority production slot booking (we reserve capacity 60 days in advance for repeat customers).</p>
          <p class="text-sm text-muted-foreground"><strong>Ongoing:</strong> 90-day defect window · 5% reorder discount · Reserved capacity for established clients</p>
        </div>
      </div>

      <div class="mt-10 p-6 border-l-4 border-brand-gold bg-brand-gold/5 rounded-r">
        <h3 class="reveal font-serif text-xl mb-3">3 Common Pitfalls When Sourcing Cashmere OEM</h3>
        <ol class="list-decimal pl-5 space-y-2 text-muted-foreground">
          <li><strong>Sample cost vs. production cost gap.</strong> Some factories quote low sample cost then triple the production price. We lock the production price in the PI at sample-approval stage — no surprise escalations.</li>
          <li><strong>Hidden MOQ per color.</strong> Industry norm is 100-150 pcs per color per size, not 100 pcs total. Confirm before signing the PI.</li>
          <li><strong>Lead time excluding pre-production.</strong> "15-day lead time" sometimes excludes yarn sourcing (15-25 days) or labeling. Our lead time is end-to-end, signed in the PI.</li>
        </ol>
      </div>

      <div class="mt-10 text-center">
        <a href="/en/contact?type=garment" class="inline-block px-8 py-3 bg-primary text-primary-foreground rounded-none font-medium hover:bg-primary/90 transition-colors">Start Your OEM Inquiry →</a>
      </div>
    </div>
  </section>
  )}

  <SEOFaq faqs={[
    locale === 'cn' ? { q: '成衣 OEM 询盘应提供哪些信息？', a: '请提供产品参考、设计或技术包、目标规格、数量、目的地、打样用途、标签或包装要求及所需文件。' } : { q: 'What should a garment OEM inquiry include?', a: 'Include product references, a design or technical pack, target specifications, quantity, destination, sample purpose, label or packaging requirements and required documents.' },
    locale === 'cn' ? { q: '样品、起订量、价格和交期何时确认？', a: '应结合具体产品、数量、目的地、打样路径和商务背景，在书面报价或销售协议中确认。' } : { q: 'When are sampling, MOQ, price and lead-time terms confirmed?', a: 'They are confirmed against the specific product, quantity, destination, sample route and commercial context in the written quotation or sales agreement.' },
    locale === 'cn' ? { q: '如何准备质量和交付要求？', a: '请在项目沟通中说明验货方式、文件需求、目的地和交付要求，以便将相关条件记录到书面文件中。' } : { q: 'How should quality and delivery requirements be prepared?', a: 'State the inspection approach, document needs, destination and delivery requirements so they can be recorded in the written project documents.' },
  ]} />

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
