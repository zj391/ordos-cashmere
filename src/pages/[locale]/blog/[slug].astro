---
/**
 * Blog 详情页 - 从 src/content/blog/{locale}/{slug}.md 读取
 * 由 scripts/generate-blog.mjs + GitHub Actions 每日自动生成。
 * Schema 策略：仅为可索引且可见内容完整的文章输出 BlogPosting、BreadcrumbList 和 FAQPage。
 */
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { LOCALES, LOCALE_HREFLANG, type Locale, pickLocale } from '@/lib/i18n';
import { SITE_URL } from '@/lib/seo';
import { getCollection, render } from 'astro:content';
import { extractBlogFAQ } from '@/lib/blog-faq';
import { blogHeroImage } from '@/lib/blog-hero';
import { getBlogSlugFromId, isIndexableBlogPost } from '@/lib/blog-indexability';

export async function getStaticPaths() {
  const allBlogPaths = await getCollection('blog');
  const localesBySlug = new Map<string, Locale[]>();

  for (const post of allBlogPaths) {
    const [rawLocale, ...rest] = post.id.split('/');
    const slug = rest.join('/').replace(/\.md$/, '');
    const locale = pickLocale(rawLocale);
    const existing = localesBySlug.get(slug) || [];
    if (!existing.includes(locale)) existing.push(locale);
    localesBySlug.set(slug, existing);
  }

  return allBlogPaths.map((post) => {
    const [rawLocale, ...rest] = post.id.split('/');
    const slug = rest.join('/').replace(/\.md$/, '');
    const locale = pickLocale(rawLocale);
    return {
      params: { locale, slug },
      props: { post, alternateLocales: localesBySlug.get(slug) || [locale] },
    };
  });
}

const { post, alternateLocales } = Astro.props as { post: any; alternateLocales: Locale[] };
const locale = pickLocale(Astro.params.locale);
const slug = getBlogSlugFromId(post.id);
const isIndexable = isIndexableBlogPost(locale, slug);
const { Content } = await render(post);
const articleUrl = `${SITE_URL}/${locale}/blog/${Astro.params.slug}/`;

// 2026-09-23 — Related reading: 在 frontmatter 计算同语言其他博客,
// 按 tag 重叠度 + 发布日期排序, 前 5 条作为底部 "Related Reading" 区块。
// 这给所有 86+ 篇博客自动获得 3-5 个内部链接, 改善 SEO orphan 问题。
const allBlogPosts = await getCollection('blog');
const myTags = new Set((post.data.tags || []).map((t: string) => t.toLowerCase()));
type RelatedPost = { slug: string; title: string; excerpt: string; score: number; dateMs: number };
const relatedPosts: RelatedPost[] = [];
for (const p of allBlogPosts) {
  if (p.id === post.id) continue;
  if (!p.id.startsWith(locale + '/')) continue;
  const pSlug = getBlogSlugFromId(p.id);
  const theirTags = (p.data.tags || []).map((t: string) => String(t).toLowerCase());
  const overlap = theirTags.filter((t: string) => myTags.has(t)).length;
  const dateMs = p.data.publishDate?.getTime?.() || 0;
  relatedPosts.push({
    slug: pSlug,
    title: String(p.data.title || ''),
    excerpt: String(p.data.excerpt || '').replace(/\s+/g, ' ').slice(0, 140),
    score: overlap,
    dateMs,
  });
}
// Sort: most overlapping tags first; tiebreaker = most recent
relatedPosts.sort((a, b) => (b.score - a.score) || (b.dateMs - a.dateMs));
const relatedByTags = relatedPosts.filter((r) => r.score > 0).slice(0, 5);
if (relatedByTags.length < 3) {
  const fallback = relatedPosts
    .filter((r) => r.score === 0 && !relatedByTags.some((x) => x.slug === r.slug))
    .slice(0, 5 - relatedByTags.length);
  relatedByTags.push(...fallback);
}
const relatedReading = relatedByTags.slice(0, 5);
const schemaLabels = {
  en: { home: 'Home', blog: 'Blog', blogName: 'DONGXIAO Cashmere Sourcing Notes' },
  cn: { home: '首页', blog: '博客', blogName: '东霄羊绒采购笔记' },
  de: { home: 'Startseite', blog: 'Blog', blogName: 'DONGXIAO Kaschmir-Beschaffungsnotizen' },
  fr: { home: 'Accueil', blog: 'Blog', blogName: 'Notes d’approvisionnement cachemire DONGXIAO' },
  ja: { home: 'ホーム', blog: 'ブログ', blogName: 'DONGXIAO カシミヤ調達ノート' },
  kr: { home: '홈', blog: '블로그', blogName: 'DONGXIAO 캐시미어 소싱 노트' },
}[locale] || { home: 'Home', blog: 'Blog', blogName: 'DONGXIAO Cashmere Sourcing Notes' };
const articleWordCount = ['en', 'de', 'fr'].includes(locale)
  ? post.body?.trim().split(/\s+/).filter(Boolean).length
  : undefined;

// 2026-08-19: hero image picked from blog tags using curated brand images.
// Visual differentiation across 1566 blog posts without storing 1566 hero images.
const heroImage = blogHeroImage(post.data.tags || [], post.data.title || '');

// SERP 优化（2026-09-23）：如果 frontmatter 写了 metaTitle/metaDescription，
// 用短版给 <title> 和 <meta description>。否则 fallback 到 title/excerpt。
// SERP 显示 title 受 ~60 chars 限制、description 受 ~160 chars 限制，
// 超长会被 Google 截断到省略号，关键词消失在前几 char 之外 = CTR 损失。
const MAX_META_TITLE = 60;
const MAX_META_DESC = 160;

function trimTo(text: string, max: number): string {
  if (text.length <= max) return text;
  // Prefer ending at a word boundary
  const cut = text.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > max - 15 ? cut.slice(0, lastSpace) : cut).trimEnd() + '…';
}

const rawMetaTitle = (post.data as any).metaTitle;
const rawMetaDesc = (post.data as any).metaDescription;
const serpTitle = (typeof rawMetaTitle === 'string' && rawMetaTitle.trim())
  ? rawMetaTitle.trim()
  : trimTo(String(post.data.title || ''), MAX_META_TITLE);
const serpDesc = (typeof rawMetaDesc === 'string' && rawMetaDesc.trim())
  ? rawMetaDesc.trim()
  : trimTo(String(post.data.excerpt || ''), MAX_META_DESC);

// Schema.org Article + BlogPosting for SEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: serpTitle,
  description: serpDesc,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    name: 'DONGXIAO® Cashmere',
    legalName: 'Ordos Dongxiao Cashmere Co., Ltd.',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/logo.svg`,
      width: 600,
      height: 60,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${SITE_URL}/${locale}/blog/#blog`,
    name: schemaLabels.blogName,
    url: `${SITE_URL}/${locale}/blog/`,
    inLanguage: LOCALE_HREFLANG[locale],
  },
  url: articleUrl,
  image: {
    '@type': 'ImageObject',
    url: heroImage.path,
    width: heroImage.width,
    height: heroImage.height,
    caption: heroImage.alt,
  },
  keywords: (post.data.targetKeywords || []).join(', '),
  inLanguage: LOCALE_HREFLANG[locale],
  articleSection: schemaLabels.blog,
  ...(articleWordCount ? { wordCount: articleWordCount } : {}),
  isAccessibleForFree: true,
};


// Breadcrumb JSON-LD（首页 → 博客 → 文章）
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: schemaLabels.home, item: `${SITE_URL}/${locale}/` },
    { '@type': 'ListItem', position: 2, name: schemaLabels.blog, item: `${SITE_URL}/${locale}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};

const t: Record<string, Record<string, string>> = {
  en: { backToBlog: '← Back to Blog', readTime: 'min read', publishedOn: 'Published', tags: 'Tags' },
  cn: { backToBlog: '← 返回博客', readTime: '分钟阅读', publishedOn: '发布于', tags: '标签' },
  de: { backToBlog: '← Zurück zum Blog', readTime: 'Min. Lesezeit', publishedOn: 'Veröffentlicht', tags: 'Schlagwörter' },
  fr: { backToBlog: '← Retour au blog', readTime: 'min de lecture', publishedOn: 'Publié le', tags: 'Mots-clés' },
  ja: { backToBlog: '← ブログに戻る', readTime: '分読む', publishedOn: '公開日', tags: 'タグ' },
  kr: { backToBlog: '← 블로그로', readTime: '분 소요', publishedOn: '게시일', tags: '태그' },
};
const T = (k: string) => t[locale]?.[k] || t.en[k] || k;

// 估算阅读时间（按 200 wpm）
const wordCount = post.body?.split(/\s+/).length || 0;
const readMin = Math.max(1, Math.round(wordCount / 200));

// Auto-extract FAQ block from the markdown body so the page emits FAQPage JSON-LD.
// 2026-08-20 SEO: pass locale so extractBlogFAQ can use language-specific
// question-word heuristics (e.g. "Was/Wie" in DE, "何/怎么" in CN/JA).
const blogFAQ = extractBlogFAQ(post.body, 4, locale);
---

<BaseLayout
  locale={locale}
  pageKey="blog"
  path={`/blog/${Astro.params.slug}`}
  alternateLocales={alternateLocales}
  title={serpTitle}
  description={serpDesc}
  ogType="article"
  ogImage={heroImage.path}
  schema="blog"
  noIndex={!isIndexable}
  suppressDefaultBreadcrumb={true}
  faqs={isIndexable ? blogFAQ : []}
  customSchemas={isIndexable ? [articleSchema, breadcrumbSchema] : []}
>
  <Fragment slot="head">
    <Fragment set:html={(() => {
      // Astro 5 限制：{} 表达式里不能 return JSX 元素数组（报 "Expected '>' but found 'class'"），
      // 所以用 set:html + 字符串拼接 + tag 转义
      const tagMetas = (post.data.tags || [])
        .map((t: string) => `<meta property="article:tag" content="${String(t).replace(/"/g, '&quot;')}" />`)
        .join('');
      return `
      <!-- Article-specific Open Graph meta (extends base OG) -->
      <meta property="article:published_time" content="${post.data.publishDate.toISOString()}" />
      <meta property="article:modified_time" content="${(post.data.updatedDate || post.data.publishDate).toISOString()}" />
      <meta property="article:author" content="${String(post.data.author || '').replace(/"/g, '&quot;')}" />
      <meta property="article:section" content="B2B Cashmere Sourcing" />
      ${tagMetas}
      <meta property="article:locale" content="${locale}" />
      <meta property="og:image:width" content="${heroImage.width}" />
      <meta property="og:image:height" content="${heroImage.height}" />
      <meta property="og:image:alt" content="${heroImage.alt.replace(/"/g, '&quot;')}" />
      <meta name="twitter:image:alt" content="${heroImage.alt.replace(/"/g, '&quot;')}" />

      <!-- Twitter: site + creator -->
      <meta name="twitter:site" content="@dongxiaocashmere" />
      <meta name="twitter:creator" content="@dongxiaocashmere" />

      <!-- BlogPosting + Breadcrumb JSON-LD moved to BaseLayout customSchemas (2026-08-19: JSON-LD @graph consolidation) -->
    `;
    })()} />
  </Fragment>

  <Navigation slot="header" locale={locale} currentPath={`/${locale}/blog/${Astro.params.slug}`} availableLocales={alternateLocales} />

  <article class="pt-32 pb-16 container-narrow max-w-3xl">
    <a href={`/${locale}/blog/`} class="text-sm text-muted-foreground hover:text-primary mb-8 inline-block">{T('backToBlog')}</a>

    <header class="mb-12">
      <h1 class="font-display text-4xl md:text-5xl font-light leading-tight mb-6">{post.data.title}</h1>
      <p class="text-xl text-muted-foreground leading-relaxed mb-6">{post.data.excerpt}</p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground border-y border-border py-4">
        <span><strong class="text-foreground">{T('publishedOn')}:</strong> {post.data.publishDate.toISOString().slice(0, 10)}</span>
        <span>·</span>
        <span>{readMin} {T('readTime')}</span>
        <span>·</span>
        <span><strong class="text-foreground">{post.data.author}</strong></span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-2 py-1 bg-muted text-muted-foreground rounded-full">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {blogFAQ.length > 0 && (
      <details class="mt-12 pt-6 border-t border-stone-200 open:bg-transparent" open>
        <summary class="font-display text-xl cursor-pointer list-none flex items-center justify-between">
          <span>Quick answers from this article</span>
          <svg class="w-5 h-5 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <dl class="mt-4 space-y-4">
          {blogFAQ.map((f) => (
            <div>
              <dt class="font-medium">{f.question}</dt>
              <dd class="text-sm text-muted-foreground leading-relaxed mt-1">{f.answer}</dd>
            </div>
          ))}
        </dl>
      </details>
    )}

    <footer class="mt-16 pt-8 border-t border-border">
      <div class="card-editorial p-6">
        <h3 class="font-display text-xl mb-2">{locale === 'cn' ? '需要报价？' : 'Need a quotation?'}</h3>
        <p class="text-muted-foreground mb-4">
          {locale === 'cn'
            ? '请提供产品类型、数量、目的地和资料需求；适用范围与项目条件将在书面沟通中确认。'
            : 'Share the product type, quantity, destination and documentation needs; the applicable scope and project terms are confirmed in writing.'}
        </p>
        <a href={`/${locale}/contact/`} class="btn-tier-1">
          {locale === 'cn' ? '索取报价 →' : 'Request a Quote →'}
        </a>
      </div>

      {/* Related Products: 内部链接到 category hub 页面, 让 Google 看到 blog → product 信号 */}
      {post.data.relatedProducts && post.data.relatedProducts.length > 0 && (() => {
        const links: { id: string; label: string; href: string }[] = [
          { id: 'raw_material', label: locale === 'cn' ? '羊绒原料 — 白绒/青绒/紫绒' : 'Cashmere Raw Material — white, brown, purple', href: `/${locale}/raw-material` },
          { id: 'yarn_fabric', label: locale === 'cn' ? '羊绒纱线产品记录 — 精纺、粗纺、筒纱与绞纱' : 'Cashmere Yarn Product Records — worsted, woollen, cone & hank', href: `/${locale}/products/yarn/` },
          { id: 'garment_oem', label: locale === 'cn' ? '羊绒成衣 OEM — 针织代工' : 'Cashmere Garment OEM/ODM', href: `/${locale}/garment-oem` },
          { id: 'factory', label: locale === 'cn' ? '羊绒质量核验准备' : 'Cashmere Quality-Verification Preparation', href: `/${locale}/quality-control/` },
          { id: 'cashmere_yarn', label: locale === 'cn' ? '纱线支数指南' : 'Cashmere Yarn Types & Counts', href: `/${locale}/cashmere-yarn-types` },
          { id: 'cashmere_grades', label: locale === 'cn' ? '羊绒等级鉴别' : 'Cashmere Grades Guide', href: `/${locale}/cashmere-grades` },
        ];
        const matched = links.filter((l) => post.data.relatedProducts.includes(l.id));
        if (matched.length === 0) return null;
        return (
          <div class="mt-12 pt-8 border-t border-border">
            <h3 class="font-display text-xl font-medium mb-4">
              {locale === 'cn' ? '相关产品' : 'Related Products'}
            </h3>
            <ul class="space-y-2">
              {matched.map((l) => (
                <li>
                  <a href={l.href} class="btn-tier-3">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })()}
    </footer>

    {/*
      Related reading: 内部链接到同语言的其他博客（2026-09-23 SEO 加分）。
      数据由 frontmatter 计算（按 tag 重叠度），给所有 86+ 篇博客自动获得
      3-5 个内部链接, 提升爬虫可达性 + 降低 orphan 比例。
    */}
    {relatedReading.length > 0 && (
      <aside class="mt-12 pt-8 border-t border-border">
        <h3 class="font-display text-xl font-medium mb-4">
          {locale === 'cn' ? '延伸阅读' : 'Related Reading'}
        </h3>
        <ul class="space-y-3">
          {relatedReading.map((r) => (
            <li>
              <a
                href={`/${locale}/blog/${r.slug}/`}
                class="block group hover:bg-stone-50 -mx-2 px-2 py-2 rounded transition-colors"
              >
                <div class="font-medium group-hover:text-brand-camel transition-colors">
                  {r.title}
                </div>
                {r.excerpt && (
                  <div class="text-sm text-muted-foreground mt-1">{r.excerpt}…</div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="mt-10 flex items-center gap-3">
      <span class="text-xs uppercase tracking-wider text-muted-foreground">{locale === 'cn' ? '分享到 LinkedIn' : 'Share on LinkedIn'}</span>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${SITE_URL}/${locale}/blog/${Astro.params.slug}/`)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-primary hover:text-brand-camel transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg> {locale === 'cn' ? '分享' : 'Share'}
      </a>
    </div>
  </article>

  <Footer slot="footer" locale={locale} availableLocales={alternateLocales} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>
