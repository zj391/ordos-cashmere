---

/**

 * Factory 工厂介绍页

 */

export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';

import Navigation from '@/components/Navigation.astro';

import Footer from '@/components/Footer.astro';

import FloatingChatButtons from '@/components/FloatingChatButtons.astro';

import CookieConsent from '@/components/CookieConsent.astro';

import SEOFaq from '@/components/SEOFaq.astro';

import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';



export function getStaticPaths() {

  return LOCALES.map((locale) => ({ params: { locale } }));

}



const { locale: rawLocale } = Astro.params;

const locale = pickLocale(rawLocale);



const t: Record<string, Record<string, string>> = {

  en: {

        tagline: 'OUR FACTORY \xc2\xb7 GROUP',
    title: 'Group Strength',
    subtitle: '38,000 sqm \xc2\xb7 500+ workers \xc2\xb7 1,200t annual capacity. ISO/OEKO-TEX certified source factory group in Ordos. Full collection: knitwear, woven scarves, accessories, childrenswear.',

    scaleTitle: 'Scale & capacity',

    scaleSub: 'A vertically integrated facility, from dehairing to finished knitwear.',

    equipTitle: 'Equipment',

    equipSub: 'Italian, German, Japanese, Swiss machinery. Best-in-class for cashmere.',

    certTitle: 'Certifications',

    ctaTitle: 'Visit our factory',

    ctaSub: 'B2B clients welcome for on-site visits. 7-day advance notice.',

    cta: 'Schedule a visit',

  },

  cn: {

        tagline: '集团工厂 \xc2\xb7 实力',
    title: '集团\n实力',
    subtitle: '38,000平米厂房 \xc2\xb7 500+员工 \xc2\xb7 年产能1,200吨 \xc2\xb7 ISO/OEKO-TEX 认证源头集团。针织、梭织围巾、配饰、童装全品类。',

    scaleTitle: '规模与产能',

    scaleSub: '全产业链垂直整合，从原料分梳到成衣出厂。',

    equipTitle: '生产设备',

    equipSub: '意大利、德国、日本、瑞士设备，全球顶级羊绒生产配置。',

    certTitle: '资质认证',

    ctaTitle: '预约考察',

    ctaSub: '欢迎 B2B 客户实地考察，提前 7 天预约。',

    cta: '预约参观',

  },

  de: { tagline: 'FABRIK', title: 'Fabrik-\nstärke', subtitle: '38.000 qm · 500+ Mitarbeiter · 1.200t Jahreskapazität', scaleTitle: 'Maßstab', scaleSub: 'Vertikal integriert.', equipTitle: 'Ausrüstung', equipSub: 'Italienische, deutsche, japanische, schweizer Maschinen.', certTitle: 'Zertifizierungen', ctaTitle: 'Werk besuchen', ctaSub: '7 Tage Vorlauf.', cta: 'Besuch planen' },

  fr: { tagline: 'USINE', title: 'Force de\nl\'usine', subtitle: '38 000 m² · 500+ · 1 200t capacité', scaleTitle: 'Échelle', scaleSub: 'Intégration verticale.', equipTitle: 'Équipement', equipSub: 'Machines italiennes, allemandes, japonaises, suisses.', certTitle: 'Certifications', ctaTitle: 'Visiter l\'usine', ctaSub: 'Préavis 7 jours.', cta: 'Planifier' },

  ja: { tagline: '工場', title: '工場の\n強み', subtitle: '38,000平米 · 500名+ · 年間1,200トン', scaleTitle: '規模・能力', scaleSub: '垂直統合。', equipTitle: '設備', equipSub: '伊・独・日・スイス製。', certTitle: '認証', ctaTitle: '工場見学', ctaSub: '7日前予約。', cta: '予約' },

  kr: { tagline: '공장', title: '공장\n강점', subtitle: '38,000 sqm · 500+ · 연 1,200톤', scaleTitle: '규모', scaleSub: '수직 통합.', equipTitle: '설비', equipSub: '이탈리아·독일·일본·스위스.', certTitle: '인증', ctaTitle: '공장 방문', ctaSub: '7일 사전 예약.', cta: '예약' },

};

const T = (k: string) => t[locale]?.[k] || t.en[k] || k;



const parseCounter = (v: string): { n: number; s: string } => {
  const m = v.match(/^(?:[^\d]*?)(\d[\d,]*)(.*)$/);
  if (!m) return { n: 0, s: v };
  const n = parseInt(m[1].replace(/,/g, ''), 10);
  return { n: Number.isFinite(n) ? n : 0, s: m[2] || '' };
};
const scale = [
  { value: '38,000', unit: 'm²', label: locale === 'cn' ? '厂房面积' : 'Factory Area' },
  { value: '500+', unit: '', label: locale === 'cn' ? '员工' : 'Employees' },
  { value: '1,200', unit: 't', label: locale === 'cn' ? '年产能' : 'Annual Capacity' },
  { value: '50+', unit: '', label: locale === 'cn' ? '出口国家' : 'Export Countries' },
  { value: '23+', unit: 'yrs', label: locale === 'cn' ? '行业经验' : 'Years of Excellence' },
    { value: '6', unit: '', label: locale === 'cn' ? '终童模式' : 'Business Models' },
{ value: '7', unit: '', label: locale === 'cn' ? '国际认证' : 'Certifications' },
];
const scaleItems = scale.map((s) => ({ ...s, counter: parseCounter(s.value) }));



const equipment = [

  { name: locale === 'cn' ? '意大利梳绒机' : 'Italian Dehairing Lines', spec: '12 lines' },

  { name: locale === 'cn' ? '日本岛精横机' : 'Shima Seiki Flatbed', spec: '48 machines' },

  { name: locale === 'cn' ? '德国斯托尔电脑横机' : 'Stoll CMS Knitting', spec: '24 machines' },

  { name: locale === 'cn' ? '意大利络筒机' : 'Italian Winding Lines', spec: '8 lines' },

  { name: locale === 'cn' ? '瑞士乌斯特检测仪' : 'Uster Tester', spec: '6 units' },

  { name: locale === 'cn' ? '全自动包装线' : 'Auto Packing Lines', spec: '4 lines' },

];



const certs = ['ISO 9001:2015', 'OEKO-TEX®', 'Good Cashmere Standard', 'BSCI', 'Sedex SMETA', 'WRAP', 'SFA'];

---



    <BaseLayout locale={locale} pageKey="factory" path="/factory">
  <Navigation slot="header" locale={locale} currentPath={`/${locale}/factory`} />

  <!-- ============ HERO：全屏沉浸式 ============ -->
  <section class="relative min-h-[80vh] flex items-end overflow-hidden bg-brand-ink">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-ink/70 to-brand-ink"></div>
    <div class="container-narrow relative z-10 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="h-[2px] w-12 bg-brand-red"></span>
          <span class="text-xs tracking-[0.4em] uppercase text-brand-gold font-medium">{T('tagline')}</span>
        </div>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-light text-white leading-[1.05] mb-6" set:html={T('title').replace(/\n/g, '<br/>')} />
        <p class="text-lg md:text-xl text-white/80 leading-relaxed max-w-2xl font-light mb-10">{T('subtitle')}</p>
        <div class="flex flex-wrap gap-4">
          <a href={`/${locale}/contact?type=visit`} class="inline-flex items-center gap-2 px-9 py-4 bg-brand-gold text-brand-ink font-medium tracking-wider hover:bg-white transition-colors">
            {T('cta')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href={`/${locale}/download/`} class="inline-flex items-center gap-2 px-9 py-4 border border-white/30 text-white hover:border-brand-gold hover:text-brand-gold transition-colors">
            {locale === 'cn' ? '下载认证文件' : 'Download Certificates'}
          </a>
        </div>
      </div>

      <!-- 底部关键数据条 -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-px bg-white/15 border border-white/10">
        {scale.slice(0, 4).map((s, i) => (
          <div class="bg-brand-ink/70 backdrop-blur-sm px-6 py-6 text-center">
            <div class="font-serif text-3xl md:text-4xl font-light text-brand-gold leading-none mb-2">{s.value}{s.unit && <span class="text-sm text-white/60 ml-1">{s.unit}</span>}</div>
            <div class="text-[11px] uppercase tracking-[0.2em] text-white/60">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 公司简介 ============ -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">{locale === 'cn' ? '公司简介' : 'Company Profile'}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '鄂尔多斯市东霄羊绒制品厂' : 'Erdos Dongxiao Cashmere Products Factory'}</h2>
      </div>
      {locale === 'cn' ? (
        <div class="max-w-3xl space-y-4 text-muted-foreground leading-relaxed">
          <p>鄂尔多斯市东霄羊绒制品厂成立于 2002 年，位于资源富饶、羊煤土气的内蒙古“鄂尔多斯”市，是一家集自主设计开发、生产、营销、加工于一体的专业化羊绒制品厂。主营产品有纯羊绒、纯羊毛、羊绒/羊毛混纺制品（毛衣、纱线、外衣、围巾、手套、袜子、毯子等）。</p>
          <p>经过 22 年的发展，现已形成 ODM/OEM 生产加工、来样定做、实体批发、品牌加盟、一件代发、线上线下一体化的综合性经营模式。</p>
          <p>我们以质量求生存、以信誉促发展，凭借品类多、品种全、价格稳定、质量卓越的产品和薄利多销、服务周到的经营理念，赢得广大羊绒客商的一致认可。我们的信念是“诚信合作、互惠互利、共同发展”，愿与每一位客户实现共赢。</p>
        </div>
      ) : (
        <div class="max-w-3xl space-y-4 text-muted-foreground leading-relaxed">
          <p>Erdos Dongxiao Cashmere Products Factory, founded in 2002 in Ordos, Inner Mongolia — a region rich in natural resources — is a professional cashmere factory integrating independent design and development, production, marketing, and processing.</p>
          <p>Main products include pure cashmere, pure wool, and cashmere/wool blends: sweaters, yarn, coats, scarves, gloves, socks, blankets, and more. After 22 years of growth, we run a full business model — ODM/OEM manufacturing, sample customization, physical wholesale, brand franchise, drop shipping, and online/offline integration.</p>
          <p>We survive on quality, develop on reputation, and serve with small margins and thoughtful service. Our belief: “Integrity cooperation, mutual benefit, common development.”</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ 01 规模与产能 ============ -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">01 / {T('scaleTitle')}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('scaleTitle')}</h2>
        <p class="text-muted-foreground leading-relaxed">{T('scaleSub')}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-border">
        {scaleItems.map((s, i) => {
          const cv = s.counter;
          return (
          <div class="bg-background p-8 md:p-10 hover:bg-brand-cream/30 transition-colors group">
            <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 flex items-baseline justify-between">
              <span>{s.label}</span>
              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="counter font-serif text-4xl md:text-5xl text-brand-chocolate font-light group-hover:text-brand-gold transition-colors" data-counter={cv.n} data-suffix={cv.s} data-display={s.value}>{s.value}</span>
              {s.unit && <span class="text-sm text-muted-foreground">{s.unit}</span>}
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ 02 厂区实拍：杂志式拼贴 ============ -->
  <section class="py-24 md:py-32 bg-brand-cream/50 border-y border-border">
    <div class="container-narrow">
      <div class="flex items-end justify-between mb-16 gap-6 flex-wrap">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-[2px] w-8 bg-brand-red"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">02 / {locale === 'cn' ? '厂区实拍' : 'Inside the Factory'}</span>
          </div>
          <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '车间与展会，眼见为实' : 'Workshops & exhibitions, in real light'}</h2>
          <p class="text-muted-foreground leading-relaxed">{locale === 'cn' ? '从原料分梳到成品检验，全部自有产能。欢迎实地考察，眼见为实。' : 'From dehairing to final QC — every step under our own roof. On-site visits welcome.'}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-5">
        <!-- 大图：车间 -->
        <div class="md:col-span-7 relative aspect-[4/3] overflow-hidden group">
          <img src="/images/factory/page2-factory-floor.webp" alt="DONGXIAO factory floor - raw material dehairing and spinning workshops" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <div class="font-serif text-xl md:text-2xl font-light">{locale === 'cn' ? '原料分梳与纺纱车间' : 'Dehairing & spinning workshops'}</div>
            <div class="text-xs text-white/70 mt-1 tracking-wider">{locale === 'cn' ? '意大利分梳线 · 精纺车间' : 'Italian dehairing lines · worsted spinning'}</div>
          </div>
        </div>
        <!-- 小图：展会 -->
        <div class="md:col-span-5 relative aspect-[4/3] md:aspect-auto md:min-h-[280px] overflow-hidden group">
          <img src="/images/factory/page3-exhibition.webp" alt="DONGXIAO at international cashmere trade exhibitions" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <div class="font-serif text-xl md:text-2xl font-light">{locale === 'cn' ? '国际展会' : 'Trade exhibitions'}</div>
            <div class="text-xs text-white/70 mt-1 tracking-wider">{locale === 'cn' ? '全球 B2B 买家面对面' : 'Face-to-face with global B2B buyers'}</div>
          </div>
        </div>
        <!-- 小图：色卡织造 -->
        <div class="md:col-span-5 relative aspect-[4/3] md:aspect-auto md:min-h-[280px] overflow-hidden group">
          <img src="/images/factory/page9-colorcard-weaving.webp" alt="Color card and weaving detail - Nm2/26 cashmere yarn range" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <div class="font-serif text-xl md:text-2xl font-light">{locale === 'cn' ? '色卡与织造细节' : 'Color cards & weaving detail'}</div>
            <div class="text-xs text-white/70 mt-1 tracking-wider">{locale === 'cn' ? 'Nm2/26 起全支数纱线' : 'Full yarn count range from Nm2/26'}</div>
          </div>
        </div>
        <!-- 文字面板 -->
        <div class="md:col-span-7 bg-brand-chocolate text-white p-8 md:p-12 flex flex-col justify-center min-h-[280px]">
          <div class="font-serif text-2xl md:text-3xl font-light leading-snug mb-6">
            {locale === 'cn' ? '自有牧场 → 分梳 → 纺纱 → 织造 → 水洗 → 检验 → 出运' : 'Pasture → dehairing → spinning → knitting/weaving → washing → QC → shipment'}
          </div>
          <p class="text-white/70 leading-relaxed mb-8">{locale === 'cn' ? '全链路垂直整合，每一道工序都在集团内部完成——这就是我们敢让客户实地验厂的原因。' : 'Every step under one group. That is why we welcome unannounced factory audits.'}</p>
          <div class="grid grid-cols-3 gap-6">
            <div>
              <div class="font-serif text-3xl text-brand-gold">100%</div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/60 mt-1">{locale === 'cn' ? '自有产能' : 'In-house'}</div>
            </div>
            <div>
              <div class="font-serif text-3xl text-brand-gold">5</div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/60 mt-1">{locale === 'cn' ? '道质检' : 'QC stages'}</div>
            </div>
            <div>
              <div class="font-serif text-3xl text-brand-gold">7</div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/60 mt-1">{locale === 'cn' ? '天出样' : 'Day sample'}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 生产设备 ============ -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">03 / {T('equipTitle')}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('equipTitle')}</h2>
        <p class="text-muted-foreground leading-relaxed">{T('equipSub')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border">
        {equipment.map((e, i) => (
          <div class="bg-background p-6 md:p-8 flex justify-between items-center group hover:bg-brand-cream/30 transition-colors">
            <div class="flex items-baseline gap-3">
              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
              <span class="font-serif text-xl group-hover:text-brand-chocolate transition-colors">{e.name}</span>
            </div>
            <span class="text-sm text-muted-foreground">{e.spec}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 04 资质认证 ============ -->
  <section class="py-24 md:py-32 bg-brand-cream/50 border-y border-border">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">04 / {T('certTitle')}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight">{T('certTitle')}</h2>
      </div>

      <div class="flex flex-wrap gap-4">
        {certs.map((cert, i) => (
          <div class="px-7 py-4 border border-brand-gold/40 rounded-full hover:border-brand-gold hover:bg-brand-gold/5 transition-colors group flex items-center gap-3">
            <span class="font-serif text-xs text-brand-gold/60">{String(i+1).padStart(2,'0')}</span>
            <span class="font-serif text-base text-brand-chocolate tracking-wide">{cert}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 05 全品类（图卡） ============ -->
  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow">
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-[2px] w-8 bg-brand-red"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">05 / {locale === 'cn' ? '产品类别' : 'Product Range'}</span>
        </div>
        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '产品类别' : 'Full Product Range'}</h2>
        <p class="text-muted-foreground leading-relaxed">{locale === 'cn' ? '针织、梭织围巾、配饰、童装 — 集团全系列覆盖。' : 'Knitwear, woven scarves, accessories, childrenswear — all groups under one factory.'}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href={`/${locale}/products/garment-oem/`} class="group relative aspect-[3/4] overflow-hidden bg-brand-ink">
          <img src="/images/factory/page6-menswear.webp" alt="Knit garments from DONGXIAO - men's cashmere pullovers and sweaters" class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-opacity transition-transform duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/85 via-brand-ink/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <div class="font-serif text-xs text-brand-gold/70 mb-1">01</div>
            <h3 class="font-serif text-2xl text-white mb-1">{locale === 'cn' ? '针织成衣' : 'Knit Garments'}</h3>
            <p class="text-sm text-white/75">{locale === 'cn' ? '男装、女装、童装。Nm2/26 至 Nm2/36/2 全支数。' : 'Men\'s, women\'s, children\'s. Nm2/26 to Nm2/36/2.'}</p>
          </div>
        </a>
        <a href={`/${locale}/products/scarves/`} class="group relative aspect-[3/4] overflow-hidden bg-brand-ink">
          <img src="/images/factory/page5-sets.webp" alt="Woven cashmere scarves and shawls" class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-opacity transition-transform duration-700" loading="lazy" decoding="async" />
