---

/**

 * Factory 工厂介绍页

 */

export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';

import Navigation from '@/components/Navigation.astro';

import Footer from '@/components/Footer.astro';

import FloatingChatButtons from '@/components/FloatingChatButtons.astro';

import CookieConsent from '@/components/CookieConsent.astro';

import SEOFaq from '@/components/SEOFaq.astro';

import { LOCALES, type Locale, isLocale, pickLocale } from '@/lib/i18n';



export function getStaticPaths() {

  return LOCALES.map((locale) => ({ params: { locale } }));

}



const { locale: rawLocale } = Astro.params;

const locale = pickLocale(rawLocale);



const t: Record<string, Record<string, string>> = {

  en: {

        tagline: 'OUR FACTORY \xc2\xb7 GROUP',
    title: 'Group Strength',
    subtitle: '38,000 sqm \xc2\xb7 500+ workers \xc2\xb7 1,200t annual capacity. ISO/OEKO-TEX certified source factory group in Ordos. Full collection: knitwear, woven scarves, accessories, childrenswear.',

    scaleTitle: 'Scale & capacity',

    scaleSub: 'A vertically integrated facility, from dehairing to finished knitwear.',

    equipTitle: 'Equipment',

    equipSub: 'Italian, German, Japanese, Swiss machinery. Best-in-class for cashmere.',

    certTitle: 'Certifications',

    ctaTitle: 'Visit our factory',

    ctaSub: 'B2B clients welcome for on-site visits. 7-day advance notice.',

    cta: 'Schedule a visit',

  },

  cn: {

        tagline: '集团工厂 \xc2\xb7 实力',
    title: '集团\n实力',
    subtitle: '38,000平米厂房 \xc2\xb7 500+员工 \xc2\xb7 年产能1,200吨 \xc2\xb7 ISO/OEKO-TEX 认证源头集团。针织、梭织回巾、配饰、童装全品类。',

    scaleTitle: '规模与产能',

    scaleSub: '全产业链垂直整合，从原料分梳到成衣出厂。',

    equipTitle: '生产设备',

    equipSub: '意大利、德国、日本、瑞士设备，全球顶级羊绒生产配置。',

    certTitle: '资质认证',

    ctaTitle: '预约考察',

    ctaSub: '欢迎 B2B 客户实地考察，提前 7 天预约。',

    cta: '预约参观',

  },

  de: { tagline: 'FABRIK', title: 'Fabrik-\nstärke', subtitle: '38.000 qm · 500+ Mitarbeiter · 1.200t Jahreskapazität', scaleTitle: 'Maßstab', scaleSub: 'Vertikal integriert.', equipTitle: 'Ausrüstung', equipSub: 'Italienische, deutsche, japanische, schweizer Maschinen.', certTitle: 'Zertifizierungen', ctaTitle: 'Werk besuchen', ctaSub: '7 Tage Vorlauf.', cta: 'Besuch planen' },

  fr: { tagline: 'USINE', title: 'Force de\nl\'usine', subtitle: '38 000 m² · 500+ · 1 200t capacité', scaleTitle: 'Échelle', scaleSub: 'Intégration verticale.', equipTitle: 'Équipement', equipSub: 'Machines italiennes, allemandes, japonaises, suisses.', certTitle: 'Certifications', ctaTitle: 'Visiter l\'usine', ctaSub: 'Préavis 7 jours.', cta: 'Planifier' },

  ja: { tagline: '工場', title: '工場の\n強み', subtitle: '38,000平米 · 500名+ · 年間1,200トン', scaleTitle: '規模・能力', scaleSub: '垂直統合。', equipTitle: '設備', equipSub: '伊・独・日・スイス製。', certTitle: '認証', ctaTitle: '工場見学', ctaSub: '7日前予約。', cta: '予約' },

  kr: { tagline: '공장', title: '공장\n강점', subtitle: '38,000 sqm · 500+ · 연 1,200톤', scaleTitle: '규모', scaleSub: '수직 통합.', equipTitle: '설비', equipSub: '이탈리아·독일·일본·스위스.', certTitle: '인증', ctaTitle: '공장 방문', ctaSub: '7일 사전 예약.', cta: '예약' },

};

const T = (k: string) => t[locale]?.[k] || t.en[k] || k;



const parseCounter = (v: string): { n: number; s: string } => {
  const m = v.match(/^(?:[^\d]*?)(\d[\d,]*)(.*)$/);
  if (!m) return { n: 0, s: v };
  const n = parseInt(m[1].replace(/,/g, ''), 10);
  return { n: Number.isFinite(n) ? n : 0, s: m[2] || '' };
};
const scale = [
  { value: '38,000', unit: 'm²', label: locale === 'cn' ? '厂房面积' : 'Factory Area' },
  { value: '500+', unit: '', label: locale === 'cn' ? '员工' : 'Employees' },
  { value: '1,200', unit: 't', label: locale === 'cn' ? '年产能' : 'Annual Capacity' },
  { value: '50+', unit: '', label: locale === 'cn' ? '出口国家' : 'Export Countries' },
  { value: '23+', unit: 'yrs', label: locale === 'cn' ? '行业经验' : 'Years of Excellence' },
    { value: '6', unit: '', label: locale === 'cn' ? '终童模式' : 'Business Models' },
{ value: '7', unit: '', label: locale === 'cn' ? '国际认证' : 'Certifications' },
];
const scaleItems = scale.map((s) => ({ ...s, counter: parseCounter(s.value) }));



const equipment = [

  { name: locale === 'cn' ? '意大利梳绒机' : 'Italian Dehairing Lines', spec: '12 lines' },

  { name: locale === 'cn' ? '日本岛精横机' : 'Shima Seiki Flatbed', spec: '48 machines' },

  { name: locale === 'cn' ? '德国斯托尔电脑横机' : 'Stoll CMS Knitting', spec: '24 machines' },

  { name: locale === 'cn' ? '意大利络筒机' : 'Italian Winding Lines', spec: '8 lines' },

  { name: locale === 'cn' ? '瑞士乌斯特检测仪' : 'Uster Tester', spec: '6 units' },

  { name: locale === 'cn' ? '全自动包装线' : 'Auto Packing Lines', spec: '4 lines' },

];



const certs = ['ISO 9001:2015', 'OEKO-TEX®', 'Good Cashmere Standard', 'BSCI', 'Sedex SMETA', 'WRAP', 'SFA'];

---



<BaseLayout locale={locale} pageKey="factory" path="/factory">

  <Navigation slot="header" locale={locale} currentPath={`/${locale}/factory`} />



  <!-- HERO -->

  <section class="relative bg-brand-ink text-white overflow-hidden">

    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[60vh]">

      <div class="flex items-center py-20 lg:py-0 px-6 lg:pl-12 order-2 lg:order-1">

        <div class="max-w-xl">

          <div class="flex items-center gap-3 mb-8">

            <span class="h-px w-12 bg-brand-gold"></span>

            <span class="text-xs tracking-[0.4em] text-brand-gold uppercase font-medium">{T('tagline')}</span>

          </div>

          <h1 class="font-serif text-5xl md:text-7xl font-light leading-[1.05] mb-8" set:html={T('title').replace(/\n/g, '<br/>')} />

          <p class="text-lg text-white/75 leading-relaxed max-w-md font-light">{T('subtitle')}</p>

        </div>

      </div>

      <div class="relative aspect-[4/3] lg:aspect-auto overflow-hidden order-1 lg:order-2">

        <img src="/images/factory/page1-factory-intro.webp" alt="DONGXIAO Cashmere Group - 23 years manufacturing cashmere in Ordos" class="ken-burns absolute inset-0 w-full h-full object-cover opacity-80" decoding="async" loading="eager" fetchpriority="high" />

        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-brand-ink/60"></div>

      </div>

    </div>

  </section>



  <!-- Scale：6 数据块 -->

  <section class="py-24 md:py-32 bg-background">

    <div class="container-narrow">

      <div class="max-w-2xl mb-16">

        <div class="flex items-center gap-3 mb-4">

          <span class="h-px w-8 bg-brand-gold"></span>

          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">01 / {T('scaleTitle')}</span>

        </div>

        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('scaleTitle')}</h2>

        <p class="text-muted-foreground leading-relaxed">{T('scaleSub')}</p>

      </div>



      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-border">

        {scaleItems.map((s, i) => {
          const cv = s.counter;
          return (
          <div class="bg-background p-8 md:p-10 hover:bg-brand-cream/30 transition-colors group">
            <div class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 flex items-baseline justify-between">
              <span>{s.label}</span>
              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="counter font-serif text-4xl md:text-5xl text-brand-chocolate font-light group-hover:text-brand-gold transition-colors" data-counter={cv.n} data-suffix={cv.s} data-display={s.value}>{s.value}</span>
              {s.unit && <span class="text-sm text-muted-foreground">{s.unit}</span>}
            </div>
          </div>
          );
        })}
      </div>
    </div>

    <!-- Factory floor scene (from PDF page 2) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-4 reveal">
      <div class="aspect-[4/3] overflow-hidden">
        <img src="/images/factory/page2-factory-floor.webp" alt="DONGXIAO factory floor - raw material dehairing and spinning workshops" class="w-full h-full object-cover hover-zoom" loading="lazy" decoding="async" />
      </div>
      <div class="aspect-[4/3] overflow-hidden">
        <img src="/images/factory/page3-exhibition.webp" alt="DONGXIAO at international cashmere trade exhibitions" class="w-full h-full object-cover hover-zoom" loading="lazy" decoding="async" />
      </div>
      <div class="aspect-[4/3] overflow-hidden">
        <img src="/images/factory/page9-colorcard-weaving.webp" alt="Color card and weaving detail - Nm2/26 cashmere yarn range" class="w-full h-full object-cover hover-zoom" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>


  <!-- Equipment -->

  <section class="py-24 md:py-32 bg-brand-cream/50 border-y border-border">

    <div class="container-narrow">

      <div class="max-w-2xl mb-16">

        <div class="flex items-center gap-3 mb-4">

          <span class="h-px w-8 bg-brand-gold"></span>

          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">02 / {T('equipTitle')}</span>

        </div>

        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{T('equipTitle')}</h2>

        <p class="text-muted-foreground leading-relaxed">{T('equipSub')}</p>

      </div>



      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border">

        {equipment.map((e, i) => (

          <div class="bg-brand-cream/30 p-6 md:p-8 flex justify-between items-center group hover:bg-background transition-colors">

            <div class="flex items-baseline gap-3">

              <span class="font-serif text-sm text-brand-gold/50">{String(i+1).padStart(2,'0')}</span>

              <span class="font-serif text-xl group-hover:text-brand-chocolate transition-colors">{e.name}</span>

            </div>

            <span class="text-sm text-muted-foreground">{e.spec}</span>

          </div>

        ))}

      </div>

    </div>

  </section>



  <!-- Certifications -->

  <section class="py-24 md:py-32 bg-background">

    <div class="container-narrow">

      <div class="max-w-2xl mb-16">

        <div class="flex items-center gap-3 mb-4">

          <span class="h-px w-8 bg-brand-gold"></span>

          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">03 / {T('certTitle')}</span>

        </div>

        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight">{T('certTitle')}</h2>

      </div>



      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-6">

        {certs.map((cert) => (

          <div class="aspect-square rounded-full border border-brand-gold/40 flex items-center justify-center hover:border-brand-gold hover:bg-brand-gold/5 transition-all group">

            <span class="font-serif text-sm text-brand-gold tracking-wider text-center px-2 leading-tight">{cert}</span>

          </div>

        ))}

      </div>

    </div>

  </section>



  <!-- Product Categories (from PDF catalogue) -->

  <section class="py-24 md:py-32 bg-brand-cream/50 border-y border-border">

    <div class="container-narrow">

      <div class="max-w-2xl mb-16">

        <div class="flex items-center gap-3 mb-4">

          <span class="h-px w-8 bg-brand-gold"></span>

          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">04 / {locale === 'cn' ? '产品类别' : 'Product Range'}</span>

        </div>

        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '产品类别' : 'Full Product Range'}</h2>

        <p class="text-muted-foreground leading-relaxed">{locale === 'cn' ? '针织、梭织围巾、配饰、童装 — 集团全系列覆盖。' : 'Knitwear, woven scarves, accessories, childrenswear — all groups under one factory.'}</p>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-background rounded-lg overflow-hidden hover-lift group">
          <div class="aspect-square overflow-hidden bg-secondary/30">
            <img src="/images/factory/page6-menswear.webp" alt="Knit garments from DONGXIAO - men's cashmere pullovers and sweaters" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <div class="font-serif text-sm text-brand-gold/50 mb-1">01</div>
            <h3 class="font-serif text-xl mb-2">{locale === 'cn' ? '针织成衣' : 'Knit Garments'}</h3>
            <p class="text-sm text-muted-foreground">{locale === 'cn' ? '男装、女装、童装。Nm2/26 至 Nm2/36/2 全支数纱线。' : 'Men's, women's, children's. Nm2/26 to Nm2/36/2 full count range.'}</p>
          </div>
        </div>
        <div class="bg-background rounded-lg overflow-hidden hover-lift group">
          <div class="aspect-square overflow-hidden bg-secondary/30">
            <img src="/images/factory/page5-sets.webp" alt="Woven cashmere scarves and shawls" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <div class="font-serif text-sm text-brand-gold/50 mb-1">02</div>
            <h3 class="font-serif text-xl mb-2">{locale === 'cn' ? '梭织围巾' : 'Woven Scarves'}</h3>
            <p class="text-sm text-muted-foreground">{locale === 'cn' ? '羊绒披肩、长巾。Nm2/26×2+Nm2/26&1/6.5&1/4.3 多组份。' : 'Cashmere wraps, shawls. Nm2/26×2 + Nm2/26&1/6.5&1/4.3 multi-ply.'}</p>
          </div>
        </div>
        <div class="bg-background rounded-lg overflow-hidden hover-lift group">
          <div class="aspect-square overflow-hidden bg-secondary/30">
            <img src="/images/factory/page8-accessories.webp" alt="Cashmere accessories - hats, gloves, throws" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <div class="font-serif text-sm text-brand-gold/50 mb-1">03</div>
            <h3 class="font-serif text-xl mb-2">{locale === 'cn' ? '配饰系列' : 'Accessories'}</h3>
            <p class="text-sm text-muted-foreground">{locale === 'cn' ? '帽子、手套、披肩、家居纺织品。' : 'Hats, gloves, throws, home textiles. 1×1 to 12GG knit gauge options.'}</p>
          </div>
        </div>
        <div class="bg-background rounded-lg overflow-hidden hover-lift group">
          <div class="aspect-square overflow-hidden bg-secondary/30">
            <img src="/images/factory/page7-childrenswear.webp" alt="DONGXIAO childrenswear - baby and kids cashmere knitwear" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <div class="font-serif text-sm text-brand-gold/50 mb-1">04</div>
            <h3 class="font-serif text-xl mb-2">{locale === 'cn' ? '童童装' : 'Childrenswear'}</h3>
            <p class="text-sm text-muted-foreground">{locale === 'cn' ? '婴幼儿装。可爱款、休闲款，OEKO-TEX 安全标准。' : "Baby & kids' knitwear. Cute & casual styles. OEKO-TEX safe fabric certified."}</p>
          </div>
        </div>
      </div>
    </div>
  </section>


    <!-- Business Models (from PDF catalogue) -->

  <section class="py-24 md:py-32 bg-background">

    <div class="container-narrow">

      <div class="max-w-2xl mb-16">

        <div class="flex items-center gap-3 mb-4">

          <span class="h-px w-8 bg-brand-gold"></span>

          <span class="text-xs tracking-[0.3em] uppercase text-brand-camel">05 / {locale === 'cn' ? '\u7ec8\u7aef\u6a21\u5f0f' : 'Business Models'}</span>

        </div>

        <h2 class="reveal font-serif text-4xl md:text-5xl font-light leading-tight mb-4">{locale === 'cn' ? '\u591a\u5143\u5316\u7ec8\u7aef\u6a21\u5f0f' : 'Six Business Models'}</h2>

        <p class="text-muted-foreground leading-relaxed">{locale === 'cn' ? '\u4ece ODM/OEM \u5236\u9020\u5230\u54c1\u724c\u52a0\u76df\u3001\u5728\u7ebf\u7ebf\u4e0b\u4e00\u4f53\u5316 \u2014 \u9002\u914d\u4e0d\u540c B2B \u5ba2\u6237\u9700\u6c42\u3002' : 'From ODM/OEM manufacturing to brand franchise and online-offline integration.'}</p>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">01</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? 'ODM/OEM \u751f\u4ea7\u52a0\u5de5' : 'ODM / OEM Manufacturing'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u4e3a\u54c1\u724c\u65b9\u8bbe\u8ba1\u3001\u5236\u4f5c\u3001\u52a0\u5de5\u548c\u4ed3\u50a8\u4e00\u7ad9\u5f0f\u670d\u52a1\u3002' : 'Design, manufacturing and warehousing under one roof.'}</p>
        </div>
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">02</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? '\u6765\u6837\u5b9a\u505a' : 'Sample Customization'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u6839\u636e\u5ba2\u6237\u63d0\u4f9b\u7684\u6b3e\u5f0f\u3001\u56fe\u7eb8\u6216\u7247\u8282\u8fdb\u884c\u6837\u68c9\u3001\u7c73\u62bd\u3002' : 'Sample dyeing and weaving based on client swatches or designs.'}</p>
        </div>
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">03</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? '\u5b9e\u4f53\u6279\u53d1' : 'Physical Wholesale'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u9488\u7eb1\u3001\u5dfe\u3001\u88c5\u3001\u9762\u9762\u6599\u7c7b\u591a\u70c8\u7247\u4ef7\u3002' : 'Direct factory pricing on sweaters, scarves, accessories.'}</p>
        </div>
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">04</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? '\u54c1\u724c\u52a0\u76df' : 'Brand Franchise'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u63a5\u53d7\u56fd\u5185\u5916\u54c1\u724c\u52a0\u76df\u53ca\u4ee3\u5236\u7684\u5ba2\u6237\u3002' : 'Domestic and international brand franchise and licensing clients.'}</p>
        </div>
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">05</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? '\u4e00\u4ef6\u4ee3\u53d1' : 'Drop Shipping'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u5c0f\u6279\u6b21\u5ba2\u6237\u9002\u7528\u3002\u76f4\u53d1\u5ba2\u6237\u3002' : 'Small-batch dropship direct to end customers.'}</p>
        </div>
        <div class="bg-brand-cream/30 p-6 rounded-lg hover-lift">
          <div class="font-serif text-3xl text-brand-gold mb-2">06</div>
          <h3 class="font-serif text-lg mb-2">{locale === 'cn' ? '\u7ebf\u4e0a\u7ebf\u4e0b\u4e00\u4f53' : 'Online + Offline'}</h3>
          <p class="text-sm text-muted-foreground">{locale === 'cn' ? '\u7ebf\u4e0a\u7535\u5546\u5e73\u53f0 + \u7ebf\u4e0b\u7ecf\u9500\u5546 \u4e00\u4f53\u5316\u8fd0\u4f5c\u3002' : 'E-commerce platforms plus offline retailer integration.'}</p>
        </div>
      </div>

      <div class="mt-16 max-w-3xl mx-auto text-center">
        <blockquote class="font-serif text-2xl md:text-3xl text-brand-chocolate font-light italic leading-snug">
          {locale === 'cn' ? '\u201c\u8ba4\u771f\u5408\u4f5c\u3001\u4e92\u60e0\u4e92\u5229\u3001\u5171\u540c\u53d1\u5c55\u201d \u2014 \u6bcf\u4e00\u4efd\u5408\u4f5c\u90fd\u662f\u6109\u5feb\u7684\u3002' : '"Integrity cooperation, mutual benefit, common development" \u2014 every cooperation a pleasant one.'}
        </blockquote>
        <p class="text-xs text-muted-foreground mt-4 uppercase tracking-widest">{locale === 'cn' ? '\u2014 \u96c6\u56e2\u7406\u5ff5' : '\u2014 Our Belief'}</p>
      </div>
    </div>
  </section>


