---
/**
 * Custom 404 page. Without this, Astro returns a bare HTTP 404 with empty body,
 * which hurts SEO crawl budget (Googlebot sees no links to follow) and UX
 * (visitors land on a blank screen with no recovery path).
 *
 * Renders a helpful "what you can do next" layout: search hints, link back
 * to popular categories, and the inquiry form CTA. Each link is a real
 * `<a href>` so Googlebot can continue crawling the site from this URL.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import FloatingChatButtons from '@/components/FloatingChatButtons.astro';
import CookieConsent from '@/components/CookieConsent.astro';

const locale = 'en' as const;

const popularLinks = [
  { href: '/en/yarn-fabric', label: 'Cashmere Yarn & Fabric Wholesale', desc: 'Greige and dyed yarn from 26/2 to 48/2' },
  { href: '/en/raw-material', label: 'Cashmere Raw Material', desc: 'White, brown (qing), purple (zi) dehaired cashmere' },
  { href: '/en/factory', label: 'Ordos Factory Tour', desc: '23-year-old B2B source factory — 38,000 sqm' },
  { href: '/en/products', label: 'All 591 Products', desc: 'Hats, scarves, sweaters, accessories, yarn' },
  { href: '/en/blog', label: 'Cashmere B2B Guides', desc: '32 articles on sourcing, QC, shipping, payment terms' },
  { href: '/en/contact', label: 'Request a Quote', desc: 'MOQ 100 pcs · sample in 7 days · FOB Tianjin' },
];
---
<BaseLayout locale={locale} title="Page Not Found (404) | DONGXIAO® Cashmere" description="The page you're looking for doesn't exist or has moved. Browse our most-visited categories below or contact us for a quote." path="/" noindex={true}>
  <Navigation slot="header" locale={locale} currentPath="/" />

  <section class="py-24 md:py-32 bg-background">
    <div class="container-narrow text-center max-w-3xl mx-auto">
      <p class="text-sm tracking-[0.4em] text-brand-gold uppercase font-medium mb-6">404 · Page Not Found</p>
      <h1 class="font-serif text-4xl md:text-6xl font-light leading-[1.05] mb-6">We can't find<br/>that page.</h1>
      <p class="text-lg text-muted-foreground leading-relaxed mb-12">
        The page may have moved, or the link is broken. Try one of our most-visited sections below, or jump straight to a quote request — we usually reply within 24 hours.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left mb-12">
        {popularLinks.map((l) => (
          <a href={l.href} class="group block border border-border p-6 hover:border-primary hover:shadow-md transition-all">
            <h2 class="text-base font-medium text-foreground group-hover:text-primary mb-1 transition-colors">
              {l.label}
              <svg class="inline-block w-4 h-4 ml-2 -mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </h2>
            <p class="text-sm text-muted-foreground">{l.desc}</p>
          </a>
        ))}
      </div>

      <a href="/en/contact" class="inline-block px-8 py-4 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-all">
        Request a Cashmere Quote →
      </a>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <FloatingChatButtons slot="floating" locale={locale} />
  <CookieConsent slot="cookie-consent" locale={locale} />
</BaseLayout>